pals:ACKicker a owl:Class ;
    rdfs:label "ACKicker" ;
    rdfs:subClassOf pals:Kicker ;
    skos:definition "An ACKicker element simulates a time-dependent kicker.  It is like a Kicker element except that the field varies in time.  This element requires a user supplied time-dependent expression." ;
    skos:exactMatch pals:ACKicker ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Aperture a owl:Class ;
    rdfs:label "Aperture" ;
    rdfs:subClassOf pals:DiagnosticDevice,
        pals:HasReferenceP,
        pals:HasTwissP ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic or limiting aperture element used to constrain or characterize beam passage." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BeamLineSection a owl:Class ;
    rdfs:label "BeamLineSection" ;
    rdfs:subClassOf pals:BookkeepingComponent,
        pals:HasFloorP ;
    skos:definition "A virtual component used to represent a section of the BeamLine for organizational or functional grouping of components." ;
    skos:exactMatch pals:BeamLineSection ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BeginningEle a owl:Class ;
    rdfs:label "BeginningEle" ;
    rdfs:subClassOf pals:BookkeepingComponent,
        pals:HasReferenceP,
        pals:HasTwissP ;
    skos:definition "Initial element at the start of a beamline branch. It holds the initial reference and Twiss parameters for the branch. A BeginningEle may be omitted when the branch is reached through a Fork that propagates its reference parameters; otherwise it is expected to be the first element in the branch." ;
    skos:exactMatch pals:BeginningEle ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BodyShiftParamGroup a owl:Class ;
    rdfs:label "BodyShiftParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:y_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:z_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:z_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:x_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:x_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:z_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:y_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:x_offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:z_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:z_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:z_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:x_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:x_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:y_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:x_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:y_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:y_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:y_offset ],
        pals:ParamGroup ;
    skos:broadMatch pals:BodyShiftP ;
    skos:definition "Mixin class for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:CavityTypeEnum a owl:Class ;
    rdfs:label "CavityTypeEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/CavityTypeEnum#STANDING_WAVE> <https://pals-project.readthedocs.io/CavityTypeEnum#TRAVELING_WAVE> ) ;
    skos:definition "The type of cavity, which determines the field configuration and mode structure." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/CavityTypeEnum#STANDING_WAVE>,
        <https://pals-project.readthedocs.io/CavityTypeEnum#TRAVELING_WAVE> .

pals:CrabCavity a owl:Class ;
    rdfs:label "CrabCavity" ;
    rdfs:subClassOf pals:Cavity ;
    skos:definition "A cavity used for transverse beam manipulation, such as crabbing or deflecting." ;
    skos:exactMatch pals:CrabCavity ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:E_tot_ref a owl:DatatypeProperty ;
    rdfs:label "E_tot_ref" ;
    skos:altLabel "ETotal" ;
    skos:definition "[eV] Reference total energy" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasElectricMultipoleP a owl:Class ;
    rdfs:label "HasElectricMultipoleP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:ElectricMultipoleParamGroup ;
            owl:onProperty pals:ElectricMultipoleP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:ElectricMultipoleP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:ElectricMultipoleP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasLongitudinalPlacementP a owl:Class ;
    rdfs:label "HasLongitudinalPlacementP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:LongitudinalPlacementParamGroup ;
            owl:onProperty pals:LongitudinalPlacementP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:LongitudinalPlacementP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:LongitudinalPlacementP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasMagneticMultipoleP a owl:Class ;
    rdfs:label "HasMagneticMultipoleP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:MagneticMultipoleP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:MagneticMultipoleP ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:MagneticMultipoleParamGroup ;
            owl:onProperty pals:MagneticMultipoleP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:L_active a owl:DatatypeProperty ;
    rdfs:label "L_active" ;
    skos:definition "Active acceleration length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:L_chord a owl:DatatypeProperty ;
    rdfs:label "L_chord" ;
    skos:definition "Chord length of the bend." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:L_rectangle a owl:DatatypeProperty ;
    rdfs:label "L_rectangle" ;
    skos:definition "Rectangular length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:L_sagitta a owl:DatatypeProperty ;
    rdfs:label "L_sagitta" ;
    skos:definition "Output parameter. Sagitta length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:LongitudinalPlacementP a owl:ObjectProperty ;
    rdfs:label "LongitudinalPlacementP" ;
    skos:definition "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:MagneticMultipoleParamGroup a owl:Class ;
    rdfs:label "MagneticMultipoleParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:mag_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:MultipoleParameterGroup ;
            owl:onProperty pals:mag_components ],
        pals:ParamGroup ;
    skos:broadMatch pals:MagneticMultipoleP ;
    skos:definition """Mixin for magnetic multipole parameters,  which can be used to describe the magnetic field components of an accelerator element. This mixin is aligned with PALS MagneticMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS). Example with three multipole components (N=0,1,2): ```yaml mag_components: - order: 7
  tilt: 0.7
- order: 3
  Bn: 27.3
- order: 2
  BnL: 3.47e1
- order: 1
  Kn: 0.85     # normalized form, e.g. a quadrupole's k1-like strength
```""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Octupole a owl:Class ;
    rdfs:label "Octupole" ;
    rdfs:subClassOf pals:Multipole ;
    skos:definition """A magnet primarily used to focus or defocus the beam. 8 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:exactMatch pals:Octupole ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:PALSAccelerator a owl:Class ;
    rdfs:label "PALSAccelerator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:notes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Facility ;
            owl:onProperty pals:facility ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Author ;
            owl:onProperty pals:authors ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Affiliation ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" ] ) ] ) ] ;
            owl:onProperty pals:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:facility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:authors ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:facility ] ;
    skos:definition "Root container for accelerator core components, semantic signals, and local bindings." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:PlaneEnum a owl:Class ;
    rdfs:label "PlaneEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/PlaneEnum#Horizontal> <https://pals-project.readthedocs.io/PlaneEnum#Vertical> ) ;
    skos:definition "Controlled values for transverse plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/PlaneEnum#Horizontal>,
        <https://pals-project.readthedocs.io/PlaneEnum#Vertical> .

pals:RFParamGroup a owl:Class ;
    rdfs:label "RFParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:dE_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:multipass_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:cavity_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:cavity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:CavityTypeEnum ;
            owl:onProperty pals:cavity_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:harmon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:L_active ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pals:num_cells ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:L_active ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:ZeroPhaseEnum ;
            owl:onProperty pals:zero_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:zero_phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pals:harmon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:harmon ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:L_active ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:frequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:voltage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:dE_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:voltage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:voltage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:dE_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:multipass_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:zero_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:num_cells ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:multipass_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:frequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:num_cells ],
        pals:ParamGroup ;
    skos:broadMatch pals:RFP ;
    skos:definition "Mixin for RF parameters, which can be used to describe the RF properties of an accelerator element. This mixin is aligned with PALS RFP for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Sextupole a owl:Class ;
    rdfs:label "Sextupole" ;
    rdfs:subClassOf pals:Multipole ;
    skos:definition """A magnet primarily used to focus or defocus the beam. 6 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:exactMatch pals:Sextupole ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:SolenoidParamGroup a owl:Class ;
    rdfs:label "SolenoidParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:Bsol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Bsol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:Bsol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Ksol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:Ksol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:Ksol ],
        pals:ParamGroup ;
    skos:definition "Mixin for solenoid-specific parameters." ;
    skos:exactMatch pals:SolenoidP ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:access_protocol a owl:DatatypeProperty ;
    rdfs:label "access_protocol" ;
    skos:definition "The protocol used to access the signal in the source system,  such as EPICS Channel Access, PALS-Ext, MYA, or a simulation service." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:alpha_a a owl:DatatypeProperty ;
    rdfs:label "alpha_a" ;
    skos:altLabel "alpha_x",
        "alphax" ;
    skos:definition "Twiss alpha parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:alpha_b a owl:DatatypeProperty ;
    rdfs:label "alpha_b" ;
    skos:altLabel "alpha_y",
        "alphay" ;
    skos:definition "Twiss alpha parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:angle_ref a owl:DatatypeProperty ;
    rdfs:label "angle_ref" ;
    skos:definition "Reference bend angle." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:archive_identifier a owl:DatatypeProperty ;
    rdfs:label "archive_identifier" ;
    skos:definition "The identifier used to reference the signal in an archival system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:bend_field_actual a owl:DatatypeProperty ;
    rdfs:label "bend_field_actual" ;
    skos:definition "Actual bend field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:bend_field_ref a owl:DatatypeProperty ;
    rdfs:label "bend_field_ref" ;
    skos:definition "Reference bend field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:beta_a a owl:DatatypeProperty ;
    rdfs:label "beta_a" ;
    skos:altLabel "beta_x",
        "betax" ;
    skos:definition "Twiss beta parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:beta_b a owl:DatatypeProperty ;
    rdfs:label "beta_b" ;
    skos:altLabel "beta_y",
        "betay" ;
    skos:definition "Twiss beta parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:canonical_signal_type a owl:ObjectProperty ;
    rdfs:label "canonical_signal_type" ;
    skos:definition "The canonical semantic meaning of the signal." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:cavity_type a owl:ObjectProperty ;
    rdfs:label "cavity_type" ;
    skos:definition "Cavity type" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:component_direction a owl:ObjectProperty ;
    rdfs:label "component_direction" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:coordinate_system a owl:ObjectProperty ;
    rdfs:label "coordinate_system" ;
    skos:definition "The coordinate system used for the coordinates (e.g., Cartesian, Cylindrical)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:dE_ref a owl:DatatypeProperty ;
    rdfs:label "dE_ref" ;
    skos:definition "Reference energy gain." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:datatype a owl:ObjectProperty ;
    rdfs:label "datatype" ;
    skos:definition "Hint for the value's original type, so consumers can parse it back (e.g. float, integer, boolean) rather than treating everything as an opaque string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:direction a owl:DatatypeProperty ;
    rdfs:label "direction" ;
    skos:definition "Beam direction along the BeamLine: +1 or -1. Longitudinal orientation. Default is +1." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:e1 a owl:DatatypeProperty ;
    rdfs:label "e1" ;
    skos:definition "Entrance end pole face rotation with respect to a sector geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:e1_rect a owl:DatatypeProperty ;
    rdfs:label "e1_rect" ;
    skos:definition "Entrance end pole face rotation with respect to a rectangular geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:e2 a owl:DatatypeProperty ;
    rdfs:label "e2" ;
    skos:definition "Exit end pole face rotation with respect to a sector geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:e2_rect a owl:DatatypeProperty ;
    rdfs:label "e2_rect" ;
    skos:definition "Exit end pole face rotation with respect to a rectangular geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:edge1_int a owl:DatatypeProperty ;
    rdfs:label "edge1_int" ;
    skos:definition "Entrance end fringe field integral." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:edge2_int a owl:DatatypeProperty ;
    rdfs:label "edge2_int" ;
    skos:definition "Exit end fringe field integral." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    skos:definition "The email address of the author." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:eta_x a owl:DatatypeProperty ;
    rdfs:label "eta_x" ;
    skos:altLabel "etax" ;
    skos:definition "Twiss dispersion parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:eta_y a owl:DatatypeProperty ;
    rdfs:label "eta_y" ;
    skos:altLabel "etay" ;
    skos:definition "Twiss dispersion parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:etap_x a owl:DatatypeProperty ;
    rdfs:label "etap_x" ;
    skos:altLabel "etapx" ;
    skos:definition "Twiss dispersion slope parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:etap_y a owl:DatatypeProperty ;
    rdfs:label "etap_y" ;
    skos:altLabel "etapy" ;
    skos:definition "Twiss dispersion slope parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:facility a owl:ObjectProperty ;
    rdfs:label "facility" ;
    skos:definition "A facility that contains lattice elements (physical and virtual), beamlines, parameter set commands, signals, etc." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    skos:definition "RF frequency." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:g_actual a owl:DatatypeProperty ;
    rdfs:label "g_actual" ;
    skos:definition "Actual bend strength = 1/radius_actual" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:g_ref a owl:DatatypeProperty ;
    rdfs:label "g_ref" ;
    skos:definition "Reference bend strength = 1/radius_ref" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:h1 a owl:DatatypeProperty ;
    rdfs:label "h1" ;
    skos:definition "Entrance end pole face curvature" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:h2 a owl:DatatypeProperty ;
    rdfs:label "h2" ;
    skos:definition "Exit end pole face curvature" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:harmon a owl:DatatypeProperty ;
    rdfs:label "harmon" ;
    skos:definition "RF harmonic number." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:identifier_type a owl:ObjectProperty ;
    rdfs:label "identifier_type" ;
    skos:definition "The type of identifier, such as DOI | PURL | ROR | LOCAL | URL | ARK." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:identifier_value a owl:DatatypeProperty ;
    rdfs:label "identifier_value" ;
    skos:definition "The value of the identifier." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:key a owl:DatatypeProperty ;
    rdfs:label "key" ;
    skos:definition "The metadata field name." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:definition "A label string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:multipass a owl:DatatypeProperty ;
    rdfs:label "multipass" ;
    skos:definition "Indicates whether the BeamLine is a multipass BeamLine, where the beam passes through the same physical elements multiple times. If not provided, the default assumption is that the BeamLine is single-pass." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:multipass_phase a owl:DatatypeProperty ;
    rdfs:label "multipass_phase" ;
    skos:definition "rad/2pi RF Phase added to multipass elements" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:native_data_type a owl:ObjectProperty ;
    rdfs:label "native_data_type" ;
    skos:definition "The native data type of the signal in the source system,  such as String, Integer, Float, or Boolean." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:native_description a owl:DatatypeProperty ;
    rdfs:label "native_description" ;
    skos:definition "A human-readable description of the signal in the source system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:native_unit a owl:ObjectProperty ;
    rdfs:label "native_unit" ;
    skos:definition "The native unit of the signal in the source system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:num_cells a owl:DatatypeProperty ;
    rdfs:label "num_cells" ;
    skos:definition "Number of cells in the cavity" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:orcid a owl:DatatypeProperty ;
    rdfs:label "orcid" ;
    skos:definition "The ORCID identifier of the author." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:order a owl:DatatypeProperty ;
    rdfs:label "order" ;
    skos:definition "Multipole order N (0 = dipole, 1 = quadrupole, etc.)" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:pc_ref a owl:DatatypeProperty ;
    rdfs:label "pc_ref" ;
    skos:altLabel "pCentral" ;
    skos:definition "[momentum*c] Reference momentum times speed of light." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:periodic a owl:DatatypeProperty ;
    rdfs:label "periodic" ;
    skos:definition "Indicates whether orbit and Twiss parameters periodic. If not provided, the default assumption is that the BeamLine is not periodic." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:phase a owl:DatatypeProperty ;
    rdfs:label "phase" ;
    skos:definition "RF phase. rad/2pi RF phase in 0 to 2*pi" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:phi a owl:DatatypeProperty ;
    rdfs:label "phi" ;
    skos:altLabel "ModelPitch",
        "Model_Pitch",
        "phi_angle" ;
    skos:definition "Rotation around the X-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:phi_a a owl:DatatypeProperty ;
    rdfs:label "phi_a" ;
    skos:altLabel "phi_x",
        "phix",
        "psi_x",
        "psix" ;
    skos:definition "Twiss phase advance parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:phi_b a owl:DatatypeProperty ;
    rdfs:label "phi_b" ;
    skos:altLabel "phi_y",
        "phiy",
        "psi_y",
        "psiy" ;
    skos:definition "Twiss phase advance parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:phi_coord a owl:DatatypeProperty ;
    rdfs:label "phi_coord" ;
    skos:definition "The azimuthal angle in spherical coordinates (in radians)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:plane a owl:ObjectProperty ;
    rdfs:label "plane" ;
    skos:definition "The transverse plane in which the kicker operates, either horizontal or vertical." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:psi a owl:DatatypeProperty ;
    rdfs:label "psi" ;
    skos:altLabel "Model_Roll",
        "Rotation",
        "psi_angle" ;
    skos:definition "Rotation around the Z-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:quantity_kind a owl:ObjectProperty ;
    rdfs:label "quantity_kind" ;
    skos:definition "The physical quantity kind of the signal." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:r_coord a owl:DatatypeProperty ;
    rdfs:label "r_coord" ;
    skos:definition "The radial distance in cylindrical coordinates." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:reference_frame a owl:ObjectProperty ;
    rdfs:label "reference_frame" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:repeat a owl:DatatypeProperty ;
    rdfs:label "repeat" ;
    skos:definition """Repetition count. If not provided, the default assumption is that the beamline is not repeated and the value is 1.
If value is greater than 1, the beamline is repeated that many times.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:rho_ref a owl:DatatypeProperty ;
    rdfs:label "rho_ref" ;
    skos:definition "Reference bend radius." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:signal_role a owl:ObjectProperty ;
    rdfs:label "signal_role" ;
    skos:definition "The role of the signal in the control system, such as setpoint, readback, status, command, or limit." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:source_system a owl:ObjectProperty ;
    rdfs:label "source_system" ;
    skos:definition "The source system from which the signal originates, such as EPICS, PALS-Ext, MYA, an element database, a channel database, or a simulation service." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:species_ref a owl:DatatypeProperty ;
    rdfs:label "species_ref" ;
    skos:definition "A reference to a species or particle type, such as an ion, electron, or proton." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:theta a owl:DatatypeProperty ;
    rdfs:label "theta" ;
    skos:altLabel "ModelYaw",
        "Model_Yaw",
        "theta_angle" ;
    skos:definition "Orientation angle around the Y-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:theta_coord a owl:DatatypeProperty ;
    rdfs:label "theta_coord" ;
    skos:definition "The angular coordinate in cylindrical coordinates (in radians)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:tilt_ref a owl:DatatypeProperty ;
    rdfs:label "tilt_ref" ;
    skos:definition "Reference tilt of the bend." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:time_ref a owl:DatatypeProperty ;
    rdfs:label "time_ref" ;
    skos:altLabel "tRef" ;
    skos:definition "[s] Reference time" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    skos:definition "The metadata value, serialized as a string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:definition "Version of the representation of a particle accelerator and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:voltage a owl:DatatypeProperty ;
    rdfs:label "voltage" ;
    skos:definition "RF voltage." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:x a owl:DatatypeProperty ;
    rdfs:label "x" ;
    skos:altLabel "ModelX",
        "x coordinate",
        "x_coordinate" ;
    skos:definition "Global X coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:x_coord a owl:DatatypeProperty ;
    rdfs:label "x_coord" ;
    skos:definition "The x-coordinate in the specified coordinate system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:x_offset a owl:DatatypeProperty ;
    rdfs:label "x_offset" ;
    skos:altLabel "GlobalOffsetX",
        "delta_x",
        "x_shift" ;
    skos:definition "Shift in the X direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:x_rot a owl:DatatypeProperty ;
    rdfs:label "x_rot" ;
    skos:altLabel "GlobalOffsetPhi",
        "delta_phi",
        "phi_shift" ;
    skos:definition "Rotation around the X-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:y a owl:DatatypeProperty ;
    rdfs:label "y" ;
    skos:altLabel "ModelY",
        "y coordinate",
        "y_coordinate" ;
    skos:definition "Global Y coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:y_coord a owl:DatatypeProperty ;
    rdfs:label "y_coord" ;
    skos:definition "The y-coordinate in the specified coordinate system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:y_offset a owl:DatatypeProperty ;
    rdfs:label "y_offset" ;
    skos:altLabel "GlobalOffsetY",
        "delta_y",
        "y_shift" ;
    skos:definition "Shift in the Y direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:y_rot a owl:DatatypeProperty ;
    rdfs:label "y_rot" ;
    skos:altLabel "GlobalOffsetTheta",
        "delta_theta",
        "theta_shift" ;
    skos:definition "Rotation around the Y-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:z a owl:DatatypeProperty ;
    rdfs:label "z" ;
    skos:altLabel "ModelZ",
        "z coordinate",
        "z_coordinate" ;
    skos:definition "Global Z coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:z_coord a owl:DatatypeProperty ;
    rdfs:label "z_coord" ;
    skos:definition "The z-coordinate in the specified coordinate system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:z_offset a owl:DatatypeProperty ;
    rdfs:label "z_offset" ;
    skos:altLabel "GlobalOffsetZ",
        "delta_z",
        "z_shift" ;
    skos:definition "Shift in the Z direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:z_rot a owl:DatatypeProperty ;
    rdfs:label "z_rot" ;
    skos:altLabel "GlobalOffsetPsi",
        "delta_psi",
        "psi_shift" ;
    skos:definition "Rotation around the Z-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:zero_phase a owl:ObjectProperty ;
    rdfs:label "zero_phase" ;
    skos:definition "Sets what phase = 0 means." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

xsd:boolean a owl:Class ;
    rdfs:label "Boolean" ;
    rdfs:subClassOf pals:DataTypeEnum ;
    skos:definition "boolean data type" .

inst:IFYK203 a pals:BeamProfileMonitor ;
    pals:FloorP <https://example.org/pals-instance/IFYK203/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/IFYK203/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/IFYK203/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/IFYK203/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/IFYK203/TwissP> ;
    pals:native_types "DiagnosticDevice",
        "FaradayCup",
        "MONITOR" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "BeamCurrentMeasurement" ;
    pals:precedes inst:ISLK302 .

inst:ISLK302 a pals:Aperture ;
    pals:FloorP <https://example.org/pals-instance/ISLK302/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/ISLK302/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/ISLK302/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/ISLK302/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/ISLK302/TwissP> ;
    pals:native_types "Aperture",
        "DiagnosticDevice",
        "MONITOR" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "Measurement" ;
    pals:precedes inst:IYGK302 .

inst:ITVK201 a pals:BeamProfileMonitor ;
    pals:FloorP <https://example.org/pals-instance/ITVK201/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/ITVK201/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/ITVK201/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/ITVK201/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/ITVK201/TwissP> ;
    pals:native_types "DiagnosticDevice",
        "MONITOR",
        "Standard" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "BeamProfileMeasurement" ;
    pals:precedes inst:MDSK201 .

inst:IYGK302 a pals:BeamProfileMonitor ;
    pals:FloorP <https://example.org/pals-instance/IYGK302/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/IYGK302/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/IYGK302/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/IYGK302/ReferenceP> ;
    pals:native_types "DiagnosticDevice",
        "MONITOR",
        "YAG" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "BeamProfileMeasurement" ;
    pals:precedes inst:RM11 .

inst:MFHK101 a pals:Solenoid ;
    pals:FloorP <https://example.org/pals-instance/MFHK101/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/MFHK101/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/MFHK101/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/MFHK101/ReferenceP> ;
    pals:SolenoidP <https://example.org/pals-instance/MFHK101/SolenoidP> ;
    pals:TwissP <https://example.org/pals-instance/MFHK101/TwissP> ;
    pals:native_types "SOLE",
        "Solenoid" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "Focusing" ;
    pals:precedes inst:IPMK102 .

inst:S_IS_20CM a pals:Marker ;
    pals:FloorP <https://example.org/pals-instance/S_IS_20CM/FloorP> ;
    pals:MetaP <https://example.org/pals-instance/S_IS_20CM/MetaP> ;
    pals:TwissP <https://example.org/pals-instance/S_IS_20CM/TwissP> ;
    pals:native_types "Mark",
        "Marker" ;
    pals:precedes inst:IPMK101 ;
    pals:virtual_beamline_relation "Inline" ;
    pals:virtual_function pals:Marker .

pals:Affiliation a owl:Class ;
    rdfs:label "Affiliation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:identifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Identifier ;
            owl:onProperty pals:identifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:id ] ;
    skos:definition "Contains affiliation information for an author or component, such as a ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BeamPositionMonitor a owl:Class ;
    rdfs:label "BeamPositionMonitor" ;
    rdfs:subClassOf pals:DiagnosticDevice,
        pals:HasBodyShiftP,
        pals:HasReferenceP,
        pals:HasTwissP ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic device used to measure transverse beam position." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Bend a owl:Class ;
    rdfs:label "Bend" ;
    rdfs:subClassOf pals:HasBendP,
        pals:Multipole ;
    skos:altLabel "Dipole" ;
    skos:definition "Dipole magnet used to bend the beam. 2 poles. The major difference between this element and other physical elements is that with a Bend  the curvilinear coordinate system is an arc with finite curvature  and for the other elements the curvilinear coordinate system is straight." ;
    skos:exactMatch pals:Bend ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BendP a owl:ObjectProperty ;
    rdfs:label "BendP" ;
    skos:definition "A mixin for bend parameters that are aligned with PALS BendP (Bend Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BendParamGroup a owl:Class ;
    rdfs:label "BendParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:ReferenceGeometryEnum ;
            owl:onProperty pals:ref_geometry ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:tilt_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:h2 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:edge2_int ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:edge2_int ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:L_sagitta ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:rho_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:e1 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:bend_field_actual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:bend_field_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:tilt_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:L_chord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:e1_rect ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:e2_rect ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:bend_field_actual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:g_actual ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:L_rectangle ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:e2 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:angle_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:tilt_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:e2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:e1 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:bend_field_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:h2 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:L_chord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:g_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:h1 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:L_rectangle ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:multipole_geometry ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:angle_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:edge2_int ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:e1_rect ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:g_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:h1 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:L_sagitta ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:rho_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:MultipoleGeometryEnum ;
            owl:onProperty pals:multipole_geometry ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:g_actual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:e1 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:L_chord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:e2_rect ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:edge1_int ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:ref_geometry ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:g_actual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:e2_rect ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:e1_rect ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:L_rectangle ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:g_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:bend_field_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:edge1_int ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:angle_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:h1 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:L_sagitta ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:bend_field_actual ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:h2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:rho_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:ref_geometry ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:edge1_int ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:multipole_geometry ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:e2 ],
        pals:ParamGroup ;
    skos:definition "Mixin for bend parameters, which can be used to describe the bending properties of an accelerator element. This mixin is aligned with PALS BendP for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:exactMatch pals:BendP ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BodyShiftP a owl:ObjectProperty ;
    rdfs:label "BodyShiftP" ;
    skos:definition "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Cavity a owl:Class ;
    rdfs:label "Cavity" ;
    rdfs:subClassOf pals:HasBodyShiftP,
        pals:HasElectricMultipoleP,
        pals:HasMagneticMultipoleP,
        pals:HasReferenceP,
        pals:HasTwissP,
        pals:PhysicalComponent ;
    skos:definition "A cavity used for beam acceleration or manipulation." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:CoordinateSystemEnum a owl:Class ;
    rdfs:label "CoordinateSystemEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/CoordinateSystemEnum#Cartesian> <https://pals-project.readthedocs.io/CoordinateSystemEnum#Cylindrical> <https://pals-project.readthedocs.io/CoordinateSystemEnum#Spherical> ) ;
    skos:definition "Coordinate systems for spatial relationships." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/CoordinateSystemEnum#Cartesian>,
        <https://pals-project.readthedocs.io/CoordinateSystemEnum#Cylindrical>,
        <https://pals-project.readthedocs.io/CoordinateSystemEnum#Spherical> .

pals:Edge a owl:Class ;
    rdfs:label "Edge" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:subject ] ;
    skos:definition "Abstract base for subject-predicate-object associations." ;
    skos:exactMatch rdf:Statement ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:FloorP a owl:ObjectProperty ;
    rdfs:label "FloorP" ;
    skos:definition "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasFloorP a owl:Class ;
    rdfs:label "HasFloorP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:FloorP ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:FloorParamGroup ;
            owl:onProperty pals:FloorP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:FloorP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:MagneticMultipoleP a owl:ObjectProperty ;
    rdfs:label "MagneticMultipoleP" ;
    skos:definition "A mixin for magnetic multipole parameters that are aligned with PALS MagneticMultipoleP (Magnetic Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:MetaP a owl:ObjectProperty ;
    rdfs:label "MetaP" ;
    skos:definition "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Node a owl:Class ;
    rdfs:label "Node" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:alias ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:alias ] ;
    skos:definition "Abstract base class for all node entities in the accelerator core ontology. This differentiates nodes from edges (relationships) in the ontology. This class is not intended to be instantiated directly, but serves as a common ancestor for all other classes. Allows for the use of kind: as a discriminator for the type of node in the ontology." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Quadrupole a owl:Class ;
    rdfs:label "Quadrupole" ;
    rdfs:subClassOf pals:Multipole ;
    skos:definition """A magnet primarily used to focus or defocus the beam. 4 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:exactMatch pals:Quadrupole ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:RFP a owl:ObjectProperty ;
    rdfs:label "RFP" ;
    skos:definition "A mixin for RF parameters that are aligned with PALS RFP (RF Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:ReferenceP a owl:ObjectProperty ;
    rdfs:label "ReferenceP" ;
    skos:definition "A mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Solenoid a owl:Class ;
    rdfs:label "Solenoid" ;
    rdfs:subClassOf pals:HasSolenoidP,
        pals:Magnet ;
    skos:definition """A magnet with a primarily longitudinal magnetic field used for focusing.
A solenoid is an element whose magnetic field is dominated by a field whose direction is aligned with the magnetic axis. """ ;
    skos:exactMatch pals:Solenoid ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:SolenoidP a owl:ObjectProperty ;
    rdfs:label "SolenoidP" ;
    skos:definition "A mixin for solenoid-specific parameters that are aligned with PALS SolenoidP (Solenoid Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:SuperConductingRFCavity a owl:Class ;
    rdfs:label "SuperConductingRFCavity" ;
    rdfs:subClassOf pals:RFCavity ;
    skos:broadMatch pals:RFCavity ;
    skos:definition "A cavity used for RF acceleration or longitudinal manipulation, which is superconducting." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:TwissP a owl:ObjectProperty ;
    rdfs:label "TwissP" ;
    skos:definition "A mixin for Twiss parameters that are aligned with PALS TwissP (Twiss Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:VirtualRelationEnum a owl:Class ;
    rdfs:label "VirtualRelationEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/VirtualRelationEnum#Inline> <https://pals-project.readthedocs.io/VirtualRelationEnum#AssociatedWithBeamLine> <https://pals-project.readthedocs.io/VirtualRelationEnum#NotAssociatedWithBeamLine> ) ;
    skos:definition "Controlled values for virtual relation to the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/VirtualRelationEnum#AssociatedWithBeamLine>,
        <https://pals-project.readthedocs.io/VirtualRelationEnum#Inline>,
        <https://pals-project.readthedocs.io/VirtualRelationEnum#NotAssociatedWithBeamLine> .

pals:ZeroPhaseEnum a owl:Class ;
    rdfs:label "ZeroPhaseEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/ZeroPhaseEnum#ACCELERATING> <https://pals-project.readthedocs.io/ZeroPhaseEnum#BELOW_TRANSITION> <https://pals-project.readthedocs.io/ZeroPhaseEnum#ABOVE_TRANSITION> ) ;
    skos:definition "The zero phase reference for the cavity, which determines the phase of the RF field at the entrance of the cavity." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/ZeroPhaseEnum#ABOVE_TRANSITION>,
        <https://pals-project.readthedocs.io/ZeroPhaseEnum#ACCELERATING>,
        <https://pals-project.readthedocs.io/ZeroPhaseEnum#BELOW_TRANSITION> .

pals:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    rdfs:range xsd:string ;
    skos:definition "An alternative name or identifier for the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:identifiers a owl:ObjectProperty ;
    rdfs:label "identifiers" ;
    rdfs:range pals:Identifier ;
    skos:definition "A unique and ideally persistent identifier for the facility, such as a DOI or ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:s_position a owl:DatatypeProperty ;
    rdfs:label "s_position" ;
    skos:definition "Longitudinal position of the element along the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:tilt a owl:DatatypeProperty ;
    rdfs:label "tilt" ;
    skos:broadMatch pals:tilt ;
    skos:definition "Tilt of the Nth multipole." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

inst:RF_LASER a pals:SuperConductingRFCavity ;
    pals:FloorP <https://example.org/pals-instance/RF_LASER/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/RF_LASER/LongitudinalPlacementP> ;
    pals:RFP <https://example.org/pals-instance/RF_LASER/RFP> ;
    pals:ReferenceP <https://example.org/pals-instance/RF_LASER/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/RF_LASER/TwissP> ;
    pals:has_readback_signal inst:RK11.GMES,
        inst:RK11.STAT ;
    pals:has_setpoint_signal inst:RK11.GET ;
    pals:native_types "RFCA",
        "RFCavity",
        "WarmCavity" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "BeamAcceleration",
        "Focusing" ;
    pals:precedes inst:S_IS_20CM .

pals:BookkeepingComponent a owl:Class ;
    rdfs:label "BookkeepingComponent" ;
    rdfs:subClassOf pals:HasBodyShiftP,
        pals:VirtualComponent ;
    skos:broadMatch pals:BookkeepingElement ;
    skos:definition "A virtual component that represents a bookkeeping or organizational role in the accelerator system,  such as a BeamLineSection, Marker or a Fork. These can include BeamLineSections, Markers, Forks, and other virtual components that are important for understanding  the structure and function of the accelerator system but are not physical devices." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:CoordinateSet a owl:Class ;
    rdfs:label "CoordinateSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:z_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:theta_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:CoordinateSystemEnum ;
            owl:onProperty pals:coordinate_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:coordinate_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:r_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:coordinate_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:phi_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:theta_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:x_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:theta_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:phi_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:y_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:r_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:z_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:y_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:r_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:y_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:phi_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:z_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:x_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:x_coord ] ;
    skos:definition "A set of coordinates that define the spatial relationship between two components. This can include Cartesian coordinates, cylindrical coordinates, or other coordinate systems as needed. Useful for defining the spatial relationship where the relationship is not strictly linear or where the components are not aligned along a single axis." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:DirectionEnum a owl:Class ;
    rdfs:label "DirectionEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/DirectionEnum#upstream> <https://pals-project.readthedocs.io/DirectionEnum#downstream> <https://pals-project.readthedocs.io/DirectionEnum#positive> <https://pals-project.readthedocs.io/DirectionEnum#negative> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/DirectionEnum#downstream>,
        <https://pals-project.readthedocs.io/DirectionEnum#negative>,
        <https://pals-project.readthedocs.io/DirectionEnum#positive>,
        <https://pals-project.readthedocs.io/DirectionEnum#upstream> .

pals:Drift a owl:Class ;
    rdfs:label "Drift",
        "DriftSpace" ;
    rdfs:subClassOf pals:HasLongitudinalPlacementP,
        pals:VirtualComponent,
        pals:VirtualFunctionEnum ;
    skos:definition "A field-free longitudinal interval separating beamline components.",
        "A field-free space between beamline components. A Drift is a virtual beamline component whose longitudinal extent preserves the separation between adjacent physical or virtual components." ;
    skos:exactMatch pals:Drift ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:ElectricMultipoleP a owl:ObjectProperty ;
    rdfs:label "ElectricMultipoleP" ;
    skos:definition "A mixin for electric multipole parameters that are aligned with PALS ElectricMultipoleP (Electric Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Magnet a owl:Class ;
    rdfs:label "Magnet" ;
    rdfs:subClassOf pals:HasBodyShiftP,
        pals:HasReferenceP,
        pals:HasTwissP,
        pals:PhysicalComponent ;
    skos:broadMatch pals:Element ;
    skos:definition "An accelerator device that produces a magnetic field for beam control." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:PhysicalRelationEnum a owl:Class ;
    rdfs:label "PhysicalRelationEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/PhysicalRelationEnum#Inline> <https://pals-project.readthedocs.io/PhysicalRelationEnum#AttachedToPipe> <https://pals-project.readthedocs.io/PhysicalRelationEnum#NearBeamLine> <https://pals-project.readthedocs.io/PhysicalRelationEnum#SupportingFacility> ) ;
    skos:definition "Controlled values for physical relation to the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/PhysicalRelationEnum#AttachedToPipe>,
        <https://pals-project.readthedocs.io/PhysicalRelationEnum#Inline>,
        <https://pals-project.readthedocs.io/PhysicalRelationEnum#NearBeamLine>,
        <https://pals-project.readthedocs.io/PhysicalRelationEnum#SupportingFacility> .

pals:ReferenceFrameEnum a owl:Class ;
    rdfs:label "ReferenceFrameEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/ReferenceFrameEnum#beam_direction> <https://pals-project.readthedocs.io/ReferenceFrameEnum#facility_coordinates> <https://pals-project.readthedocs.io/ReferenceFrameEnum#local_component_frame> <https://pals-project.readthedocs.io/ReferenceFrameEnum#tunnel_stationing> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/ReferenceFrameEnum#beam_direction>,
        <https://pals-project.readthedocs.io/ReferenceFrameEnum#facility_coordinates>,
        <https://pals-project.readthedocs.io/ReferenceFrameEnum#local_component_frame>,
        <https://pals-project.readthedocs.io/ReferenceFrameEnum#tunnel_stationing> .

pals:ReferenceGeometryEnum a owl:Class ;
    rdfs:label "ReferenceGeometryEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/ReferenceGeometryEnum#arc> <https://pals-project.readthedocs.io/ReferenceGeometryEnum#chord> <https://pals-project.readthedocs.io/ReferenceGeometryEnum#entrance_coords> <https://pals-project.readthedocs.io/ReferenceGeometryEnum#exit_coords> ) ;
    skos:definition "The reference geometry used to calculate multipoles.  Sets the geometry used to calculate multipoles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/ReferenceGeometryEnum#arc>,
        <https://pals-project.readthedocs.io/ReferenceGeometryEnum#chord>,
        <https://pals-project.readthedocs.io/ReferenceGeometryEnum#entrance_coords>,
        <https://pals-project.readthedocs.io/ReferenceGeometryEnum#exit_coords> .

pals:VirtualComponent a owl:Class ;
    rdfs:label "VirtualComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:functions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:beamline_relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:VirtualRelationEnum ;
            owl:onProperty pals:beamline_relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:VirtualFunctionEnum ;
            owl:onProperty pals:functions ],
        pals:Component,
        pals:HasFloorP ;
    skos:broadMatch pals:BookkeepingElement,
        pals:Element ;
    skos:definition "A virtual or logical component that represents a concept, function, or role in the accelerator  beamline operation but does not have a physical instantiation.  This can be used to capture abstract components, such as Markers, BeamLineSections, and FacilitySpaces that are important for understanding the structure and function of the accelerator system but are not physical devices." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:multipole_geometry a owl:ObjectProperty ;
    rdfs:label "multipole_geometry" ;
    skos:definition "Multipole geometry type. Must be `follows_ref_geometry`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:ref_geometry a owl:ObjectProperty ;
    rdfs:label "ref_geometry" ;
    skos:definition "Reference geometry type. Must be `arc`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

quantitykind:ElectricFieldStrength a owl:Class ;
    rdfs:label "CavityGradient" ;
    rdfs:subClassOf pals:QuantityKindEnum ;
    skos:definition "Cavity accelerating gradient." .

qudt:MegaV-PER-M a owl:Class ;
    rdfs:label "MV_per_m" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "megavolt per meter" .

qudt:MilliM a owl:Class ;
    rdfs:label "mm" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "millimeter" .

inst:RM11 a pals:SuperConductingRFCavity ;
    pals:FloorP <https://example.org/pals-instance/RM11/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/RM11/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/RM11/MetaP> ;
    pals:RFP <https://example.org/pals-instance/RM11/RFP> ;
    pals:ReferenceP <https://example.org/pals-instance/RM11/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/RM11/TwissP> ;
    pals:has_readback_signal inst:RM11.GMES,
        inst:RM11.STAT ;
    pals:has_setpoint_signal inst:RM11.GET ;
    pals:native_types "CryoCavity",
        "RFCA",
        "RFCavity" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "BeamAcceleration" .

pals:BeamProfileMonitor a owl:Class ;
    rdfs:label "BeamProfileMonitor" ;
    rdfs:subClassOf pals:DiagnosticDevice,
        pals:HasBodyShiftP,
        pals:HasReferenceP,
        pals:HasTwissP ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic device used to measure transverse beam profile." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Bsol a owl:DatatypeProperty ;
    rdfs:label "Bsol" ;
    skos:definition "Solenoid field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:DiagnosticDevice a owl:Class ;
    rdfs:label "DiagnosticDevice" ;
    rdfs:subClassOf pals:PhysicalComponent ;
    skos:broadMatch pals:Instrument ;
    skos:definition "An accelerator device used to measure beam or machine state." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasReferenceP a owl:Class ;
    rdfs:label "HasReferenceP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:ReferenceParamGroup ;
            owl:onProperty pals:ReferenceP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:ReferenceP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:ReferenceP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:identifier_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:identifier_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:IdentifierTypeEnum ;
            owl:onProperty pals:identifier_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:identifier_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:identifier_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:identifier_value ] ;
    skos:definition "A unique, and ideally persistent, identifier for a facility, such as a DOI or ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Ksol a owl:DatatypeProperty ;
    rdfs:label "Ksol" ;
    skos:definition "Normalized solenoid strength." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:VirtualFunctionEnum a owl:Class ;
    rdfs:label "VirtualFunctionEnum" ;
    owl:unionOf ( pals:BeamLine pals:Marker pals:Drift pals:Fork <https://pals-project.readthedocs.io/VirtualFunctionEnum#Control> ) ;
    skos:definition "Broad virtual component functions or roles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values pals:BeamLine,
        pals:Drift,
        pals:Fork,
        pals:Marker,
        <https://pals-project.readthedocs.io/VirtualFunctionEnum#Control> .

pals:affiliation a owl:ObjectProperty ;
    rdfs:label "affiliation" ;
    rdfs:range pals:Affiliation ;
    skos:definition "The affiliation of the author or component, as a ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:beamline_context a owl:ObjectProperty ;
    rdfs:label "beamline_context" ;
    rdfs:range pals:BeamLine ;
    skos:definition "The specific BeamLine this relationship is defined with respect to (relevant when context=beamline_order). Only an edge-property slot for edges that are defined with respect to a specific BeamLine." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:beamline_relation a owl:ObjectProperty ;
    rdfs:label "beamline_relation" ;
    skos:definition "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems.",
        "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:distance_unit a owl:ObjectProperty ;
    rdfs:label "distance_unit" ;
    rdfs:range pals:UnitEnum ;
    skos:definition "Unit of the distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:distance_value a owl:DatatypeProperty ;
    rdfs:label "distance_value" ;
    rdfs:range xsd:float ;
    skos:definition "Distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:functions a owl:ObjectProperty ;
    rdfs:label "functions" ;
    skos:definition "The function of the physical component,  which can be used to identify the component across different source systems.",
        "The function of the supporting facility component,  which can be used to identify the component across different source systems.",
        "The function of the virtual component,  which can be used to identify the component across different source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "The name of the entity. For example, the name of the person or organization." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:tolerance_unit a owl:ObjectProperty ;
    rdfs:label "tolerance_unit" ;
    rdfs:range pals:UnitEnum ;
    skos:definition "Unit of the tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:tolerance_value a owl:DatatypeProperty ;
    rdfs:label "tolerance_value" ;
    rdfs:range xsd:float ;
    skos:definition "Tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

qudt:T-M a owl:Class ;
    rdfs:label "T_M" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "tesla meter" .

xsd:integer a owl:Class ;
    rdfs:label "Integer" ;
    rdfs:subClassOf pals:DataTypeEnum ;
    skos:definition "integer data type" .

inst:IPMK101 a pals:BeamPositionMonitor ;
    pals:BodyShiftP <https://example.org/pals-instance/IPMK101/BodyShiftP> ;
    pals:FloorP <https://example.org/pals-instance/IPMK101/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/IPMK101/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/IPMK101/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/IPMK101/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/IPMK101/TwissP> ;
    pals:has_readback_signal inst:IPMK101.STAT,
        inst:IPMK101.XPOS,
        inst:IPMK101.YPOS ;
    pals:native_types "BPM",
        "DRBPM",
        "MONITOR" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "BeamPositionMeasurement" ;
    pals:precedes inst:MBHK101H .

inst:IPMK102 a pals:BeamPositionMonitor ;
    pals:BodyShiftP <https://example.org/pals-instance/IPMK102/BodyShiftP> ;
    pals:FloorP <https://example.org/pals-instance/IPMK102/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/IPMK102/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/IPMK102/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/IPMK102/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/IPMK102/TwissP> ;
    pals:has_readback_signal inst:IPMK102.STAT,
        inst:IPMK102.XPOS,
        inst:IPMK102.YPOS ;
    pals:native_types "BPM",
        "DRBPM",
        "MONITOR" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "BeamPositionMeasurement" ;
    pals:precedes inst:ITVK201 .

inst:MFRM604H a pals:Kicker ;
    pals:FloorP <https://example.org/pals-instance/MFRM604H/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/MFRM604H/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/MFRM604H/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/MFRM604H/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/MFRM604H/TwissP> ;
    pals:has_limit_signal inst:MFRM604H.HMAX,
        inst:MFRM604H.HMIN ;
    pals:has_readback_signal inst:MFRM604H.STAT,
        inst:MFRM604HM ;
    pals:has_setpoint_signal inst:MFRM604H.KICK,
        inst:MFRM604H.S ;
    pals:native_types "Corrector",
        "HDiagKicker",
        "HKICK" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "Steering" ;
    pals:plane "Horizontal" .

inst:MFRM604V a pals:Kicker ;
    pals:FloorP <https://example.org/pals-instance/MFRM604V/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/MFRM604V/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/MFRM604V/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/MFRM604V/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/MFRM604V/TwissP> ;
    pals:has_limit_signal inst:MFRM604V.HMAX,
        inst:MFRM604V.HMIN ;
    pals:has_readback_signal inst:MFRM604V.STAT,
        inst:MFRM604VM ;
    pals:has_setpoint_signal inst:MFRM604V.KICK,
        inst:MFRM604V.S ;
    pals:native_types "Corrector",
        "VDiagKicker",
        "VKICK" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "Steering" ;
    pals:plane "Vertical" .

pals:Component a owl:Class ;
    rdfs:label "Component" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:native_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:native_types ],
        pals:HasMetaP,
        pals:Node ;
    skos:broadMatch pals:Element ;
    skos:definition "A general class for accelerator components, which can be specialized into more specific types like AcceleratorDevice, Magnet, etc." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:DataTypeEnum a owl:Class ;
    rdfs:label "DataTypeEnum" ;
    owl:unionOf ( xsd:string xsd:integer xsd:float xsd:boolean acc:FloatArray ) ;
    skos:definition "Data types for parameter values." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values xsd:boolean,
        xsd:float,
        xsd:integer,
        xsd:string,
        acc:FloatArray .

pals:HasBodyShiftP a owl:Class ;
    rdfs:label "HasBodyShiftP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:BodyShiftParamGroup ;
            owl:onProperty pals:BodyShiftP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:BodyShiftP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:BodyShiftP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasTwissP a owl:Class ;
    rdfs:label "HasTwissP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:TwissParamGroup ;
            owl:onProperty pals:TwissP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:TwissP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:TwissP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:IdentifierTypeEnum a owl:Class ;
    rdfs:label "IdentifierTypeEnum" ;
    owl:unionOf ( <http://purl.org/spar/datacite/doi> <http://purl.org/spar/datacite/purl> <http://purl.org/spar/datacite/ror> <http://purl.org/spar/datacite/local-resource-identifier-scheme> <http://purl.org/spar/datacite/url> <http://purl.org/spar/datacite/ark> ) ;
    skos:definition "Controlled values for identifier types." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <http://purl.org/spar/datacite/ark>,
        <http://purl.org/spar/datacite/doi>,
        <http://purl.org/spar/datacite/local-resource-identifier-scheme>,
        <http://purl.org/spar/datacite/purl>,
        <http://purl.org/spar/datacite/ror>,
        <http://purl.org/spar/datacite/url> .

pals:Marker a owl:Class ;
    rdfs:label "Mark",
        "Marker" ;
    rdfs:subClassOf pals:BookkeepingComponent,
        pals:HasTwissP,
        pals:VirtualFunctionEnum ;
    skos:definition "A virtual component representing an important location on the beamline,  such as a reference point for beam-based alignment, a location of a known aperture restriction,  or a location of a critical diagnostic device.",
        "A virtual component used as a reference point or marker in the beamline structure." ;
    skos:exactMatch pals:Marker ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Multipole a owl:Class ;
    rdfs:label "Multipole" ;
    rdfs:subClassOf pals:HasElectricMultipoleP,
        pals:HasMagneticMultipoleP,
        pals:Magnet ;
    skos:broadMatch pals:Multipole ;
    skos:definition """A general magnet with a higher-order multipole field, such as a sextupole or octupole.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:MultipoleGeometryEnum a owl:Class ;
    rdfs:label "MultipoleGeometryEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/MultipoleGeometryEnum#follows_ref_geometry> <https://pals-project.readthedocs.io/MultipoleGeometryEnum#vertically_pure> <https://pals-project.readthedocs.io/MultipoleGeometryEnum#horizontally_pure> <https://pals-project.readthedocs.io/MultipoleGeometryEnum#chord> <https://pals-project.readthedocs.io/MultipoleGeometryEnum#entrance_coords> <https://pals-project.readthedocs.io/MultipoleGeometryEnum#exit_coords> ) ;
    skos:definition "The geometric configuration of the multipole field.  Sets the geometry used to calculate multipoles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/MultipoleGeometryEnum#chord>,
        <https://pals-project.readthedocs.io/MultipoleGeometryEnum#entrance_coords>,
        <https://pals-project.readthedocs.io/MultipoleGeometryEnum#exit_coords>,
        <https://pals-project.readthedocs.io/MultipoleGeometryEnum#follows_ref_geometry>,
        <https://pals-project.readthedocs.io/MultipoleGeometryEnum#horizontally_pure>,
        <https://pals-project.readthedocs.io/MultipoleGeometryEnum#vertically_pure> .

pals:PhysicalComponent a owl:Class ;
    rdfs:label "PhysicalComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:PhysicalRelationEnum ;
            owl:onProperty pals:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:functions ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:beamline_relation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:beamline_relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:PhysicalFunctionEnum ;
            owl:onProperty pals:functions ],
        pals:Component,
        pals:HasFloorP,
        pals:HasLongitudinalPlacementP ;
    skos:broadMatch pals:Element ;
    skos:definition "A physical item that participates in or supports accelerator operation.  This can be used to capture physical components, such as magnets, cavities, diagnostics, vacuum devices, and racks that are important for understanding the structure and function of the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:RFCavity a owl:Class ;
    rdfs:label "RFCavity" ;
    rdfs:subClassOf pals:Cavity,
        pals:HasRFP ;
    skos:definition "A cavity used for RF acceleration or longitudinal manipulation." ;
    skos:exactMatch pals:RFCavity ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:SignalRoleEnum a owl:Class ;
    rdfs:label "SignalRoleEnum" ;
    owl:unionOf ( sosa:ActuatableProperty sosa:ObservableProperty <https://pals-project.readthedocs.io/SignalRoleEnum#Status> sosa:ActuatableProperty xsd:minInclusive xsd:maxInclusive acc:RangeLimit ) ;
    skos:definition "Roles for control-system signals." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values xsd:maxInclusive,
        xsd:minInclusive,
        sosa:ActuatableProperty,
        sosa:ObservableProperty,
        acc:RangeLimit,
        <https://pals-project.readthedocs.io/SignalRoleEnum#Status> .

pals:length a owl:DatatypeProperty ;
    rdfs:label "length" ;
    rdfs:range xsd:float ;
    skos:definition "Length of the element (arc length for bends)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

quantitykind:MagneticFluxPerLength a owl:Class ;
    rdfs:label "IntegratedMagneticField" ;
    rdfs:subClassOf pals:QuantityKindEnum ;
    skos:definition "Integrated magnetic field." .

xsd:maxInclusive a owl:Class ;
    rdfs:label "MaximumLimit" ;
    rdfs:subClassOf pals:SignalRoleEnum ;
    skos:definition "Maximum allowed signal value." .

xsd:minInclusive a owl:Class ;
    rdfs:label "MinimumLimit" ;
    rdfs:subClassOf pals:SignalRoleEnum ;
    skos:definition "Minimum allowed signal value." .

pals:Bn a owl:DatatypeProperty ;
    rdfs:label "Bn" ;
    skos:broadMatch pals:BnN ;
    skos:definition "Normal component of the magnetic field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Bs a owl:DatatypeProperty ;
    rdfs:label "Bs" ;
    skos:broadMatch pals:BsN ;
    skos:definition "Skew component of the magnetic field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:En a owl:DatatypeProperty ;
    rdfs:label "En" ;
    skos:broadMatch pals:EnN ;
    skos:definition "Normal component of the field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:EnL a owl:DatatypeProperty ;
    rdfs:label "EnL" ;
    skos:broadMatch pals:EnNL ;
    skos:definition "Length-integrated normal component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Es a owl:DatatypeProperty ;
    rdfs:label "Es" ;
    skos:broadMatch pals:EsN ;
    skos:definition "Skew component of the field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:EsL a owl:DatatypeProperty ;
    rdfs:label "EsL" ;
    skos:broadMatch pals:EsNL ;
    skos:definition "Length-integrated skew component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:FacilityFunctionEnum a owl:Class ;
    rdfs:label "FacilityFunctionEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/FacilityFunctionEnum#Support> <https://pals-project.readthedocs.io/FacilityFunctionEnum#Alignment> <https://pals-project.readthedocs.io/FacilityFunctionEnum#PowerSupply> <https://pals-project.readthedocs.io/FacilityFunctionEnum#ControlRack> <https://pals-project.readthedocs.io/FacilityFunctionEnum#Cooling> <https://pals-project.readthedocs.io/FacilityFunctionEnum#Diagnostics> <https://pals-project.readthedocs.io/FacilityFunctionEnum#Detection> ) ;
    skos:definition "Broad structural or support functions." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/FacilityFunctionEnum#Alignment>,
        <https://pals-project.readthedocs.io/FacilityFunctionEnum#ControlRack>,
        <https://pals-project.readthedocs.io/FacilityFunctionEnum#Cooling>,
        <https://pals-project.readthedocs.io/FacilityFunctionEnum#Detection>,
        <https://pals-project.readthedocs.io/FacilityFunctionEnum#Diagnostics>,
        <https://pals-project.readthedocs.io/FacilityFunctionEnum#PowerSupply>,
        <https://pals-project.readthedocs.io/FacilityFunctionEnum#Support> .

pals:Kicker a owl:Class ;
    rdfs:label "Kicker" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:plane ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:plane ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:PlaneEnum ;
            owl:onProperty pals:plane ],
        pals:HasElectricMultipoleP,
        pals:HasMagneticMultipoleP,
        pals:Magnet ;
    skos:altLabel "Corrector",
        "HCorrector",
        "HDiagKicker",
        "VCorrector",
        "VDiagKicker" ;
    skos:broadMatch pals:Kicker ;
    skos:definition """A magnet primarily used to steer the beam.
Can deflect the beam transversely in both planes, or a single plane, depending on the design and parameters of the kicker. 
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Kn a owl:DatatypeProperty ;
    rdfs:label "Kn" ;
    skos:broadMatch pals:KnN ;
    skos:definition "Normalized normal component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Ks a owl:DatatypeProperty ;
    rdfs:label "Ks" ;
    skos:broadMatch pals:KsN ;
    skos:definition "Normalized skew component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:RelationContextEnum a owl:Class ;
    rdfs:label "RelationContextEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/RelationContextEnum#beamline_order> <https://pals-project.readthedocs.io/RelationContextEnum#Euclidean_3D> <https://pals-project.readthedocs.io/RelationContextEnum#Euclidean_2D> <https://pals-project.readthedocs.io/RelationContextEnum#floorplan> <https://pals-project.readthedocs.io/RelationContextEnum#containment> <https://pals-project.readthedocs.io/RelationContextEnum#installation_mounting> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/RelationContextEnum#Euclidean_2D>,
        <https://pals-project.readthedocs.io/RelationContextEnum#Euclidean_3D>,
        <https://pals-project.readthedocs.io/RelationContextEnum#beamline_order>,
        <https://pals-project.readthedocs.io/RelationContextEnum#containment>,
        <https://pals-project.readthedocs.io/RelationContextEnum#floorplan>,
        <https://pals-project.readthedocs.io/RelationContextEnum#installation_mounting> .

pals:SignalBinding a owl:Class ;
    rdfs:label "SignalBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:PhysicalComponent ;
            owl:onProperty pals:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Signal ;
            owl:onProperty pals:object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:object ],
        pals:Edge ;
    skos:definition "Association between a PhysicalComponent and one of its Signals, e.g. QUAD1 component to QUAD1.STATUS signal." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:SourceSystemEnum a owl:Class ;
    rdfs:label "SourceSystemEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/SourceSystemEnum#EPICS> <https://pals-project.readthedocs.io/SourceSystemEnum#EPICS_ChannelAccess> <https://pals-project.readthedocs.io/SourceSystemEnum#PALS_Ext> <https://pals-project.readthedocs.io/SourceSystemEnum#MYA> <https://pals-project.readthedocs.io/SourceSystemEnum#ElementDatabase> <https://pals-project.readthedocs.io/SourceSystemEnum#ChannelDatabase> <https://pals-project.readthedocs.io/SourceSystemEnum#Simulation> <https://pals-project.readthedocs.io/SourceSystemEnum#Other> ) ;
    skos:definition "Controlled values for facility-local source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/SourceSystemEnum#ChannelDatabase>,
        <https://pals-project.readthedocs.io/SourceSystemEnum#EPICS>,
        <https://pals-project.readthedocs.io/SourceSystemEnum#EPICS_ChannelAccess>,
        <https://pals-project.readthedocs.io/SourceSystemEnum#ElementDatabase>,
        <https://pals-project.readthedocs.io/SourceSystemEnum#MYA>,
        <https://pals-project.readthedocs.io/SourceSystemEnum#Other>,
        <https://pals-project.readthedocs.io/SourceSystemEnum#PALS_Ext>,
        <https://pals-project.readthedocs.io/SourceSystemEnum#Simulation> .

pals:context a owl:ObjectProperty ;
    rdfs:label "context" ;
    rdfs:range pals:RelationContextEnum ;
    skos:definition "The frame of reference / domain in which this relationship is asserted to hold." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "A human-readable description of the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:object a owl:DatatypeProperty ;
    rdfs:label "object" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:subject a owl:DatatypeProperty ;
    rdfs:label "subject" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

inst:MBHK101H a pals:Kicker ;
    pals:FloorP <https://example.org/pals-instance/MBHK101H/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/MBHK101H/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/MBHK101H/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/MBHK101H/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/MBHK101H/TwissP> ;
    pals:has_limit_signal inst:MBHK101H.HMAX,
        inst:MBHK101H.HMIN ;
    pals:has_readback_signal inst:MBHK101H.STAT,
        inst:MBHK101HM ;
    pals:has_setpoint_signal inst:MBHK101H.KICK,
        inst:MBHK101H.S ;
    pals:native_types "Corrector",
        "HCorrector",
        "HKICK" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "Steering" ;
    pals:plane "Horizontal" ;
    pals:precedes inst:MBHK101V .

inst:MBHK101V a pals:Kicker ;
    pals:FloorP <https://example.org/pals-instance/MBHK101V/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/MBHK101V/LongitudinalPlacementP> ;
    pals:MetaP <https://example.org/pals-instance/MBHK101V/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/MBHK101V/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/MBHK101V/TwissP> ;
    pals:has_limit_signal inst:MBHK101V.HMAX,
        inst:MBHK101V.HMIN ;
    pals:has_readback_signal inst:MBHK101V.STAT,
        inst:MBHK101VM ;
    pals:has_setpoint_signal inst:MBHK101V.KICK,
        inst:MBHK101V.S ;
    pals:native_types "Corrector",
        "VCorrector",
        "VKICK" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "Steering" ;
    pals:plane "Vertical" ;
    pals:precedes inst:MFHK101 .

inst:MDSK201 a pals:Bend ;
    pals:BendP <https://example.org/pals-instance/MDSK201/BendP> ;
    pals:FloorP <https://example.org/pals-instance/MDSK201/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/MDSK201/LongitudinalPlacementP> ;
    pals:MagneticMultipoleP <https://example.org/pals-instance/MDSK201/MagneticMultipoleP> ;
    pals:MetaP <https://example.org/pals-instance/MDSK201/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/MDSK201/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/MDSK201/TwissP> ;
    pals:has_limit_signal inst:MDSK201.HMAX,
        inst:MDSK201.HMIN ;
    pals:has_readback_signal inst:MDSK201.STAT,
        inst:MDSK201M ;
    pals:has_setpoint_signal inst:MDSK201.BDL,
        inst:MDSK201.S ;
    pals:native_types "CSBEND",
        "Dipole" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "Steering" ;
    pals:precedes inst:MQWK202 .

inst:MQWK202 a pals:Quadrupole ;
    pals:FloorP <https://example.org/pals-instance/MQWK202/FloorP> ;
    pals:LongitudinalPlacementP <https://example.org/pals-instance/MQWK202/LongitudinalPlacementP> ;
    pals:MagneticMultipoleP <https://example.org/pals-instance/MQWK202/MagneticMultipoleP> ;
    pals:MetaP <https://example.org/pals-instance/MQWK202/MetaP> ;
    pals:ReferenceP <https://example.org/pals-instance/MQWK202/ReferenceP> ;
    pals:TwissP <https://example.org/pals-instance/MQWK202/TwissP> ;
    pals:has_limit_signal inst:MQWK202.HMAX,
        inst:MQWK202.HMIN ;
    pals:has_readback_signal inst:MQWK202.STAT,
        inst:MQWK202M ;
    pals:has_setpoint_signal inst:MQWK202.BDL,
        inst:MQWK202.S ;
    pals:native_types "KQUAD",
        "QW",
        "Quadrupole" ;
    pals:physical_beamline_relation "Inline" ;
    pals:physical_function "Focusing" ;
    pals:precedes inst:IFYK203 .

pals:BeamLine a owl:Class ;
    rdfs:label "BeamLine",
        "BeamLineSection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:repeat ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:multipass ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:periodic ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pals:repeat ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty pals:periodic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:multipass ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pals:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:periodic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty pals:multipass ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:repeat ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:description ],
        pals:VirtualComponent,
        pals:VirtualFunctionEnum ;
    skos:definition "A section of the BeamLine used for organizational or functional grouping of components, such as a linac section, transfer line, or ring sector.",
        "PALS element for an ordered sequence of beamline elements defining a beam path." ;
    skos:exactMatch pals:BeamLine ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:ParamGroup a owl:Class ;
    rdfs:label "ParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:id ] ;
    skos:definition "Abstract base for inlined PALS parameter-group objects, giving each an identifier so it resolves to a stable node/IRI rather than a blank node when exported to RDF." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:MultipoleParameterGroup a owl:Class ;
    rdfs:label "MultipoleParameterGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:Ks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pals:order ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Ks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Kn ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:En ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:tilt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:EnL ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:EnL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:tilt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:EsL ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Bn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:Kn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:Bs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Es ],
