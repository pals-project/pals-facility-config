    pals:name "Thomas Jefferson National Accelerator Facility" .

pals:AdjacentTo a owl:Class ;
    rdfs:label "AdjacentTo" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:distance_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:tolerance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:tolerance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:CoordinateSet ;
            owl:onProperty pals:coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:UnitEnum ;
            owl:onProperty pals:distance_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:tolerance_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:distance_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:distance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:UnitEnum ;
            owl:onProperty pals:tolerance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:tolerance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:tolerance_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:distance_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:distance_value ],
        pals:ComponentRelation ;
    skos:definition """A relationship indicating that the subject component is adjacent to the object component and not overlapping
 in a specified context, such as radiation detector and a magnet.""" ;
    skos:exactMatch RO:0002220,
        pals:AdjacentToRelation ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    pals:rdf_predicate "pals:adjacent_to" .

pals:Author a owl:Class ;
    rdfs:label "Author" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^@]+@[^@]+\\.[^@]+$" ] ) ] ) ] ;
            owl:onProperty pals:email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" ] ) ] ) ] ;
            owl:onProperty pals:orcid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:orcid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Affiliation ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:orcid ] ;
    skos:definition "Contains authorship information for a representation of an accelerator facility and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

