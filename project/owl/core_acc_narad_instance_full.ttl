acc:Contains a owl:Class ;
    rdfs:label "Contains" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:BeamLine ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Contains" ] ) ] ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beamline_context ],
        acc:ComponentRelation ;
    skos:definition "A relationship indicating that the subject component contains the object component in a specified context,  such as within a BeamLineSection or other organizational grouping." ;
    skos:exactMatch BFO:0000051 ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:contains" .

acc:Controls a owl:Class ;
    rdfs:label "Controls" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Controls" ] ) ] ;
            owl:onProperty acc:predicate ],
        acc:ComponentRelation ;
    skos:definition "A relationship indicating that the subject component controls the object component in a specified context,  such as a power supply controlling a magnet." ;
    skos:exactMatch saref:controls ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:controls" .

