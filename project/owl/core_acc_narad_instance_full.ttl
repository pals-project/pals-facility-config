        pals:SignalBinding ;
    skos:exactMatch pals:HasReadbackSignalRelation ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    pals:rdf_predicate "pals:has_readback_signal" .

quantitykind:ElectricCurrent a owl:Class ;
    rdfs:label "ElectricCurrent" ;
    rdfs:subClassOf pals:QuantityKindEnum ;
    skos:definition "Electric current." .

qudt:A a owl:Class ;
    rdfs:label "A" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "ampere" .

pals:UnitEnum a owl:Class ;
    rdfs:label "UnitEnum" ;
    owl:unionOf ( qudt:A qudt:DEG qudt:EV <https://pals-project.readthedocs.io/UnitEnum#eV_per_c> <https://pals-project.readthedocs.io/UnitEnum#eV_per_c2> <https://pals-project.readthedocs.io/UnitEnum#fundamental_charge> <https://pals-project.readthedocs.io/UnitEnum#G_per_cm> qudt:HZ qudt:KiloW qudt:M qudt:MilliM qudt:MREM-PER-H qudt:MegaV-PER-M qudt:PA <https://pals-project.readthedocs.io/UnitEnum#randians_pi2> <https://pals-project.readthedocs.io/UnitEnum#rem_per_h> qudt:SEC qudt:T qudt:T-M qudt:TORR qudt:V qudt:V-PER-M qudt:NUM <https://pals-project.readthedocs.io/UnitEnum#none> ) ;
    skos:definition "Engineering units using ASCII-safe enum names. Values map to QUDT unit IRIs with the LinkML meaning field when an exact QUDT unit is available." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values qudt:A,
        qudt:DEG,
        qudt:EV,
        qudt:HZ,
        qudt:KiloW,
        qudt:M,
        qudt:MREM-PER-H,
        qudt:MegaV-PER-M,
        qudt:MilliM,
        qudt:NUM,
        qudt:PA,
        qudt:SEC,
        qudt:T,
        qudt:T-M,
        qudt:TORR,
        qudt:V,
        qudt:V-PER-M,
        <https://pals-project.readthedocs.io/UnitEnum#G_per_cm>,
        <https://pals-project.readthedocs.io/UnitEnum#eV_per_c>,
        <https://pals-project.readthedocs.io/UnitEnum#eV_per_c2>,
        <https://pals-project.readthedocs.io/UnitEnum#fundamental_charge>,
        <https://pals-project.readthedocs.io/UnitEnum#none>,
        <https://pals-project.readthedocs.io/UnitEnum#randians_pi2>,
        <https://pals-project.readthedocs.io/UnitEnum#rem_per_h> .

sosa:ObservableProperty a owl:Class ;
    rdfs:label "Readback",
        "State" ;
    rdfs:subClassOf pals:QuantityKindEnum,
        pals:SignalRoleEnum ;
    skos:definition "Device state or condition.",
        "Measured or reported value." .

pals:kind a owl:DatatypeProperty ;
    rdfs:label "kind" ;
    rdfs:range xsd:string ;
    skos:definition "The LinkML class name of this instance in uri/curie form, e.g. `pals:Quadrupole` or `pals:BeamProfileMonitor`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Signal a owl:Class ;
    rdfs:label "Signal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:access_protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:canonical_signal_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:SourceSystemEnum ;
            owl:onProperty pals:source_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:access_protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:signal_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:native_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:DataTypeEnum ;
            owl:onProperty pals:native_data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:native_data_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:quantity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:signal_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:native_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:access_protocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:SignalRoleEnum ;
            owl:onProperty pals:signal_role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:native_data_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:CanonicalSignalTypeEnum ;
            owl:onProperty pals:canonical_signal_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:native_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:archive_identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:QuantityKindEnum ;
            owl:onProperty pals:quantity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:source_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:native_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:archive_identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:native_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:canonical_signal_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:archive_identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:source_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:quantity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:UnitEnum ;
            owl:onProperty pals:native_unit ],
        pals:HasMetaP,
        pals:Node ;
    skos:broadMatch sosa:Actuator,
        sosa:Sensor ;
    skos:definition "Semantic meaning of a control-system signal associated with a component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:predicate a owl:DatatypeProperty ;
