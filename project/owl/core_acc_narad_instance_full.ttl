acc:Octupole a owl:Class ;
    rdfs:label "Octupole" ;
    rdfs:subClassOf acc:Multipole ;
    skos:definition """A magnet primarily used to focus or defocus the beam. 8 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:exactMatch ns1:Octupole ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Overlaps a owl:Class ;
    rdfs:label "Overlaps" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Overlaps" ] ) ] ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:CoordinateSet ;
            owl:onProperty acc:coordinates ],
        acc:ComponentRelation ;
    skos:definition "A relationship indicating that the subject component overlaps the object component in a specified context,  such as a magnet and a diagnostic device." ;
    skos:exactMatch RO:0002131 ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:overlaps" .

