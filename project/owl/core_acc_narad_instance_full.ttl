acc:Affiliation a owl:Class ;
    rdfs:label "Affiliation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:Identifier ;
            owl:onProperty acc:identifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:identifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:name ] ;
    skos:definition "Contains affiliation information for an author or component, such as a ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BeamPositionMonitor a owl:Class ;
    rdfs:label "BeamPositionMonitor" ;
    rdfs:subClassOf acc:DiagnosticDevice,
        acc:HasBodyShiftP,
        acc:HasReferenceP,
        acc:HasTwissP ;
    skos:broadMatch ns1:Instrument ;
    skos:definition "A diagnostic device used to measure transverse beam position." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

