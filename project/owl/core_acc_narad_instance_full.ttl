acc:Intersects a owl:Class ;
    rdfs:label "Intersects" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Intersects" ] ) ] ;
            owl:onProperty acc:predicate ],
        acc:ComponentRelation ;
    skos:broadMatch RO:0015011 ;
    skos:definition "A relationship indicating that the subject component intersects the object component in a specified context,  such as a beamline and a diagnostic device." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
