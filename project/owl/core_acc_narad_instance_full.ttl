acc:ACKicker a owl:Class ;
    rdfs:label "ACKicker" ;
    rdfs:subClassOf acc:Kicker ;
    skos:definition "An ACKicker element simulates a time-dependent kicker.  It is like a Kicker element except that the field varies in time.  This element requires a user supplied time-dependent expression." ;
    skos:exactMatch ns1:ACKicker ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:AdjacentTo a owl:Class ;
    rdfs:label "AdjacentTo" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:distance_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:distance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:tolerance_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:CoordinateSet ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:tolerance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:distance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "AdjacentTo" ] ) ] ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:tolerance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:distance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:UnitEnum ;
            owl:onProperty acc:tolerance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:distance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:tolerance_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:tolerance_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:UnitEnum ;
            owl:onProperty acc:distance_unit ],
        acc:ComponentRelation ;
    skos:definition """A relationship indicating that the subject component is adjacent to the object component and not overlapping
 in a specified context, such as radiation detector and a magnet.""" ;
    skos:exactMatch RO:0002220 ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:adjacent_to" .

acc:Author a owl:Class ;
    rdfs:label "Author" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:orcid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" ] ) ] ) ] ;
            owl:onProperty acc:orcid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:orcid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:Affiliation ;
            owl:onProperty acc:affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^@]+@[^@]+\\.[^@]+$" ] ) ] ) ] ;
            owl:onProperty acc:email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:affiliation ] ;
    skos:definition "Contains authorship information for a representation of an accelerator facility and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BeamLineSection a owl:Class ;
    rdfs:label "BeamLineSection" ;
    rdfs:subClassOf acc:BookkeepingComponent,
        acc:HasFloorP ;
    skos:definition "A virtual component used to represent a section of the BeamLine for organizational or functional grouping of components." ;
    skos:exactMatch ns1:BeamLineSection ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BeginningEle a owl:Class ;
    rdfs:label "BeginningEle" ;
    rdfs:subClassOf acc:BookkeepingComponent,
        acc:HasReferenceP,
        acc:HasTwissP ;
    skos:definition "Initial element at the start of a beamline branch. It holds the initial reference and Twiss parameters for the branch. A BeginningEle may be omitted when the branch is reached through a Fork that propagates its reference parameters; otherwise it is expected to be the first element in the branch." ;
    skos:exactMatch ns1:BeginningEle ;
    skos:inScheme <https://w3id.org/accelerator-core> .

