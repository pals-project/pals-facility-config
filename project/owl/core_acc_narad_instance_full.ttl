pals:SupportingFacilityComponent a owl:Class ;
    rdfs:label "SupportingFacilityComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:FacilityFunctionEnum ;
            owl:onProperty pals:functions ],
        pals:HasBodyShiftP,
        pals:HasFloorP,
        pals:HasLongitudinalPlacementP,
        pals:PhysicalComponent ;
    skos:broadMatch pals:StructuralElement ;
    skos:definition "A physical component that supports accelerator operation  without a specific beam-pipe placement,  such as a power supply, control rack, or radiation detector. These can include Girders, Racks, Power Supplies,  and other physical infrastructure components that are important for understanding  the structure and function of the accelerator system but are not inline with the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

<https://pals-project.readthedocs.io/UnitEnum#G_per_cm> a owl:Class ;
    rdfs:label "G_per_cm" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "gauss per centimeter" .

<https://pals-project.readthedocs.io/UnitEnum#eV_per_c> a owl:Class ;
    rdfs:label "eV_per_c" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "momentum in electron volts per speed of light" .

<https://pals-project.readthedocs.io/UnitEnum#eV_per_c2> a owl:Class ;
    rdfs:label "eV_per_c2" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "mass in electron volts per speed of light squared" .

<https://pals-project.readthedocs.io/UnitEnum#fundamental_charge> a owl:Class ;
    rdfs:label "fundamental_charge" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "fundamental charge" .

<https://pals-project.readthedocs.io/UnitEnum#none> a owl:Class ;
    rdfs:label "none" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "no unit or not applicable" .

<https://pals-project.readthedocs.io/UnitEnum#randians_pi2> a owl:Class ;
    rdfs:label "randians_pi2" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "radians divided by 2 pi - angles and phases" .

<https://pals-project.readthedocs.io/UnitEnum#rem_per_h> a owl:Class ;
    rdfs:label "rem_per_h" ;
    rdfs:subClassOf pals:UnitEnum ;
    skos:definition "rem per hour. Kept as a local accelerator unit value because QUDT publishes rem and rem-per-second but no exact rem-per-hour unit in the checked vocabulary." .

<https://pals-project.readthedocs.io/VirtualFunctionEnum#Control> a owl:Class ;
    rdfs:label "Control" ;
    rdfs:subClassOf pals:VirtualFunctionEnum ;
    skos:definition "A virtual component representing a control system function or role that is important for understanding the overall accelerator system  but doesn't have a direct relationship to the beamline structure,  such as the EPICS control system that manages device process variables across the accelerator." .

<https://pals-project.readthedocs.io/VirtualRelationEnum#AssociatedWithBeamLine> a owl:Class ;
    rdfs:label "AssociatedWithBeamLine" ;
    rdfs:subClassOf pals:VirtualRelationEnum ;
    skos:definition "Not inline with the beamline but still operationally associated with it.  Used for virtual components that are important for understanding the BeamLine structure and function but don't have a direct physical relationship to the beam path,  such as BeamLineSections or Markers that are not inline with the beam." .

<https://pals-project.readthedocs.io/VirtualRelationEnum#Inline> a owl:Class ;
    rdfs:label "Inline" ;
    rdfs:subClassOf pals:VirtualRelationEnum ;
    skos:definition "Beam passes through the virtual component. Used for virtual components like Markers that represent important locations on the beamline but don't have a physical instantiation." .

<https://pals-project.readthedocs.io/VirtualRelationEnum#NotAssociatedWithBeamLine> a owl:Class ;
    rdfs:label "NotAssociatedWithBeamLine" ;
    rdfs:subClassOf pals:VirtualRelationEnum ;
    skos:definition "Not inline with the BeamLine and not operationally associated with it.  Used for virtual components that are more abstract and don't have a specific relationship  to the BeamLine, such as a virtual component representing a control system function  or role that is important for understanding the overall accelerator system but doesn't have a direct relationship to the BeamLine structure." .

<https://pals-project.readthedocs.io/ZeroPhaseEnum#ABOVE_TRANSITION> a owl:Class ;
    rdfs:label "ABOVE_TRANSITION" ;
    rdfs:subClassOf pals:ZeroPhaseEnum ;
    skos:definition "Zero phase is at the stable zero crossing for particles above transition.." .

<https://pals-project.readthedocs.io/ZeroPhaseEnum#ACCELERATING> a owl:Class ;
    rdfs:label "ACCELERATING" ;
    rdfs:subClassOf pals:ZeroPhaseEnum ;
    skos:definition "Default. The zero phase is the maximum accelerating phase, where the beam gains energy." .

<https://pals-project.readthedocs.io/ZeroPhaseEnum#BELOW_TRANSITION> a owl:Class ;
    rdfs:label "BELOW_TRANSITION" ;
    rdfs:subClassOf pals:ZeroPhaseEnum ;
    skos:definition "Zero phase is at the stable zero crossing for particles below transition." .

pals:additional_metadata a owl:ObjectProperty ;
    rdfs:label "additional_metadata" ;
    skos:definition "Additional metadata or annotations for the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:authors a owl:ObjectProperty ;
    rdfs:label "authors" ;
    skos:definition "Contains the authorship information for this representation of an accelerator facility and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:beamlines a owl:ObjectProperty ;
    rdfs:label "beamlines" ;
    skos:definition "A list of beamlines in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:component_relations a owl:ObjectProperty ;
    rdfs:label "component_relations" ;
    skos:definition "A list of component relations in the accelerator system (Component <-> Component relationships)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:components a owl:ObjectProperty ;
    rdfs:label "components" ;
    skos:definition "A list of physical components in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:elec_components a owl:ObjectProperty ;
    rdfs:label "elec_components" ;
    skos:definition "Electric multipole components, one per order N." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:mag_components a owl:ObjectProperty ;
    rdfs:label "mag_components" ;
    skos:definition "Magnetic multipole components, one per order N." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:native_types a owl:DatatypeProperty ;
    rdfs:label "native_types" ;
    skos:definition "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:notes a owl:DatatypeProperty ;
    rdfs:label "notes" ;
    skos:definition "Additional notes or comments about the representation of a particle accelerator and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:signal_bindings a owl:ObjectProperty ;
    rdfs:label "signal_bindings" ;
    skos:definition "A list of signal bindings in the accelerator system (Component <-> Signal relationships)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:signals a owl:ObjectProperty ;
    rdfs:label "signals" ;
    skos:definition "A list of signals in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

inst:IPMK101.STAT a pals:Signal ;
