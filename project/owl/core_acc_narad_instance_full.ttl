    skos:definition "A relationship indicating that the subject component is part of the object component in a specified context,  such as a magnet being part of a BeamLineSection." ;
    skos:exactMatch BFO:0000050 ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:is_part_of" .

