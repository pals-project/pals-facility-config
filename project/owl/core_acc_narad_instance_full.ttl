        <https://example.org/accelerator-core/SourceSystemEnum#EPICS_ChannelAccess>,
        <https://example.org/accelerator-core/SourceSystemEnum#ElementDatabase>,
        <https://example.org/accelerator-core/SourceSystemEnum#MYA>,
        <https://example.org/accelerator-core/SourceSystemEnum#Other>,
        <https://example.org/accelerator-core/SourceSystemEnum#PALS_Ext>,
        <https://example.org/accelerator-core/SourceSystemEnum#Simulation> .

acc:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
