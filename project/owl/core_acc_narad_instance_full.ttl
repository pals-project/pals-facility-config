<https://example.org/accelerator-core/VirtualFunctionEnum#BeamLineSection> a owl:Class ;
    rdfs:label "BeamLineSection" ;
    rdfs:subClassOf acc:VirtualFunctionEnum ;
    skos:definition "A section of the BeamLine used for organizational or functional grouping of components, such as a linac section, transfer line, or ring sector." ;
    skos:exactMatch ns1:BeamLine .

<https://example.org/accelerator-core/VirtualFunctionEnum#Control> a owl:Class ;
    rdfs:label "Control" ;
    rdfs:subClassOf acc:VirtualFunctionEnum ;
    skos:definition "A virtual component representing a control system function or role that is important for understanding the overall accelerator system  but doesn't have a direct relationship to the beamline structure,  such as the EPICS control system that manages device process variables across the accelerator." .

<https://example.org/accelerator-core/VirtualFunctionEnum#DriftSpace> a owl:Class ;
    rdfs:label "DriftSpace" ;
    rdfs:subClassOf acc:VirtualFunctionEnum ;
    skos:definition "A field-free longitudinal interval separating beamline components." ;
    skos:exactMatch ns1:Drift .

<https://example.org/accelerator-core/VirtualFunctionEnum#Fork> a owl:Class ;
    rdfs:label "Fork" ;
    rdfs:subClassOf acc:VirtualFunctionEnum ;
    skos:definition "A virtual component representing a branching point in the beamline,  such as a beamline fork or switchyard." ;
    skos:exactMatch ns1:Fork .

<https://example.org/accelerator-core/VirtualFunctionEnum#Mark> a owl:Class ;
    rdfs:label "Mark" ;
    rdfs:subClassOf acc:VirtualFunctionEnum ;
    skos:definition "A virtual component representing an important location on the beamline,  such as a reference point for beam-based alignment, a location of a known aperture restriction,  or a location of a critical diagnostic device." ;
    skos:exactMatch ns1:Marker .

<https://example.org/accelerator-core/VirtualRelationEnum#AssociatedWithBeamLine> a owl:Class ;
    rdfs:label "AssociatedWithBeamLine" ;
    rdfs:subClassOf acc:VirtualRelationEnum ;
    skos:definition "Not inline with the beamline but still operationally associated with it.  Used for virtual components that are important for understanding the BeamLine structure and function but don't have a direct physical relationship to the beam path,  such as BeamLineSections or Markers that are not inline with the beam." .

<https://example.org/accelerator-core/VirtualRelationEnum#Inline> a owl:Class ;
    rdfs:label "Inline" ;
    rdfs:subClassOf acc:VirtualRelationEnum ;
    skos:definition "Beam passes through the virtual component. Used for virtual components like Markers that represent important locations on the beamline but don't have a physical instantiation." .

<https://example.org/accelerator-core/VirtualRelationEnum#NotAssociatedWithBeamLine> a owl:Class ;
    rdfs:label "NotAssociatedWithBeamLine" ;
    rdfs:subClassOf acc:VirtualRelationEnum ;
    skos:definition "Not inline with the BeamLine and not operationally associated with it.  Used for virtual components that are more abstract and don't have a specific relationship  to the BeamLine, such as a virtual component representing a control system function  or role that is important for understanding the overall accelerator system but doesn't have a direct relationship to the BeamLine structure." .

<https://example.org/accelerator-core/ZeroPhaseEnum#ABOVE_TRANSITION> a owl:Class ;
    rdfs:label "ABOVE_TRANSITION" ;
    rdfs:subClassOf acc:ZeroPhaseEnum ;
    skos:definition "Zero phase is at the stable zero crossing for particles above transition.." .

<https://example.org/accelerator-core/ZeroPhaseEnum#ACCELERATING> a owl:Class ;
    rdfs:label "ACCELERATING" ;
    rdfs:subClassOf acc:ZeroPhaseEnum ;
    skos:definition "Default. The zero phase is the maximum accelerating phase, where the beam gains energy." .

<https://example.org/accelerator-core/ZeroPhaseEnum#BELOW_TRANSITION> a owl:Class ;
    rdfs:label "BELOW_TRANSITION" ;
    rdfs:subClassOf acc:ZeroPhaseEnum ;
    skos:definition "Zero phase is at the stable zero crossing for particles below transition." .

acc:additional_metadata a owl:ObjectProperty ;
    rdfs:label "additional_metadata" ;
    skos:definition "Additional metadata or annotations for the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:authors a owl:ObjectProperty ;
    rdfs:label "authors" ;
    skos:definition "Contains the authorship information for this representation of an accelerator facility and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:beamlines a owl:ObjectProperty ;
    rdfs:label "beamlines" ;
    skos:definition "A list of beamlines in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:component_relations a owl:ObjectProperty ;
    rdfs:label "component_relations" ;
    skos:definition "A list of component relations in the accelerator system (Component <-> Component relationships)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:components a owl:ObjectProperty ;
    rdfs:label "components" ;
    skos:definition "A list of physical components in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:elec_components a owl:ObjectProperty ;
    rdfs:label "elec_components" ;
    skos:definition "Electric multipole components, one per order N." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:facility_functions a owl:ObjectProperty ;
    rdfs:label "facility_functions" ;
    skos:closeMatch ns1:supporting_facility_function ;
    skos:definition "The function of the supporting facility component,  which can be used to identify the component across different source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:mag_components a owl:ObjectProperty ;
    rdfs:label "mag_components" ;
    skos:definition "Magnetic multipole components, one per order N." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:native_types a owl:DatatypeProperty ;
    rdfs:label "native_types" ;
    skos:definition "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:notes a owl:DatatypeProperty ;
    rdfs:label "notes" ;
    skos:definition "Additional notes or comments about the representation of a particle accelerator and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:signal_bindings a owl:ObjectProperty ;
    rdfs:label "signal_bindings" ;
    skos:definition "A list of signal bindings in the accelerator system (Component <-> Signal relationships)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:signals a owl:ObjectProperty ;
    rdfs:label "signals" ;
    skos:definition "A list of signals in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

<https://uitf/jefferson-lab> a acc:Affiliation ;
    acc:identifiers [ a acc:Identifier ;
            acc:identifier_type "ROR" ;
            acc:identifier_value "https://ror.org/01gq9xj92" ],
        [ a acc:Identifier ;
            acc:identifier_type "ROR" ;
            acc:identifier_value "https://ror.org/01gq9xj92" ] ;
    acc:name "Thomas Jefferson National Accelerator Facility" .

acc:Aperture a owl:Class ;
    rdfs:label "Aperture" ;
    rdfs:subClassOf acc:DiagnosticDevice,
        acc:HasReferenceP,
        acc:HasTwissP ;
    skos:broadMatch ns1:Instrument ;
    skos:definition "A diagnostic or limiting aperture element used to constrain or characterize beam passage." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Bend a owl:Class ;
    rdfs:label "Bend" ;
    rdfs:subClassOf acc:HasBendP,
        acc:Multipole ;
    skos:altLabel "Dipole" ;
    skos:definition "Dipole magnet used to bend the beam. 2 poles. The major difference between this element and other physical elements is that with a Bend  the curvilinear coordinate system is an arc with finite curvature  and for the other elements the curvilinear coordinate system is straight." ;
    skos:exactMatch ns1:Bend ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BendP a owl:ObjectProperty ;
    rdfs:label "BendP" ;
    skos:definition "A mixin for bend parameters that are aligned with PALS BendP (Bend Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BodyShiftP a owl:ObjectProperty ;
    rdfs:label "BodyShiftP" ;
    skos:definition "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BodyShiftParamGroup a owl:Class ;
    rdfs:label "BodyShiftParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:y_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:x_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:y_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:z_offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:x_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:z_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:x_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:z_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:y_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:y_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:x_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:x_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:z_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:y_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:y_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:z_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:z_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:x_rot ],
        acc:ParamGroup ;
    skos:broadMatch ns1:BodyShiftP ;
    skos:definition "Mixin class for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:CavityTypeEnum a owl:Class ;
    rdfs:label "CavityTypeEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/CavityTypeEnum#STANDING_WAVE> <https://example.org/accelerator-core/CavityTypeEnum#TRAVELING_WAVE> ) ;
    skos:definition "The type of cavity, which determines the field configuration and mode structure." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/CavityTypeEnum#STANDING_WAVE>,
        <https://example.org/accelerator-core/CavityTypeEnum#TRAVELING_WAVE> .

acc:E_tot_ref a owl:DatatypeProperty ;
    rdfs:label "E_tot_ref" ;
    skos:altLabel "ETotal" ;
    skos:closeMatch ns1:E_tot_ref ;
    skos:definition "[eV] Reference total energy" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ElectricMultipoleP a owl:ObjectProperty ;
    rdfs:label "ElectricMultipoleP" ;
    skos:definition "A mixin for electric multipole parameters that are aligned with PALS ElectricMultipoleP (Electric Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:FloorP a owl:ObjectProperty ;
    rdfs:label "FloorP" ;
    skos:definition "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasConnectingBranch a owl:Class ;
    rdfs:label "HasConnectingBranch" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:BeamLine ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "HasConnectingBranch" ] ) ] ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:beamline_context ],
        acc:ComponentRelation ;
    skos:definition "A relationship indicating that the subject component has a connecting branch to the object component in a specified context,  such as a beamline section having a fork as a connecting branch." ;
    skos:exactMatch RO:0002253 ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:has_connecting_branch" .

acc:HasElectricMultipoleP a owl:Class ;
    rdfs:label "HasElectricMultipoleP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:ElectricMultipoleParamGroup ;
            owl:onProperty acc:ElectricMultipoleP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:ElectricMultipoleP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:ElectricMultipoleP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasLongitudinalPlacementP a owl:Class ;
    rdfs:label "HasLongitudinalPlacementP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:LongitudinalPlacementParamGroup ;
            owl:onProperty acc:LongitudinalPlacementP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:LongitudinalPlacementP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:LongitudinalPlacementP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasMagneticMultipoleP a owl:Class ;
    rdfs:label "HasMagneticMultipoleP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:MagneticMultipoleP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:MagneticMultipoleP ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:MagneticMultipoleParamGroup ;
            owl:onProperty acc:MagneticMultipoleP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:L_active a owl:DatatypeProperty ;
    rdfs:label "L_active" ;
    skos:closeMatch ns1:L_active ;
    skos:definition "Active acceleration length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:L_chord a owl:DatatypeProperty ;
    rdfs:label "L_chord" ;
    skos:closeMatch ns1:L_chord ;
    skos:definition "Chord length of the bend." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:L_rectangle a owl:DatatypeProperty ;
    rdfs:label "L_rectangle" ;
    skos:closeMatch ns1:L_rectangle ;
    skos:definition "Rectangular length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:L_sagitta a owl:DatatypeProperty ;
    rdfs:label "L_sagitta" ;
    skos:closeMatch ns1:L_sagitta ;
    skos:definition "Output parameter. Sagitta length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:LongitudinalPlacementP a owl:ObjectProperty ;
    rdfs:label "LongitudinalPlacementP" ;
    skos:definition "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:MagneticMultipoleP a owl:ObjectProperty ;
    rdfs:label "MagneticMultipoleP" ;
    skos:definition "A mixin for magnetic multipole parameters that are aligned with PALS MagneticMultipoleP (Magnetic Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:MagneticMultipoleParamGroup a owl:Class ;
    rdfs:label "MagneticMultipoleParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:mag_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:MultipoleParameterGroup ;
            owl:onProperty acc:mag_components ],
        acc:ParamGroup ;
    skos:broadMatch ns1:MagneticMultipoleP ;
    skos:definition """Mixin for magnetic multipole parameters,  which can be used to describe the magnetic field components of an accelerator element. This mixin is aligned with PALS MagneticMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS). Example with three multipole components (N=0,1,2): ```yaml mag_components: - order: 7
  tilt: 0.7
- order: 3
  Bn: 27.3
- order: 2
  BnL: 3.47e1
- order: 1
  Kn: 0.85     # normalized form, e.g. a quadrupole's k1-like strength
```""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Marker a owl:Class ;
    rdfs:label "Marker" ;
    rdfs:subClassOf acc:BookkeepingComponent,
        acc:HasTwissP ;
    skos:definition "A virtual component used as a reference point or marker in the beamline structure." ;
    skos:exactMatch ns1:Marker ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:MetaP a owl:ObjectProperty ;
    rdfs:label "MetaP" ;
    skos:definition "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:PALSAccelerator a owl:Class ;
    rdfs:label "PALSAccelerator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:Author ;
            owl:onProperty acc:authors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:facility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:affiliation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:Facility ;
            owl:onProperty acc:facility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:facility ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" ] ) ] ) ] ;
            owl:onProperty acc:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:notes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:authors ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:Affiliation ;
            owl:onProperty acc:affiliation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:version ] ;
    skos:definition "Root container for accelerator core components, semantic signals, and local bindings." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:PlaneEnum a owl:Class ;
    rdfs:label "PlaneEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/PlaneEnum#Horizontal> <https://example.org/accelerator-core/PlaneEnum#Vertical> ) ;
    skos:definition "Controlled values for transverse plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/PlaneEnum#Horizontal>,
        <https://example.org/accelerator-core/PlaneEnum#Vertical> .

acc:Quadrupole a owl:Class ;
    rdfs:label "Quadrupole" ;
    rdfs:subClassOf acc:Multipole ;
    skos:definition """A magnet primarily used to focus or defocus the beam. 4 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:exactMatch ns1:Quadrupole ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:RFP a owl:ObjectProperty ;
    rdfs:label "RFP" ;
    skos:definition "A mixin for RF parameters that are aligned with PALS RFP (RF Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:RFParamGroup a owl:Class ;
    rdfs:label "RFParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:ZeroPhaseEnum ;
            owl:onProperty acc:zero_phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:frequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:voltage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:cavity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty acc:harmon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:L_active ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:L_active ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:num_cells ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:zero_phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty acc:num_cells ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:num_cells ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:dE_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:CavityTypeEnum ;
            owl:onProperty acc:cavity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:multipass_phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:voltage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:dE_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:cavity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:zero_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:frequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:harmon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:harmon ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:L_active ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:multipass_phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:dE_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:voltage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:multipass_phase ],
        acc:ParamGroup ;
    skos:broadMatch ns1:RFP ;
    skos:definition "Mixin for RF parameters, which can be used to describe the RF properties of an accelerator element. This mixin is aligned with PALS RFP for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ReferenceP a owl:ObjectProperty ;
    rdfs:label "ReferenceP" ;
    skos:definition "A mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Solenoid a owl:Class ;
    rdfs:label "Solenoid" ;
    rdfs:subClassOf acc:HasSolenoidP,
        acc:Magnet ;
    skos:definition """A magnet with a primarily longitudinal magnetic field used for focusing.
A solenoid is an element whose magnetic field is dominated by a field whose direction is aligned with the magnetic axis. """ ;
    skos:exactMatch ns1:Solenoid ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:SolenoidP a owl:ObjectProperty ;
    rdfs:label "SolenoidP" ;
    skos:definition "A mixin for solenoid-specific parameters that are aligned with PALS SolenoidP (Solenoid Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:SolenoidParamGroup a owl:Class ;
    rdfs:label "SolenoidParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:Bsol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:Bsol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:Ksol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:Ksol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:Bsol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:Ksol ],
        acc:ParamGroup ;
    skos:definition "Mixin for solenoid-specific parameters." ;
    skos:exactMatch ns1:SolenoidP ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:TwissP a owl:ObjectProperty ;
    rdfs:label "TwissP" ;
    skos:definition "A mixin for Twiss parameters that are aligned with PALS TwissP (Twiss Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:access_protocol a owl:DatatypeProperty ;
    rdfs:label "access_protocol" ;
    skos:definition "The protocol used to access the signal in the source system,  such as EPICS Channel Access, PALS-Ext, MYA, or a simulation service." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:alpha_a a owl:DatatypeProperty ;
    rdfs:label "alpha_a" ;
    skos:altLabel "alpha_x",
        "alphax" ;
    skos:closeMatch ns1:alpha_a ;
    skos:definition "Twiss alpha parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:alpha_b a owl:DatatypeProperty ;
    rdfs:label "alpha_b" ;
    skos:altLabel "alpha_y",
        "alphay" ;
    skos:closeMatch ns1:alpha_b ;
    skos:definition "Twiss alpha parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:angle_ref a owl:DatatypeProperty ;
    rdfs:label "angle_ref" ;
    skos:closeMatch ns1:angle_ref ;
    skos:definition "Reference bend angle." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:archive_identifier a owl:DatatypeProperty ;
    rdfs:label "archive_identifier" ;
    skos:definition "The identifier used to reference the signal in an archival system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:bend_field_actual a owl:DatatypeProperty ;
    rdfs:label "bend_field_actual" ;
    skos:closeMatch ns1:bend_field_actual ;
    skos:definition "Actual bend field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:bend_field_ref a owl:DatatypeProperty ;
    rdfs:label "bend_field_ref" ;
    skos:closeMatch ns1:bend_field_ref ;
    skos:definition "Reference bend field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:beta_a a owl:DatatypeProperty ;
    rdfs:label "beta_a" ;
    skos:altLabel "beta_x",
        "betax" ;
    skos:closeMatch ns1:beta_a ;
    skos:definition "Twiss beta parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:beta_b a owl:DatatypeProperty ;
    rdfs:label "beta_b" ;
    skos:altLabel "beta_y",
        "betay" ;
    skos:closeMatch ns1:beta_b ;
    skos:definition "Twiss beta parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

