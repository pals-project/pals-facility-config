    acc:native_types "SOLE",
        "Solenoid" ;
    acc:precedes <https://uitf/IPMK102> .

<https://uitf/S_IS_20CM> a acc:Marker ;
    acc:FloorP <https://uitf/S_IS_20CM/FloorP> ;
    acc:MetaP <https://uitf/S_IS_20CM/MetaP> ;
    acc:TwissP <https://uitf/S_IS_20CM/TwissP> ;
    acc:beamline_relation "Inline" ;
    acc:functions "Mark" ;
    acc:native_types "Mark",
        "Marker" ;
    acc:precedes <https://uitf/IPMK101> .

acc:BookkeepingComponent a owl:Class ;
    rdfs:label "BookkeepingComponent" ;
    rdfs:subClassOf acc:HasBodyShiftP,
        acc:VirtualComponent ;
    skos:broadMatch ns1:BookkeepingElement ;
    skos:definition "A virtual component that represents a bookkeeping or organizational role in the accelerator system,  such as a BeamLineSection, Marker or a Fork. These can include BeamLineSections, Markers, Forks, and other virtual components that are important for understanding  the structure and function of the accelerator system but are not physical devices." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:CoordinateSet a owl:Class ;
    rdfs:label "CoordinateSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:x_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:x_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:coordinate_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:phi_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:z_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:z_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:z_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:phi_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:CoordinateSystemEnum ;
            owl:onProperty acc:coordinate_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:theta_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:theta_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:r_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:phi_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:y_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:r_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:r_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:coordinate_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:y_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:x_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:theta_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:y_coord ] ;
    skos:definition "A set of coordinates that define the spatial relationship between two components. This can include Cartesian coordinates, cylindrical coordinates, or other coordinate systems as needed. Useful for defining the spatial relationship where the relationship is not strictly linear or where the components are not aligned along a single axis." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:DirectionEnum a owl:Class ;
    rdfs:label "DirectionEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/DirectionEnum#upstream> <https://example.org/accelerator-core/DirectionEnum#downstream> <https://example.org/accelerator-core/DirectionEnum#positive> <https://example.org/accelerator-core/DirectionEnum#negative> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/DirectionEnum#downstream>,
        <https://example.org/accelerator-core/DirectionEnum#negative>,
        <https://example.org/accelerator-core/DirectionEnum#positive>,
        <https://example.org/accelerator-core/DirectionEnum#upstream> .

acc:Magnet a owl:Class ;
    rdfs:label "Magnet" ;
    rdfs:subClassOf acc:HasBodyShiftP,
        acc:HasReferenceP,
        acc:HasTwissP,
        acc:PhysicalComponent ;
    skos:broadMatch ns1:Element ;
    skos:definition "An accelerator device that produces a magnetic field for beam control." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:PhysicalRelationEnum a owl:Class ;
    rdfs:label "PhysicalRelationEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/PhysicalRelationEnum#Inline> <https://example.org/accelerator-core/PhysicalRelationEnum#AttachedToPipe> <https://example.org/accelerator-core/PhysicalRelationEnum#NearBeamLine> <https://example.org/accelerator-core/PhysicalRelationEnum#SupportingFacility> ) ;
    skos:definition "Controlled values for physical relation to the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/PhysicalRelationEnum#AttachedToPipe>,
        <https://example.org/accelerator-core/PhysicalRelationEnum#Inline>,
        <https://example.org/accelerator-core/PhysicalRelationEnum#NearBeamLine>,
        <https://example.org/accelerator-core/PhysicalRelationEnum#SupportingFacility> .

acc:ReferenceFrameEnum a owl:Class ;
    rdfs:label "ReferenceFrameEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/ReferenceFrameEnum#beam_direction> <https://example.org/accelerator-core/ReferenceFrameEnum#facility_coordinates> <https://example.org/accelerator-core/ReferenceFrameEnum#local_component_frame> <https://example.org/accelerator-core/ReferenceFrameEnum#tunnel_stationing> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/ReferenceFrameEnum#beam_direction>,
        <https://example.org/accelerator-core/ReferenceFrameEnum#facility_coordinates>,
        <https://example.org/accelerator-core/ReferenceFrameEnum#local_component_frame>,
        <https://example.org/accelerator-core/ReferenceFrameEnum#tunnel_stationing> .

acc:ReferenceGeometryEnum a owl:Class ;
    rdfs:label "ReferenceGeometryEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/ReferenceGeometryEnum#arc> <https://example.org/accelerator-core/ReferenceGeometryEnum#chord> <https://example.org/accelerator-core/ReferenceGeometryEnum#entrance_coords> <https://example.org/accelerator-core/ReferenceGeometryEnum#exit_coords> ) ;
    skos:definition "The reference geometry used to calculate multipoles.  Sets the geometry used to calculate multipoles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/ReferenceGeometryEnum#arc>,
        <https://example.org/accelerator-core/ReferenceGeometryEnum#chord>,
        <https://example.org/accelerator-core/ReferenceGeometryEnum#entrance_coords>,
        <https://example.org/accelerator-core/ReferenceGeometryEnum#exit_coords> .

acc:VirtualComponent a owl:Class ;
    rdfs:label "VirtualComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:VirtualFunctionEnum ;
            owl:onProperty acc:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:VirtualRelationEnum ;
            owl:onProperty acc:beamline_relation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:beamline_relation ],
        acc:Component,
        acc:HasFloorP ;
    skos:broadMatch ns1:BookkeepingElement,
        ns1:Element ;
    skos:definition "A virtual or logical component that represents a concept, function, or role in the accelerator  beamline operation but does not have a physical instantiation.  This can be used to capture abstract components, such as Markers, BeamLineSections, and FacilitySpaces that are important for understanding the structure and function of the accelerator system but are not physical devices." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:multipole_geometry a owl:ObjectProperty ;
    rdfs:label "multipole_geometry" ;
    skos:closeMatch ns1:multipole_geometry ;
    skos:definition "Multipole geometry type. Must be `follows_ref_geometry`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ref_geometry a owl:ObjectProperty ;
    rdfs:label "ref_geometry" ;
    skos:closeMatch ns1:ref_geometry ;
    skos:definition "Reference geometry type. Must be `arc`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

<https://uitf/RF_LASER> a acc:SuperConductingRFCavity ;
    acc:FloorP <https://uitf/RF_LASER/FloorP> ;
    acc:LongitudinalPlacementP <https://uitf/RF_LASER/LongitudinalPlacementP> ;
    acc:RFP <https://uitf/RF_LASER/RFP> ;
    acc:ReferenceP <https://uitf/RF_LASER/ReferenceP> ;
    acc:TwissP <https://uitf/RF_LASER/TwissP> ;
    acc:beamline_relation "Inline" ;
    acc:functions "BeamAcceleration",
        "Focusing" ;
    acc:native_types "RFCA",
        "RFCavity",
        "WarmCavity" ;
    acc:precedes <https://uitf/S_IS_20CM> ;
    ns1:has_readback_signal <https://uitf/RK11.GMES>,
        <https://uitf/RK11.STAT> ;
    ns1:has_setpoint_signal <https://uitf/RK11.GET> .

acc:BeamProfileMonitor a owl:Class ;
    rdfs:label "BeamProfileMonitor" ;
    rdfs:subClassOf acc:DiagnosticDevice,
        acc:HasBodyShiftP,
        acc:HasReferenceP,
        acc:HasTwissP ;
    skos:altLabel "profile monitor",
        "viewer" ;
    skos:broadMatch ns1:Instrument ;
    skos:definition "A diagnostic device used to measure transverse beam profile." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Bsol a owl:DatatypeProperty ;
    rdfs:label "Bsol" ;
    skos:closeMatch ns1:Bsol ;
    skos:definition "Solenoid field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:DiagnosticDevice a owl:Class ;
    rdfs:label "DiagnosticDevice" ;
    rdfs:subClassOf acc:PhysicalComponent ;
    skos:broadMatch ns1:Instrument ;
    skos:definition "An accelerator device used to measure beam or machine state." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasReferenceP a owl:Class ;
    rdfs:label "HasReferenceP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:ReferenceParamGroup ;
            owl:onProperty acc:ReferenceP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:ReferenceP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:ReferenceP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:identifier_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:identifier_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:IdentifierTypeEnum ;
            owl:onProperty acc:identifier_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:identifier_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:identifier_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:identifier_value ] ;
    skos:definition "A unique, and ideally persistent, identifier for a facility, such as a DOI or ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Ksol a owl:DatatypeProperty ;
    rdfs:label "Ksol" ;
    skos:closeMatch ns1:Ksol ;
    skos:definition "Normalized solenoid strength." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Multipole a owl:Class ;
    rdfs:label "Multipole" ;
    rdfs:subClassOf acc:HasElectricMultipoleP,
        acc:HasMagneticMultipoleP,
        acc:Magnet ;
    skos:broadMatch ns1:Multipole ;
    skos:definition """A general magnet with a higher-order multipole field, such as a sextupole or octupole.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:VirtualFunctionEnum a owl:Class ;
    rdfs:label "VirtualFunctionEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/VirtualFunctionEnum#BeamLineSection> <https://example.org/accelerator-core/VirtualFunctionEnum#Mark> <https://example.org/accelerator-core/VirtualFunctionEnum#DriftSpace> <https://example.org/accelerator-core/VirtualFunctionEnum#Fork> <https://example.org/accelerator-core/VirtualFunctionEnum#Control> ) ;
    skos:definition "Broad virtual component functions or roles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/VirtualFunctionEnum#BeamLineSection>,
        <https://example.org/accelerator-core/VirtualFunctionEnum#Control>,
        <https://example.org/accelerator-core/VirtualFunctionEnum#DriftSpace>,
        <https://example.org/accelerator-core/VirtualFunctionEnum#Fork>,
        <https://example.org/accelerator-core/VirtualFunctionEnum#Mark> .

acc:affiliation a owl:ObjectProperty ;
    rdfs:label "affiliation" ;
    rdfs:range acc:Affiliation ;
    skos:definition "The affiliation of the author or component, as a ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:beamline_relation a owl:ObjectProperty .

acc:distance_unit a owl:ObjectProperty ;
    rdfs:label "distance_unit" ;
    rdfs:range acc:UnitEnum ;
    skos:definition "Unit of the distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:distance_value a owl:DatatypeProperty ;
    rdfs:label "distance_value" ;
    rdfs:range xsd:float ;
    skos:definition "Distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "The name of the entity. For example, the name of the person or organization." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:tolerance_unit a owl:ObjectProperty ;
    rdfs:label "tolerance_unit" ;
    rdfs:range acc:UnitEnum ;
    skos:definition "Unit of the tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:tolerance_value a owl:DatatypeProperty ;
    rdfs:label "tolerance_value" ;
    rdfs:range xsd:float ;
    skos:definition "Tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

<https://uitf/RM11> a acc:SuperConductingRFCavity ;
    acc:FloorP <https://uitf/RM11/FloorP> ;
    acc:LongitudinalPlacementP <https://uitf/RM11/LongitudinalPlacementP> ;
    acc:MetaP <https://uitf/RM11/MetaP> ;
    acc:RFP <https://uitf/RM11/RFP> ;
    acc:ReferenceP <https://uitf/RM11/ReferenceP> ;
    acc:TwissP <https://uitf/RM11/TwissP> ;
    acc:beamline_relation "Inline" ;
    acc:functions "BeamAcceleration" ;
    acc:native_types "CryoCavity",
        "RFCA",
        "RFCavity" ;
    ns1:has_readback_signal <https://uitf/RM11.GMES>,
        <https://uitf/RM11.STAT> ;
    ns1:has_setpoint_signal <https://uitf/RM11.GET> .

acc:Component a owl:Class ;
    rdfs:label "Component" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:native_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:native_types ],
        acc:HasMetaP,
        acc:Node ;
    skos:broadMatch ns1:Element ;
    skos:definition "A general class for accelerator components, which can be specialized into more specific types like AcceleratorDevice, Magnet, etc." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:DataTypeEnum a owl:Class ;
    rdfs:label "DataTypeEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/DataTypeEnum#String> <https://example.org/accelerator-core/DataTypeEnum#Integer> <https://example.org/accelerator-core/DataTypeEnum#Float> <https://example.org/accelerator-core/DataTypeEnum#Boolean> <https://example.org/accelerator-core/DataTypeEnum#FloatArray> ) ;
    skos:definition "Data types for parameter values." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/DataTypeEnum#Boolean>,
        <https://example.org/accelerator-core/DataTypeEnum#Float>,
        <https://example.org/accelerator-core/DataTypeEnum#FloatArray>,
        <https://example.org/accelerator-core/DataTypeEnum#Integer>,
        <https://example.org/accelerator-core/DataTypeEnum#String> .

acc:HasBodyShiftP a owl:Class ;
    rdfs:label "HasBodyShiftP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:BodyShiftParamGroup ;
            owl:onProperty acc:BodyShiftP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:BodyShiftP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:BodyShiftP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasTwissP a owl:Class ;
    rdfs:label "HasTwissP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:TwissP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:TwissP ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:TwissParamGroup ;
            owl:onProperty acc:TwissP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:IdentifierTypeEnum a owl:Class ;
    rdfs:label "IdentifierTypeEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/IdentifierTypeEnum#DOI> <https://example.org/accelerator-core/IdentifierTypeEnum#PURL> <https://example.org/accelerator-core/IdentifierTypeEnum#ROR> <https://example.org/accelerator-core/IdentifierTypeEnum#LOCAL> <https://example.org/accelerator-core/IdentifierTypeEnum#URL> <https://example.org/accelerator-core/IdentifierTypeEnum#ARK> ) ;
    skos:definition "Controlled values for identifier types." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/IdentifierTypeEnum#ARK>,
        <https://example.org/accelerator-core/IdentifierTypeEnum#DOI>,
        <https://example.org/accelerator-core/IdentifierTypeEnum#LOCAL>,
        <https://example.org/accelerator-core/IdentifierTypeEnum#PURL>,
        <https://example.org/accelerator-core/IdentifierTypeEnum#ROR>,
        <https://example.org/accelerator-core/IdentifierTypeEnum#URL> .

acc:Kicker a owl:Class ;
    rdfs:label "Kicker" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:plane ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:PlaneEnum ;
            owl:onProperty acc:plane ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:plane ],
        acc:HasElectricMultipoleP,
        acc:HasMagneticMultipoleP,
        acc:Magnet ;
    skos:altLabel "Corrector",
        "HCorrector",
        "HDiagKicker",
        "VCorrector",
        "VDiagKicker" ;
    skos:broadMatch ns1:Kicker ;
    skos:definition """A magnet primarily used to steer the beam.
Can deflect the beam transversely in both planes, or a single plane, depending on the design and parameters of the kicker. 
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:MultipoleGeometryEnum a owl:Class ;
    rdfs:label "MultipoleGeometryEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/MultipoleGeometryEnum#follows_ref_geometry> <https://example.org/accelerator-core/MultipoleGeometryEnum#vertically_pure> <https://example.org/accelerator-core/MultipoleGeometryEnum#horizontally_pure> <https://example.org/accelerator-core/MultipoleGeometryEnum#chord> <https://example.org/accelerator-core/MultipoleGeometryEnum#entrance_coords> <https://example.org/accelerator-core/MultipoleGeometryEnum#exit_coords> ) ;
    skos:definition "The geometric configuration of the multipole field.  Sets the geometry used to calculate multipoles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/MultipoleGeometryEnum#chord>,
        <https://example.org/accelerator-core/MultipoleGeometryEnum#entrance_coords>,
        <https://example.org/accelerator-core/MultipoleGeometryEnum#exit_coords>,
        <https://example.org/accelerator-core/MultipoleGeometryEnum#follows_ref_geometry>,
        <https://example.org/accelerator-core/MultipoleGeometryEnum#horizontally_pure>,
        <https://example.org/accelerator-core/MultipoleGeometryEnum#vertically_pure> .

acc:PhysicalComponent a owl:Class ;
    rdfs:label "PhysicalComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:PhysicalRelationEnum ;
            owl:onProperty acc:beamline_relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:PhysicalFunctionEnum ;
            owl:onProperty acc:functions ],
        acc:Component,
        acc:HasFloorP,
        acc:HasLongitudinalPlacementP ;
    skos:broadMatch ns1:Element ;
    skos:definition "A physical item that participates in or supports accelerator operation.  This can be used to capture physical components, such as magnets, cavities, diagnostics, vacuum devices, and racks that are important for understanding the structure and function of the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:length a owl:DatatypeProperty ;
    rdfs:label "length" ;
    rdfs:range xsd:float ;
    skos:closeMatch ns1:length ;
    skos:definition "Length of the element (arc length for bends)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

