[] pals:affiliation inst:jefferson-lab ;
    pals:authors [ a pals:Author ;
            pals:affiliation inst:jefferson-lab ;
            pals:email "dianam@jlab.org" ;
            pals:name "Diana McSpadden" ;
            pals:orcid "https://orcid.org/0000-0002-8520-1631" ] ;
    pals:description "PALS-NARAD representation of a validated subset of the Jefferson Lab UITF injector beamline, ported from a prior instance format to conform to the accelerator_core LinkML schema." ;
    pals:facility [ a pals:Facility ;
            pals:beamlines inst:GUN_thru_MV ;
            pals:component_relations inst:IFYK203_to_ISLK302,
                inst:IPMK101_to_MBHK101H,
                inst:IPMK102_to_ITVK201,
                inst:ISLK302_to_IYGK302,
                inst:ITVK201_to_MDSK201,
                inst:MBHK101H_to_MBHK101V,
                inst:MBHK101V_to_MFHK101,
                inst:MDSK201_to_MQWK202,
                inst:MFHK101_to_IPMK102,
                inst:MQWK202_to_IFYK203,
                inst:RF_LASER_to_S_IS_20CM,
                inst:S_IS_20CM_to_IPMK101 ;
            pals:components inst:ICBK403,
                inst:IFYK203,
                inst:IPMK101,
                inst:IPMK102,
                inst:ISLK302,
                inst:ITVK201,
                inst:IYGK302,
                inst:MBHK101H,
                inst:MBHK101V,
                inst:MDSK201,
                inst:MFHK101,
                inst:MFRM604H,
                inst:MFRM604V,
                inst:MQWK202,
                inst:RF_LASER,
                inst:RM11,
                inst:S_IS_20CM ;
            pals:identifiers [ a pals:Identifier ;
                    pals:identifier_type "URL" ;
                    pals:identifier_value "https://www.jlab.org/accelerator/uitf" ] ;
            pals:signal_bindings inst:IPMK101_STAT,
                inst:IPMK101_XPOS,
                inst:IPMK101_YPOS,
                inst:IPMK102_STAT,
                inst:IPMK102_XPOS,
                inst:IPMK102_YPOS,
                inst:MBHK101H_KICK,
                inst:MBHK101H_LMAX,
                inst:MBHK101H_LMIN,
                inst:MBHK101H_RB,
                inst:MBHK101H_S,
                inst:MBHK101H_STAT,
                inst:MBHK101V_KICK,
                inst:MBHK101V_LMAX,
                inst:MBHK101V_LMIN,
                inst:MBHK101V_RB,
                inst:MBHK101V_S,
                inst:MBHK101V_STAT,
