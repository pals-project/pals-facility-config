acc:HasCommandSignal a owl:Class ;
    rdfs:label "HasCommandSignal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:predicate ],
        acc:SignalBinding ;
    skos:closeMatch pals:HasCommandSignalRelation ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "pals:has_command_signal" .

acc:HasLimitSignal a owl:Class ;
    rdfs:label "HasLimitSignal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
