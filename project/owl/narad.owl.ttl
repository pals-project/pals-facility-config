acc:NearestTo a owl:Class ;
    rdfs:label "NearestTo" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:tolerance_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:CoordinateSet ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:distance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:distance_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:distance_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:tolerance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:distance_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:tolerance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:tolerance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:distance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:UnitEnum ;
            owl:onProperty acc:distance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:tolerance_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:UnitEnum ;
            owl:onProperty acc:tolerance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "NearestTo" ] ) ] ;
            owl:onProperty acc:predicate ],
        acc:ComponentRelation ;
    skos:broadMatch RO:0002325 ;
    skos:definition "A relationship indicating that the subject component is nearest to the object component in a specified context,  such as a diagnostic device nearest to a magnet." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:nearest_to" .

acc:NormalConductingRFCavity a owl:Class ;
    rdfs:label "NormalConductingRFCavity" ;
    rdfs:subClassOf acc:RFCavity ;
