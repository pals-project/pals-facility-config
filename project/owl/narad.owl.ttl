@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix narad: <https://example.org/narad/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pals: <https://pals-project.readthedocs.io/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saref: <https://saref.etsi.org/core/v4.1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

narad:ACKicker a owl:Class ;
    rdfs:label "ACKicker" ;
    rdfs:subClassOf narad:Kicker ;
    skos:definition "An ACKicker element simulates a time-dependent kicker.  It is like a Kicker element except that the field varies in time.  This element requires a user supplied time-dependent expression." ;
    skos:exactMatch pals:ACKicker ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:BeamPositionMonitor a owl:Class ;
    rdfs:label "BeamPositionMonitor" ;
    rdfs:subClassOf narad:BodyShiftP,
        narad:DiagnosticDevice,
        narad:ReferenceP,
        narad:TwissP ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic device used to measure transverse beam position." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:BeamlineSection a owl:Class ;
    rdfs:label "BeamlineSection" ;
    rdfs:subClassOf narad:BookkeepingComponent ;
    skos:definition """A virtual component used to represent a section of the beamline for organizational 
or functional grouping of components.""" ;
    skos:exactMatch pals:BeamlineSection ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Bend a owl:Class ;
    rdfs:label "Bend" ;
    rdfs:subClassOf narad:Multipole ;
    skos:definition "Dipole magnet used to bend the beam. 2 poles. The major difference between this element and other physical elements is that with a Bend  the curvilinear coordinate system is an arc with finite curvature  and for the other elements the curvilinear coordinate system is straight." ;
    skos:exactMatch pals:Bend ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:BendP a owl:Class ;
    rdfs:label "BendP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:e2_rect ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:e2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:L_sagitta ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:g_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:rho_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:L_rectangle ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:e1 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:e2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:edge1_int ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:bend_field_actual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:edge1_int ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:h1 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:L_sagitta ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:MultipoleGeometryEnum ;
            owl:onProperty narad:multipole_geometry ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:ref_geometry ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:h2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:multipole_geometry ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:g_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:angle_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:angle_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:edge1_int ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:edge2_int ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:e1_rect ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:e2_rect ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:e2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:ref_geometry ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:h2 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:edge2_int ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:multipole_geometry ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:g_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:rho_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:e1 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:L_chord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:g_actual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:angle_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:e1_rect ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:L_rectangle ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:g_actual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:e2_rect ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:g_actual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:bend_field_actual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:bend_field_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:L_rectangle ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:h2 ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ReferenceGeometryEnum ;
            owl:onProperty narad:ref_geometry ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:bend_field_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:edge2_int ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:e1 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:L_sagitta ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:tilt_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:bend_field_actual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:h1 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:L_chord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:bend_field_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:L_chord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:tilt_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:h1 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:rho_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:tilt_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:e1_rect ] ;
    skos:definition """Mixin for bend parameters, which can be used to describe the bending properties of an accelerator element.
This mixin is aligned with PALS BendP for interoperability with the Particle Accelerator Language Standard (PALS).""" ;
    skos:exactMatch pals:BendP ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:CrabCavity a owl:Class ;
    rdfs:label "CrabCavity" ;
    rdfs:subClassOf narad:Cavity ;
    skos:definition "A cavity used for transverse beam manipulation, such as crabbing or deflecting." ;
    skos:exactMatch pals:CrabCavity ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Dipole a owl:Class ;
    rdfs:label "Dipole" ;
    rdfs:subClassOf narad:Multipole ;
    skos:broadMatch pals:Multipole ;
    skos:definition """A magnet primarily used to bend the beam. 2 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Marker a owl:Class ;
    rdfs:label "Marker" ;
    rdfs:subClassOf narad:BookkeepingComponent,
        narad:TwissP ;
    skos:definition "A virtual component used as a reference point or marker in the beamline structure." ;
    skos:exactMatch pals:Marker ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:NARAD a owl:Class ;
    rdfs:label "NARAD" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:virtual_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Signal ;
            owl:onProperty narad:signals ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ComponentRelation ;
            owl:onProperty narad:component_relations ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Beamline ;
            owl:onProperty narad:beamlines ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:PhysicalComponent ;
            owl:onProperty narad:physical_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SupportingFacilityComponent ;
            owl:onProperty narad:supporting_facility_components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:component_relations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:signal_bindings ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:signals ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:physical_components ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:beamlines ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:VirtualComponent ;
            owl:onProperty narad:virtual_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:supporting_facility_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SignalBinding ;
            owl:onProperty narad:signal_bindings ] ;
    skos:definition "Root container for accelerator core components, semantic signals, and local bindings." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Octupole a owl:Class ;
    rdfs:label "Octupole" ;
    rdfs:subClassOf narad:Multipole ;
    skos:definition """A magnet primarily used to focus or defocus the beam. 8 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:exactMatch pals:Octupole ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Quadrupole a owl:Class ;
    rdfs:label "Quadrupole" ;
    rdfs:subClassOf narad:Multipole ;
    skos:definition """A magnet primarily used to focus or defocus the beam. 4 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:exactMatch pals:Quadrupole ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:RadiationMonitor a owl:Class ;
    rdfs:label "RadiationMonitor" ;
    rdfs:subClassOf narad:BodyShiftP,
        narad:DiagnosticDevice ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic device used to monitor radiation dose or dose rate." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Sextupole a owl:Class ;
    rdfs:label "Sextupole" ;
    rdfs:subClassOf narad:Multipole ;
    skos:definition """A magnet primarily used to focus or defocus the beam. 6 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:exactMatch pals:Sextupole ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Solenoid a owl:Class ;
    rdfs:label "Solenoid" ;
    rdfs:subClassOf narad:Magnet,
        narad:SolenoidP ;
    skos:definition """A magnet with a primarily longitudinal magnetic field used for focusing.
A solenoid is an element whose magnetic field is dominated by a field whose direction is aligned with the magnetic axis. """ ;
    skos:exactMatch pals:Solenoid ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:SuperconductingRFCavity a owl:Class ;
    rdfs:label "SuperconductingRFCavity" ;
    rdfs:subClassOf narad:RFCavity ;
    skos:broadMatch pals:RFCavity ;
    skos:definition "A cavity used for RF acceleration or longitudinal manipulation, which is superconducting." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

<https://w3id.org/accelerator-core.owl.ttl> a owl:Ontology ;
    rdfs:label "accelerator_core" ;
    dcterms:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    dcterms:title "Accelerator Core Ontology" ;
    skos:definition "A lightweight LinkML schema for facility-agnostic accelerator components, their beamline relationships, and associated control-system signals." .

narad:ComponentRelation a owl:Class ;
    rdfs:label "ComponentRelation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:distance_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:reference_frame ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:tolerance_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:beamline_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:RelationContextEnum ;
            owl:onProperty narad:context ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Component ;
            owl:onProperty narad:object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:distance_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:distance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:distance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Component ;
            owl:onProperty narad:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:reference_frame ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:context ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:UnitEnum ;
            owl:onProperty narad:tolerance_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ComponentRelationPredicateEnum ;
            owl:onProperty narad:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ReferenceFrameEnum ;
            owl:onProperty narad:reference_frame ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:AxisEnum ;
            owl:onProperty narad:axis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:tolerance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:axis ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:DirectionEnum ;
            owl:onProperty narad:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:tolerance_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:beamline_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Beamline ;
            owl:onProperty narad:beamline_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:tolerance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:axis ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:UnitEnum ;
            owl:onProperty narad:distance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:tolerance_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:distance_value ],
        narad:Relationship ;
    skos:definition "Association between two Components (Physical or Virtual), with supporting contextual/qualifying information about how and where the relationship holds." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Kicker a owl:Class ;
    rdfs:label "Kicker" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom narad:PlaneEnum ;
            owl:onProperty narad:plane ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:plane ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:plane ],
        narad:ElectricMultipoleP,
        narad:Magnet,
        narad:MagneticMultipoleP ;
    skos:altLabel "Corrector",
        "HCorrector",
        "HDiagKicker",
        "VCorrector",
        "VDiagKicker" ;
    skos:broadMatch pals:Kicker ;
    skos:definition """A magnet primarily used to steer the beam.
Can deflect the beam transversely in both planes, or a single plane, depending on the design and parameters of the kicker. 
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:MetadataEntry a owl:Class ;
    rdfs:label "MetadataEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:datatype ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:DataTypeEnum ;
            owl:onProperty narad:datatype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:key ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:datatype ] ;
    skos:definition "A single generic key/value metadata entry, used as a GraphQL-compatible replacement for an open-ended (range: Any) field. A list of these represents an arbitrary, extensible bag of program-specific metadata." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:RFCavity a owl:Class ;
    rdfs:label "RFCavity" ;
    rdfs:subClassOf narad:Cavity ;
    skos:definition "A cavity used for RF acceleration or longitudinal manipulation." ;
    skos:exactMatch pals:RFCavity ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:SignalBinding a owl:Class ;
    rdfs:label "SignalBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SignalBindingPredicateEnum ;
            owl:onProperty narad:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:PhysicalComponent ;
            owl:onProperty narad:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Signal ;
            owl:onProperty narad:object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:subject ],
        narad:Relationship ;
    skos:definition "Association between a PhysicalComponent and one of its Signals, e.g. QUAD1.QUAD1_STATUS_binding." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:SupportingFacilityComponent a owl:Class ;
    rdfs:label "SupportingFacilityComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:FacilityFunctionEnum ;
            owl:onProperty narad:functions ],
        narad:BodyShiftP,
        narad:FloorP,
        narad:HasLongitudinalPlacement,
        narad:PhysicalComponent ;
    skos:broadMatch pals:StructuralElement ;
    skos:definition """A physical component that supports accelerator operation 
without a specific beam-pipe placement, 
such as a power supply, control rack, or radiation detector.
These can include Girders, Racks, Power Supplies, 
and other physical infrastructure components that are important for understanding 
the structure and function of the accelerator system but are not inline with the beamline.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

BFO:0000062 a owl:Class ;
    rdfs:label "follows" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject occurs after object in the sequence/beamline order." .

BFO:0000063 a owl:Class ;
    rdfs:label "precedes" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject occurs immediately before object in the sequence/beamline order." .

RO:0002131 a owl:Class ;
    rdfs:label "overlaps" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject and object share at least one part in common." .

RO:0002170 a owl:Class ;
    rdfs:label "connected_to" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject and object are physically connected. a is connected to b if and only if a and b are discrete structure,  and there exists some connecting structure c, such that c connects a and b" .

RO:0002220 a owl:Class ;
    rdfs:label "adjacent_to" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject and object are spatially adjacent, without overlapping." .

