            owl:allValuesFrom pals:PhysicalComponent ;
            owl:onProperty pals:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:subject ],
        pals:Relationship ;
    skos:definition "Association between a PhysicalComponent and one of its Signals, e.g. QUAD1.QUAD1_STATUS_binding." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Solenoid a owl:Class ;
    rdfs:label "Solenoid" ;
    rdfs:subClassOf pals:HasSolenoidP,
        pals:Magnet ;
    skos:definition """A magnet with a primarily longitudinal magnetic field used for focusing.
A solenoid is an element whose magnetic field is dominated by a field whose direction is aligned with the magnetic axis. """ ;
    skos:exactMatch pals:Solenoid ;
    skos:inScheme <https://w3id.org/accelerator-core> .

