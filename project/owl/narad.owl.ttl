pals:MultipoleParameterGroup a owl:Class ;
    rdfs:label "MultipoleParameterGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Es ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:Bn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:Es ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:En ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:Kn ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Ks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:En ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:En ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:EnL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:Kn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:tilt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:tilt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:EnL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:Es ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:tilt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:Ks ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Bs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Kn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:EsL ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:Bn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:EsL ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:Ks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pals:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:EnL ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:Bs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:Bs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:EsL ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:Bn ] ;
    skos:definition """A single order's electric (or magnetic) multipole component.
Only the fields supporting Electric Multipoles  OR the fields for Magnetic Multipoles should be present, not both.
Not a mixin, but a class used in the ElectricMultipoleP and MagneticMultipoleP mixins to represent individual multipole components.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:QuantityKindEnum a owl:Class ;
    rdfs:label "QuantityKindEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/QuantityKindEnum#BeamPosition> sosa:ObservableProperty quantitykind:ElectricCurrent quantitykind:MagneticFluxPerLength quantitykind:MagneticFluxDensity quantitykind:Pressure quantitykind:AbsorbedDoseRate quantitykind:Voltage quantitykind:Power quantitykind:PhaseAngle quantitykind:ElectricFieldStrength ) ;
