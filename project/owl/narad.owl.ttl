    rdfs:label "mm" ;
    rdfs:subClassOf acc:UnitEnum ;
    skos:definition "millimeter" ;
    skos:exactMatch qudt:MilliM .

<https://example.org/accelerator-core/UnitEnum#mrem_per_h> a owl:Class ;
    rdfs:label "mrem_per_h" ;
    rdfs:subClassOf acc:UnitEnum ;
    skos:definition "millirem per hour. Kept as a local accelerator unit value because QUDT publishes related radiation units but no exact millirem-per-hour unit in the checked vocabulary." ;
    skos:exactMatch qudt:MREM-PER-H .

<https://example.org/accelerator-core/UnitEnum#none> a owl:Class ;
    rdfs:label "none" ;
    rdfs:subClassOf acc:UnitEnum ;
    skos:definition "no unit or not applicable" .

<https://example.org/accelerator-core/UnitEnum#randians_pi2> a owl:Class ;
    rdfs:label "randians_pi2" ;
    rdfs:subClassOf acc:UnitEnum ;
    skos:definition "radians divided by 2 pi - angles and phases" .

<https://example.org/accelerator-core/UnitEnum#rem_per_h> a owl:Class ;
    rdfs:label "rem_per_h" ;
    rdfs:subClassOf acc:UnitEnum ;
    skos:definition "rem per hour. Kept as a local accelerator unit value because QUDT publishes rem and rem-per-second but no exact rem-per-hour unit in the checked vocabulary." .

