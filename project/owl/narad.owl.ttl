        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "MountedOn" ] ) ] ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:CoordinateSet ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        acc:ComponentRelation ;
    skos:broadMatch RO:0002371 ;
    skos:definition "A relationship indicating that the subject component is mounted on the object component in a specified context,  such as a diagnostic device mounted on a magnet." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:mounted_on" .

