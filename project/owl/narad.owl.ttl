            owl:onProperty acc:edge2_int ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:bend_field_actual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:angle_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:bend_field_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:L_sagitta ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:L_rectangle ],
        acc:ParamGroup ;
    skos:definition "Mixin for bend parameters, which can be used to describe the bending properties of an accelerator element. This mixin is aligned with PALS BendP for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:exactMatch pals:BendP ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BodyShiftP a owl:ObjectProperty ;
    rdfs:label "BodyShiftP" ;
    skos:definition "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:CavityTypeEnum a owl:Class ;
    rdfs:label "CavityTypeEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/CavityTypeEnum#STANDING_WAVE> <https://example.org/accelerator-core/CavityTypeEnum#TRAVELING_WAVE> ) ;
    skos:definition "The type of cavity, which determines the field configuration and mode structure." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/CavityTypeEnum#STANDING_WAVE>,
        <https://example.org/accelerator-core/CavityTypeEnum#TRAVELING_WAVE> .

acc:E_tot_ref a owl:DatatypeProperty ;
    rdfs:label "E_tot_ref" ;
    skos:altLabel "ETotal" ;
    skos:closeMatch pals:E_tot_ref ;
    skos:definition "[eV] Reference total energy" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ElectricMultipoleP a owl:ObjectProperty ;
    rdfs:label "ElectricMultipoleP" ;
    skos:definition "A mixin for electric multipole parameters that are aligned with PALS ElectricMultipoleP (Electric Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:FloorP a owl:ObjectProperty ;
    rdfs:label "FloorP" ;
    skos:definition "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasConnectingBranch a owl:Class ;
    rdfs:label "HasConnectingBranch" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:BeamLine ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "HasConnectingBranch" ] ) ] ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:beamline_context ],
        acc:ComponentRelation ;
    skos:definition "A relationship indicating that the subject component has a connecting branch to the object component in a specified context,  such as a beamline section having a fork as a connecting branch." ;
    skos:exactMatch RO:0002253 ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:has_connecting_branch" .

acc:HasElectricMultipoleP a owl:Class ;
    rdfs:label "HasElectricMultipoleP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:ElectricMultipoleParamGroup ;
            owl:onProperty acc:ElectricMultipoleP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:ElectricMultipoleP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:ElectricMultipoleP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasLongitudinalPlacementP a owl:Class ;
    rdfs:label "HasLongitudinalPlacementP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:LongitudinalPlacementParamGroup ;
            owl:onProperty acc:LongitudinalPlacementP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:LongitudinalPlacementP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:LongitudinalPlacementP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasMagneticMultipoleP a owl:Class ;
    rdfs:label "HasMagneticMultipoleP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:MagneticMultipoleP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:MagneticMultipoleP ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:MagneticMultipoleParamGroup ;
            owl:onProperty acc:MagneticMultipoleP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:identifier_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:identifier_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:IdentifierTypeEnum ;
            owl:onProperty acc:identifier_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:identifier_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:identifier_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:identifier_value ] ;
    skos:definition "A unique, and ideally persistent, identifier for a facility, such as a DOI or ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Kicker a owl:Class ;
    rdfs:label "Kicker" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:plane ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:PlaneEnum ;
            owl:onProperty acc:plane ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:plane ],
        acc:HasElectricMultipoleP,
        acc:HasMagneticMultipoleP,
        acc:Magnet ;
    skos:altLabel "Corrector",
        "HCorrector",
        "HDiagKicker",
        "VCorrector",
        "VDiagKicker" ;
    skos:broadMatch pals:Kicker ;
    skos:definition """A magnet primarily used to steer the beam.
Can deflect the beam transversely in both planes, or a single plane, depending on the design and parameters of the kicker. 
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:L_active a owl:DatatypeProperty ;
    rdfs:label "L_active" ;
    skos:closeMatch pals:L_active ;
    skos:definition "Active acceleration length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:L_chord a owl:DatatypeProperty ;
    rdfs:label "L_chord" ;
    skos:closeMatch pals:L_chord ;
    skos:definition "Chord length of the bend." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:L_rectangle a owl:DatatypeProperty ;
    rdfs:label "L_rectangle" ;
    skos:closeMatch pals:L_rectangle ;
    skos:definition "Rectangular length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:L_sagitta a owl:DatatypeProperty ;
    rdfs:label "L_sagitta" ;
    skos:closeMatch pals:L_sagitta ;
    skos:definition "Output parameter. Sagitta length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:LongitudinalPlacementP a owl:ObjectProperty ;
    rdfs:label "LongitudinalPlacementP" ;
    skos:definition "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:MagneticMultipoleP a owl:ObjectProperty ;
    rdfs:label "MagneticMultipoleP" ;
    skos:definition "A mixin for magnetic multipole parameters that are aligned with PALS MagneticMultipoleP (Magnetic Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:MetaP a owl:ObjectProperty ;
    rdfs:label "MetaP" ;
    skos:definition "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:PlaneEnum a owl:Class ;
    rdfs:label "PlaneEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/PlaneEnum#Horizontal> <https://example.org/accelerator-core/PlaneEnum#Vertical> ) ;
    skos:definition "Controlled values for transverse plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/PlaneEnum#Horizontal>,
        <https://example.org/accelerator-core/PlaneEnum#Vertical> .

acc:Precedes a owl:Class ;
    rdfs:label "Precedes" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Precedes" ] ) ] ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:BeamLine ;
            owl:onProperty acc:beamline_context ],
        acc:ComponentRelation ;
    skos:definition "A relationship indicating that the subject component precedes the object component in a specified context,  such as along a beamline." ;
    skos:exactMatch BFO:0000063 ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:precedes" .

acc:RFP a owl:ObjectProperty ;
    rdfs:label "RFP" ;
    skos:definition "A mixin for RF parameters that are aligned with PALS RFP (RF Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ReferenceP a owl:ObjectProperty ;
    rdfs:label "ReferenceP" ;
    skos:definition "A mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:SolenoidP a owl:ObjectProperty ;
    rdfs:label "SolenoidP" ;
    skos:definition "A mixin for solenoid-specific parameters that are aligned with PALS SolenoidP (Solenoid Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:TwissP a owl:ObjectProperty ;
    rdfs:label "TwissP" ;
    skos:definition "A mixin for Twiss parameters that are aligned with PALS TwissP (Twiss Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:access_protocol a owl:DatatypeProperty ;
    rdfs:label "access_protocol" ;
    skos:definition "The protocol used to access the signal in the source system,  such as EPICS Channel Access, PALS-Ext, MYA, or a simulation service." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:alpha_a a owl:DatatypeProperty ;
    rdfs:label "alpha_a" ;
    skos:altLabel "alpha_x",
        "alphax" ;
    skos:closeMatch pals:alpha_a ;
    skos:definition "Twiss alpha parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:alpha_b a owl:DatatypeProperty ;
    rdfs:label "alpha_b" ;
    skos:altLabel "alpha_y",
        "alphay" ;
    skos:closeMatch pals:alpha_b ;
    skos:definition "Twiss alpha parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:angle_ref a owl:DatatypeProperty ;
    rdfs:label "angle_ref" ;
    skos:closeMatch pals:angle_ref ;
    skos:definition "Reference bend angle." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:archive_identifier a owl:DatatypeProperty ;
    rdfs:label "archive_identifier" ;
    skos:definition "The identifier used to reference the signal in an archival system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:bend_field_actual a owl:DatatypeProperty ;
    rdfs:label "bend_field_actual" ;
    skos:closeMatch pals:bend_field_actual ;
    skos:definition "Actual bend field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:bend_field_ref a owl:DatatypeProperty ;
    rdfs:label "bend_field_ref" ;
    skos:closeMatch pals:bend_field_ref ;
    skos:definition "Reference bend field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:beta_a a owl:DatatypeProperty ;
    rdfs:label "beta_a" ;
    skos:altLabel "beta_x",
        "betax" ;
    skos:closeMatch pals:beta_a ;
    skos:definition "Twiss beta parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:beta_b a owl:DatatypeProperty ;
    rdfs:label "beta_b" ;
    skos:altLabel "beta_y",
        "betay" ;
    skos:closeMatch pals:beta_b ;
    skos:definition "Twiss beta parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:canonical_signal_type a owl:ObjectProperty ;
    rdfs:label "canonical_signal_type" ;
    skos:definition "The canonical semantic meaning of the signal." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:cavity_type a owl:ObjectProperty ;
    rdfs:label "cavity_type" ;
    skos:closeMatch pals:cavity_type ;
    skos:definition "Cavity type" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:component_direction a owl:ObjectProperty ;
    rdfs:label "component_direction" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:coordinate_system a owl:ObjectProperty ;
    rdfs:label "coordinate_system" ;
    skos:definition "The coordinate system used for the coordinates (e.g., Cartesian, Cylindrical)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:dE_ref a owl:DatatypeProperty ;
    rdfs:label "dE_ref" ;
    skos:closeMatch pals:dE_ref ;
    skos:definition "Reference energy gain." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:datatype a owl:ObjectProperty ;
    rdfs:label "datatype" ;
    skos:definition "Hint for the value's original type, so consumers can parse it back (e.g. float, integer, boolean) rather than treating everything as an opaque string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:direction a owl:DatatypeProperty ;
    rdfs:label "direction" ;
    skos:closeMatch pals:direction ;
    skos:definition "Beam direction along the BeamLine: +1 or -1. Longitudinal orientation. Default is +1." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:e1 a owl:DatatypeProperty ;
    rdfs:label "e1" ;
    skos:closeMatch pals:e1 ;
    skos:definition "Entrance end pole face rotation with respect to a sector geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:e1_rect a owl:DatatypeProperty ;
    rdfs:label "e1_rect" ;
    skos:closeMatch pals:e1_rect ;
    skos:definition "Entrance end pole face rotation with respect to a rectangular geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:e2 a owl:DatatypeProperty ;
    rdfs:label "e2" ;
    skos:closeMatch pals:e2 ;
    skos:definition "Exit end pole face rotation with respect to a sector geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:e2_rect a owl:DatatypeProperty ;
    rdfs:label "e2_rect" ;
    skos:closeMatch pals:e2_rect ;
    skos:definition "Exit end pole face rotation with respect to a rectangular geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:edge1_int a owl:DatatypeProperty ;
    rdfs:label "edge1_int" ;
    skos:closeMatch pals:edge1_int ;
    skos:definition "Entrance end fringe field integral." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:edge2_int a owl:DatatypeProperty ;
    rdfs:label "edge2_int" ;
    skos:closeMatch pals:edge2_int ;
    skos:definition "Exit end fringe field integral." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    skos:definition "The email address of the author." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:eta_x a owl:DatatypeProperty ;
    rdfs:label "eta_x" ;
    skos:altLabel "etax" ;
    skos:closeMatch pals:eta_x ;
    skos:definition "Twiss dispersion parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:eta_y a owl:DatatypeProperty ;
    rdfs:label "eta_y" ;
    skos:altLabel "etay" ;
    skos:closeMatch pals:eta_y ;
    skos:definition "Twiss dispersion parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:etap_x a owl:DatatypeProperty ;
    rdfs:label "etap_x" ;
    skos:altLabel "etapx" ;
    skos:closeMatch pals:etap_x ;
    skos:definition "Twiss dispersion slope parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:etap_y a owl:DatatypeProperty ;
    rdfs:label "etap_y" ;
    skos:altLabel "etapy" ;
    skos:closeMatch pals:etap_y ;
    skos:definition "Twiss dispersion slope parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:facility a owl:ObjectProperty ;
    rdfs:label "facility" ;
    skos:definition "A facility that contains lattice elements (physical and virtual), beamlines, parameter set commands, signals, etc." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    skos:closeMatch pals:frequency ;
    skos:definition "RF frequency." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:g_actual a owl:DatatypeProperty ;
    rdfs:label "g_actual" ;
    skos:closeMatch pals:g_actual ;
    skos:definition "Actual bend strength = 1/radius_actual" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:g_ref a owl:DatatypeProperty ;
    rdfs:label "g_ref" ;
    skos:closeMatch pals:g_ref ;
    skos:definition "Reference bend strength = 1/radius_ref" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:h1 a owl:DatatypeProperty ;
    rdfs:label "h1" ;
    skos:closeMatch pals:h1 ;
    skos:definition "Entrance end pole face curvature" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:h2 a owl:DatatypeProperty ;
    rdfs:label "h2" ;
    skos:closeMatch pals:h2 ;
    skos:definition "Exit end pole face curvature" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:harmon a owl:DatatypeProperty ;
    rdfs:label "harmon" ;
    skos:closeMatch pals:harmon ;
    skos:definition "RF harmonic number." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:id_namespace a owl:DatatypeProperty ;
    rdfs:label "id_namespace" ;
    skos:definition "Base IRI for this facility's instance identifiers. Identifiers in the data (id, subject, object, beamline_context) are written bare, e.g. RF_LASER, and are made absolute by prefixing this value on export to RDF or Neo4j, e.g. tag:jlab.org,2026:uitf/ + RF_LASER. Required, with no schema-wide default, so that facilities cannot silently share a namespace and collide. Any absolute IRI is accepted, resolvable (https://...) or not (tag:..., urn:...). It must end in '/', '#' or ':' so that simple concatenation yields a well-formed IRI." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:identifier_type a owl:ObjectProperty ;
    rdfs:label "identifier_type" ;
    skos:definition "The type of identifier, such as DOI | PURL | ROR | LOCAL | URL | ARK." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:identifier_value a owl:DatatypeProperty ;
    rdfs:label "identifier_value" ;
    skos:definition "The value of the identifier." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:key a owl:DatatypeProperty ;
    rdfs:label "key" ;
    skos:definition "The metadata field name." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:closeMatch pals:label ;
    skos:definition "A label string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:multipass a owl:DatatypeProperty ;
    rdfs:label "multipass" ;
    skos:closeMatch pals:multipass ;
    skos:definition "Indicates whether the BeamLine is a multipass BeamLine, where the beam passes through the same physical elements multiple times. If not provided, the default assumption is that the BeamLine is single-pass." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:multipass_phase a owl:DatatypeProperty ;
    rdfs:label "multipass_phase" ;
    skos:closeMatch pals:multipass_phase ;
    skos:definition "rad/2pi RF Phase added to multipass elements" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:native_data_type a owl:ObjectProperty ;
    rdfs:label "native_data_type" ;
    skos:definition "The native data type of the signal in the source system,  such as String, Integer, Float, or Boolean." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:native_description a owl:DatatypeProperty ;
    rdfs:label "native_description" ;
    skos:definition "A human-readable description of the signal in the source system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:native_unit a owl:ObjectProperty ;
    rdfs:label "native_unit" ;
    skos:definition "The native unit of the signal in the source system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:num_cells a owl:DatatypeProperty ;
    rdfs:label "num_cells" ;
    skos:closeMatch pals:num_cells ;
    skos:definition "Number of cells in the cavity" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:orcid a owl:DatatypeProperty ;
    rdfs:label "orcid" ;
    skos:definition "The ORCID identifier of the author." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:order a owl:DatatypeProperty ;
    rdfs:label "order" ;
    skos:definition "Multipole order N (0 = dipole, 1 = quadrupole, etc.)" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:pc_ref a owl:DatatypeProperty ;
    rdfs:label "pc_ref" ;
    skos:altLabel "pCentral" ;
    skos:closeMatch pals:pc_ref ;
    skos:definition "[momentum*c] Reference momentum times speed of light." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:periodic a owl:DatatypeProperty ;
    rdfs:label "periodic" ;
    skos:closeMatch pals:periodic ;
    skos:definition "Indicates whether orbit and Twiss parameters periodic. If not provided, the default assumption is that the BeamLine is not periodic." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:phase a owl:DatatypeProperty ;
    rdfs:label "phase" ;
    skos:closeMatch pals:phase ;
    skos:definition "RF phase. rad/2pi RF phase in 0 to 2*pi" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:phi a owl:DatatypeProperty ;
    rdfs:label "phi" ;
    skos:altLabel "ModelPitch",
        "Model_Pitch",
        "phi_angle" ;
    skos:closeMatch pals:phi ;
    skos:definition "Rotation around the X-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:phi_a a owl:DatatypeProperty ;
    rdfs:label "phi_a" ;
    skos:altLabel "phi_x",
        "phix",
        "psi_x",
        "psix" ;
    skos:closeMatch pals:phi_a ;
    skos:definition "Twiss phase advance parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:phi_b a owl:DatatypeProperty ;
    rdfs:label "phi_b" ;
    skos:altLabel "phi_y",
        "phiy",
        "psi_y",
        "psiy" ;
    skos:closeMatch pals:phi_b ;
    skos:definition "Twiss phase advance parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:phi_coord a owl:DatatypeProperty ;
    rdfs:label "phi_coord" ;
    skos:definition "The azimuthal angle in spherical coordinates (in radians)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:plane a owl:ObjectProperty ;
    rdfs:label "plane" ;
    skos:definition "The transverse plane in which the kicker operates, either horizontal or vertical." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:psi a owl:DatatypeProperty ;
    rdfs:label "psi" ;
    skos:altLabel "Model_Roll",
        "Rotation",
        "psi_angle" ;
    skos:closeMatch pals:psi ;
    skos:definition "Rotation around the Z-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:quantity_kind a owl:ObjectProperty ;
    rdfs:label "quantity_kind" ;
    skos:definition "The physical quantity kind of the signal." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:r_coord a owl:DatatypeProperty ;
    rdfs:label "r_coord" ;
    skos:definition "The radial distance in cylindrical coordinates." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:reference_frame a owl:ObjectProperty ;
    rdfs:label "reference_frame" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:repeat a owl:DatatypeProperty ;
    rdfs:label "repeat" ;
    skos:closeMatch pals:repeat ;
    skos:definition """Repetition count. If not provided, the default assumption is that the beamline is not repeated and the value is 1.
If value is greater than 1, the beamline is repeated that many times.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:rho_ref a owl:DatatypeProperty ;
    rdfs:label "rho_ref" ;
    skos:closeMatch pals:rho_ref ;
    skos:definition "Reference bend radius." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:signal_role a owl:ObjectProperty ;
    rdfs:label "signal_role" ;
    skos:definition "The role of the signal in the control system, such as setpoint, readback, status, command, or limit." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:source_system a owl:ObjectProperty ;
    rdfs:label "source_system" ;
    skos:definition "The source system from which the signal originates, such as EPICS, PALS-Ext, MYA, an element database, a channel database, or a simulation service." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:species_ref a owl:DatatypeProperty ;
    rdfs:label "species_ref" ;
    skos:closeMatch pals:species_ref ;
    skos:definition "A reference to a species or particle type, such as an ion, electron, or proton." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:theta a owl:DatatypeProperty ;
    rdfs:label "theta" ;
    skos:altLabel "ModelYaw",
        "Model_Yaw",
        "theta_angle" ;
    skos:closeMatch pals:theta ;
    skos:definition "Orientation angle around the Y-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:theta_coord a owl:DatatypeProperty ;
    rdfs:label "theta_coord" ;
    skos:definition "The angular coordinate in cylindrical coordinates (in radians)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:tilt a owl:DatatypeProperty ;
    rdfs:label "tilt" ;
    skos:broadMatch pals:tilt ;
    skos:definition "Tilt of the Nth multipole." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:tilt_ref a owl:DatatypeProperty ;
    rdfs:label "tilt_ref" ;
    skos:closeMatch pals:tilt_ref ;
    skos:definition "Reference tilt of the bend." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:time_ref a owl:DatatypeProperty ;
    rdfs:label "time_ref" ;
    skos:altLabel "tRef" ;
    skos:closeMatch pals:time_ref ;
    skos:definition "[s] Reference time" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    skos:definition "The metadata value, serialized as a string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:definition "Version of the representation of a particle accelerator and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:voltage a owl:DatatypeProperty ;
    rdfs:label "voltage" ;
    skos:closeMatch pals:voltage ;
    skos:definition "RF voltage." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:x a owl:DatatypeProperty ;
    rdfs:label "x" ;
    skos:altLabel "ModelX",
        "x coordinate",
        "x_coordinate" ;
    skos:closeMatch pals:x ;
    skos:definition "Global X coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:x_coord a owl:DatatypeProperty ;
    rdfs:label "x_coord" ;
    skos:definition "The x-coordinate in the specified coordinate system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:x_offset a owl:DatatypeProperty ;
    rdfs:label "x_offset" ;
    skos:altLabel "GlobalOffsetX",
        "delta_x",
        "x_shift" ;
    skos:closeMatch pals:x_offset ;
    skos:definition "Shift in the X direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:x_rot a owl:DatatypeProperty ;
    rdfs:label "x_rot" ;
    skos:altLabel "GlobalOffsetPhi",
        "delta_phi",
        "phi_shift" ;
    skos:closeMatch pals:x_rot ;
    skos:definition "Rotation around the X-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:y a owl:DatatypeProperty ;
    rdfs:label "y" ;
    skos:altLabel "ModelY",
        "y coordinate",
        "y_coordinate" ;
    skos:closeMatch pals:y ;
    skos:definition "Global Y coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:y_coord a owl:DatatypeProperty ;
    rdfs:label "y_coord" ;
    skos:definition "The y-coordinate in the specified coordinate system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:y_offset a owl:DatatypeProperty ;
    rdfs:label "y_offset" ;
    skos:altLabel "GlobalOffsetY",
        "delta_y",
        "y_shift" ;
    skos:closeMatch pals:y_offset ;
    skos:definition "Shift in the Y direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:y_rot a owl:DatatypeProperty ;
    rdfs:label "y_rot" ;
    skos:altLabel "GlobalOffsetTheta",
        "delta_theta",
        "theta_shift" ;
    skos:closeMatch pals:y_rot ;
    skos:definition "Rotation around the Y-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:z a owl:DatatypeProperty ;
    rdfs:label "z" ;
    skos:altLabel "ModelZ",
        "z coordinate",
        "z_coordinate" ;
    skos:closeMatch pals:z ;
    skos:definition "Global Z coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:z_coord a owl:DatatypeProperty ;
    rdfs:label "z_coord" ;
    skos:definition "The z-coordinate in the specified coordinate system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:z_offset a owl:DatatypeProperty ;
    rdfs:label "z_offset" ;
    skos:altLabel "GlobalOffsetZ",
        "delta_z",
        "z_shift" ;
    skos:closeMatch pals:z_offset ;
    skos:definition "Shift in the Z direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:z_rot a owl:DatatypeProperty ;
    rdfs:label "z_rot" ;
    skos:altLabel "GlobalOffsetPsi",
        "delta_psi",
        "psi_shift" ;
    skos:closeMatch pals:z_rot ;
    skos:definition "Rotation around the Z-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:zero_phase a owl:ObjectProperty ;
    rdfs:label "zero_phase" ;
    skos:closeMatch pals:zero_phase ;
    skos:definition "Sets what phase = 0 means." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Cavity a owl:Class ;
    rdfs:label "Cavity" ;
    rdfs:subClassOf acc:HasBodyShiftP,
        acc:HasElectricMultipoleP,
        acc:HasMagneticMultipoleP,
        acc:HasReferenceP,
        acc:HasTwissP,
        acc:PhysicalComponent ;
    skos:definition "A cavity used for beam acceleration or manipulation." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:CoordinateSystemEnum a owl:Class ;
    rdfs:label "CoordinateSystemEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/CoordinateSystemEnum#Cartesian> <https://example.org/accelerator-core/CoordinateSystemEnum#Cylindrical> <https://example.org/accelerator-core/CoordinateSystemEnum#Spherical> ) ;
    skos:definition "Coordinate systems for spatial relationships." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/CoordinateSystemEnum#Cartesian>,
        <https://example.org/accelerator-core/CoordinateSystemEnum#Cylindrical>,
        <https://example.org/accelerator-core/CoordinateSystemEnum#Spherical> .

acc:Edge a owl:Class ;
    rdfs:label "Edge" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:object ] ;
    skos:definition "Abstract base for subject-predicate-object associations." ;
    skos:exactMatch rdf:Statement ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasFloorP a owl:Class ;
    rdfs:label "HasFloorP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:FloorP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:FloorP ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:FloorParamGroup ;
            owl:onProperty acc:FloorP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Node a owl:Class ;
    rdfs:label "Node" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:alias ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:alias ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:id ] ;
    skos:definition "Abstract base class for all node entities in the accelerator core ontology. This differentiates nodes from edges (relationships) in the ontology. This class is not intended to be instantiated directly, but serves as a common ancestor for all other classes. Allows for the use of kind: as a discriminator for the type of node in the ontology." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:RFCavity a owl:Class ;
    rdfs:label "RFCavity" ;
    rdfs:subClassOf acc:Cavity,
        acc:HasRFP ;
    skos:definition "A cavity used for RF acceleration or longitudinal manipulation." ;
    skos:exactMatch pals:RFCavity ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Signal a owl:Class ;
    rdfs:label "Signal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:SignalRoleEnum ;
            owl:onProperty acc:signal_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:native_description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:signal_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:canonical_signal_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:access_protocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:SourceSystemEnum ;
            owl:onProperty acc:source_system ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:native_data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:source_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:quantity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:signal_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:archive_identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:CanonicalSignalTypeEnum ;
            owl:onProperty acc:canonical_signal_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:canonical_signal_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:UnitEnum ;
            owl:onProperty acc:native_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:native_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:QuantityKindEnum ;
            owl:onProperty acc:quantity_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:source_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:native_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:archive_identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:native_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:access_protocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:archive_identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:access_protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:quantity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:DataTypeEnum ;
            owl:onProperty acc:native_data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:native_data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:native_unit ],
        acc:HasMetaP,
        acc:Node ;
    skos:broadMatch sosa:Actuator,
        sosa:Sensor ;
    skos:definition "Semantic meaning of a control-system signal associated with a component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:VirtualRelationEnum a owl:Class ;
    rdfs:label "VirtualRelationEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/VirtualRelationEnum#Inline> <https://example.org/accelerator-core/VirtualRelationEnum#AssociatedWithBeamLine> <https://example.org/accelerator-core/VirtualRelationEnum#NotAssociatedWithBeamLine> ) ;
    skos:definition "Controlled values for virtual relation to the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/VirtualRelationEnum#AssociatedWithBeamLine>,
        <https://example.org/accelerator-core/VirtualRelationEnum#Inline>,
        <https://example.org/accelerator-core/VirtualRelationEnum#NotAssociatedWithBeamLine> .

acc:ZeroPhaseEnum a owl:Class ;
    rdfs:label "ZeroPhaseEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/ZeroPhaseEnum#ACCELERATING> <https://example.org/accelerator-core/ZeroPhaseEnum#BELOW_TRANSITION> <https://example.org/accelerator-core/ZeroPhaseEnum#ABOVE_TRANSITION> ) ;
    skos:definition "The zero phase reference for the cavity, which determines the phase of the RF field at the entrance of the cavity." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/ZeroPhaseEnum#ABOVE_TRANSITION>,
        <https://example.org/accelerator-core/ZeroPhaseEnum#ACCELERATING>,
        <https://example.org/accelerator-core/ZeroPhaseEnum#BELOW_TRANSITION> .

acc:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    rdfs:range xsd:string ;
    skos:closeMatch pals:alias ;
    skos:definition "An alternative name or identifier for the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:functions a owl:ObjectProperty .

acc:identifiers a owl:ObjectProperty ;
    rdfs:label "identifiers" ;
    rdfs:range acc:Identifier ;
    skos:definition "A unique and ideally persistent identifier for the facility, such as a DOI or ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:s_position a owl:DatatypeProperty ;
    rdfs:label "s_position" ;
    skos:closeMatch pals:s_position ;
    skos:definition "Longitudinal position of the element along the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BookkeepingComponent a owl:Class ;
    rdfs:label "BookkeepingComponent" ;
    rdfs:subClassOf acc:HasBodyShiftP,
        acc:VirtualComponent ;
    skos:broadMatch pals:BookkeepingElement ;
    skos:definition "A virtual component that represents a bookkeeping or organizational role in the accelerator system,  such as a BeamLineSection, Marker or a Fork. These can include BeamLineSections, Markers, Forks, and other virtual components that are important for understanding  the structure and function of the accelerator system but are not physical devices." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:CoordinateSet a owl:Class ;
    rdfs:label "CoordinateSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:x_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:x_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:coordinate_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:phi_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:z_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:z_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:z_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:phi_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:CoordinateSystemEnum ;
            owl:onProperty acc:coordinate_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:theta_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:theta_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:r_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:phi_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:y_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:r_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:r_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:coordinate_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:y_coord ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:x_coord ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:theta_coord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:y_coord ] ;
    skos:definition "A set of coordinates that define the spatial relationship between two components. This can include Cartesian coordinates, cylindrical coordinates, or other coordinate systems as needed. Useful for defining the spatial relationship where the relationship is not strictly linear or where the components are not aligned along a single axis." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:DirectionEnum a owl:Class ;
    rdfs:label "DirectionEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/DirectionEnum#upstream> <https://example.org/accelerator-core/DirectionEnum#downstream> <https://example.org/accelerator-core/DirectionEnum#positive> <https://example.org/accelerator-core/DirectionEnum#negative> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/DirectionEnum#downstream>,
        <https://example.org/accelerator-core/DirectionEnum#negative>,
        <https://example.org/accelerator-core/DirectionEnum#positive>,
        <https://example.org/accelerator-core/DirectionEnum#upstream> .

acc:Magnet a owl:Class ;
    rdfs:label "Magnet" ;
    rdfs:subClassOf acc:HasBodyShiftP,
        acc:HasReferenceP,
        acc:HasTwissP,
        acc:PhysicalComponent ;
    skos:broadMatch pals:Element ;
    skos:definition "An accelerator device that produces a magnetic field for beam control." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:PhysicalRelationEnum a owl:Class ;
    rdfs:label "PhysicalRelationEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/PhysicalRelationEnum#Inline> <https://example.org/accelerator-core/PhysicalRelationEnum#AttachedToPipe> <https://example.org/accelerator-core/PhysicalRelationEnum#NearBeamLine> <https://example.org/accelerator-core/PhysicalRelationEnum#SupportingFacility> ) ;
    skos:definition "Controlled values for physical relation to the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/PhysicalRelationEnum#AttachedToPipe>,
        <https://example.org/accelerator-core/PhysicalRelationEnum#Inline>,
        <https://example.org/accelerator-core/PhysicalRelationEnum#NearBeamLine>,
        <https://example.org/accelerator-core/PhysicalRelationEnum#SupportingFacility> .

acc:ReferenceFrameEnum a owl:Class ;
    rdfs:label "ReferenceFrameEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/ReferenceFrameEnum#beam_direction> <https://example.org/accelerator-core/ReferenceFrameEnum#facility_coordinates> <https://example.org/accelerator-core/ReferenceFrameEnum#local_component_frame> <https://example.org/accelerator-core/ReferenceFrameEnum#tunnel_stationing> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/ReferenceFrameEnum#beam_direction>,
        <https://example.org/accelerator-core/ReferenceFrameEnum#facility_coordinates>,
        <https://example.org/accelerator-core/ReferenceFrameEnum#local_component_frame>,
        <https://example.org/accelerator-core/ReferenceFrameEnum#tunnel_stationing> .

acc:ReferenceGeometryEnum a owl:Class ;
    rdfs:label "ReferenceGeometryEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/ReferenceGeometryEnum#arc> <https://example.org/accelerator-core/ReferenceGeometryEnum#chord> <https://example.org/accelerator-core/ReferenceGeometryEnum#entrance_coords> <https://example.org/accelerator-core/ReferenceGeometryEnum#exit_coords> ) ;
    skos:definition "The reference geometry used to calculate multipoles.  Sets the geometry used to calculate multipoles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/ReferenceGeometryEnum#arc>,
        <https://example.org/accelerator-core/ReferenceGeometryEnum#chord>,
        <https://example.org/accelerator-core/ReferenceGeometryEnum#entrance_coords>,
        <https://example.org/accelerator-core/ReferenceGeometryEnum#exit_coords> .

acc:VirtualComponent a owl:Class ;
    rdfs:label "VirtualComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:VirtualFunctionEnum ;
            owl:onProperty acc:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:VirtualRelationEnum ;
            owl:onProperty acc:beamline_relation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:beamline_relation ],
        acc:Component,
        acc:HasFloorP ;
    skos:broadMatch pals:BookkeepingElement,
        pals:Element ;
    skos:definition "A virtual or logical component that represents a concept, function, or role in the accelerator  beamline operation but does not have a physical instantiation.  This can be used to capture abstract components, such as Markers, BeamLineSections, and FacilitySpaces that are important for understanding the structure and function of the accelerator system but are not physical devices." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:multipole_geometry a owl:ObjectProperty ;
    rdfs:label "multipole_geometry" ;
    skos:closeMatch pals:multipole_geometry ;
    skos:definition "Multipole geometry type. Must be `follows_ref_geometry`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ref_geometry a owl:ObjectProperty ;
    rdfs:label "ref_geometry" ;
    skos:closeMatch pals:ref_geometry ;
    skos:definition "Reference geometry type. Must be `arc`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Bsol a owl:DatatypeProperty ;
    rdfs:label "Bsol" ;
    skos:closeMatch pals:Bsol ;
    skos:definition "Solenoid field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:DiagnosticDevice a owl:Class ;
    rdfs:label "DiagnosticDevice" ;
    rdfs:subClassOf acc:PhysicalComponent ;
    skos:broadMatch pals:Instrument ;
    skos:definition "An accelerator device used to measure beam or machine state." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasReferenceP a owl:Class ;
    rdfs:label "HasReferenceP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:ReferenceParamGroup ;
            owl:onProperty acc:ReferenceP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:ReferenceP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:ReferenceP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Ksol a owl:DatatypeProperty ;
    rdfs:label "Ksol" ;
    skos:closeMatch pals:Ksol ;
    skos:definition "Normalized solenoid strength." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Multipole a owl:Class ;
    rdfs:label "Multipole" ;
    rdfs:subClassOf acc:HasElectricMultipoleP,
        acc:HasMagneticMultipoleP,
        acc:Magnet ;
    skos:broadMatch pals:Multipole ;
    skos:definition """A general magnet with a higher-order multipole field, such as a sextupole or octupole.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:VirtualFunctionEnum a owl:Class ;
    rdfs:label "VirtualFunctionEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/VirtualFunctionEnum#BeamLineSection> <https://example.org/accelerator-core/VirtualFunctionEnum#Mark> <https://example.org/accelerator-core/VirtualFunctionEnum#DriftSpace> <https://example.org/accelerator-core/VirtualFunctionEnum#Fork> <https://example.org/accelerator-core/VirtualFunctionEnum#Control> ) ;
    skos:definition "Broad virtual component functions or roles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/VirtualFunctionEnum#BeamLineSection>,
        <https://example.org/accelerator-core/VirtualFunctionEnum#Control>,
        <https://example.org/accelerator-core/VirtualFunctionEnum#DriftSpace>,
        <https://example.org/accelerator-core/VirtualFunctionEnum#Fork>,
        <https://example.org/accelerator-core/VirtualFunctionEnum#Mark> .

acc:affiliation a owl:ObjectProperty ;
    rdfs:label "affiliation" ;
    rdfs:range acc:Affiliation ;
    skos:definition "The affiliation of the author or component, as a ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:beamline_relation a owl:ObjectProperty .

acc:distance_unit a owl:ObjectProperty ;
    rdfs:label "distance_unit" ;
    rdfs:range acc:UnitEnum ;
    skos:definition "Unit of the distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:distance_value a owl:DatatypeProperty ;
    rdfs:label "distance_value" ;
    rdfs:range xsd:float ;
    skos:definition "Distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "The name of the entity. For example, the name of the person or organization." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:tolerance_unit a owl:ObjectProperty ;
    rdfs:label "tolerance_unit" ;
    rdfs:range acc:UnitEnum ;
    skos:definition "Unit of the tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:tolerance_value a owl:DatatypeProperty ;
    rdfs:label "tolerance_value" ;
    rdfs:range xsd:float ;
    skos:definition "Tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Component a owl:Class ;
    rdfs:label "Component" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:native_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:native_types ],
        acc:HasMetaP,
        acc:Node ;
    skos:broadMatch pals:Element ;
    skos:definition "A general class for accelerator components, which can be specialized into more specific types like AcceleratorDevice, Magnet, etc." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:DataTypeEnum a owl:Class ;
    rdfs:label "DataTypeEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/DataTypeEnum#String> <https://example.org/accelerator-core/DataTypeEnum#Integer> <https://example.org/accelerator-core/DataTypeEnum#Float> <https://example.org/accelerator-core/DataTypeEnum#Boolean> <https://example.org/accelerator-core/DataTypeEnum#FloatArray> ) ;
    skos:definition "Data types for parameter values." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/DataTypeEnum#Boolean>,
        <https://example.org/accelerator-core/DataTypeEnum#Float>,
        <https://example.org/accelerator-core/DataTypeEnum#FloatArray>,
        <https://example.org/accelerator-core/DataTypeEnum#Integer>,
        <https://example.org/accelerator-core/DataTypeEnum#String> .

acc:HasBodyShiftP a owl:Class ;
    rdfs:label "HasBodyShiftP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:BodyShiftParamGroup ;
            owl:onProperty acc:BodyShiftP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:BodyShiftP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:BodyShiftP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasTwissP a owl:Class ;
    rdfs:label "HasTwissP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:TwissP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:TwissP ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:TwissParamGroup ;
            owl:onProperty acc:TwissP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:IdentifierTypeEnum a owl:Class ;
    rdfs:label "IdentifierTypeEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/IdentifierTypeEnum#DOI> <https://example.org/accelerator-core/IdentifierTypeEnum#PURL> <https://example.org/accelerator-core/IdentifierTypeEnum#ROR> <https://example.org/accelerator-core/IdentifierTypeEnum#LOCAL> <https://example.org/accelerator-core/IdentifierTypeEnum#URL> <https://example.org/accelerator-core/IdentifierTypeEnum#ARK> ) ;
    skos:definition "Controlled values for identifier types." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/IdentifierTypeEnum#ARK>,
        <https://example.org/accelerator-core/IdentifierTypeEnum#DOI>,
        <https://example.org/accelerator-core/IdentifierTypeEnum#LOCAL>,
        <https://example.org/accelerator-core/IdentifierTypeEnum#PURL>,
        <https://example.org/accelerator-core/IdentifierTypeEnum#ROR>,
        <https://example.org/accelerator-core/IdentifierTypeEnum#URL> .

acc:MultipoleGeometryEnum a owl:Class ;
    rdfs:label "MultipoleGeometryEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/MultipoleGeometryEnum#follows_ref_geometry> <https://example.org/accelerator-core/MultipoleGeometryEnum#vertically_pure> <https://example.org/accelerator-core/MultipoleGeometryEnum#horizontally_pure> <https://example.org/accelerator-core/MultipoleGeometryEnum#chord> <https://example.org/accelerator-core/MultipoleGeometryEnum#entrance_coords> <https://example.org/accelerator-core/MultipoleGeometryEnum#exit_coords> ) ;
    skos:definition "The geometric configuration of the multipole field.  Sets the geometry used to calculate multipoles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/MultipoleGeometryEnum#chord>,
        <https://example.org/accelerator-core/MultipoleGeometryEnum#entrance_coords>,
        <https://example.org/accelerator-core/MultipoleGeometryEnum#exit_coords>,
        <https://example.org/accelerator-core/MultipoleGeometryEnum#follows_ref_geometry>,
        <https://example.org/accelerator-core/MultipoleGeometryEnum#horizontally_pure>,
        <https://example.org/accelerator-core/MultipoleGeometryEnum#vertically_pure> .

acc:PhysicalComponent a owl:Class ;
    rdfs:label "PhysicalComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:PhysicalRelationEnum ;
            owl:onProperty acc:beamline_relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:PhysicalFunctionEnum ;
            owl:onProperty acc:functions ],
        acc:Component,
        acc:HasFloorP,
        acc:HasLongitudinalPlacementP ;
    skos:broadMatch pals:Element ;
    skos:definition "A physical item that participates in or supports accelerator operation.  This can be used to capture physical components, such as magnets, cavities, diagnostics, vacuum devices, and racks that are important for understanding the structure and function of the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:length a owl:DatatypeProperty ;
    rdfs:label "length" ;
    rdfs:range xsd:float ;
    skos:closeMatch pals:length ;
    skos:definition "Length of the element (arc length for bends)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BeamLine a owl:Class ;
    rdfs:label "BeamLine" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty acc:repeat ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty acc:multipass ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:repeat ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:periodic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:multipass ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:periodic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty acc:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:multipass ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty acc:periodic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:repeat ],
        acc:VirtualComponent ;
    skos:definition "PALS element for an ordered sequence of beamline elements defining a beam path." ;
    skos:exactMatch pals:BeamLine ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Bn a owl:DatatypeProperty ;
    rdfs:label "Bn" ;
    skos:broadMatch pals:BnN ;
    skos:definition "Normal component of the magnetic field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Bs a owl:DatatypeProperty ;
    rdfs:label "Bs" ;
    skos:broadMatch pals:BsN ;
    skos:definition "Skew component of the magnetic field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:En a owl:DatatypeProperty ;
    rdfs:label "En" ;
    skos:broadMatch pals:EnN ;
    skos:definition "Normal component of the field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:EnL a owl:DatatypeProperty ;
    rdfs:label "EnL" ;
    skos:broadMatch pals:EnNL ;
    skos:definition "Length-integrated normal component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Es a owl:DatatypeProperty ;
    rdfs:label "Es" ;
    skos:broadMatch pals:EsN ;
    skos:definition "Skew component of the field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:EsL a owl:DatatypeProperty ;
    rdfs:label "EsL" ;
    skos:broadMatch pals:EsNL ;
    skos:definition "Length-integrated skew component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:FacilityFunctionEnum a owl:Class ;
    rdfs:label "FacilityFunctionEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/FacilityFunctionEnum#Support> <https://example.org/accelerator-core/FacilityFunctionEnum#Alignment> <https://example.org/accelerator-core/FacilityFunctionEnum#PowerSupply> <https://example.org/accelerator-core/FacilityFunctionEnum#ControlRack> <https://example.org/accelerator-core/FacilityFunctionEnum#Cooling> <https://example.org/accelerator-core/FacilityFunctionEnum#Diagnostics> <https://example.org/accelerator-core/FacilityFunctionEnum#Detection> ) ;
    skos:definition "Broad structural or support functions." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/FacilityFunctionEnum#Alignment>,
        <https://example.org/accelerator-core/FacilityFunctionEnum#ControlRack>,
        <https://example.org/accelerator-core/FacilityFunctionEnum#Cooling>,
        <https://example.org/accelerator-core/FacilityFunctionEnum#Detection>,
        <https://example.org/accelerator-core/FacilityFunctionEnum#Diagnostics>,
        <https://example.org/accelerator-core/FacilityFunctionEnum#PowerSupply>,
        <https://example.org/accelerator-core/FacilityFunctionEnum#Support> .

acc:Kn a owl:DatatypeProperty ;
    rdfs:label "Kn" ;
    skos:broadMatch pals:KnN ;
    skos:definition "Normalized normal component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Ks a owl:DatatypeProperty ;
    rdfs:label "Ks" ;
    skos:broadMatch pals:KsN ;
    skos:definition "Normalized skew component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:SignalBinding a owl:Class ;
    rdfs:label "SignalBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:Signal ;
            owl:onProperty acc:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:PhysicalComponent ;
            owl:onProperty acc:subject ],
        acc:Edge ;
    skos:definition "Association between a PhysicalComponent and one of its Signals, e.g. QUAD1 component to QUAD1.STATUS signal." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:SignalRoleEnum a owl:Class ;
    rdfs:label "SignalRoleEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/SignalRoleEnum#Setpoint> <https://example.org/accelerator-core/SignalRoleEnum#Readback> <https://example.org/accelerator-core/SignalRoleEnum#Status> <https://example.org/accelerator-core/SignalRoleEnum#Command> <https://example.org/accelerator-core/SignalRoleEnum#MinimumLimit> <https://example.org/accelerator-core/SignalRoleEnum#MaximumLimit> <https://example.org/accelerator-core/SignalRoleEnum#RangeLimit> ) ;
    skos:definition "Roles for control-system signals." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/SignalRoleEnum#Command>,
        <https://example.org/accelerator-core/SignalRoleEnum#MaximumLimit>,
        <https://example.org/accelerator-core/SignalRoleEnum#MinimumLimit>,
        <https://example.org/accelerator-core/SignalRoleEnum#RangeLimit>,
        <https://example.org/accelerator-core/SignalRoleEnum#Readback>,
        <https://example.org/accelerator-core/SignalRoleEnum#Setpoint>,
        <https://example.org/accelerator-core/SignalRoleEnum#Status> .

acc:RelationContextEnum a owl:Class ;
    rdfs:label "RelationContextEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/RelationContextEnum#beamline_order> <https://example.org/accelerator-core/RelationContextEnum#Euclidean_3D> <https://example.org/accelerator-core/RelationContextEnum#Euclidean_2D> <https://example.org/accelerator-core/RelationContextEnum#floorplan> <https://example.org/accelerator-core/RelationContextEnum#containment> <https://example.org/accelerator-core/RelationContextEnum#installation_mounting> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/RelationContextEnum#Euclidean_2D>,
        <https://example.org/accelerator-core/RelationContextEnum#Euclidean_3D>,
        <https://example.org/accelerator-core/RelationContextEnum#beamline_order>,
        <https://example.org/accelerator-core/RelationContextEnum#containment>,
        <https://example.org/accelerator-core/RelationContextEnum#floorplan>,
        <https://example.org/accelerator-core/RelationContextEnum#installation_mounting> .

acc:SourceSystemEnum a owl:Class ;
    rdfs:label "SourceSystemEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/SourceSystemEnum#EPICS> <https://example.org/accelerator-core/SourceSystemEnum#EPICS_ChannelAccess> <https://example.org/accelerator-core/SourceSystemEnum#PALS_Ext> <https://example.org/accelerator-core/SourceSystemEnum#MYA> <https://example.org/accelerator-core/SourceSystemEnum#ElementDatabase> <https://example.org/accelerator-core/SourceSystemEnum#ChannelDatabase> <https://example.org/accelerator-core/SourceSystemEnum#Simulation> <https://example.org/accelerator-core/SourceSystemEnum#Other> ) ;
    skos:definition "Controlled values for facility-local source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/SourceSystemEnum#ChannelDatabase>,
        <https://example.org/accelerator-core/SourceSystemEnum#EPICS>,
        <https://example.org/accelerator-core/SourceSystemEnum#EPICS_ChannelAccess>,
        <https://example.org/accelerator-core/SourceSystemEnum#ElementDatabase>,
        <https://example.org/accelerator-core/SourceSystemEnum#MYA>,
        <https://example.org/accelerator-core/SourceSystemEnum#Other>,
        <https://example.org/accelerator-core/SourceSystemEnum#PALS_Ext>,
        <https://example.org/accelerator-core/SourceSystemEnum#Simulation> .

acc:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "A human-readable description of the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:object a owl:DatatypeProperty ;
    rdfs:label "object" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:subject a owl:DatatypeProperty ;
    rdfs:label "subject" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:MultipoleParameterGroup a owl:Class ;
    rdfs:label "MultipoleParameterGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:EsL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:EsL ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:Es ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:EnL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:Kn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:EnL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:En ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:EnL ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:Bn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:Kn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:Es ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:Bn ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:Kn ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:En ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:Ks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:Bn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:En ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:Ks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty acc:order ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:tilt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:tilt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:Es ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:order ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:EsL ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:Bs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:Ks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:Bs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:Bs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:tilt ] ;
    skos:definition "A single order's electric (or magnetic) multipole component. Only the fields supporting Electric Multipoles  OR the fields for Magnetic Multipoles should be present, not both. Not a mixin, but a class used in the ElectricMultipoleP and MagneticMultipoleP mixins to represent individual multipole components." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ParamGroup a owl:Class ;
    rdfs:label "ParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:id ] ;
    skos:definition "Abstract base for inlined PALS parameter-group objects, giving each an identifier so it resolves to a stable node/IRI rather than a blank node when exported to RDF." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:QuantityKindEnum a owl:Class ;
    rdfs:label "QuantityKindEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/QuantityKindEnum#BeamPosition> <https://example.org/accelerator-core/QuantityKindEnum#State> <https://example.org/accelerator-core/QuantityKindEnum#ElectricCurrent> <https://example.org/accelerator-core/QuantityKindEnum#IntegratedMagneticField> <https://example.org/accelerator-core/QuantityKindEnum#MagneticField> <https://example.org/accelerator-core/QuantityKindEnum#Pressure> <https://example.org/accelerator-core/QuantityKindEnum#DoseRate> <https://example.org/accelerator-core/QuantityKindEnum#Voltage> <https://example.org/accelerator-core/QuantityKindEnum#Power> <https://example.org/accelerator-core/QuantityKindEnum#CavityPhase> <https://example.org/accelerator-core/QuantityKindEnum#CavityGradient> ) ;
    skos:definition "Physical quantity kinds for signals." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/QuantityKindEnum#BeamPosition>,
        <https://example.org/accelerator-core/QuantityKindEnum#CavityGradient>,
        <https://example.org/accelerator-core/QuantityKindEnum#CavityPhase>,
        <https://example.org/accelerator-core/QuantityKindEnum#DoseRate>,
        <https://example.org/accelerator-core/QuantityKindEnum#ElectricCurrent>,
        <https://example.org/accelerator-core/QuantityKindEnum#IntegratedMagneticField>,
        <https://example.org/accelerator-core/QuantityKindEnum#MagneticField>,
        <https://example.org/accelerator-core/QuantityKindEnum#Power>,
        <https://example.org/accelerator-core/QuantityKindEnum#Pressure>,
        <https://example.org/accelerator-core/QuantityKindEnum#State>,
        <https://example.org/accelerator-core/QuantityKindEnum#Voltage> .

acc:beamline_context a owl:ObjectProperty ;
    rdfs:label "beamline_context" ;
    rdfs:range acc:BeamLine ;
    skos:definition "The specific BeamLine this relationship is defined with respect to (relevant when context=beamline_order). Only an edge-property slot for edges that are defined with respect to a specific BeamLine." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:coordinates a owl:ObjectProperty ;
    rdfs:label "coordinates" ;
    rdfs:range acc:CoordinateSet ;
    skos:definition "A set of coordinates that define the spatial relationship between the two components. Only an edge-property slot for edges that require a set of coordinates to define the spatial relationship between two components in a relationship." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ComponentRelation a owl:Class ;
    rdfs:label "ComponentRelation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:component_direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:RelationContextEnum ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:Component ;
            owl:onProperty acc:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:ReferenceFrameEnum ;
            owl:onProperty acc:reference_frame ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:DirectionEnum ;
            owl:onProperty acc:component_direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:reference_frame ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:component_direction ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:reference_frame ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:Component ;
            owl:onProperty acc:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:object ],
        acc:Edge ;
    skos:definition "Association between two Components (Physical or Virtual), with supporting contextual/qualifying information about how and where the relationship holds." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:PhysicalFunctionEnum a owl:Class ;
    rdfs:label "PhysicalFunctionEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/PhysicalFunctionEnum#Focusing> <https://example.org/accelerator-core/PhysicalFunctionEnum#Steering> <https://example.org/accelerator-core/PhysicalFunctionEnum#BeamPositionMeasurement> <https://example.org/accelerator-core/PhysicalFunctionEnum#VacuumGeneration> <https://example.org/accelerator-core/PhysicalFunctionEnum#RadiationMonitoring> <https://example.org/accelerator-core/PhysicalFunctionEnum#Measurement> <https://example.org/accelerator-core/PhysicalFunctionEnum#BeamAcceleration> <https://example.org/accelerator-core/PhysicalFunctionEnum#BeamLossDetection> <https://example.org/accelerator-core/PhysicalFunctionEnum#BeamCurrentMeasurement> <https://example.org/accelerator-core/PhysicalFunctionEnum#BeamProfileMeasurement> <https://example.org/accelerator-core/PhysicalFunctionEnum#MachineProtection> <https://example.org/accelerator-core/PhysicalFunctionEnum#TimingSynchronization> ) ;
    skos:definition "Broad device-level functions." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/PhysicalFunctionEnum#BeamAcceleration>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#BeamCurrentMeasurement>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#BeamLossDetection>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#BeamPositionMeasurement>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#BeamProfileMeasurement>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#Focusing>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#MachineProtection>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#Measurement>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#RadiationMonitoring>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#Steering>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#TimingSynchronization>,
        <https://example.org/accelerator-core/PhysicalFunctionEnum#VacuumGeneration> .

acc:context a owl:ObjectProperty ;
    rdfs:label "context" ;
    rdfs:range acc:RelationContextEnum ;
    skos:definition "The frame of reference / domain in which this relationship is asserted to hold." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:string ;
    skos:closeMatch pals:id ;
    skos:definition "A unique identifier for the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:CanonicalSignalTypeEnum a owl:Class ;
    rdfs:label "CanonicalSignalTypeEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/CanonicalSignalTypeEnum#HorizontalBeamPosition> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#VerticalBeamPosition> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#HorizontalBeamPositionOffset> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#VerticalBeamPositionOffset> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#BeamIntensity> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#DeviceStatus> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#GradientSetpoint> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#GradientReadback> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#MagnetCurrentSetpoint> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#MagnetCurrentReadback> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#MagnetFieldSetpoint> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#MagnetCurrentRange> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#IntegratedFieldSetpoint> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#IntegratedFieldReadback> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#VacuumPressure> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#IonPumpCurrent> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#IonPumpVoltage> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#GammaDoseRate> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#NeutronDoseRate> <https://example.org/accelerator-core/CanonicalSignalTypeEnum#Status> ) ;
    skos:definition "Portable semantic meanings for important signals." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/CanonicalSignalTypeEnum#BeamIntensity>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#DeviceStatus>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#GammaDoseRate>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#GradientReadback>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#GradientSetpoint>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#HorizontalBeamPosition>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#HorizontalBeamPositionOffset>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#IntegratedFieldReadback>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#IntegratedFieldSetpoint>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#IonPumpCurrent>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#IonPumpVoltage>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#MagnetCurrentRange>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#MagnetCurrentReadback>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#MagnetCurrentSetpoint>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#MagnetFieldSetpoint>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#NeutronDoseRate>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#Status>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#VacuumPressure>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#VerticalBeamPosition>,
        <https://example.org/accelerator-core/CanonicalSignalTypeEnum#VerticalBeamPositionOffset> .

acc:UnitEnum a owl:Class ;
    rdfs:label "UnitEnum" ;
    owl:unionOf ( <https://example.org/accelerator-core/UnitEnum#A> <https://example.org/accelerator-core/UnitEnum#degree> <https://example.org/accelerator-core/UnitEnum#eV> <https://example.org/accelerator-core/UnitEnum#eV_per_c> <https://example.org/accelerator-core/UnitEnum#eV_per_c2> <https://example.org/accelerator-core/UnitEnum#fundamental_charge> <https://example.org/accelerator-core/UnitEnum#Gauss> <https://example.org/accelerator-core/UnitEnum#G_per_cm> <https://example.org/accelerator-core/UnitEnum#Hz> <https://example.org/accelerator-core/UnitEnum#kW> <https://example.org/accelerator-core/UnitEnum#m> <https://example.org/accelerator-core/UnitEnum#mm> <https://example.org/accelerator-core/UnitEnum#mrem_per_h> <https://example.org/accelerator-core/UnitEnum#MV_per_m> <https://example.org/accelerator-core/UnitEnum#PA> <https://example.org/accelerator-core/UnitEnum#randians_pi2> <https://example.org/accelerator-core/UnitEnum#rem_per_h> <https://example.org/accelerator-core/UnitEnum#seconds> <https://example.org/accelerator-core/UnitEnum#T> <https://example.org/accelerator-core/UnitEnum#T_M> <https://example.org/accelerator-core/UnitEnum#Torr> <https://example.org/accelerator-core/UnitEnum#V> <https://example.org/accelerator-core/UnitEnum#V_per_m> <https://example.org/accelerator-core/UnitEnum#unitless> <https://example.org/accelerator-core/UnitEnum#none> ) ;
    skos:definition "Engineering units using ASCII-safe enum names. Values map to QUDT unit IRIs with the LinkML meaning field when an exact QUDT unit is available." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/accelerator-core/UnitEnum#A>,
        <https://example.org/accelerator-core/UnitEnum#G_per_cm>,
        <https://example.org/accelerator-core/UnitEnum#Gauss>,
        <https://example.org/accelerator-core/UnitEnum#Hz>,
        <https://example.org/accelerator-core/UnitEnum#MV_per_m>,
        <https://example.org/accelerator-core/UnitEnum#PA>,
        <https://example.org/accelerator-core/UnitEnum#T>,
        <https://example.org/accelerator-core/UnitEnum#T_M>,
        <https://example.org/accelerator-core/UnitEnum#Torr>,
        <https://example.org/accelerator-core/UnitEnum#V>,
        <https://example.org/accelerator-core/UnitEnum#V_per_m>,
        <https://example.org/accelerator-core/UnitEnum#degree>,
        <https://example.org/accelerator-core/UnitEnum#eV>,
        <https://example.org/accelerator-core/UnitEnum#eV_per_c>,
        <https://example.org/accelerator-core/UnitEnum#eV_per_c2>,
        <https://example.org/accelerator-core/UnitEnum#fundamental_charge>,
        <https://example.org/accelerator-core/UnitEnum#kW>,
        <https://example.org/accelerator-core/UnitEnum#m>,
        <https://example.org/accelerator-core/UnitEnum#mm>,
        <https://example.org/accelerator-core/UnitEnum#mrem_per_h>,
        <https://example.org/accelerator-core/UnitEnum#none>,
        <https://example.org/accelerator-core/UnitEnum#randians_pi2>,
        <https://example.org/accelerator-core/UnitEnum#rem_per_h>,
        <https://example.org/accelerator-core/UnitEnum#seconds>,
        <https://example.org/accelerator-core/UnitEnum#unitless> .

acc:kind a owl:DatatypeProperty ;
    rdfs:label "kind" ;
    rdfs:range xsd:string ;
    skos:definition "The LinkML class name of this instance, e.g. `Quadrupole` or `BeamProfileMonitor` (no prefix)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:predicate a owl:DatatypeProperty ;
    rdfs:label "predicate" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/accelerator-core> .

[] a owl:Restriction ;
    rdfs:subClassOf acc:RadiationMonitor ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:RadiationMonitor .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty acc:ref_geometry ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty acc:ref_geometry ;
                owl:someValuesFrom xsd:string ] acc:BendParamGroup ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty acc:En ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty acc:EnL ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty acc:Es ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty acc:EsL ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty acc:Bs ;
                owl:someValuesFrom xsd:string ] acc:MultipoleParameterGroup ) .

[] a owl:Restriction ;
    rdfs:subClassOf acc:Solenoid ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:Solenoid .

[] a owl:Restriction ;
    rdfs:subClassOf acc:PhysicalComponent ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:PhysicalComponent .

[] a owl:Restriction ;
    rdfs:subClassOf acc:PALSAccelerator ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:PALSAccelerator .

[] a owl:Restriction ;
    rdfs:subClassOf acc:Quadrupole ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:Quadrupole .

[] a owl:Restriction ;
    rdfs:subClassOf acc:Kicker ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:Kicker .

[] rdfs:subClassOf [ owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty acc:length ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty acc:s_position ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty acc:id ;
                owl:someValuesFrom xsd:string ] acc:LongitudinalPlacementParamGroup ) .

[] a owl:Restriction ;
    rdfs:subClassOf acc:ACKicker ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:ACKicker .

[] a owl:Restriction ;
    owl:allValuesFrom xsd:string ;
    owl:onProperty acc:Ksol .

[] a owl:Restriction ;
    rdfs:subClassOf acc:NormalConductingRFCavity ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:NormalConductingRFCavity .

[] a owl:Restriction ;
    rdfs:subClassOf acc:Edge ;
    owl:onProperty acc:predicate ;
    owl:someValuesFrom acc:Edge .

[] a owl:Restriction ;
    rdfs:subClassOf acc:BeamPositionMonitor ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:BeamPositionMonitor .

[] a owl:Restriction ;
    rdfs:subClassOf acc:DiagnosticDevice ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:DiagnosticDevice .

[] a owl:Restriction ;
    rdfs:subClassOf acc:IsPartOf ;
    owl:onProperty acc:predicate ;
    owl:someValuesFrom acc:IsPartOf .

[] a owl:Restriction ;
    rdfs:subClassOf acc:BeginningEle ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:BeginningEle .

[] a owl:Restriction ;
    rdfs:subClassOf acc:Marker ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:Marker .

[] a owl:Restriction ;
    rdfs:subClassOf acc:BeamLine ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:BeamLine .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty acc:En ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty acc:EnL ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty acc:Es ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty acc:EsL ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty acc:Bn ;
                owl:someValuesFrom xsd:string ] acc:MultipoleParameterGroup ) .

[] a owl:Restriction ;
    rdfs:subClassOf acc:VirtualComponent ;
    owl:onProperty acc:kind ;
    owl:someValuesFrom acc:VirtualComponent .

[] rdfs:subClassOf [ owl:unionOf ( [ owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
