@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pals: <https://pals-project.readthedocs.io/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saref: <https://saref.etsi.org/core/v4.1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pals:BeamPositionMonitor a owl:Class ;
    rdfs:label "BeamPositionMonitor" ;
    rdfs:subClassOf pals:DiagnosticDevice,
        pals:HasBodyShiftP,
        pals:HasReferenceP,
        pals:HasTwissP ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic device used to measure transverse beam position." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BeamProfileMonitor a owl:Class ;
    rdfs:label "BeamProfileMonitor" ;
    rdfs:subClassOf pals:DiagnosticDevice,
        pals:HasBodyShiftP,
        pals:HasReferenceP,
        pals:HasTwissP ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic device used to measure transverse beam profile." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:NormalConductingRFCavity a owl:Class ;
    rdfs:label "NormalConductingRFCavity" ;
    rdfs:subClassOf pals:RFCavity ;
    skos:broadMatch pals:RFCavity ;
    skos:definition "A cavity used for RF acceleration or longitudinal manipulation, which is normal conducting." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:PALS a owl:Class ;
    rdfs:label "PALS" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:notes ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Affiliation ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:facility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:facility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" ] ) ] ) ] ;
            owl:onProperty pals:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Author ;
            owl:onProperty pals:authors ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Facility ;
            owl:onProperty pals:facility ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:authors ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:notes ] ;
    skos:definition "Root container for accelerator core components, semantic signals, and local bindings." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:RadiationMonitor a owl:Class ;
    rdfs:label "RadiationMonitor" ;
    rdfs:subClassOf pals:DiagnosticDevice,
        pals:HasBodyShiftP ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic device used to monitor radiation dose or dose rate." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:SuperConductingRFCavity a owl:Class ;
    rdfs:label "SuperConductingRFCavity" ;
    rdfs:subClassOf pals:RFCavity ;
    skos:broadMatch pals:RFCavity ;
    skos:definition "A cavity used for RF acceleration or longitudinal manipulation, which is superconducting." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:SupportingFacilityComponent a owl:Class ;
    rdfs:label "SupportingFacilityComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:FacilityFunctionEnum ;
            owl:onProperty pals:functions ],
        pals:HasBodyShiftP,
        pals:HasFloorP,
        pals:HasLongitudinalPlacementP,
        pals:PhysicalComponent ;
    skos:broadMatch pals:StructuralElement ;
    skos:definition "A physical component that supports accelerator operation  without a specific beam-pipe placement,  such as a power supply, control rack, or radiation detector. These can include Girders, Racks, Power Supplies,  and other physical infrastructure components that are important for understanding  the structure and function of the accelerator system but are not inline with the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

<https://w3id.org/accelerator-core.owl.ttl> a owl:Ontology ;
    rdfs:label "accelerator_core" ;
    dcterms:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    dcterms:title "Accelerator Core Ontology" ;
    skos:definition "A lightweight LinkML schema for facility-agnostic accelerator components, their beamline relationships, and associated control-system signals." .

pals:ACKicker a owl:Class ;
    rdfs:label "ACKicker" ;
    rdfs:subClassOf pals:Kicker ;
    skos:definition "An ACKicker element simulates a time-dependent kicker.  It is like a Kicker element except that the field varies in time.  This element requires a user supplied time-dependent expression." ;
    skos:exactMatch pals:ACKicker ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:AdditionalMetadata a owl:Class ;
    rdfs:label "AdditionalMetadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:datatype ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:DataTypeEnum ;
            owl:onProperty pals:datatype ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:datatype ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:key ] ;
    skos:definition "A single generic key/value metadata entry, used as a GraphQL-compatible replacement for an open-ended (range: Any) field. A list of these represents an arbitrary, extensible bag of program-specific metadata." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Author a owl:Class ;
    rdfs:label "Author" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" ] ) ] ) ] ;
            owl:onProperty pals:orcid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Affiliation ;
            owl:onProperty pals:affiliation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:orcid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^@]+@[^@]+\\.[^@]+$" ] ) ] ) ] ;
            owl:onProperty pals:email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:orcid ] ;
    skos:definition "Contains authorship information for a representation of an accelerator facility and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BeamLineSection a owl:Class ;
    rdfs:label "BeamLineSection" ;
    rdfs:subClassOf pals:BookkeepingComponent,
        pals:HasFloorP ;
    skos:definition "A virtual component used to represent a section of the BeamLine for organizational or functional grouping of components." ;
    skos:exactMatch pals:BeamLineSection ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Bend a owl:Class ;
    rdfs:label "Bend" ;
    rdfs:subClassOf pals:HasBendP,
        pals:Multipole ;
    skos:altLabel "Dipole" ;
    skos:definition "Dipole magnet used to bend the beam. 2 poles. The major difference between this element and other physical elements is that with a Bend  the curvilinear coordinate system is an arc with finite curvature  and for the other elements the curvilinear coordinate system is straight." ;
    skos:exactMatch pals:Bend ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BodyShiftParamGroup a owl:Class ;
    rdfs:label "BodyShiftParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:z_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:x_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:y_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:z_offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:y_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:z_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:x_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:z_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:y_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:z_offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:z_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:x_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:x_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:y_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:y_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:y_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:x_offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:x_offset ] ;
    skos:broadMatch pals:BodyShiftP ;
    skos:definition "Mixin class for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:ComponentRelation a owl:Class ;
    rdfs:label "ComponentRelation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:component_direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:RelationContextEnum ;
            owl:onProperty pals:context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:distance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:tolerance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:tolerance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:reference_frame ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:tolerance_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:BeamLine ;
            owl:onProperty pals:beamline_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Component ;
            owl:onProperty pals:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:UnitEnum ;
            owl:onProperty pals:distance_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:distance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:component_direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:ReferenceFrameEnum ;
            owl:onProperty pals:reference_frame ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:axis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:tolerance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:UnitEnum ;
            owl:onProperty pals:tolerance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:beamline_context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:axis ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:ComponentRelationPredicateEnum ;
            owl:onProperty pals:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:beamline_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Component ;
            owl:onProperty pals:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:DirectionEnum ;
            owl:onProperty pals:component_direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:AxisEnum ;
            owl:onProperty pals:axis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:reference_frame ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:tolerance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:distance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:distance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:distance_value ],
        pals:Relationship ;
    skos:definition "Association between two Components (Physical or Virtual), with supporting contextual/qualifying information about how and where the relationship holds." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:CrabCavity a owl:Class ;
    rdfs:label "CrabCavity" ;
    rdfs:subClassOf pals:Cavity ;
    skos:definition "A cavity used for transverse beam manipulation, such as crabbing or deflecting." ;
    skos:exactMatch pals:CrabCavity ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:ElectricMultipoleParamGroup a owl:Class ;
    rdfs:label "ElectricMultipoleParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:MultipoleParameterGroup ;
            owl:onProperty pals:elec_components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:elec_components ] ;
    skos:broadMatch pals:ElectricMultipoleP ;
    skos:definition """Mixin for electric multipole parameters, 
which can be used to describe the electric field components of an accelerator element.
This mixin is aligned with PALS ElectricMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS).
Example with three multipole components (N=0,1,2): ```yaml elec_components: - order: 7
  tilt: 0.7
- order: 3
  En: 27.3
- order: 2
  EnL: 3.47e1
```""" ;
    skos:exactMatch pals:ElectricMultipoleP ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Facility a owl:Class ;
    rdfs:label "Facility" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:signals ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:component_relations ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:ComponentRelation ;
            owl:onProperty pals:component_relations ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:SignalBinding ;
            owl:onProperty pals:signal_bindings ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:BeamLine ;
            owl:onProperty pals:beamlines ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:components ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Identifier ;
            owl:onProperty pals:identifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Signal ;
            owl:onProperty pals:signals ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:signal_bindings ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:beamlines ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:Component ;
            owl:onProperty pals:components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:identifiers ] ;
    skos:definition "A facility that houses one or more accelerators." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:FloorParamGroup a owl:Class ;
    rdfs:label "FloorParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:theta ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:theta ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:phi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:theta ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:psi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:phi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:psi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:psi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:phi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:x ] ;
    skos:broadMatch pals:FloorP ;
    skos:definition "Mixin class for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasBendP a owl:Class ;
    rdfs:label "HasBendP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:BendP ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:BendParamGroup ;
            owl:onProperty pals:BendP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:BendP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasRFP a owl:Class ;
    rdfs:label "HasRFP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:RFP ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:RFParamGroup ;
            owl:onProperty pals:RFP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:RFP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasSolenoidP a owl:Class ;
    rdfs:label "HasSolenoidP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:SolenoidParamGroup ;
            owl:onProperty pals:SolenoidP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:SolenoidP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:SolenoidP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:MagneticMultipoleParamGroup a owl:Class ;
    rdfs:label "MagneticMultipoleParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:mag_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:MultipoleParameterGroup ;
            owl:onProperty pals:mag_components ] ;
    skos:broadMatch pals:MagneticMultipoleP ;
    skos:definition """Mixin for magnetic multipole parameters,  which can be used to describe the magnetic field components of an accelerator element. This mixin is aligned with PALS MagneticMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS). Example with three multipole components (N=0,1,2): ```yaml mag_components: - order: 7
  tilt: 0.7
- order: 3
  Bn: 27.3
- order: 2
  BnL: 3.47e1
- order: 1
  Kn: 0.85     # normalized form, e.g. a quadrupole's k1-like strength
```""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:MetaParamGroup a owl:Class ;
    rdfs:label "MetaParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:additional_metadata ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:alias ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:AdditionalMetadata ;
            owl:onProperty pals:additional_metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:alias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:alias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:description ] ;
    skos:broadMatch pals:MetaP ;
    skos:definition "Mixin class for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Octupole a owl:Class ;
    rdfs:label "Octupole" ;
    rdfs:subClassOf pals:Multipole ;
    skos:definition """A magnet primarily used to focus or defocus the beam. 8 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:exactMatch pals:Octupole ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Quadrupole a owl:Class ;
    rdfs:label "Quadrupole" ;
    rdfs:subClassOf pals:Multipole ;
    skos:definition """A magnet primarily used to focus or defocus the beam. 4 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:exactMatch pals:Quadrupole ;
    skos:inScheme <https://w3id.org/accelerator-core> .

