narad:Beamline a owl:Class ;
    rdfs:label "Beamline" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:multipass ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty narad:periodic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty narad:multipass ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:periodic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty narad:repeat ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty narad:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:multipass ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:repeat ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:zero_point ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:periodic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:zero_point ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:zero_point ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:repeat ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:length ],
        narad:VirtualComponent ;
    skos:definition "A top-level NARAD-system for an ordered sequence of beamline elements defining a beam path." ;
    skos:exactMatch pals:BeamLine ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:BookkeepingComponent a owl:Class ;
    rdfs:label "BookkeepingComponent" ;
    rdfs:subClassOf narad:BodyShiftP,
        narad:VirtualComponent ;
    skos:broadMatch pals:BookkeepingElement ;
    skos:definition """A virtual component that represents a bookkeeping or organizational role in the accelerator system, 
such as a BeamlineSection, Marker or a Fork.
These can include BeamlineSections, Markers, Forks, 
and other virtual components that are important for understanding 
the structure and function of the accelerator system but are not physical devices.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

