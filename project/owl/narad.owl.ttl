            owl:onProperty pals:L_chord ] ;
    skos:definition """Mixin for bend parameters, which can be used to describe the bending properties of an accelerator element.
This mixin is aligned with PALS BendP for interoperability with the Particle Accelerator Language Standard (PALS).""" ;
    skos:exactMatch pals:BendP ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:CavityTypeEnum a owl:Class ;
    rdfs:label "CavityTypeEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/CavityTypeEnum#STANDING_WAVE> <https://pals-project.readthedocs.io/CavityTypeEnum#TRAVELING_WAVE> ) ;
    skos:definition "The type of cavity, which determines the field configuration and mode structure." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/CavityTypeEnum#STANDING_WAVE>,
        <https://pals-project.readthedocs.io/CavityTypeEnum#TRAVELING_WAVE> .

pals:DiagnosticDevice a owl:Class ;
    rdfs:label "DiagnosticDevice" ;
    rdfs:subClassOf pals:PhysicalComponent ;
    skos:broadMatch pals:Instrument ;
    skos:definition "An accelerator device used to measure beam or machine state." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:E_tot_ref a owl:DatatypeProperty ;
    rdfs:label "E_tot_ref" ;
    skos:altLabel "ETotal" ;
    skos:definition "[eV] Reference total energy" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasElectricMultipoleP a owl:Class ;
    rdfs:label "HasElectricMultipoleP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:ElectricMultipoleP ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:ElectricMultipoleParamGroup ;
            owl:onProperty pals:ElectricMultipoleP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:ElectricMultipoleP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasMagneticMultipoleP a owl:Class ;
    rdfs:label "HasMagneticMultipoleP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:MagneticMultipoleParamGroup ;
            owl:onProperty pals:MagneticMultipoleP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:MagneticMultipoleP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:MagneticMultipoleP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:identifier_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:IdentifierTypeEnum ;
            owl:onProperty pals:identifier_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:identifier_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:identifier_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:identifier_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:identifier_type ] ;
    skos:definition "A unique, and ideally persistent, identifier for a facility, such as a DOI or ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:L_active a owl:DatatypeProperty ;
    rdfs:label "L_active" ;
    skos:definition "Active acceleration length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:L_chord a owl:DatatypeProperty ;
    rdfs:label "L_chord" ;
    skos:definition "Chord length of the bend." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:L_rectangle a owl:DatatypeProperty ;
    rdfs:label "L_rectangle" ;
    skos:definition "Rectangular length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:L_sagitta a owl:DatatypeProperty ;
    rdfs:label "L_sagitta" ;
    skos:definition "Output parameter. Sagitta length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:LongitudinalPlacementP a owl:ObjectProperty ;
    rdfs:label "LongitudinalPlacementP" ;
    skos:definition "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Magnet a owl:Class ;
    rdfs:label "Magnet" ;
    rdfs:subClassOf pals:HasBodyShiftP,
        pals:HasReferenceP,
        pals:HasTwissP,
        pals:PhysicalComponent ;
    skos:broadMatch pals:Element ;
    skos:definition "An accelerator device that produces a magnetic field for beam control." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Marker a owl:Class ;
    rdfs:label "Mark",
        "Marker" ;
    rdfs:subClassOf pals:BookkeepingComponent,
        pals:HasTwissP,
        pals:VirtualFunctionEnum ;
    skos:definition "A virtual component representing an important location on the beamline,  such as a reference point for beam-based alignment, a location of a known aperture restriction,  or a location of a critical diagnostic device.",
        "A virtual component used as a reference point or marker in the beamline structure." ;
    skos:exactMatch pals:Marker ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:PlaneEnum a owl:Class ;
    rdfs:label "PlaneEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/PlaneEnum#Horizontal> <https://pals-project.readthedocs.io/PlaneEnum#Vertical> ) ;
    skos:definition "Controlled values for transverse plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/PlaneEnum#Horizontal>,
        <https://pals-project.readthedocs.io/PlaneEnum#Vertical> .

pals:access_protocol a owl:DatatypeProperty ;
    rdfs:label "access_protocol" ;
    skos:definition "The protocol used to access the signal in the source system,  such as EPICS Channel Access, PALS-Ext, MYA, or a simulation service." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:alpha_a a owl:DatatypeProperty ;
    rdfs:label "alpha_a" ;
    skos:altLabel "alpha_x",
        "alphax" ;
    skos:definition "Twiss alpha parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:alpha_b a owl:DatatypeProperty ;
    rdfs:label "alpha_b" ;
    skos:altLabel "alpha_y",
        "alphay" ;
    skos:definition "Twiss alpha parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:angle_ref a owl:DatatypeProperty ;
    rdfs:label "angle_ref" ;
    skos:definition "Reference bend angle." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:archive_identifier a owl:DatatypeProperty ;
    rdfs:label "archive_identifier" ;
    skos:definition "The identifier used to reference the signal in an archival system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:axis a owl:ObjectProperty ;
    rdfs:label "axis" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:beamline_context a owl:ObjectProperty ;
    rdfs:label "beamline_context" ;
    skos:definition "The specific BeamLine this relationship is defined with respect to (relevant when context=beamline_order)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:bend_field_actual a owl:DatatypeProperty ;
    rdfs:label "bend_field_actual" ;
    skos:definition "Actual bend field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:bend_field_ref a owl:DatatypeProperty ;
    rdfs:label "bend_field_ref" ;
    skos:definition "Reference bend field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:beta_a a owl:DatatypeProperty ;
    rdfs:label "beta_a" ;
    skos:altLabel "beta_x",
        "betax" ;
    skos:definition "Twiss beta parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:beta_b a owl:DatatypeProperty ;
    rdfs:label "beta_b" ;
    skos:altLabel "beta_y",
        "betay" ;
    skos:definition "Twiss beta parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:canonical_signal_type a owl:ObjectProperty ;
    rdfs:label "canonical_signal_type" ;
    skos:definition "The canonical semantic meaning of the signal." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:cavity_type a owl:ObjectProperty ;
    rdfs:label "cavity_type" ;
    skos:definition "Cavity type" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:component_direction a owl:ObjectProperty ;
    rdfs:label "component_direction" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:context a owl:ObjectProperty ;
    rdfs:label "context" ;
    skos:definition "The frame of reference / domain in which this relationship is asserted to hold." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:dE_ref a owl:DatatypeProperty ;
    rdfs:label "dE_ref" ;
    skos:definition "Reference energy gain." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:datatype a owl:ObjectProperty ;
    rdfs:label "datatype" ;
    skos:definition "Hint for the value's original type, so consumers can parse it back (e.g. float, integer, boolean) rather than treating everything as an opaque string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:direction a owl:DatatypeProperty ;
    rdfs:label "direction" ;
    skos:definition "Beam direction along the BeamLine: +1 or -1. Longitudinal orientation. Default is +1." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:distance_unit a owl:ObjectProperty ;
    rdfs:label "distance_unit" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:distance_value a owl:DatatypeProperty ;
    rdfs:label "distance_value" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:e1 a owl:DatatypeProperty ;
    rdfs:label "e1" ;
    skos:definition "Entrance end pole face rotation with respect to a sector geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:e1_rect a owl:DatatypeProperty ;
    rdfs:label "e1_rect" ;
    skos:definition "Entrance end pole face rotation with respect to a rectangular geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:e2 a owl:DatatypeProperty ;
    rdfs:label "e2" ;
    skos:definition "Exit end pole face rotation with respect to a sector geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:e2_rect a owl:DatatypeProperty ;
    rdfs:label "e2_rect" ;
    skos:definition "Exit end pole face rotation with respect to a rectangular geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:edge1_int a owl:DatatypeProperty ;
    rdfs:label "edge1_int" ;
    skos:definition "Entrance end fringe field integral." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:edge2_int a owl:DatatypeProperty ;
    rdfs:label "edge2_int" ;
    skos:definition "Exit end fringe field integral." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    skos:definition "The email address of the author." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:eta_x a owl:DatatypeProperty ;
    rdfs:label "eta_x" ;
    skos:altLabel "etax" ;
    skos:definition "Twiss dispersion parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:eta_y a owl:DatatypeProperty ;
    rdfs:label "eta_y" ;
    skos:altLabel "etay" ;
    skos:definition "Twiss dispersion parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:etap_x a owl:DatatypeProperty ;
    rdfs:label "etap_x" ;
    skos:altLabel "etapx" ;
    skos:definition "Twiss dispersion slope parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:etap_y a owl:DatatypeProperty ;
    rdfs:label "etap_y" ;
    skos:altLabel "etapy" ;
    skos:definition "Twiss dispersion slope parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:facility a owl:ObjectProperty ;
    rdfs:label "facility" ;
    skos:definition "A facility that contains lattice elements (physical and virtual), beamlines, parameter set commands, signals, etc." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    skos:definition "RF frequency." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:g_actual a owl:DatatypeProperty ;
    rdfs:label "g_actual" ;
    skos:definition "Actual bend strength = 1/radius_actual" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:g_ref a owl:DatatypeProperty ;
    rdfs:label "g_ref" ;
    skos:definition "Reference bend strength = 1/radius_ref" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:h1 a owl:DatatypeProperty ;
    rdfs:label "h1" ;
    skos:definition "Entrance end pole face curvature" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:h2 a owl:DatatypeProperty ;
    rdfs:label "h2" ;
    skos:definition "Exit end pole face curvature" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:harmon a owl:DatatypeProperty ;
    rdfs:label "harmon" ;
    skos:definition "RF harmonic number." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:identifier_type a owl:ObjectProperty ;
    rdfs:label "identifier_type" ;
    skos:definition "The type of identifier, such as DOI | PURL | ROR | LOCAL | URL | ARK." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:identifier_value a owl:DatatypeProperty ;
    rdfs:label "identifier_value" ;
    skos:definition "The value of the identifier." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:key a owl:DatatypeProperty ;
    rdfs:label "key" ;
    skos:definition "The metadata field name." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:definition "A label string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:multipass a owl:DatatypeProperty ;
    rdfs:label "multipass" ;
    skos:definition "Indicates whether the BeamLine is a multipass BeamLine, where the beam passes through the same physical elements multiple times. If not provided, the default assumption is that the BeamLine is single-pass." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:multipass_phase a owl:DatatypeProperty ;
    rdfs:label "multipass_phase" ;
    skos:definition "rad/2pi RF Phase added to multipass elements" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:native_data_type a owl:ObjectProperty ;
    rdfs:label "native_data_type" ;
    skos:definition "The native data type of the signal in the source system,  such as String, Integer, Float, or Boolean." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:native_description a owl:DatatypeProperty ;
    rdfs:label "native_description" ;
    skos:definition "A human-readable description of the signal in the source system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:native_unit a owl:ObjectProperty ;
    rdfs:label "native_unit" ;
    skos:definition "The native unit of the signal in the source system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:num_cells a owl:DatatypeProperty ;
    rdfs:label "num_cells" ;
    skos:definition "Number of cells in the cavity" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:orcid a owl:DatatypeProperty ;
    rdfs:label "orcid" ;
    skos:definition "The ORCID identifier of the author." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:order a owl:DatatypeProperty ;
    rdfs:label "order" ;
    skos:definition "Multipole order N (0 = dipole, 1 = quadrupole, etc.)" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:pc_ref a owl:DatatypeProperty ;
    rdfs:label "pc_ref" ;
    skos:altLabel "pCentral" ;
    skos:definition "[momentum*c] Reference momentum times speed of light." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:periodic a owl:DatatypeProperty ;
    rdfs:label "periodic" ;
    skos:definition "Indicates whether orbit and Twiss parameters periodic. If not provided, the default assumption is that the BeamLine is not periodic." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:phase a owl:DatatypeProperty ;
    rdfs:label "phase" ;
    skos:definition "RF phase. rad/2pi RF phase in 0 to 2*pi" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:phi a owl:DatatypeProperty ;
    rdfs:label "phi" ;
    skos:altLabel "ModelPitch",
        "Model_Pitch",
        "phi_angle" ;
    skos:definition "Rotation around the X-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:phi_a a owl:DatatypeProperty ;
    rdfs:label "phi_a" ;
    skos:altLabel "phi_x",
        "phix",
        "psi_x",
        "psix" ;
    skos:definition "Twiss phase advance parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:phi_b a owl:DatatypeProperty ;
    rdfs:label "phi_b" ;
    skos:altLabel "phi_y",
        "phiy",
        "psi_y",
        "psiy" ;
    skos:definition "Twiss phase advance parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:plane a owl:ObjectProperty ;
    rdfs:label "plane" ;
    skos:definition "The transverse plane in which the kicker operates, either horizontal or vertical." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:psi a owl:DatatypeProperty ;
    rdfs:label "psi" ;
    skos:altLabel "Model_Roll",
        "Rotation",
        "psi_angle" ;
    skos:definition "Rotation around the Z-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:quantity_kind a owl:ObjectProperty ;
    rdfs:label "quantity_kind" ;
    skos:definition "The physical quantity kind of the signal." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:reference_frame a owl:ObjectProperty ;
    rdfs:label "reference_frame" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:repeat a owl:DatatypeProperty ;
    rdfs:label "repeat" ;
    skos:definition """Repetition count. If not provided, the default assumption is that the beamline is not repeated and the value is 1.
If value is greater than 1, the beamline is repeated that many times.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:rho_ref a owl:DatatypeProperty ;
    rdfs:label "rho_ref" ;
    skos:definition "Reference bend radius." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:signal_role a owl:ObjectProperty ;
    rdfs:label "signal_role" ;
    skos:definition "The role of the signal in the control system, such as setpoint, readback, status, command, or limit." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:source_system a owl:ObjectProperty ;
    rdfs:label "source_system" ;
    skos:definition "The source system from which the signal originates, such as EPICS, PALS-Ext, MYA, an element database, a channel database, or a simulation service." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:species_ref a owl:DatatypeProperty ;
    rdfs:label "species_ref" ;
    skos:definition "A reference to a species or particle type, such as an ion, electron, or proton." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:theta a owl:DatatypeProperty ;
    rdfs:label "theta" ;
    skos:altLabel "ModelYaw",
        "Model_Yaw",
        "theta_angle" ;
    skos:definition "Orientation angle around the Y-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:tilt_ref a owl:DatatypeProperty ;
    rdfs:label "tilt_ref" ;
    skos:definition "Reference tilt of the bend." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:time_ref a owl:DatatypeProperty ;
    rdfs:label "time_ref" ;
    skos:altLabel "tRef" ;
    skos:definition "[s] Reference time" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:tolerance_unit a owl:ObjectProperty ;
    rdfs:label "tolerance_unit" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:tolerance_value a owl:DatatypeProperty ;
    rdfs:label "tolerance_value" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    skos:definition "The metadata value, serialized as a string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:definition "Version of the representation of a particle accelerator and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:voltage a owl:DatatypeProperty ;
    rdfs:label "voltage" ;
    skos:definition "RF voltage." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:x a owl:DatatypeProperty ;
    rdfs:label "x" ;
    skos:altLabel "ModelX",
        "x coordinate",
        "x_coordinate" ;
    skos:definition "Global X coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:x_offset a owl:DatatypeProperty ;
    rdfs:label "x_offset" ;
    skos:altLabel "GlobalOffsetX",
        "delta_x",
        "x_shift" ;
    skos:definition "Shift in the X direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:x_rot a owl:DatatypeProperty ;
    rdfs:label "x_rot" ;
    skos:altLabel "GlobalOffsetPhi",
        "delta_phi",
        "phi_shift" ;
    skos:definition "Rotation around the X-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:y a owl:DatatypeProperty ;
    rdfs:label "y" ;
    skos:altLabel "ModelY",
        "y coordinate",
        "y_coordinate" ;
    skos:definition "Global Y coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:y_offset a owl:DatatypeProperty ;
    rdfs:label "y_offset" ;
    skos:altLabel "GlobalOffsetY",
        "delta_y",
        "y_shift" ;
    skos:definition "Shift in the Y direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:y_rot a owl:DatatypeProperty ;
    rdfs:label "y_rot" ;
    skos:altLabel "GlobalOffsetTheta",
        "delta_theta",
        "theta_shift" ;
    skos:definition "Rotation around the Y-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:z a owl:DatatypeProperty ;
    rdfs:label "z" ;
    skos:altLabel "ModelZ",
        "z coordinate",
        "z_coordinate" ;
    skos:definition "Global Z coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:z_offset a owl:DatatypeProperty ;
    rdfs:label "z_offset" ;
    skos:altLabel "GlobalOffsetZ",
        "delta_z",
        "z_shift" ;
    skos:definition "Shift in the Z direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:z_rot a owl:DatatypeProperty ;
    rdfs:label "z_rot" ;
    skos:altLabel "GlobalOffsetPsi",
        "delta_psi",
        "psi_shift" ;
    skos:definition "Rotation around the Z-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:zero_phase a owl:ObjectProperty ;
    rdfs:label "zero_phase" ;
    skos:definition "Sets what phase = 0 means." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

xsd:boolean a owl:Class ;
    rdfs:label "Boolean" ;
    rdfs:subClassOf pals:DataTypeEnum ;
    skos:definition "boolean data type" .

sosa:ObservableProperty a owl:Class ;
    rdfs:label "Readback",
        "State" ;
    rdfs:subClassOf pals:QuantityKindEnum,
        pals:SignalRoleEnum ;
    skos:definition "Device state or condition.",
        "Measured or reported value." .

pals:BendP a owl:ObjectProperty ;
    rdfs:label "BendP" ;
    skos:definition "A mixin for bend parameters that are aligned with PALS BendP (Bend Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:BodyShiftP a owl:ObjectProperty ;
    rdfs:label "BodyShiftP" ;
    skos:definition "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:FloorP a owl:ObjectProperty ;
    rdfs:label "FloorP" ;
    skos:definition "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasFloorP a owl:Class ;
    rdfs:label "HasFloorP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:FloorP ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:FloorParamGroup ;
            owl:onProperty pals:FloorP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:FloorP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasReferenceP a owl:Class ;
    rdfs:label "HasReferenceP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:ReferenceP ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:ReferenceParamGroup ;
            owl:onProperty pals:ReferenceP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:ReferenceP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:MagneticMultipoleP a owl:ObjectProperty ;
    rdfs:label "MagneticMultipoleP" ;
    skos:definition "A mixin for magnetic multipole parameters that are aligned with PALS MagneticMultipoleP (Magnetic Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:MetaP a owl:ObjectProperty ;
    rdfs:label "MetaP" ;
    skos:definition "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:RFP a owl:ObjectProperty ;
    rdfs:label "RFP" ;
    skos:definition "A mixin for RF parameters that are aligned with PALS RFP (RF Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:ReferenceP a owl:ObjectProperty ;
    rdfs:label "ReferenceP" ;
    skos:definition "A mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:SolenoidP a owl:ObjectProperty ;
    rdfs:label "SolenoidP" ;
    skos:definition "A mixin for solenoid-specific parameters that are aligned with PALS SolenoidP (Solenoid Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:TwissP a owl:ObjectProperty ;
    rdfs:label "TwissP" ;
    skos:definition "A mixin for Twiss parameters that are aligned with PALS TwissP (Twiss Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:VirtualRelationEnum a owl:Class ;
    rdfs:label "VirtualRelationEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/VirtualRelationEnum#Inline> <https://pals-project.readthedocs.io/VirtualRelationEnum#AssociatedWithBeamLine> <https://pals-project.readthedocs.io/VirtualRelationEnum#NotAssociatedWithBeamLine> ) ;
    skos:definition "Controlled values for virtual relation to the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/VirtualRelationEnum#AssociatedWithBeamLine>,
        <https://pals-project.readthedocs.io/VirtualRelationEnum#Inline>,
        <https://pals-project.readthedocs.io/VirtualRelationEnum#NotAssociatedWithBeamLine> .

pals:ZeroPhaseEnum a owl:Class ;
    rdfs:label "ZeroPhaseEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/ZeroPhaseEnum#ACCELERATING> <https://pals-project.readthedocs.io/ZeroPhaseEnum#BELOW_TRANSITION> <https://pals-project.readthedocs.io/ZeroPhaseEnum#ABOVE_TRANSITION> ) ;
    skos:definition "The zero phase reference for the cavity, which determines the phase of the RF field at the entrance of the cavity." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/ZeroPhaseEnum#ABOVE_TRANSITION>,
        <https://pals-project.readthedocs.io/ZeroPhaseEnum#ACCELERATING>,
        <https://pals-project.readthedocs.io/ZeroPhaseEnum#BELOW_TRANSITION> .

pals:identifiers a owl:ObjectProperty ;
    rdfs:label "identifiers" ;
    rdfs:range pals:Identifier ;
    skos:definition "A unique and ideally persistent identifier for the facility, such as a DOI or ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:s_position a owl:DatatypeProperty ;
    rdfs:label "s_position" ;
    skos:definition "Longitudinal position of the element along the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:tilt a owl:DatatypeProperty ;
    rdfs:label "tilt" ;
    skos:broadMatch pals:tilt ;
    skos:definition "Tilt of the Nth multipole." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:AxisEnum a owl:Class ;
    rdfs:label "AxisEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/AxisEnum#x> <https://pals-project.readthedocs.io/AxisEnum#y> <https://pals-project.readthedocs.io/AxisEnum#z> <https://pals-project.readthedocs.io/AxisEnum#s> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/AxisEnum#s>,
        <https://pals-project.readthedocs.io/AxisEnum#x>,
        <https://pals-project.readthedocs.io/AxisEnum#y>,
        <https://pals-project.readthedocs.io/AxisEnum#z> .

pals:BeamLine a owl:Class ;
    rdfs:label "BeamLine",
        "BeamLineSection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:repeat ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:periodic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty pals:periodic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:multipass ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pals:repeat ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:periodic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:multipass ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty pals:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:repeat ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty pals:multipass ],
        pals:VirtualComponent,
        pals:VirtualFunctionEnum ;
    skos:definition "A section of the BeamLine used for organizational or functional grouping of components, such as a linac section, transfer line, or ring sector.",
        "PALS element for an ordered sequence of beamline elements defining a beam path." ;
    skos:exactMatch pals:BeamLine ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Component a owl:Class ;
    rdfs:label "Component" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:native_types ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty pals:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:native_types ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:id ],
        pals:HasMetaP ;
    skos:broadMatch pals:Element ;
    skos:definition "A general class for accelerator components, which can be specialized into more specific types like AcceleratorDevice, Magnet, etc." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:DirectionEnum a owl:Class ;
    rdfs:label "DirectionEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/DirectionEnum#upstream> <https://pals-project.readthedocs.io/DirectionEnum#downstream> <https://pals-project.readthedocs.io/DirectionEnum#positive> <https://pals-project.readthedocs.io/DirectionEnum#negative> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/DirectionEnum#downstream>,
        <https://pals-project.readthedocs.io/DirectionEnum#negative>,
        <https://pals-project.readthedocs.io/DirectionEnum#positive>,
        <https://pals-project.readthedocs.io/DirectionEnum#upstream> .

pals:ElectricMultipoleP a owl:ObjectProperty ;
    rdfs:label "ElectricMultipoleP" ;
    skos:definition "A mixin for electric multipole parameters that are aligned with PALS ElectricMultipoleP (Electric Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:HasTwissP a owl:Class ;
    rdfs:label "HasTwissP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:TwissP ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:TwissParamGroup ;
            owl:onProperty pals:TwissP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:TwissP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Multipole a owl:Class ;
    rdfs:label "Multipole" ;
    rdfs:subClassOf pals:HasElectricMultipoleP,
        pals:HasMagneticMultipoleP,
        pals:Magnet ;
    skos:broadMatch pals:Multipole ;
    skos:definition """A general magnet with a higher-order multipole field, such as a sextupole or octupole.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:PhysicalComponent a owl:Class ;
    rdfs:label "PhysicalComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:functions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:beamline_relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:PhysicalFunctionEnum ;
            owl:onProperty pals:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:PhysicalRelationEnum ;
            owl:onProperty pals:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty pals:beamline_relation ],
        pals:Component,
        pals:HasFloorP,
        pals:HasLongitudinalPlacementP ;
    skos:broadMatch pals:Element ;
    skos:definition "A physical item that participates in or supports accelerator operation.  This can be used to capture physical components, such as magnets, cavities, diagnostics, vacuum devices, and racks that are important for understanding the structure and function of the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:PhysicalRelationEnum a owl:Class ;
    rdfs:label "PhysicalRelationEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/PhysicalRelationEnum#Inline> <https://pals-project.readthedocs.io/PhysicalRelationEnum#AttachedToPipe> <https://pals-project.readthedocs.io/PhysicalRelationEnum#NearBeamLine> <https://pals-project.readthedocs.io/PhysicalRelationEnum#SupportingFacility> ) ;
    skos:definition "Controlled values for physical relation to the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/PhysicalRelationEnum#AttachedToPipe>,
        <https://pals-project.readthedocs.io/PhysicalRelationEnum#Inline>,
        <https://pals-project.readthedocs.io/PhysicalRelationEnum#NearBeamLine>,
        <https://pals-project.readthedocs.io/PhysicalRelationEnum#SupportingFacility> .

pals:RFCavity a owl:Class ;
    rdfs:label "RFCavity" ;
    rdfs:subClassOf pals:Cavity,
        pals:HasRFP ;
    skos:definition "A cavity used for RF acceleration or longitudinal manipulation." ;
    skos:exactMatch pals:RFCavity ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:ReferenceFrameEnum a owl:Class ;
    rdfs:label "ReferenceFrameEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/ReferenceFrameEnum#beam_direction> <https://pals-project.readthedocs.io/ReferenceFrameEnum#facility_coordinates> <https://pals-project.readthedocs.io/ReferenceFrameEnum#local_component_frame> <https://pals-project.readthedocs.io/ReferenceFrameEnum#tunnel_stationing> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/ReferenceFrameEnum#beam_direction>,
        <https://pals-project.readthedocs.io/ReferenceFrameEnum#facility_coordinates>,
        <https://pals-project.readthedocs.io/ReferenceFrameEnum#local_component_frame>,
        <https://pals-project.readthedocs.io/ReferenceFrameEnum#tunnel_stationing> .

pals:ReferenceGeometryEnum a owl:Class ;
    rdfs:label "ReferenceGeometryEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/ReferenceGeometryEnum#arc> <https://pals-project.readthedocs.io/ReferenceGeometryEnum#chord> <https://pals-project.readthedocs.io/ReferenceGeometryEnum#entrance_coords> <https://pals-project.readthedocs.io/ReferenceGeometryEnum#exit_coords> ) ;
    skos:definition "The reference geometry used to calculate multipoles.  Sets the geometry used to calculate multipoles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/ReferenceGeometryEnum#arc>,
        <https://pals-project.readthedocs.io/ReferenceGeometryEnum#chord>,
        <https://pals-project.readthedocs.io/ReferenceGeometryEnum#entrance_coords>,
        <https://pals-project.readthedocs.io/ReferenceGeometryEnum#exit_coords> .

pals:VirtualFunctionEnum a owl:Class ;
    rdfs:label "VirtualFunctionEnum" ;
    owl:unionOf ( pals:BeamLine pals:Marker pals:Fork <https://pals-project.readthedocs.io/VirtualFunctionEnum#Control> ) ;
    skos:definition "Broad virtual component functions or roles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values pals:BeamLine,
        pals:Fork,
        pals:Marker,
        <https://pals-project.readthedocs.io/VirtualFunctionEnum#Control> .

pals:multipole_geometry a owl:ObjectProperty ;
    rdfs:label "multipole_geometry" ;
    skos:definition "Multipole geometry type. Must be `follows_ref_geometry`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:ref_geometry a owl:ObjectProperty ;
    rdfs:label "ref_geometry" ;
    skos:definition "Reference geometry type. Must be `arc`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Bsol a owl:DatatypeProperty ;
    rdfs:label "Bsol" ;
    skos:definition "Solenoid field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:DataTypeEnum a owl:Class ;
    rdfs:label "DataTypeEnum" ;
    owl:unionOf ( xsd:string xsd:integer xsd:float xsd:boolean ) ;
    skos:definition "Data types for parameter values." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values xsd:boolean,
        xsd:float,
        xsd:integer,
        xsd:string .

pals:Ksol a owl:DatatypeProperty ;
    rdfs:label "Ksol" ;
    skos:definition "Normalized solenoid strength." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:SignalRoleEnum a owl:Class ;
    rdfs:label "SignalRoleEnum" ;
    owl:unionOf ( sosa:ActuatableProperty sosa:ObservableProperty <https://pals-project.readthedocs.io/SignalRoleEnum#Status> sosa:ActuatableProperty xsd:minInclusive xsd:maxInclusive ) ;
    skos:definition "Roles for control-system signals." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values xsd:maxInclusive,
        xsd:minInclusive,
        sosa:ActuatableProperty,
        sosa:ObservableProperty,
        <https://pals-project.readthedocs.io/SignalRoleEnum#Status> .

pals:affiliation a owl:ObjectProperty ;
    rdfs:label "affiliation" ;
    rdfs:range pals:Affiliation ;
    skos:definition "The affiliation of the author or component, as a ROR." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    rdfs:range xsd:string ;
    skos:definition "An alternative name or identifier for the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:beamline_relation a owl:ObjectProperty ;
    rdfs:label "beamline_relation" ;
    skos:definition "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems.",
        "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:functions a owl:ObjectProperty ;
    rdfs:label "functions" ;
    skos:definition "The function of the physical component,  which can be used to identify the component across different source systems.",
        "The function of the supporting facility component,  which can be used to identify the component across different source systems.",
        "The function of the virtual component,  which can be used to identify the component across different source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "The name of the entity. For example, the name of the person or organization." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

xsd:integer a owl:Class ;
    rdfs:label "Integer" ;
    rdfs:subClassOf pals:DataTypeEnum ;
    skos:definition "integer data type" .

pals:HasBodyShiftP a owl:Class ;
    rdfs:label "HasBodyShiftP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom pals:BodyShiftParamGroup ;
            owl:onProperty pals:BodyShiftP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:BodyShiftP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:BodyShiftP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:IdentifierTypeEnum a owl:Class ;
    rdfs:label "IdentifierTypeEnum" ;
    owl:unionOf ( <http://purl.org/spar/datacite/doi> <http://purl.org/spar/datacite/purl> <http://purl.org/spar/datacite/ror> <http://purl.org/spar/datacite/local-resource-identifier-scheme> <http://purl.org/spar/datacite/url> <http://purl.org/spar/datacite/ark> ) ;
    skos:definition "Controlled values for identifier types." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <http://purl.org/spar/datacite/ark>,
        <http://purl.org/spar/datacite/doi>,
        <http://purl.org/spar/datacite/local-resource-identifier-scheme>,
        <http://purl.org/spar/datacite/purl>,
        <http://purl.org/spar/datacite/ror>,
        <http://purl.org/spar/datacite/url> .

pals:MultipoleGeometryEnum a owl:Class ;
    rdfs:label "MultipoleGeometryEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/MultipoleGeometryEnum#follows_ref_geometry> <https://pals-project.readthedocs.io/MultipoleGeometryEnum#vertically_pure> <https://pals-project.readthedocs.io/MultipoleGeometryEnum#horizontally_pure> <https://pals-project.readthedocs.io/MultipoleGeometryEnum#chord> <https://pals-project.readthedocs.io/MultipoleGeometryEnum#entrance_coords> <https://pals-project.readthedocs.io/MultipoleGeometryEnum#exit_coords> ) ;
    skos:definition "The geometric configuration of the multipole field.  Sets the geometry used to calculate multipoles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/MultipoleGeometryEnum#chord>,
        <https://pals-project.readthedocs.io/MultipoleGeometryEnum#entrance_coords>,
        <https://pals-project.readthedocs.io/MultipoleGeometryEnum#exit_coords>,
        <https://pals-project.readthedocs.io/MultipoleGeometryEnum#follows_ref_geometry>,
        <https://pals-project.readthedocs.io/MultipoleGeometryEnum#horizontally_pure>,
        <https://pals-project.readthedocs.io/MultipoleGeometryEnum#vertically_pure> .

pals:RelationContextEnum a owl:Class ;
    rdfs:label "RelationContextEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/RelationContextEnum#beamline_order> <https://pals-project.readthedocs.io/RelationContextEnum#Euclidean_3D> <https://pals-project.readthedocs.io/RelationContextEnum#Euclidean_2D> <https://pals-project.readthedocs.io/RelationContextEnum#floorplan> <https://pals-project.readthedocs.io/RelationContextEnum#containment> <https://pals-project.readthedocs.io/RelationContextEnum#installation_mounting> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/RelationContextEnum#Euclidean_2D>,
        <https://pals-project.readthedocs.io/RelationContextEnum#Euclidean_3D>,
        <https://pals-project.readthedocs.io/RelationContextEnum#beamline_order>,
        <https://pals-project.readthedocs.io/RelationContextEnum#containment>,
        <https://pals-project.readthedocs.io/RelationContextEnum#floorplan>,
        <https://pals-project.readthedocs.io/RelationContextEnum#installation_mounting> .

pals:SignalBindingPredicateEnum a owl:Class ;
    rdfs:label "SignalBindingPredicateEnum" ;
    owl:unionOf ( <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_signal> <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_status_signal> <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_setpoint_signal> <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_readback_signal> <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_command_signal> <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_limit_signal> ) ;
    skos:definition "Controlled predicates for Component-to-Signal bindings." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_command_signal>,
        <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_limit_signal>,
        <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_readback_signal>,
        <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_setpoint_signal>,
        <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_signal>,
        <https://pals-project.readthedocs.io/SignalBindingPredicateEnum#has_status_signal> .

pals:length a owl:DatatypeProperty ;
    rdfs:label "length" ;
    rdfs:range xsd:float ;
    skos:definition "Length of the element (arc length for bends)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Bn a owl:DatatypeProperty ;
    rdfs:label "Bn" ;
    skos:broadMatch pals:BnN ;
    skos:definition "Normal component of the magnetic field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Bs a owl:DatatypeProperty ;
    rdfs:label "Bs" ;
    skos:broadMatch pals:BsN ;
    skos:definition "Skew component of the magnetic field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:En a owl:DatatypeProperty ;
    rdfs:label "En" ;
    skos:broadMatch pals:EnN ;
    skos:definition "Normal component of the field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:EnL a owl:DatatypeProperty ;
    rdfs:label "EnL" ;
    skos:broadMatch pals:EnNL ;
    skos:definition "Length-integrated normal component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Es a owl:DatatypeProperty ;
    rdfs:label "Es" ;
    skos:broadMatch pals:EsN ;
    skos:definition "Skew component of the field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:EsL a owl:DatatypeProperty ;
    rdfs:label "EsL" ;
    skos:broadMatch pals:EsNL ;
    skos:definition "Length-integrated skew component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:FacilityFunctionEnum a owl:Class ;
    rdfs:label "FacilityFunctionEnum" ;
