    rdfs:label "has_limit_signal" ;
    rdfs:subClassOf narad:SignalBindingPredicateEnum ;
    skos:definition "Subject has the given signal as a limit/constraint value." .

<https://example.org/narad/SignalBindingPredicateEnum#has_readback_signal> a owl:Class ;
    rdfs:label "has_readback_signal" ;
    rdfs:subClassOf narad:SignalBindingPredicateEnum ;
