pals:Kicker a owl:Class ;
    rdfs:label "Kicker" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:plane ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:plane ],
        [ a owl:Restriction ;
            owl:allValuesFrom pals:PlaneEnum ;
            owl:onProperty pals:plane ],
        pals:HasElectricMultipoleP,
        pals:HasMagneticMultipoleP,
        pals:Magnet ;
    skos:altLabel "Corrector",
        "HCorrector",
        "HDiagKicker",
        "VCorrector",
        "VDiagKicker" ;
    skos:broadMatch pals:Kicker ;
    skos:definition """A magnet primarily used to steer the beam.
Can deflect the beam transversely in both planes, or a single plane, depending on the design and parameters of the kicker. 
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:LongitudinalPlacementParamGroup a owl:Class ;
    rdfs:label "LongitudinalPlacementParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:s_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:s_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty pals:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty pals:s_position ] ;
    skos:definition """Mixin for an element's extent and position along the longitudinal (beam-direction, "s") axis. 
Corresponds to PALS's ungrouped element parameters `length` and `s_position`.
One (or both) `length` or `s_position` must be present.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

