<https://example.org/accelerator-core/UnitEnum#V_per_m> a owl:Class ;
    rdfs:label "V_per_m" ;
    rdfs:subClassOf acc:UnitEnum ;
    skos:definition "volt per meter" ;
    skos:exactMatch qudt:V-PER-M .

<https://example.org/accelerator-core/UnitEnum#degree> a owl:Class ;
    rdfs:label "degree" ;
    rdfs:subClassOf acc:UnitEnum ;
    skos:definition "degree" ;
    skos:exactMatch qudt:DEG .

