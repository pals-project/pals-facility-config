narad:Relationship a owl:Class ;
    rdfs:label "Relationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:object ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:id ] ;
    skos:definition "Abstract base for subject-predicate-object associations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Signal a owl:Class ;
    rdfs:label "Signal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:quantity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SourceSystemEnum ;
            owl:onProperty narad:source_system ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:native_data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:archive_identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:QuantityKindEnum ;
            owl:onProperty narad:quantity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:canonical_signal_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:UnitEnum ;
            owl:onProperty narad:native_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:native_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:access_protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:native_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:signal_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:source_system ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:source_system ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:canonical_signal_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:quantity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:archive_identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:native_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:CanonicalSignalTypeEnum ;
            owl:onProperty narad:canonical_signal_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:signal_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:native_data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:access_protocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:DataTypeEnum ;
            owl:onProperty narad:native_data_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:archive_identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:access_protocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:native_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SignalRoleEnum ;
            owl:onProperty narad:signal_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:native_unit ],
        narad:MetaP ;
    skos:broadMatch sosa:Actuator,
        sosa:Sensor ;
    skos:definition "Semantic meaning of a control-system signal associated with a component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

<https://example.org/narad/SignalBindingPredicateEnum#has_command_signal> a owl:Class ;
