@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix acc: <https://example.org/accelerator-core/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pals: <https://pals-project.readthedocs.io/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saref: <https://saref.etsi.org/core/v4.1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/accelerator-core.owl.ttl> a owl:Ontology ;
    rdfs:label "accelerator_core" ;
    dcterms:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    dcterms:title "Accelerator Core Ontology" ;
    skos:definition "A lightweight LinkML schema for facility-agnostic accelerator components, their beamline relationships, and associated control-system signals." .

acc:AdditionalMetadata a owl:Class ;
    rdfs:label "AdditionalMetadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:key ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:DataTypeEnum ;
            owl:onProperty acc:datatype ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:datatype ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:key ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:datatype ] ;
    skos:definition "A single generic key/value metadata entry, used as a GraphQL-compatible replacement for an open-ended (range: Any) field. A list of these represents an arbitrary, extensible bag of program-specific metadata." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Author a owl:Class ;
    rdfs:label "Author" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:orcid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" ] ) ] ) ] ;
            owl:onProperty acc:orcid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:orcid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:Affiliation ;
            owl:onProperty acc:affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[^@]+@[^@]+\\.[^@]+$" ] ) ] ) ] ;
            owl:onProperty acc:email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:affiliation ] ;
    skos:definition "Contains authorship information for a representation of an accelerator facility and its operations." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BodyShiftParamGroup a owl:Class ;
    rdfs:label "BodyShiftParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:y_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:x_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:y_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:z_offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:x_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:z_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:x_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:z_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:y_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:y_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:x_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:x_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:z_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:y_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:y_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:z_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:z_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:x_rot ],
        acc:ParamGroup ;
    skos:broadMatch pals:BodyShiftP ;
    skos:definition "Mixin class for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ElectricMultipoleParamGroup a owl:Class ;
    rdfs:label "ElectricMultipoleParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:elec_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:MultipoleParameterGroup ;
            owl:onProperty acc:elec_components ],
        acc:ParamGroup ;
    skos:broadMatch pals:ElectricMultipoleP ;
    skos:definition """Mixin for electric multipole parameters,  which can be used to describe the electric field components of an accelerator element. This mixin is aligned with PALS ElectricMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS). Example with three multipole components (N=0,1,2): ```yaml elec_components: - order: 7
  tilt: 0.7
- order: 3
  En: 27.3
- order: 2
  EnL: 3.47e1
```""" ;
    skos:exactMatch pals:ElectricMultipoleP ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Facility a owl:Class ;
    rdfs:label "Facility" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:Component ;
            owl:onProperty acc:components ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:BeamLine ;
            owl:onProperty acc:beamlines ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Za-z][A-Za-z0-9+.\\-]*:[^\\s<>\"{}|\\\\^`]*[/#:]$" ] ) ] ) ] ;
            owl:onProperty acc:id_namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:ComponentRelation ;
            owl:onProperty acc:component_relations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:id_namespace ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:signals ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:Signal ;
            owl:onProperty acc:signals ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:SignalBinding ;
            owl:onProperty acc:signal_bindings ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:beamlines ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:identifiers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:id_namespace ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:Identifier ;
            owl:onProperty acc:identifiers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:component_relations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:signal_bindings ] ;
    skos:definition "A facility that houses one or more accelerators." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:FloorParamGroup a owl:Class ;
    rdfs:label "FloorParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:phi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:psi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:phi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:theta ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:theta ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:phi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:x ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:psi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:theta ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:psi ],
        acc:ParamGroup ;
    skos:broadMatch pals:FloorP ;
    skos:definition "Mixin class for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasBendP a owl:Class ;
    rdfs:label "HasBendP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:BendParamGroup ;
            owl:onProperty acc:BendP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:BendP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:BendP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasRFP a owl:Class ;
    rdfs:label "HasRFP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:RFP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:RFP ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:RFParamGroup ;
            owl:onProperty acc:RFP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:HasSolenoidP a owl:Class ;
    rdfs:label "HasSolenoidP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:SolenoidParamGroup ;
            owl:onProperty acc:SolenoidP ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:SolenoidP ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:SolenoidP ] ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:MagneticMultipoleParamGroup a owl:Class ;
    rdfs:label "MagneticMultipoleParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:mag_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:MultipoleParameterGroup ;
            owl:onProperty acc:mag_components ],
        acc:ParamGroup ;
    skos:broadMatch pals:MagneticMultipoleP ;
    skos:definition """Mixin for magnetic multipole parameters,  which can be used to describe the magnetic field components of an accelerator element. This mixin is aligned with PALS MagneticMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS). Example with three multipole components (N=0,1,2): ```yaml mag_components: - order: 7
  tilt: 0.7
- order: 3
  Bn: 27.3
- order: 2
  BnL: 3.47e1
- order: 1
  Kn: 0.85     # normalized form, e.g. a quadrupole's k1-like strength
```""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:MetaParamGroup a owl:Class ;
    rdfs:label "MetaParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:additional_metadata ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:AdditionalMetadata ;
            owl:onProperty acc:additional_metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:alias ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:alias ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:description ],
        acc:ParamGroup ;
    skos:broadMatch pals:MetaP ;
    skos:definition "Mixin class for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:RFParamGroup a owl:Class ;
    rdfs:label "RFParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom acc:ZeroPhaseEnum ;
            owl:onProperty acc:zero_phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:frequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:voltage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:cavity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty acc:harmon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:L_active ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:L_active ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:num_cells ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:zero_phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty acc:num_cells ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:num_cells ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:dE_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:CavityTypeEnum ;
            owl:onProperty acc:cavity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:multipass_phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:voltage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:dE_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:cavity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:zero_phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:frequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:harmon ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:harmon ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:L_active ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:multipass_phase ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:dE_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:voltage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:multipass_phase ],
        acc:ParamGroup ;
    skos:broadMatch pals:RFP ;
    skos:definition "Mixin for RF parameters, which can be used to describe the RF properties of an accelerator element. This mixin is aligned with PALS RFP for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ReferenceParamGroup a owl:Class ;
    rdfs:label "ReferenceParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:E_tot_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty acc:species_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:pc_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:pc_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:species_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:species_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:E_tot_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:E_tot_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:pc_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:time_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:time_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:time_ref ],
        acc:ParamGroup ;
    skos:broadMatch pals:ReferenceP ;
    skos:definition "Mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:TwissParamGroup a owl:Class ;
    rdfs:label "TwissParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beta_a ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:eta_x ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:etap_y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:eta_x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:alpha_a ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:alpha_a ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:eta_y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:alpha_b ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beta_b ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:phi_b ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:eta_y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:etap_x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:alpha_b ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:etap_y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:beta_b ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:etap_x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:beta_a ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:phi_a ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:beta_a ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:alpha_b ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:alpha_a ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:phi_a ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:phi_b ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:phi_a ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:phi_b ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:eta_y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:beta_b ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:etap_y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:etap_x ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:eta_x ],
        acc:ParamGroup ;
    skos:broadMatch pals:TwissP ;
    skos:definition "Mixin for Twiss parameters, which can be used to describe the beam optics of an accelerator element." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:ACKicker a owl:Class ;
    rdfs:label "ACKicker" ;
    rdfs:subClassOf acc:Kicker ;
    skos:definition "An ACKicker element simulates a time-dependent kicker.  It is like a Kicker element except that the field varies in time.  This element requires a user supplied time-dependent expression." ;
    skos:exactMatch pals:ACKicker ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:AdjacentTo a owl:Class ;
    rdfs:label "AdjacentTo" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:distance_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:distance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:tolerance_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:CoordinateSet ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:tolerance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:distance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:coordinates ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "AdjacentTo" ] ) ] ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:tolerance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:distance_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:UnitEnum ;
            owl:onProperty acc:tolerance_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:distance_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:tolerance_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:tolerance_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:UnitEnum ;
            owl:onProperty acc:distance_unit ],
        acc:ComponentRelation ;
    skos:definition """A relationship indicating that the subject component is adjacent to the object component and not overlapping
 in a specified context, such as radiation detector and a magnet.""" ;
    skos:exactMatch RO:0002220 ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:adjacent_to" .

acc:Aperture a owl:Class ;
    rdfs:label "Aperture" ;
    rdfs:subClassOf acc:DiagnosticDevice,
        acc:HasReferenceP,
        acc:HasTwissP ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic or limiting aperture element used to constrain or characterize beam passage." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BeamLineSection a owl:Class ;
    rdfs:label "BeamLineSection" ;
    rdfs:subClassOf acc:BookkeepingComponent,
        acc:HasFloorP ;
    skos:definition "A virtual component used to represent a section of the BeamLine for organizational or functional grouping of components." ;
    skos:exactMatch pals:BeamLineSection ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BeamPositionMonitor a owl:Class ;
    rdfs:label "BeamPositionMonitor" ;
    rdfs:subClassOf acc:DiagnosticDevice,
        acc:HasBodyShiftP,
        acc:HasReferenceP,
        acc:HasTwissP ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic device used to measure transverse beam position." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BeamProfileMonitor a owl:Class ;
    rdfs:label "BeamProfileMonitor" ;
    rdfs:subClassOf acc:DiagnosticDevice,
        acc:HasBodyShiftP,
        acc:HasReferenceP,
        acc:HasTwissP ;
    skos:altLabel "profile monitor",
        "viewer" ;
    skos:broadMatch pals:Instrument ;
    skos:definition "A diagnostic device used to measure transverse beam profile." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:BeginningEle a owl:Class ;
    rdfs:label "BeginningEle" ;
    rdfs:subClassOf acc:BookkeepingComponent,
        acc:HasReferenceP,
        acc:HasTwissP ;
    skos:definition "Initial element at the start of a beamline branch. It holds the initial reference and Twiss parameters for the branch. A BeginningEle may be omitted when the branch is reached through a Fork that propagates its reference parameters; otherwise it is expected to be the first element in the branch." ;
    skos:exactMatch pals:BeginningEle ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Bend a owl:Class ;
    rdfs:label "Bend" ;
    rdfs:subClassOf acc:HasBendP,
        acc:Multipole ;
    skos:altLabel "Dipole" ;
    skos:definition "Dipole magnet used to bend the beam. 2 poles. The major difference between this element and other physical elements is that with a Bend  the curvilinear coordinate system is an arc with finite curvature  and for the other elements the curvilinear coordinate system is straight." ;
    skos:exactMatch pals:Bend ;
    skos:inScheme <https://w3id.org/accelerator-core> .

