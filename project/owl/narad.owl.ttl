narad:MetaP a owl:Class ;
    rdfs:label "MetaP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:alias ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:additional_metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:alias ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:label ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:MetadataEntry ;
            owl:onProperty narad:additional_metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:alias ] ;
    skos:broadMatch pals:MetaP ;
    skos:definition "Mixin class for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

