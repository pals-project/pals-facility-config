<https://example.org/narad/SignalBindingPredicateEnum#has_signal> a owl:Class ;
    rdfs:label "has_signal" ;
    rdfs:subClassOf narad:SignalBindingPredicateEnum ;
    skos:definition "Generic association between a component and one of its signals. The specific role (setpoint, readback, status, etc.) is carried by the Signal's own signal_role field, not the predicate." .

<https://example.org/narad/SignalBindingPredicateEnum#has_status_signal> a owl:Class ;
