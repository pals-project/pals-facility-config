<https://example.org/narad/UnitEnum#none> a owl:Class ;
    rdfs:label "none" ;
    rdfs:subClassOf narad:UnitEnum ;
    skos:definition "no unit or not applicable" .

<https://example.org/narad/VirtualFunctionEnum#Control> a owl:Class ;
    rdfs:label "Control" ;
    rdfs:subClassOf narad:VirtualFunctionEnum ;
    skos:definition "A virtual component representing a control system function or role that is important for understanding the overall accelerator system  but doesn't have a direct relationship to the beamline structure,  such as the EPICS control system that manages device process variables across the accelerator." .

<https://example.org/narad/VirtualRelationEnum#AssociatedWithBeamline> a owl:Class ;
    rdfs:label "AssociatedWithBeamline" ;
    rdfs:subClassOf narad:VirtualRelationEnum ;
    skos:definition "Not inline with the beamline but still operationally associated with it.  Used for virtual components that are important for understanding the beamline structure and function but don't have a direct physical relationship to the beam path,  such as BeamlineSections or Markers that are not inline with the beam." .

<https://example.org/narad/VirtualRelationEnum#Inline> a owl:Class ;
    rdfs:label "Inline" ;
    rdfs:subClassOf narad:VirtualRelationEnum ;
    skos:definition "Beam passes through the virtual component. Used for virtual components like Markers that represent important locations on the beamline but don't have a physical instantiation." .

<https://example.org/narad/VirtualRelationEnum#NotAssociatedWithBeamline> a owl:Class ;
    rdfs:label "NotAssociatedWithBeamline" ;
    rdfs:subClassOf narad:VirtualRelationEnum ;
    skos:definition "Not inline with the beamline and not operationally associated with it.  Used for virtual components that are more abstract and don't have a specific relationship  to the beamline, such as a virtual component representing a control system function  or role that is important for understanding the overall accelerator system but doesn't have a direct relationship to the beamline structure." .

narad:additional_metadata a owl:ObjectProperty ;
    rdfs:label "additional_metadata" ;
    skos:definition "Additional metadata or annotations for the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:beamlines a owl:ObjectProperty ;
    rdfs:label "beamlines" ;
    skos:definition "A list of beamlines in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:component_relations a owl:ObjectProperty ;
    rdfs:label "component_relations" ;
    skos:definition "A list of component relations in the accelerator system (Component <-> Component relationships)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:intersects a owl:Class ;
    rdfs:label "intersects" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject intersects with object." .

narad:mounted_on a owl:Class ;
    rdfs:label "mounted_on" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject is mounted on object." .

narad:native_types a owl:DatatypeProperty ;
    rdfs:label "native_types" ;
    skos:definition "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:nearest_to a owl:Class ;
    rdfs:label "nearest_to" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject is nearest to object." .

narad:physical_components a owl:ObjectProperty ;
    rdfs:label "physical_components" ;
    skos:definition "A list of physical components in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:signal_bindings a owl:ObjectProperty ;
    rdfs:label "signal_bindings" ;
    skos:definition "A list of signal bindings in the accelerator system (Component <-> Signal relationships)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:signals a owl:ObjectProperty ;
    rdfs:label "signals" ;
    skos:definition "A list of signals in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:supporting_facility_components a owl:ObjectProperty ;
    rdfs:label "supporting_facility_components" ;
    skos:definition "A list of supporting facility components in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:virtual_components a owl:ObjectProperty ;
    rdfs:label "virtual_components" ;
    skos:definition "A list of virtual components in the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Beamline a owl:Class ;
    rdfs:label "BeamlineSection" ;
    rdfs:subClassOf narad:VirtualFunctionEnum ;
    skos:definition "A section of the beamline used for organizational or functional grouping of components, such as a linac section, transfer line, or ring sector." .

pals:Fork a owl:Class ;
    rdfs:label "Fork" ;
    rdfs:subClassOf narad:VirtualFunctionEnum ;
    skos:definition "A virtual component representing a branching point in the beamline,  such as a beamline fork or switchyard." .

saref:controls a owl:Class ;
    rdfs:label "controls" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject controls the state or behavior of object." .

saref:isControlledBy a owl:Class ;
    rdfs:label "is_controlled_by" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject is controlled by object." .

BFO:0000050 a owl:Class ;
    rdfs:label "contained_in",
        "is_part_of" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject is a part of object.",
        "Subject is spatially or mereologically contained in object." .

BFO:0000051 a owl:Class ;
    rdfs:label "contains",
        "has_part" ;
    rdfs:subClassOf narad:ComponentRelationPredicateEnum ;
    skos:definition "Subject has part object.",
        "Subject spatially or mereologically contains object." .

sosa:ActuatableProperty a owl:Class ;
    rdfs:label "Command",
        "Setpoint" ;
    rdfs:subClassOf narad:SignalRoleEnum ;
    skos:definition "Command or action trigger.",
        "Requested or configured value." .

narad:E_tot_ref a owl:DatatypeProperty ;
    rdfs:label "E_tot_ref" ;
    skos:altLabel "ETotal" ;
    skos:definition "[eV] Reference total energy" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:ElectricMultipoleP a owl:Class ;
    rdfs:label "ElectricMultipoleP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:components ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:MultipoleComponent ;
            owl:onProperty narad:components ] ;
    skos:broadMatch pals:ElectricMultipoleP ;
    skos:definition """Mixin for electric multipole parameters, 
which can be used to describe the electric field components of an accelerator element.
This mixin is aligned with PALS ElectricMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS).
Example with three multipole components (N=0,1,2): ```yaml components: - order: 7
  tilt: 0.7
- order: 3
  En: 27.3
- order: 2
  EnL: 3.47e1
```""" ;
    skos:exactMatch pals:ElectricMultipoleP ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:FloorP a owl:Class ;
    rdfs:label "FloorP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:theta ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:phi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:x ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:z ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:phi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:psi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:z ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:psi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:theta ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:z ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:psi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:phi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:theta ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:y ] ;
    skos:broadMatch pals:FloorP ;
    skos:definition "Mixin class for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:HasLongitudinalPlacement a owl:Class ;
    rdfs:label "HasLongitudinalPlacement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:s_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:s_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:s_position ] ;
    skos:definition """Mixin for an element's extent and position along the longitudinal (beam-direction, "s") axis. 
Corresponds to PALS's ungrouped element parameters `length` and `s_position`.
One (or both) `length` or `s_position` must be present.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:L_chord a owl:DatatypeProperty ;
    rdfs:label "L_chord" ;
    skos:definition "Chord length of the bend." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:L_rectangle a owl:DatatypeProperty ;
    rdfs:label "L_rectangle" ;
    skos:definition "Rectangular length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:L_sagitta a owl:DatatypeProperty ;
    rdfs:label "L_sagitta" ;
    skos:definition "Output parameter. Sagitta length." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Magnet a owl:Class ;
    rdfs:label "Magnet" ;
    rdfs:subClassOf narad:BodyShiftP,
        narad:PhysicalComponent,
        narad:ReferenceP,
        narad:TwissP ;
    skos:broadMatch pals:Element ;
    skos:definition "An accelerator device that produces a magnetic field for beam control." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:MagneticMultipoleP a owl:Class ;
    rdfs:label "MagneticMultipoleP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom narad:MultipoleComponent ;
            owl:onProperty narad:components ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:components ] ;
    skos:broadMatch pals:MagneticMultipoleP ;
    skos:definition """Mixin for magnetic multipole parameters, 
which can be used to describe the magnetic field components of an accelerator element.
This mixin is aligned with PALS MagneticMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS).
Example with three multipole components (N=0,1,2): ```yaml components: - order: 7
  tilt: 0.7
- order: 3
  Bn: 27.3
- order: 2
  BnL: 3.47e1
- order: 1
  Kn: 0.85     # normalized form, e.g. a quadrupole's k1-like strength
```""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:PlaneEnum a owl:Class ;
    rdfs:label "PlaneEnum" ;
    owl:unionOf ( <https://example.org/narad/PlaneEnum#Horizontal> <https://example.org/narad/PlaneEnum#Vertical> ) ;
    skos:definition "Controlled values for transverse plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/PlaneEnum#Horizontal>,
        <https://example.org/narad/PlaneEnum#Vertical> .

narad:ReferenceP a owl:Class ;
    rdfs:label "ReferenceP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:pc_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:pc_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:pc_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:time_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:time_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:E_tot_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:species_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:time_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:species_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:E_tot_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:E_tot_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:species_ref ] ;
    skos:broadMatch pals:ReferenceP ;
    skos:definition "Mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:VirtualComponent a owl:Class ;
    rdfs:label "VirtualComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom narad:VirtualFunctionEnum ;
            owl:onProperty narad:functions ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:beamline_relation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:beamline_relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:VirtualRelationEnum ;
            owl:onProperty narad:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:functions ],
        narad:Component,
        narad:FloorP ;
    skos:broadMatch pals:BookkeepingElement,
        pals:Element ;
    skos:definition "A virtual or logical component that represents a concept, function, or role in the accelerator  beamline operation but does not have a physical instantiation.  This can be used to capture abstract components, such as Markers, BeamlineSections, and FacilitySpaces that are important for understanding the structure and function of the accelerator system but are not physical devices." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:access_protocol a owl:DatatypeProperty ;
    rdfs:label "access_protocol" ;
    skos:definition "The protocol used to access the signal in the source system,  such as EPICS Channel Access, PALS-Ext, MYA, or a simulation service." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:alias a owl:DatatypeProperty ;
    rdfs:label "alias" ;
    skos:definition "An alternative name or identifier for the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:alpha_a a owl:DatatypeProperty ;
    rdfs:label "alpha_a" ;
    skos:altLabel "alpha_x",
        "alphax" ;
    skos:definition "Twiss alpha parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:alpha_b a owl:DatatypeProperty ;
    rdfs:label "alpha_b" ;
    skos:altLabel "alpha_y",
        "alphay" ;
    skos:definition "Twiss alpha parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:angle_ref a owl:DatatypeProperty ;
    rdfs:label "angle_ref" ;
    skos:definition "Reference bend angle." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:archive_identifier a owl:DatatypeProperty ;
    rdfs:label "archive_identifier" ;
    skos:definition "The identifier used to reference the signal in an archival system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:axis a owl:ObjectProperty ;
    rdfs:label "axis" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:beamline_context a owl:ObjectProperty ;
    rdfs:label "beamline_context" ;
    skos:definition "The specific Beamline this relationship is defined with respect to (relevant when context=beamline_order)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:bend_field_actual a owl:DatatypeProperty ;
    rdfs:label "bend_field_actual" ;
    skos:definition "Actual bend field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:bend_field_ref a owl:DatatypeProperty ;
    rdfs:label "bend_field_ref" ;
    skos:definition "Reference bend field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:beta_a a owl:DatatypeProperty ;
    rdfs:label "beta_a" ;
    skos:altLabel "beta_x",
        "betax" ;
    skos:definition "Twiss beta parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:beta_b a owl:DatatypeProperty ;
    rdfs:label "beta_b" ;
    skos:altLabel "beta_y",
        "betay" ;
    skos:definition "Twiss beta parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:canonical_signal_type a owl:ObjectProperty ;
    rdfs:label "canonical_signal_type" ;
    skos:definition "The canonical semantic meaning of the signal." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:context a owl:ObjectProperty ;
    rdfs:label "context" ;
    skos:definition "The frame of reference / domain in which this relationship is asserted to hold." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:datatype a owl:ObjectProperty ;
    rdfs:label "datatype" ;
    skos:definition "Hint for the value's original type, so consumers can parse it back (e.g. float, integer, boolean) rather than treating everything as an opaque string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:distance_unit a owl:ObjectProperty ;
    rdfs:label "distance_unit" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:distance_value a owl:DatatypeProperty ;
    rdfs:label "distance_value" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:e1 a owl:DatatypeProperty ;
    rdfs:label "e1" ;
    skos:definition "Entrance end pole face rotation with respect to a sector geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:e1_rect a owl:DatatypeProperty ;
    rdfs:label "e1_rect" ;
    skos:definition "Entrance end pole face rotation with respect to a rectangular geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:e2 a owl:DatatypeProperty ;
    rdfs:label "e2" ;
    skos:definition "Exit end pole face rotation with respect to a sector geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:e2_rect a owl:DatatypeProperty ;
    rdfs:label "e2_rect" ;
    skos:definition "Exit end pole face rotation with respect to a rectangular geometry." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:edge1_int a owl:DatatypeProperty ;
    rdfs:label "edge1_int" ;
    skos:definition "Entrance end fringe field integral." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:edge2_int a owl:DatatypeProperty ;
    rdfs:label "edge2_int" ;
    skos:definition "Exit end fringe field integral." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:eta_x a owl:DatatypeProperty ;
    rdfs:label "eta_x" ;
    skos:altLabel "etax" ;
    skos:definition "Twiss dispersion parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:eta_y a owl:DatatypeProperty ;
    rdfs:label "eta_y" ;
    skos:altLabel "etay" ;
    skos:definition "Twiss dispersion parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:etap_x a owl:DatatypeProperty ;
    rdfs:label "etap_x" ;
    skos:altLabel "etapx" ;
    skos:definition "Twiss dispersion slope parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:etap_y a owl:DatatypeProperty ;
    rdfs:label "etap_y" ;
    skos:altLabel "etapy" ;
    skos:definition "Twiss dispersion slope parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:g_actual a owl:DatatypeProperty ;
    rdfs:label "g_actual" ;
    skos:definition "Actual bend strength = 1/radius_actual" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:g_ref a owl:DatatypeProperty ;
    rdfs:label "g_ref" ;
    skos:definition "Reference bend strength = 1/radius_ref" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:h1 a owl:DatatypeProperty ;
    rdfs:label "h1" ;
    skos:definition "Entrance end pole face curvature" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:h2 a owl:DatatypeProperty ;
    rdfs:label "h2" ;
    skos:definition "Exit end pole face curvature" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:key a owl:DatatypeProperty ;
    rdfs:label "key" ;
    skos:definition "The metadata field name." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:label a owl:DatatypeProperty ;
    rdfs:label "label" ;
    skos:definition "A label string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:multipass a owl:DatatypeProperty ;
    rdfs:label "multipass" ;
    skos:definition """Indicates whether the beamline is a multipass beamline, where the beam passes through the same physical elements multiple times.
If not provided, the default assumption is that the beamline is single-pass.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:multipole_geometry a owl:ObjectProperty ;
    rdfs:label "multipole_geometry" ;
    skos:definition "Multipole geometry type. Must be `follows_ref_geometry`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:native_data_type a owl:ObjectProperty ;
    rdfs:label "native_data_type" ;
    skos:definition "The native data type of the signal in the source system,  such as String, Integer, Float, or Boolean." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:native_description a owl:DatatypeProperty ;
    rdfs:label "native_description" ;
    skos:definition "A human-readable description of the signal in the source system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:native_unit a owl:ObjectProperty ;
    rdfs:label "native_unit" ;
    skos:definition "The native unit of the signal in the source system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:order a owl:DatatypeProperty ;
    rdfs:label "order" ;
    skos:definition "Multipole order N (0 = dipole, 1 = quadrupole, etc.)" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:pc_ref a owl:DatatypeProperty ;
    rdfs:label "pc_ref" ;
    skos:altLabel "pCentral" ;
    skos:definition "[momentum*c] Reference momentum times speed of light." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:periodic a owl:DatatypeProperty ;
    rdfs:label "periodic" ;
    skos:definition """Indicates whether orbit and Twiss parameters periodic.
If not provided, the default assumption is that the beamline is not periodic.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:phi a owl:DatatypeProperty ;
    rdfs:label "phi" ;
    skos:altLabel "ModelPitch",
        "Model_Pitch",
        "phi_angle" ;
    skos:definition "Rotation around the X-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:phi_a a owl:DatatypeProperty ;
    rdfs:label "phi_a" ;
    skos:altLabel "phi_x",
        "phix",
        "psi_x",
        "psix" ;
    skos:definition "Twiss phase advance parameter in the horizontal plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:phi_b a owl:DatatypeProperty ;
    rdfs:label "phi_b" ;
    skos:altLabel "phi_y",
        "phiy",
        "psi_y",
        "psiy" ;
    skos:definition "Twiss phase advance parameter in the vertical plane." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:plane a owl:ObjectProperty ;
    rdfs:label "plane" ;
    skos:definition "The transverse plane in which the kicker operates, either horizontal or vertical." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:psi a owl:DatatypeProperty ;
    rdfs:label "psi" ;
    skos:altLabel "Model_Roll",
        "Rotation",
        "psi_angle" ;
    skos:definition "Rotation around the Z-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:quantity_kind a owl:ObjectProperty ;
    rdfs:label "quantity_kind" ;
    skos:definition "The physical quantity kind of the signal." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:ref_geometry a owl:ObjectProperty ;
    rdfs:label "ref_geometry" ;
    skos:definition "Reference geometry type. Must be `arc`." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:reference_frame a owl:ObjectProperty ;
    rdfs:label "reference_frame" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:repeat a owl:DatatypeProperty ;
    rdfs:label "repeat" ;
    skos:definition """Repetition count. If not provided, the default assumption is that the beamline is not repeated and the value is 1.
If value is greater than 1, the beamline is repeated that many times.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:rho_ref a owl:DatatypeProperty ;
    rdfs:label "rho_ref" ;
    skos:definition "Reference bend radius." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:signal_role a owl:ObjectProperty ;
    rdfs:label "signal_role" ;
    skos:definition "The role of the signal in the control system, such as setpoint, readback, status, command, or limit." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:source_system a owl:ObjectProperty ;
    rdfs:label "source_system" ;
    skos:definition "The source system from which the signal originates, such as EPICS, PALS-Ext, MYA, an element database, a channel database, or a simulation service." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:species_ref a owl:DatatypeProperty ;
    rdfs:label "species_ref" ;
    skos:definition "A reference to a species or particle type, such as an ion, electron, or proton." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:theta a owl:DatatypeProperty ;
    rdfs:label "theta" ;
    skos:altLabel "ModelYaw",
        "Model_Yaw",
        "theta_angle" ;
    skos:definition "Orientation angle around the Y-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:tilt a owl:DatatypeProperty ;
    rdfs:label "tilt" ;
    skos:broadMatch pals:tilt ;
    skos:definition "Tilt of the Nth multipole." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:tilt_ref a owl:DatatypeProperty ;
    rdfs:label "tilt_ref" ;
    skos:definition "Reference tilt of the bend." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:time_ref a owl:DatatypeProperty ;
    rdfs:label "time_ref" ;
    skos:altLabel "tRef" ;
    skos:definition "[s] Reference time" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:tolerance_unit a owl:ObjectProperty ;
    rdfs:label "tolerance_unit" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:tolerance_value a owl:DatatypeProperty ;
    rdfs:label "tolerance_value" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    skos:definition "The metadata value, serialized as a string." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:x a owl:DatatypeProperty ;
    rdfs:label "x" ;
    skos:altLabel "ModelX",
        "x coordinate",
        "x_coordinate" ;
    skos:definition "Global X coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:x_offset a owl:DatatypeProperty ;
    rdfs:label "x_offset" ;
    skos:altLabel "GlobalOffsetX",
        "delta_x",
        "x_shift" ;
    skos:definition "Shift in the X direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:x_rot a owl:DatatypeProperty ;
    rdfs:label "x_rot" ;
    skos:altLabel "GlobalOffsetPhi",
        "delta_phi",
        "phi_shift" ;
    skos:definition "Rotation around the X-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:y a owl:DatatypeProperty ;
    rdfs:label "y" ;
    skos:altLabel "ModelY",
        "y coordinate",
        "y_coordinate" ;
    skos:definition "Global Y coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:y_offset a owl:DatatypeProperty ;
    rdfs:label "y_offset" ;
    skos:altLabel "GlobalOffsetY",
        "delta_y",
        "y_shift" ;
    skos:definition "Shift in the Y direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:y_rot a owl:DatatypeProperty ;
    rdfs:label "y_rot" ;
    skos:altLabel "GlobalOffsetTheta",
        "delta_theta",
        "theta_shift" ;
    skos:definition "Rotation around the Y-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:z a owl:DatatypeProperty ;
    rdfs:label "z" ;
    skos:altLabel "ModelZ",
        "z coordinate",
        "z_coordinate" ;
    skos:definition "Global Z coordinate in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:z_offset a owl:DatatypeProperty ;
    rdfs:label "z_offset" ;
    skos:altLabel "GlobalOffsetZ",
        "delta_z",
        "z_shift" ;
    skos:definition "Shift in the Z direction in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:z_rot a owl:DatatypeProperty ;
    rdfs:label "z_rot" ;
    skos:altLabel "GlobalOffsetPsi",
        "delta_psi",
        "psi_shift" ;
    skos:definition "Rotation around the Z-axis in the facility floor plan." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:zero_point a owl:DatatypeProperty ;
    rdfs:label "zero_point" ;
    skos:definition "Name of a line item used as a reference point when the BeamLine is used as a subline." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

pals:Marker a owl:Class ;
    rdfs:label "Mark" ;
    rdfs:subClassOf narad:VirtualFunctionEnum ;
    skos:definition "A virtual component representing an important location on the beamline,  such as a reference point for beam-based alignment, a location of a known aperture restriction,  or a location of a critical diagnostic device." .

xsd:boolean a owl:Class ;
    rdfs:label "Boolean" ;
    rdfs:subClassOf narad:DataTypeEnum ;
    skos:definition "boolean data type" .

sosa:ObservableProperty a owl:Class ;
    rdfs:label "Readback",
        "State" ;
    rdfs:subClassOf narad:QuantityKindEnum,
        narad:SignalRoleEnum ;
    skos:definition "Device state or condition.",
        "Measured or reported value." .

narad:Component a owl:Class ;
    rdfs:label "Component" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:native_types ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:native_types ],
        narad:MetaP ;
    skos:broadMatch pals:Element ;
    skos:definition "A general class for accelerator components, which can be specialized into more specific types like AcceleratorDevice, Magnet, etc." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:TwissP a owl:Class ;
    rdfs:label "TwissP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:beta_b ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:alpha_a ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:phi_b ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:eta_x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:phi_b ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:beta_b ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:eta_y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:beta_a ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:alpha_b ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:eta_x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:phi_a ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:etap_x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:eta_y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:phi_b ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:eta_y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:etap_y ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:beta_b ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:beta_a ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:alpha_a ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:phi_a ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:phi_a ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:etap_y ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:etap_y ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:eta_x ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:etap_x ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:etap_x ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:alpha_b ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:alpha_b ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:alpha_a ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:beta_a ] ;
    skos:broadMatch pals:TwissP ;
    skos:definition "Mixin for Twiss parameters, which can be used to describe the beam optics of an accelerator element." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:VirtualRelationEnum a owl:Class ;
    rdfs:label "VirtualRelationEnum" ;
    owl:unionOf ( <https://example.org/narad/VirtualRelationEnum#Inline> <https://example.org/narad/VirtualRelationEnum#AssociatedWithBeamline> <https://example.org/narad/VirtualRelationEnum#NotAssociatedWithBeamline> ) ;
    skos:definition "Controlled values for virtual relation to the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/VirtualRelationEnum#AssociatedWithBeamline>,
        <https://example.org/narad/VirtualRelationEnum#Inline>,
        <https://example.org/narad/VirtualRelationEnum#NotAssociatedWithBeamline> .

narad:components a owl:ObjectProperty .

narad:s_position a owl:DatatypeProperty ;
    rdfs:label "s_position" ;
    skos:definition "Longitudinal position of the element along the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

xsd:integer a owl:Class ;
    rdfs:label "Integer" ;
    rdfs:subClassOf narad:DataTypeEnum ;
    skos:definition "integer data type" .

narad:AxisEnum a owl:Class ;
    rdfs:label "AxisEnum" ;
    owl:unionOf ( <https://example.org/narad/AxisEnum#x> <https://example.org/narad/AxisEnum#y> <https://example.org/narad/AxisEnum#z> <https://example.org/narad/AxisEnum#s> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/AxisEnum#s>,
        <https://example.org/narad/AxisEnum#x>,
        <https://example.org/narad/AxisEnum#y>,
        <https://example.org/narad/AxisEnum#z> .

narad:DirectionEnum a owl:Class ;
    rdfs:label "DirectionEnum" ;
    owl:unionOf ( <https://example.org/narad/DirectionEnum#upstream> <https://example.org/narad/DirectionEnum#downstream> <https://example.org/narad/DirectionEnum#positive> <https://example.org/narad/DirectionEnum#negative> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/DirectionEnum#downstream>,
        <https://example.org/narad/DirectionEnum#negative>,
        <https://example.org/narad/DirectionEnum#positive>,
        <https://example.org/narad/DirectionEnum#upstream> .

narad:Multipole a owl:Class ;
    rdfs:label "Multipole" ;
    rdfs:subClassOf narad:ElectricMultipoleP,
        narad:Magnet,
        narad:MagneticMultipoleP ;
    skos:broadMatch pals:Multipole ;
    skos:definition """A general magnet with a higher-order multipole field, such as a sextupole or octupole.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:PhysicalRelationEnum a owl:Class ;
    rdfs:label "PhysicalRelationEnum" ;
    owl:unionOf ( <https://example.org/narad/PhysicalRelationEnum#Inline> <https://example.org/narad/PhysicalRelationEnum#AttachedToPipe> <https://example.org/narad/PhysicalRelationEnum#NearBeamline> <https://example.org/narad/PhysicalRelationEnum#SupportingFacility> ) ;
    skos:definition "Controlled values for physical relation to the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/PhysicalRelationEnum#AttachedToPipe>,
        <https://example.org/narad/PhysicalRelationEnum#Inline>,
        <https://example.org/narad/PhysicalRelationEnum#NearBeamline>,
        <https://example.org/narad/PhysicalRelationEnum#SupportingFacility> .

narad:ReferenceFrameEnum a owl:Class ;
    rdfs:label "ReferenceFrameEnum" ;
    owl:unionOf ( <https://example.org/narad/ReferenceFrameEnum#beam_direction> <https://example.org/narad/ReferenceFrameEnum#facility_coordinates> <https://example.org/narad/ReferenceFrameEnum#local_component_frame> <https://example.org/narad/ReferenceFrameEnum#tunnel_stationing> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/ReferenceFrameEnum#beam_direction>,
        <https://example.org/narad/ReferenceFrameEnum#facility_coordinates>,
        <https://example.org/narad/ReferenceFrameEnum#local_component_frame>,
        <https://example.org/narad/ReferenceFrameEnum#tunnel_stationing> .

narad:ReferenceGeometryEnum a owl:Class ;
    rdfs:label "ReferenceGeometryEnum" ;
    owl:unionOf ( <https://example.org/narad/ReferenceGeometryEnum#arc> <https://example.org/narad/ReferenceGeometryEnum#chord> <https://example.org/narad/ReferenceGeometryEnum#entrance_coords> <https://example.org/narad/ReferenceGeometryEnum#exit_coords> ) ;
    skos:definition "The reference geometry used to calculate multipoles.  Sets the geometry used to calculate multipoles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/ReferenceGeometryEnum#arc>,
        <https://example.org/narad/ReferenceGeometryEnum#chord>,
        <https://example.org/narad/ReferenceGeometryEnum#entrance_coords>,
        <https://example.org/narad/ReferenceGeometryEnum#exit_coords> .

narad:SignalRoleEnum a owl:Class ;
    rdfs:label "SignalRoleEnum" ;
    owl:unionOf ( sosa:ActuatableProperty sosa:ObservableProperty <https://example.org/narad/SignalRoleEnum#Status> sosa:ActuatableProperty <https://example.org/narad/SignalRoleEnum#Limit> ) ;
    skos:definition "Roles for control-system signals." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values sosa:ActuatableProperty,
        sosa:ObservableProperty,
        <https://example.org/narad/SignalRoleEnum#Limit>,
        <https://example.org/narad/SignalRoleEnum#Status> .

narad:VirtualFunctionEnum a owl:Class ;
    rdfs:label "VirtualFunctionEnum" ;
    owl:unionOf ( pals:Beamline pals:Marker pals:Fork <https://example.org/narad/VirtualFunctionEnum#Control> ) ;
    skos:definition "Broad virtual component functions or roles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/VirtualFunctionEnum#Control>,
        pals:Beamline,
        pals:Fork,
        pals:Marker .

narad:BodyShiftP a owl:Class ;
    rdfs:label "BodyShiftP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:z_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:y_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:y_offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:y_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:y_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:z_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:z_offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:z_offset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:x_offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:x_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:x_rot ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:x_offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:x_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:x_offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:z_rot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:y_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:z_rot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:y_rot ] ;
    skos:broadMatch pals:BodyShiftP ;
    skos:definition "Mixin class for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Bsol a owl:DatatypeProperty ;
    rdfs:label "Bsol" ;
    skos:definition "Solenoid field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:DataTypeEnum a owl:Class ;
    rdfs:label "DataTypeEnum" ;
    owl:unionOf ( xsd:string xsd:integer xsd:float xsd:boolean ) ;
    skos:definition "Data types for parameter values." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values xsd:boolean,
        xsd:float,
        xsd:integer,
        xsd:string .

narad:Ksol a owl:DatatypeProperty ;
    rdfs:label "Ksol" ;
    skos:definition "Normalized solenoid strength." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:PhysicalComponent a owl:Class ;
    rdfs:label "PhysicalComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:beamline_relation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:PhysicalRelationEnum ;
            owl:onProperty narad:beamline_relation ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:PhysicalFunctionEnum ;
            owl:onProperty narad:functions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:beamline_relation ],
        narad:Component,
        narad:FloorP,
        narad:HasLongitudinalPlacement ;
    skos:broadMatch pals:Element ;
    skos:definition "A physical item that participates in or supports accelerator operation.  This can be used to capture physical components, such as magnets, cavities, diagnostics, vacuum devices, and racks that are important for understanding the structure and function of the accelerator system." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:beamline_relation a owl:ObjectProperty ;
    rdfs:label "beamline_relation" ;
    skos:definition "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems.",
        "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:definition "Human-readable description for the representation of a particle accelerator and its operations.",
        "Human-readable description." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:direction a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "direction" ;
    skos:definition """Beam direction along the beamline: +1 or -1. 
Longitudinal orientation. Default is +1.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:functions a owl:ObjectProperty ;
    rdfs:label "functions" ;
    skos:definition "The function of the physical component,  which can be used to identify the component across different source systems.",
        "The function of the supporting facility component,  which can be used to identify the component across different source systems.",
        "The function of the virtual component,  which can be used to identify the component across different source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:MultipoleGeometryEnum a owl:Class ;
    rdfs:label "MultipoleGeometryEnum" ;
    owl:unionOf ( <https://example.org/narad/MultipoleGeometryEnum#follows_ref_geometry> <https://example.org/narad/MultipoleGeometryEnum#vertically_pure> <https://example.org/narad/MultipoleGeometryEnum#horizontally_pure> <https://example.org/narad/MultipoleGeometryEnum#chord> <https://example.org/narad/MultipoleGeometryEnum#entrance_coords> <https://example.org/narad/MultipoleGeometryEnum#exit_coords> ) ;
    skos:definition "The geometric configuration of the multipole field.  Sets the geometry used to calculate multipoles." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/MultipoleGeometryEnum#chord>,
        <https://example.org/narad/MultipoleGeometryEnum#entrance_coords>,
        <https://example.org/narad/MultipoleGeometryEnum#exit_coords>,
        <https://example.org/narad/MultipoleGeometryEnum#follows_ref_geometry>,
        <https://example.org/narad/MultipoleGeometryEnum#horizontally_pure>,
        <https://example.org/narad/MultipoleGeometryEnum#vertically_pure> .

narad:RelationContextEnum a owl:Class ;
    rdfs:label "RelationContextEnum" ;
    owl:unionOf ( <https://example.org/narad/RelationContextEnum#beamline_order> <https://example.org/narad/RelationContextEnum#Euclidean_3D> <https://example.org/narad/RelationContextEnum#Euclidean_2D> <https://example.org/narad/RelationContextEnum#floorplan> <https://example.org/narad/RelationContextEnum#containment> <https://example.org/narad/RelationContextEnum#installation_mounting> ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/RelationContextEnum#Euclidean_2D>,
        <https://example.org/narad/RelationContextEnum#Euclidean_3D>,
        <https://example.org/narad/RelationContextEnum#beamline_order>,
        <https://example.org/narad/RelationContextEnum#containment>,
        <https://example.org/narad/RelationContextEnum#floorplan>,
        <https://example.org/narad/RelationContextEnum#installation_mounting> .

narad:SignalBindingPredicateEnum a owl:Class ;
    rdfs:label "SignalBindingPredicateEnum" ;
    owl:unionOf ( <https://example.org/narad/SignalBindingPredicateEnum#has_signal> <https://example.org/narad/SignalBindingPredicateEnum#has_status_signal> <https://example.org/narad/SignalBindingPredicateEnum#has_setpoint_signal> <https://example.org/narad/SignalBindingPredicateEnum#has_readback_signal> <https://example.org/narad/SignalBindingPredicateEnum#has_command_signal> <https://example.org/narad/SignalBindingPredicateEnum#has_limit_signal> ) ;
    skos:definition "Controlled predicates for Component-to-Signal bindings." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/SignalBindingPredicateEnum#has_command_signal>,
        <https://example.org/narad/SignalBindingPredicateEnum#has_limit_signal>,
        <https://example.org/narad/SignalBindingPredicateEnum#has_readback_signal>,
        <https://example.org/narad/SignalBindingPredicateEnum#has_setpoint_signal>,
        <https://example.org/narad/SignalBindingPredicateEnum#has_signal>,
        <https://example.org/narad/SignalBindingPredicateEnum#has_status_signal> .

narad:length a owl:DatatypeProperty ;
    rdfs:label "length" ;
    skos:definition "Length of the element (arc length for bends).",
        """The total length of the beamline.
For pals interoperability, use m as the unit of length.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Bn a owl:DatatypeProperty ;
    rdfs:label "Bn" ;
    skos:broadMatch pals:BnN ;
    skos:definition "Normal component of the magnetic field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Bs a owl:DatatypeProperty ;
    rdfs:label "Bs" ;
    skos:broadMatch pals:BsN ;
    skos:definition "Skew component of the magnetic field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:En a owl:DatatypeProperty ;
    rdfs:label "En" ;
    skos:broadMatch pals:EnN ;
    skos:definition "Normal component of the field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:EnL a owl:DatatypeProperty ;
    rdfs:label "EnL" ;
    skos:broadMatch pals:EnNL ;
    skos:definition "Length-integrated normal component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Es a owl:DatatypeProperty ;
    rdfs:label "Es" ;
    skos:broadMatch pals:EsN ;
    skos:definition "Skew component of the field." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:EsL a owl:DatatypeProperty ;
    rdfs:label "EsL" ;
    skos:broadMatch pals:EsNL ;
    skos:definition "Length-integrated skew component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:FacilityFunctionEnum a owl:Class ;
    rdfs:label "FacilityFunctionEnum" ;
    owl:unionOf ( <https://example.org/narad/FacilityFunctionEnum#Support> <https://example.org/narad/FacilityFunctionEnum#Alignment> <https://example.org/narad/FacilityFunctionEnum#PowerSupply> <https://example.org/narad/FacilityFunctionEnum#ControlRack> <https://example.org/narad/FacilityFunctionEnum#Cooling> <https://example.org/narad/FacilityFunctionEnum#Diagnostics> <https://example.org/narad/FacilityFunctionEnum#Detection> ) ;
    skos:definition "Broad structural or support functions." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/FacilityFunctionEnum#Alignment>,
        <https://example.org/narad/FacilityFunctionEnum#ControlRack>,
        <https://example.org/narad/FacilityFunctionEnum#Cooling>,
        <https://example.org/narad/FacilityFunctionEnum#Detection>,
        <https://example.org/narad/FacilityFunctionEnum#Diagnostics>,
        <https://example.org/narad/FacilityFunctionEnum#PowerSupply>,
        <https://example.org/narad/FacilityFunctionEnum#Support> .

narad:Kn a owl:DatatypeProperty ;
    rdfs:label "Kn" ;
    skos:broadMatch pals:KnN ;
    skos:definition "Normalized normal component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:Ks a owl:DatatypeProperty ;
    rdfs:label "Ks" ;
    skos:broadMatch pals:KsN ;
    skos:definition "Normalized skew component." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:SourceSystemEnum a owl:Class ;
    rdfs:label "SourceSystemEnum" ;
    owl:unionOf ( <https://example.org/narad/SourceSystemEnum#EPICS> <https://example.org/narad/SourceSystemEnum#EPICS_ChannelAccess> <https://example.org/narad/SourceSystemEnum#PALS_Ext> <https://example.org/narad/SourceSystemEnum#MYA> <https://example.org/narad/SourceSystemEnum#ElementDatabase> <https://example.org/narad/SourceSystemEnum#ChannelDatabase> <https://example.org/narad/SourceSystemEnum#Simulation> <https://example.org/narad/SourceSystemEnum#Other> ) ;
    skos:definition "Controlled values for facility-local source systems." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/SourceSystemEnum#ChannelDatabase>,
        <https://example.org/narad/SourceSystemEnum#EPICS>,
        <https://example.org/narad/SourceSystemEnum#EPICS_ChannelAccess>,
        <https://example.org/narad/SourceSystemEnum#ElementDatabase>,
        <https://example.org/narad/SourceSystemEnum#MYA>,
        <https://example.org/narad/SourceSystemEnum#Other>,
        <https://example.org/narad/SourceSystemEnum#PALS_Ext>,
        <https://example.org/narad/SourceSystemEnum#Simulation> .

narad:object a owl:DatatypeProperty ;
    rdfs:label "object" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:predicate a owl:DatatypeProperty ;
    rdfs:label "predicate" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:subject a owl:DatatypeProperty ;
    rdfs:label "subject" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    rdfs:range xsd:string ;
    skos:definition "The LinkML class name of this instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:MultipoleComponent a owl:Class ;
    rdfs:label "MultipoleComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:Bn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:tilt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:tilt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:Bn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:Bs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:Bn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:EnL ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:En ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:Ks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:Es ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:En ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:Ks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:Bs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:EsL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:Es ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:EsL ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:EnL ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty narad:order ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:Bs ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:order ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:Es ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:Kn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:tilt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:order ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:EsL ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:Kn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:Ks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:En ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:EnL ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:Kn ] ;
    skos:definition """A single order's electric (or magnetic) multipole component.
Only the fields supporting Electric Multipoles  OR the fields for Magnetic Multipoles should be present, not both.
Not a mixin, but a class used in the ElectricMultipoleP and MagneticMultipoleP mixins to represent individual multipole components.""" ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:string ;
    skos:definition "A unique identifier for the instance." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

narad:QuantityKindEnum a owl:Class ;
    rdfs:label "QuantityKindEnum" ;
    owl:unionOf ( <https://example.org/narad/QuantityKindEnum#BeamPosition> sosa:ObservableProperty quantitykind:ElectricCurrent quantitykind:MagneticFluxPerLength quantitykind:MagneticFluxDensity quantitykind:Pressure quantitykind:AbsorbedDoseRate quantitykind:Voltage quantitykind:Power quantitykind:PhaseAngle quantitykind:ElectricFieldStrength ) ;
    skos:definition "Physical quantity kinds for signals." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values quantitykind:AbsorbedDoseRate,
        quantitykind:ElectricCurrent,
        quantitykind:ElectricFieldStrength,
        quantitykind:MagneticFluxDensity,
        quantitykind:MagneticFluxPerLength,
        quantitykind:PhaseAngle,
        quantitykind:Power,
        quantitykind:Pressure,
        quantitykind:Voltage,
        sosa:ObservableProperty,
        <https://example.org/narad/QuantityKindEnum#BeamPosition> .

narad:ComponentRelationPredicateEnum a owl:Class ;
    rdfs:label "ComponentRelationPredicateEnum" ;
    owl:unionOf ( BFO:0000063 BFO:0000062 BFO:0000051 BFO:0000050 RO:0002170 saref:controls saref:isControlledBy BFO:0000050 BFO:0000051 RO:0002220 RO:0002131 narad:mounted_on narad:intersects narad:nearest_to ) ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values BFO:0000050,
        BFO:0000051,
        BFO:0000062,
        BFO:0000063,
        RO:0002131,
        RO:0002170,
        RO:0002220,
        narad:intersects,
        narad:mounted_on,
        narad:nearest_to,
        saref:controls,
        saref:isControlledBy .

narad:PhysicalFunctionEnum a owl:Class ;
    rdfs:label "PhysicalFunctionEnum" ;
    owl:unionOf ( <https://example.org/narad/PhysicalFunctionEnum#Focusing> <https://example.org/narad/PhysicalFunctionEnum#Steering> <https://example.org/narad/PhysicalFunctionEnum#BeamPositionMeasurement> <https://example.org/narad/PhysicalFunctionEnum#VacuumGeneration> <https://example.org/narad/PhysicalFunctionEnum#RadiationMonitoring> <https://example.org/narad/PhysicalFunctionEnum#Measurement> <https://example.org/narad/PhysicalFunctionEnum#BeamAcceleration> <https://example.org/narad/PhysicalFunctionEnum#BeamLossDetection> <https://example.org/narad/PhysicalFunctionEnum#BeamCurrentMeasurement> <https://example.org/narad/PhysicalFunctionEnum#BeamProfileMeasurement> <https://example.org/narad/PhysicalFunctionEnum#MachineProtection> <https://example.org/narad/PhysicalFunctionEnum#TimingSynchronization> ) ;
    skos:definition "Broad device-level functions." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/PhysicalFunctionEnum#BeamAcceleration>,
        <https://example.org/narad/PhysicalFunctionEnum#BeamCurrentMeasurement>,
        <https://example.org/narad/PhysicalFunctionEnum#BeamLossDetection>,
        <https://example.org/narad/PhysicalFunctionEnum#BeamPositionMeasurement>,
        <https://example.org/narad/PhysicalFunctionEnum#BeamProfileMeasurement>,
        <https://example.org/narad/PhysicalFunctionEnum#Focusing>,
        <https://example.org/narad/PhysicalFunctionEnum#MachineProtection>,
        <https://example.org/narad/PhysicalFunctionEnum#Measurement>,
        <https://example.org/narad/PhysicalFunctionEnum#RadiationMonitoring>,
        <https://example.org/narad/PhysicalFunctionEnum#Steering>,
        <https://example.org/narad/PhysicalFunctionEnum#TimingSynchronization>,
        <https://example.org/narad/PhysicalFunctionEnum#VacuumGeneration> .

narad:UnitEnum a owl:Class ;
    rdfs:label "UnitEnum" ;
    owl:unionOf ( unit:MilliM unit:M unit:A unit:T-M unit:PA unit:TORR unit:REM-PER-H unit:MREM-PER-H unit:V unit:KiloW unit:DEG unit:MegaV-PER-M <https://example.org/narad/UnitEnum#G_per_cm> unit:NUM <https://example.org/narad/UnitEnum#none> ) ;
    skos:definition "Engineering units using ASCII-safe enum names. Values map to QUDT unit IRIs with the LinkML meaning field when an exact QUDT unit is available." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values unit:A,
        unit:DEG,
        unit:KiloW,
        unit:M,
        unit:MREM-PER-H,
        unit:MegaV-PER-M,
        unit:MilliM,
        unit:NUM,
        unit:PA,
        unit:REM-PER-H,
        unit:T-M,
        unit:TORR,
        unit:V,
        <https://example.org/narad/UnitEnum#G_per_cm>,
        <https://example.org/narad/UnitEnum#none> .

narad:CanonicalSignalTypeEnum a owl:Class ;
    rdfs:label "CanonicalSignalTypeEnum" ;
    owl:unionOf ( <https://example.org/narad/CanonicalSignalTypeEnum#HorizontalBeamPosition> <https://example.org/narad/CanonicalSignalTypeEnum#VerticalBeamPosition> <https://example.org/narad/CanonicalSignalTypeEnum#HorizontalBeamPositionOffset> <https://example.org/narad/CanonicalSignalTypeEnum#VerticalBeamPositionOffset> <https://example.org/narad/CanonicalSignalTypeEnum#BeamIntensity> <https://example.org/narad/CanonicalSignalTypeEnum#DeviceStatus> <https://example.org/narad/CanonicalSignalTypeEnum#GradientSetpoint> <https://example.org/narad/CanonicalSignalTypeEnum#GradientReadback> <https://example.org/narad/CanonicalSignalTypeEnum#MagnetCurrentSetpoint> <https://example.org/narad/CanonicalSignalTypeEnum#MagnetCurrentReadback> <https://example.org/narad/CanonicalSignalTypeEnum#MagnetFieldSetpoint> <https://example.org/narad/CanonicalSignalTypeEnum#IntegratedFieldSetpoint> <https://example.org/narad/CanonicalSignalTypeEnum#IntegratedFieldReadback> <https://example.org/narad/CanonicalSignalTypeEnum#VacuumPressure> <https://example.org/narad/CanonicalSignalTypeEnum#IonPumpCurrent> <https://example.org/narad/CanonicalSignalTypeEnum#IonPumpVoltage> <https://example.org/narad/CanonicalSignalTypeEnum#GammaDoseRate> <https://example.org/narad/CanonicalSignalTypeEnum#NeutronDoseRate> <https://example.org/narad/CanonicalSignalTypeEnum#Status> ) ;
    skos:definition "Portable semantic meanings for important signals." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    linkml:permissible_values <https://example.org/narad/CanonicalSignalTypeEnum#BeamIntensity>,
        <https://example.org/narad/CanonicalSignalTypeEnum#DeviceStatus>,
        <https://example.org/narad/CanonicalSignalTypeEnum#GammaDoseRate>,
        <https://example.org/narad/CanonicalSignalTypeEnum#GradientReadback>,
        <https://example.org/narad/CanonicalSignalTypeEnum#GradientSetpoint>,
        <https://example.org/narad/CanonicalSignalTypeEnum#HorizontalBeamPosition>,
        <https://example.org/narad/CanonicalSignalTypeEnum#HorizontalBeamPositionOffset>,
        <https://example.org/narad/CanonicalSignalTypeEnum#IntegratedFieldReadback>,
        <https://example.org/narad/CanonicalSignalTypeEnum#IntegratedFieldSetpoint>,
        <https://example.org/narad/CanonicalSignalTypeEnum#IonPumpCurrent>,
        <https://example.org/narad/CanonicalSignalTypeEnum#IonPumpVoltage>,
        <https://example.org/narad/CanonicalSignalTypeEnum#MagnetCurrentReadback>,
        <https://example.org/narad/CanonicalSignalTypeEnum#MagnetCurrentSetpoint>,
        <https://example.org/narad/CanonicalSignalTypeEnum#MagnetFieldSetpoint>,
        <https://example.org/narad/CanonicalSignalTypeEnum#NeutronDoseRate>,
        <https://example.org/narad/CanonicalSignalTypeEnum#Status>,
        <https://example.org/narad/CanonicalSignalTypeEnum#VacuumPressure>,
        <https://example.org/narad/CanonicalSignalTypeEnum#VerticalBeamPosition>,
        <https://example.org/narad/CanonicalSignalTypeEnum#VerticalBeamPositionOffset> .

xsd:float a owl:Class ;
    rdfs:label "Float" ;
    rdfs:subClassOf narad:DataTypeEnum ;
    skos:definition "floating-point data type" .

xsd:string a owl:Class ;
    rdfs:label "String" ;
    rdfs:subClassOf narad:DataTypeEnum ;
    skos:definition "string data type" .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty narad:En ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:EnL ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Es ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:EsL ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty narad:Bs ;
                owl:someValuesFrom xsd:string ] narad:MultipoleComponent ) .

[] a owl:Restriction ;
    owl:allValuesFrom xsd:string ;
    owl:onProperty narad:Ksol .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty narad:En ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:EnL ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Es ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:EsL ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty narad:Kn ;
                owl:someValuesFrom xsd:string ] narad:MultipoleComponent ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty narad:Bn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Bs ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Kn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Ks ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty narad:EnL ;
                owl:someValuesFrom xsd:string ] narad:MultipoleComponent ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty narad:Bn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Bs ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Kn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Ks ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty narad:EsL ;
                owl:someValuesFrom xsd:string ] narad:MultipoleComponent ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty narad:En ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:EnL ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Es ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:EsL ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty narad:Bn ;
                owl:someValuesFrom xsd:string ] narad:MultipoleComponent ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty narad:Bn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Bs ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Kn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Ks ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty narad:Es ;
                owl:someValuesFrom xsd:string ] narad:MultipoleComponent ) .

[] rdfs:subClassOf [ owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty narad:length ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty narad:s_position ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty narad:id ;
                owl:someValuesFrom xsd:string ] narad:HasLongitudinalPlacement ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty narad:Bn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Bs ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Kn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Ks ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty narad:En ;
                owl:someValuesFrom xsd:string ] narad:MultipoleComponent ) .

[] a owl:Restriction ;
    owl:allValuesFrom xsd:string ;
    owl:onProperty narad:Bsol .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty narad:En ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:EnL ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:Es ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty narad:EsL ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty narad:Ks ;
                owl:someValuesFrom xsd:string ] narad:MultipoleComponent ) .

[] rdfs:subClassOf [ owl:unionOf ( [ owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty narad:Ksol ] [ owl:complementOf [ a owl:Restriction ;
                                            owl:allValuesFrom xsd:string ;
                                            owl:onProperty narad:Bsol ] ] ) ] [ owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty narad:Bsol ] [ owl:complementOf [ a owl:Restriction ;
                                            owl:allValuesFrom xsd:string ;
                                            owl:onProperty narad:Ksol ] ] ) ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty narad:id ;
                owl:someValuesFrom xsd:string ] narad:SolenoidP ) .


