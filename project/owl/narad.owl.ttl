        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:edge1_int ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty pals:e1_rect ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
