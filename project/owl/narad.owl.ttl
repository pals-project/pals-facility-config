    skos:definition "Measured or reported value." ;
    skos:exactMatch sosa:ObservableProperty .

<https://example.org/accelerator-core/SignalRoleEnum#Setpoint> a owl:Class ;
    rdfs:label "Setpoint" ;
    rdfs:subClassOf acc:SignalRoleEnum ;
    skos:definition "Requested or configured value." ;
    skos:exactMatch sosa:ActuatableProperty .

<https://example.org/accelerator-core/SignalRoleEnum#Status> a owl:Class ;
    rdfs:label "Status" ;
    rdfs:subClassOf acc:SignalRoleEnum ;
    skos:definition "State or condition indicator." .

acc:Solenoid a owl:Class ;
    rdfs:label "Solenoid" ;
    rdfs:subClassOf acc:HasSolenoidP,
        acc:Magnet ;
    skos:definition """A magnet with a primarily longitudinal magnetic field used for focusing.
A solenoid is an element whose magnetic field is dominated by a field whose direction is aligned with the magnetic axis. """ ;
    skos:exactMatch pals:Solenoid ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:SolenoidParamGroup a owl:Class ;
    rdfs:label "SolenoidParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:Bsol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:Bsol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:Ksol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:Ksol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:Bsol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:Ksol ],
        acc:ParamGroup ;
    skos:definition "Mixin for solenoid-specific parameters." ;
    skos:exactMatch pals:SolenoidP ;
    skos:inScheme <https://w3id.org/accelerator-core> .

