acc:Intersects a owl:Class ;
    rdfs:label "Intersects" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "Intersects" ] ) ] ;
            owl:onProperty acc:predicate ],
        acc:ComponentRelation ;
    skos:broadMatch RO:0015011 ;
    skos:definition "A relationship indicating that the subject component intersects the object component in a specified context,  such as a beamline and a diagnostic device." ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:intersects" .

acc:IsPartOf a owl:Class ;
    rdfs:label "IsPartOf" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:BeamLine ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "IsPartOf" ] ) ] ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:beamline_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:RelationContextEnum ;
            owl:onProperty acc:context ],
        acc:ComponentRelation ;
    skos:definition "A relationship indicating that the subject component is part of the object component in a specified context,  such as a magnet being part of a BeamLineSection." ;
    skos:exactMatch BFO:0000050 ;
    skos:inScheme <https://w3id.org/accelerator-core> ;
    acc:rdf_predicate "acc:is_part_of" .

acc:LongitudinalPlacementParamGroup a owl:Class ;
    rdfs:label "LongitudinalPlacementParamGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:s_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty acc:s_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty acc:s_position ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty acc:length ],
        acc:ParamGroup ;
    skos:definition "Mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis.  Corresponds to PALS's ungrouped element parameters `length` and `s_position`. One (or both) `length` or `s_position` must be present." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:Marker a owl:Class ;
    rdfs:label "Marker" ;
    rdfs:subClassOf acc:BookkeepingComponent,
        acc:HasTwissP ;
    skos:definition "A virtual component used as a reference point or marker in the beamline structure." ;
    skos:exactMatch pals:Marker ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:MountedOn a owl:Class ;
    rdfs:label "MountedOn" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
