xsd:float a owl:Class ;
    rdfs:label "Float" ;
    rdfs:subClassOf pals:DataTypeEnum ;
    skos:definition "floating-point data type" .

xsd:string a owl:Class ;
    rdfs:label "String" ;
    rdfs:subClassOf pals:DataTypeEnum ;
    skos:definition "string data type" .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pals:multipole_geometry ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty pals:multipole_geometry ;
                owl:someValuesFrom xsd:string ] pals:BendParamGroup ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty pals:ref_geometry ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty pals:ref_geometry ;
                owl:someValuesFrom xsd:string ] pals:BendParamGroup ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty pals:Bn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Bs ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Kn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Ks ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty pals:En ;
                owl:someValuesFrom xsd:string ] pals:MultipoleParameterGroup ) .

[] rdfs:subClassOf [ owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty pals:length ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty pals:s_position ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty pals:id ;
                owl:someValuesFrom xsd:string ] pals:LongitudinalPlacementParamGroup ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty pals:En ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:EnL ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Es ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:EsL ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty pals:Kn ;
                owl:someValuesFrom xsd:string ] pals:MultipoleParameterGroup ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty pals:En ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:EnL ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Es ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:EsL ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty pals:Ks ;
                owl:someValuesFrom xsd:string ] pals:MultipoleParameterGroup ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty pals:Bn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Bs ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Kn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Ks ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty pals:Es ;
                owl:someValuesFrom xsd:string ] pals:MultipoleParameterGroup ) .

[] a owl:Restriction ;
    owl:allValuesFrom xsd:string ;
    owl:onProperty pals:Ksol .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty pals:Bn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Bs ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Kn ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Ks ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty pals:EsL ;
                owl:someValuesFrom xsd:string ] pals:MultipoleParameterGroup ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty pals:En ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:EnL ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:Es ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty pals:EsL ;
