<https://example.org/accelerator-core/SourceSystemEnum#ElementDatabase> a owl:Class ;
    rdfs:label "ElementDatabase" ;
    rdfs:subClassOf acc:SourceSystemEnum ;
    skos:definition "Facility element database." .

<https://example.org/accelerator-core/SourceSystemEnum#MYA> a owl:Class ;
    rdfs:label "MYA" ;
    rdfs:subClassOf acc:SourceSystemEnum ;
    skos:definition "MYA archive or historical channel service." .

<https://example.org/accelerator-core/SourceSystemEnum#Other> a owl:Class ;
    rdfs:label "Other" ;
    rdfs:subClassOf acc:SourceSystemEnum ;
    skos:definition "Other source system." .

<https://example.org/accelerator-core/SourceSystemEnum#PALS_Ext> a owl:Class ;
    rdfs:label "PALS_Ext" ;
    rdfs:subClassOf acc:SourceSystemEnum ;
    skos:definition "PALS-Ext or middle-layer channel/export system." .

<https://example.org/accelerator-core/SourceSystemEnum#Simulation> a owl:Class ;
    rdfs:label "Simulation" ;
    rdfs:subClassOf acc:SourceSystemEnum ;
    skos:definition "Simulation or model-derived signal source." .

acc:SuperConductingRFCavity a owl:Class ;
    rdfs:label "SuperConductingRFCavity" ;
    rdfs:subClassOf acc:RFCavity ;
    skos:broadMatch pals:RFCavity ;
    skos:definition "A cavity used for RF acceleration or longitudinal manipulation, which is superconducting." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

acc:SupportingFacilityComponent a owl:Class ;
    rdfs:label "SupportingFacilityComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty acc:facility_functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom acc:FacilityFunctionEnum ;
            owl:onProperty acc:facility_functions ],
        acc:HasBodyShiftP,
        acc:HasFloorP,
        acc:HasLongitudinalPlacementP,
        acc:PhysicalComponent ;
    skos:broadMatch pals:StructuralElement ;
    skos:definition "A physical component that supports accelerator operation  without a specific beam-pipe placement,  such as a power supply, control rack, or radiation detector. These can include Girders, Racks, Power Supplies,  and other physical infrastructure components that are important for understanding  the structure and function of the accelerator system but are not inline with the beamline." ;
    skos:inScheme <https://w3id.org/accelerator-core> .

<https://example.org/accelerator-core/UnitEnum#A> a owl:Class ;
    rdfs:label "A" ;
    rdfs:subClassOf acc:UnitEnum ;
    skos:definition "ampere" ;
    skos:exactMatch qudt:A .

