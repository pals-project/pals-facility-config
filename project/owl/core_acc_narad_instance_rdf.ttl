[] a acc:PALSAccelerator ;
    acc:affiliation <https://uitf/jefferson-lab> ;
    acc:authors [ a acc:Author ;
            acc:affiliation <https://uitf/jefferson-lab> ;
            acc:email "dianam@jlab.org" ;
            acc:name "Diana McSpadden" ;
            acc:orcid "https://orcid.org/0000-0002-8520-1631" ] ;
    acc:description "PALS-NARAD representation of a validated subset of the Jefferson Lab UITF injector beamline, ported from a prior instance format to conform to the accelerator_core LinkML schema." ;
    acc:facility [ a acc:Facility ;
            acc:beamlines <https://uitf/GUN_thru_MV> ;
            acc:component_relations <https://uitf/IFYK203_to_ISLK302>,
