@prefix linkml: <https://w3id.org/linkml/> .
@prefix narad: <https://example.org/narad_linkml/schema/narad/> .
@prefix ncit: <http://purl.obolibrary.org/obo/ncit.owl> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pals: <https://pals-project.readthedocs.io/en/latest/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

narad:ActuatableSignal a owl:Class ;
    rdfs:label "ActuatableSignal" ;
    rdfs:subClassOf narad:Signal ;
    skos:broadMatch sosa:ActuatableProperty ;
    skos:definition """A NARAD signal that can be commanded, set, or acted upon. Examples: current_setpoint, strength_setpoint, kick_setpoint, field_setpoint, current_min, current_max, gradient_setpoint. Aligned to sosa:ActuatableProperty.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:CapabilityLayer a owl:Class ;
    rdfs:label "CapabilityLayer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:capabilities ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Capability ;
            owl:onProperty narad:capabilities ] ;
    skos:definition "Capability-layer container for control profile families." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:subClassOf narad:System ;
    skos:definition "A generic beam diagnostic instrument." ;
    skos:exactMatch ssn:System ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:NaradModel a owl:Class ;
    rdfs:label "NaradModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:elements ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Beamline ;
            owl:onProperty narad:beamlines ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:beamlines ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:NaradConfig ;
            owl:onProperty narad:narad_config ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:BeamlineElement ;
            owl:onProperty narad:elements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:narad_config ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:narad_config ] ;
    skos:definition "Top-level NARAD document container." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:ObservableSignal a owl:Class ;
    rdfs:label "ObservableSignal" ;
    rdfs:subClassOf narad:Signal ;
    skos:broadMatch sosa:ObservableProperty ;
    skos:definition """A NARAD signal that is read, monitored, observed, or exposed by a system. Examples: current_readback, status, horizontal_beam_position, gradient_readback. Aligned to sosa:ObservableProperty.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:TemplateExample a owl:Class ;
    rdfs:label "TemplateExample" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:example ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:example ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:example ] ;
    skos:definition """An example of a control system PV name generated from a naming convention template, along with a description of what it represents.  This can be used to illustrate how the template works in practice and to provide concrete examples of the expected PV naming convention for different device types and signals.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:capability a owl:ObjectProperty ;
    rdfs:label "capability" ;
    rdfs:range narad:Capability ;
    skos:definition "Cross-reference to the specific control capability applied to this element." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:capability_class a owl:DatatypeProperty ;
    rdfs:label "capability_class" ;
    rdfs:range xsd:string ;
    skos:altLabel "class" ;
    skos:definition "Semantic class label for a type-specific capability (e.g. QuadrupoleStrengthCapability). Serialized as 'class' in source YAML." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

<https://w3id.org/narad_linkml/schema/narad/system.owl.ttl> a owl:Ontology ;
    rdfs:label "narad-system-schema" ;
    skos:definition """LinkML schema for representing NARAD control-system semantics, facility-level signal templates, and facility-specific instance bindings aligned with SSN, SSN-System, and SOSA ontologies. 
Main modeling layers:
  - NaradModel — top-level document containing NaradConfig, beamlines, and elements
    - NaradConfig — top-level NARAD-system container for the capability layer and signal layer
      - ControlCapabilityLayer — reusable control-profile families, shared capabilities
      - InstrumentLayer — facility-specific instrument definitions -> their  capabilities
      - SignalLayer — facility-specific signal suffix templates for system/device types and instance bindings keyed by semantic signal name, linked to the
        device type
  - Beamline / BeamlineElement — ordered machine layout of the beamline/line
  - Element instances — individual beamline elements with applied profiles and instance signal
    bindings, parameters, and optional facility-specific parameters

System hierarchy:
  - System
    - ControlSystem
    - Magnet
      - Quadrupole, Corrector, Dipole, Solenoid
    - Instrument
      - BPM
    - RFCavity
    - Marker
    - Drift

Control Capability hierarchy:
  - SystemCapability
    - MagnetCapability
      - QuadrupoleCapability, CorrectorKickCapability, DipoleCapability
    - InstrumentCapability
    - BPMCapability
    - CavityGradientCapability

Signal modeling:
  - Signal — abstract control-system quantity
    - ObservableSignal — readback, constraint, and status quantities
    - ActuatableSignal — writable/control setpoints
  - SignalBinding — signal template or suffix definition in the signal layer
  - InstanceSignalBinding — facility-specific PV binding attached to a beamline element

Serialization conventions:
  - beamlines are keyed by beamline name
  - signals are keyed by semantic signal name
  - signal bindings are created through the is_observed_by relationship to  and are keyed by semantic signal name

Alignments with PALS (Particle Accelerator Language Standard):
  - Beamline aligns with pals:BeamLine
  - BeamlineElement aligns with pals:Element
  - Instrument aligns with pals:Instrument
  - Dipole aligns with pals:Multipole
  - Quadrupole aligns with pals:Quadrupole
  - Solenoid aligns with pals:Solenoid
  - RFCavity aligns with pals:RFCavity

Additional Notes on Usage: 1. On Signal, and InstanceSignalBinding: These classes represent different levels of abstraction in the signal modeling.  Signal defines the abstract control-system quantity (e.g. current_readback), SignalBinding captures the control system suffix convention for that signal (e.g. .R for EPICS readback),  and InstanceSignalBinding represents the concrete binding of that signal to a specific beamline element instance, for example, MQWK202.S or RK11:GSET, depending on the facility naming convention.  The semantic signal name (e.g. current_readback) is the key that links these layers together, while the control-system suffix (e.g. .R)  is captured in the InstanceSignalBinding. 2. On the distinction between is_instance_of, facility_element_type, and device_type:
  - BeamlineElement.is_instance_of identifies the element’s semantic class, device_type classifies capability or signal-definition scope, and facility_element_type records facility-local designation.
  - facility_element_type (FacilityParamSet.facility_element_type) is an optional slot for recording the facility-specific type designation for this element, if it differs from the generic element_kind. 
  - device_type (Capability.device_type) is the generic element type used for capability profile matching 
  and signal definition scoping, while facility_element_type captures the facility-specific type designation that may be used in the control system naming convention 
  or for other facility-specific purposes.
  For example, a facility might have its own naming convention for magnet types that doesn't align one-to-one with the ElementKindEnum values.
3. Expected CURIE usage for is_instance_of, is_hosted_by, and is_property_of: 
  - is_instance_of typically points to the semantic class instantiated by the binding or element, using a CURIE such as narad:CavityGradientCapability if that is your intended convention.
  - is_hosted_by typically points to the FacilitySystem this binding belongs to, e.g. narad:UITF.
  - is_property_of typically points to the ControlSystem that implements this binding, e.g. narad:epics.
4. Open and constrained vocabularies:
  - ElementKindEnum provides a controlled vocabulary for key classification slots, but the schema is designed to be extensible 
  with new enum values as needed.
  - SystemTypeEnum is a high-level classification for systems that can be used for querying and filtering, 
  but it is not intended to capture all the nuance of device types or capabilities.
  - DataTypeEnum and SignalRoleEnum provide a controlled vocabulary for signal data types and roles, 
  but the schema allows for additional values to be added as needed.
  - IdentifierTypeEnum provides a controlled vocabulary for types of identifiers used in FacilityIdentifier, 
  but it can be extended to apply to other entities, and with additional identifier types as needed.
  - The properties slot in FacilityParamSet allows for open-ended key-value pairs to capture any additional 
  facility-specific parameters that don't fit into the predefined schema structure.

Needed Custom Validations:
  - Validation to ensure that the element_kind of a BeamlineElement matches the device_type of the Device it is an instance of.
  - Validation to ensure that the value of is_property_of in InstanceSignalBinding matches one of the control systems listed in narad_config.has_sub_system.
  - Validation that each signal_layer -> facilities -> FacilitySystem -> control_system value has a corresponding entry in narad_config.has_sub_system to ensure that all control systems referenced in the signal layer are defined in the capability layer.
  - Validation that the signal_bindings defined for a given device_type in the signal layer align with the signals defined in the capability profiles and instrument systems for that device type.
""" .

narad:InstanceSignalBinding a owl:Class ;
    rdfs:label "InstanceSignalBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:is_hosted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:is_hosted_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:pv_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:is_property_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:is_hosted_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Signal ;
            owl:onProperty narad:is_instance_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:for_property ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:pv_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:is_property_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:pv_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:is_instance_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ControlSystem ;
            owl:onProperty narad:is_property_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SignalBinding ;
            owl:onProperty narad:for_property ],
        narad:NamedThing ;
    skos:broadMatch rdf:type,
        sosa:Sensor ;
    skos:definition """A facility-specific binding between a NARAD Signal and an implementation interface (e.g. an EPICS process variable). Modeled as sosa:Sensor because it describes how a signal is observed, monitored, or actuated. ssn:forProperty → Signal; narad:isInstanceOf → the capability class.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

ncit:C45253 a owl:Class ;
    rdfs:label "string" ;
    rdfs:subClassOf narad:DataTypeEnum ;
    skos:definition "Text string." .

ncit:C45254 a owl:Class ;
    rdfs:label "boolean" ;
    rdfs:subClassOf narad:DataTypeEnum ;
    skos:definition "True/false value." .

ncit:C47840 a owl:Class ;
    rdfs:label "int" ;
    rdfs:subClassOf narad:DataTypeEnum ;
    skos:definition "Integer." .

ncit:C48150 a owl:Class ;
    rdfs:label "float" ;
    rdfs:subClassOf narad:DataTypeEnum ;
    skos:definition "Single-precision floating-point." .

ncit:C48870 a owl:Class ;
    rdfs:label "double" ;
    rdfs:subClassOf narad:DataTypeEnum ;
    skos:definition "Double-precision floating-point." .

ncit:C95637 a owl:Class ;
    rdfs:label "coded_value" ;
    rdfs:subClassOf narad:DataTypeEnum ;
    skos:definition "A code referenced from an external coding system." .

narad:AnyValue a owl:Class ;
    rdfs:label "AnyValue" ;
    skos:definition "Unconstrained type — accepts any YAML/JSON value (string, number, object, list, etc.)." ;
    skos:exactMatch linkml:Any ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:Beamline a owl:Class ;
    rdfs:label "Beamline" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:multipass ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty narad:periodic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:multipass ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:periodic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty narad:multipass ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:periodic ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:line ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:zero_point ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:BeamlineElement ;
            owl:onProperty narad:zero_point ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:zero_point ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:BeamlineElement ;
            owl:onProperty narad:line ],
        narad:NamedThing ;
    skos:definition "A top-level NARAD-system for an ordered sequence of beamline elements defining a beam path." ;
    skos:exactMatch pals:BeamLine ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#BPM> a owl:Class ;
    rdfs:label "BPM" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:broadMatch pals:Instrument ;
    skos:definition "Beam Position Monitor." .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#CavityGradient> a owl:Class ;
    rdfs:label "CavityGradient" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:definition "Accelerating or bunching cavity." .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#Corrector> a owl:Class ;
    rdfs:label "Corrector" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:definition "Dipole corrector magnet for orbit correction." .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#Dipole> a owl:Class ;
    rdfs:label "Dipole" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:broadMatch pals:Multipole ;
    skos:definition "Dipole bending magnet." .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#Drift> a owl:Class ;
    rdfs:label "Drift" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:definition "A field-free drift space between elements." ;
    skos:exactMatch pals:Drift .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#Instrument> a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:definition "Generic beam diagnostic instrument (halo monitor, viewer, etc.)." ;
    skos:exactMatch pals:Instrument .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#Magnet> a owl:Class ;
    rdfs:label "Magnet" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:definition "Generic powered magnet device (supertype for all magnet kinds)." .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#Marker> a owl:Class ;
    rdfs:label "Marker" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:definition "A zero-length reference point or survey marker." ;
    skos:exactMatch pals:Marker .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#Quadrupole> a owl:Class ;
    rdfs:label "Quadrupole" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:definition "Quadrupole focusing/defocusing magnet." ;
    skos:exactMatch pals:Quadrupole .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#RFCavity> a owl:Class ;
    rdfs:label "RFCavity" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:definition "Radio-frequency accelerating or bunching cavity." ;
    skos:exactMatch pals:RFCavity .

<https://example.org/narad_linkml/schema/narad/ElementKindEnum#Solenoid> a owl:Class ;
    rdfs:label "Solenoid" ;
    rdfs:subClassOf narad:ElementKindEnum ;
    skos:definition "Solenoid magnet." ;
    skos:exactMatch pals:Solenoid .

narad:ElementParamSet a owl:Class ;
    rdfs:label "ElementParamSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:angle_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:frequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:angle_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:Kn1 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:phase ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:voltage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:Ksol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:voltage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:e2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:e2 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:Kn1 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:facility_param_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:e1 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:phase ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:facility_param_set ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:Kn1 ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:angle_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:e2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:voltage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:Ksol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:Ksol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:e1 ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:FacilityParamSet ;
            owl:onProperty narad:facility_param_set ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:e1 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:frequency ] ;
    skos:definition "Named physics-parameter block for a beamline element. The name identifies the block type (e.g. RFP, BendP, MagneticMultipoleP, SolenoidP)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:FacilityIdentifier a owl:Class ;
    rdfs:label "FacilityIdentifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:identifier_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:identifier_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:identifier_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:IdentifierTypeEnum ;
            owl:onProperty narad:identifier_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:identifier_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:identifier_value ] ;
    skos:definition "A globally unique identifier for an entity (e.g., facility), with a specified type (e.g. DOI, ROR, ARK, local)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:FacilityParamSet a owl:Class ;
    rdfs:label "FacilityParamSet" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:modeled_as ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:properties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:facility_element_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:modeled_as ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:AnyValue ;
            owl:onProperty narad:properties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:properties ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:facility_element_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:facility_element_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:modeled_as ] ;
    skos:definition "Facility-specific element parameters block for beamline elements. Differs from an ElementParamSet in that it captures facility-specific metadata about the element (e.g. type designation, model name) rather than physics parameters." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

<https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#ark> a owl:Class ;
    rdfs:label "ark" ;
    rdfs:subClassOf narad:IdentifierTypeEnum ;
    skos:definition "Archival Resource Key (ARK)." .

<https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#doi> a owl:Class ;
    rdfs:label "doi" ;
    rdfs:subClassOf narad:IdentifierTypeEnum ;
    skos:definition "Digital Object Identifier (DOI)." .

<https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#handle> a owl:Class ;
    rdfs:label "handle" ;
    rdfs:subClassOf narad:IdentifierTypeEnum ;
    skos:definition "Handle System identifier." .

<https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#local> a owl:Class ;
    rdfs:label "local" ;
    rdfs:subClassOf narad:IdentifierTypeEnum ;
    skos:definition "Local identifier unique within a specific context or namespace." .

<https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf narad:IdentifierTypeEnum ;
    skos:definition "Any other type of identifier not covered by the above categories." .

<https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#url> a owl:Class ;
    rdfs:label "url" ;
    rdfs:subClassOf narad:IdentifierTypeEnum ;
    skos:definition "Uniform Resource Locator (URL)." .

narad:NamingConvention a owl:Class ;
    rdfs:label "NamingConvention" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:template ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:full_pattern ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:examples ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:template_components ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:TemplateComponent ;
            owl:onProperty narad:template_components ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:template ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:NamingConventionExample ;
            owl:onProperty narad:examples ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:template ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:full_pattern ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:full_pattern ],
        narad:NamedThing ;
    skos:definition """A template for constructing facility-specific signal names from a semantic signal name and a control-system-specific suffix.  The template is used to generate the full control system PV name for a given device instance and semantic signal by substituting the device name and signal code suffix into the template.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:NamingConventionExample a owl:Class ;
    rdfs:label "NamingConventionExample" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:example ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:example ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:example ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:description ] ;
    skos:definition """An example of a control system naming convention, illustrating how the template is used to generate full control system PV names from semantic signal names and device instance information.  This can be used to provide concrete examples of the expected PV naming convention for different device types and signals based on the defined NamingConvention template.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:NaradConfig a owl:Class ;
    rdfs:label "NaradConfig" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom narad:Capability ;
            owl:onProperty narad:capability_layer ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:capability_layer ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:intent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:control_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:deployed_system ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:schema_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ControlSystem ;
            owl:onProperty narad:control_system ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:device_layer ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:control_system ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:signal_layer ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:schema_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Device ;
            owl:onProperty narad:device_layer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:schema_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:intent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:intent ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:DeployedSystem ;
            owl:onProperty narad:deployed_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:signal_layer ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:deployed_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SignalLayer ;
            owl:onProperty narad:signal_layer ] ;
    skos:broadMatch ssn:Deployment ;
    skos:definition "A top-level NARAD-system container for the: capability layer + signal layer." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:SignalLayer a owl:Class ;
    rdfs:label "SignalLayer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:facilities ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:FacilitySystem ;
            owl:onProperty narad:facilities ] ;
    skos:definition "Signal-layer container for facility-specific signal bindings." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

<https://example.org/narad_linkml/schema/narad/SignalRoleEnum#constraint> a owl:Class ;
    rdfs:label "constraint" ;
    rdfs:subClassOf narad:SignalRoleEnum ;
    skos:definition "A signal that defines an operational limit or boundary on a control quantity." .

<https://example.org/narad_linkml/schema/narad/SignalRoleEnum#control> a owl:Class ;
    rdfs:label "control" ;
    rdfs:subClassOf narad:SignalRoleEnum ;
    skos:broadMatch sosa:ActuatableProperty ;
    skos:definition "A writable signal that commands a device setpoint." .

<https://example.org/narad_linkml/schema/narad/SignalRoleEnum#readback> a owl:Class ;
    rdfs:label "readback" ;
    rdfs:subClassOf narad:SignalRoleEnum ;
    skos:broadMatch sosa:ObservableProperty ;
    skos:definition "A readable signal that reports a measured or monitored quantity. Differs from status in that it typically indicates a continuous measurement (e.g. current readback, beam position) rather than discrete states." .

<https://example.org/narad_linkml/schema/narad/SignalRoleEnum#status> a owl:Class ;
    rdfs:label "status" ;
    rdfs:subClassOf narad:SignalRoleEnum ;
    skos:broadMatch sosa:ObservableProperty ;
    skos:definition "A signal reporting the device or system operational state. Differs from readback in that it typically indicates discrete states (e.g. fault, standby, ready) rather than a continuous measurement." .

<https://example.org/narad_linkml/schema/narad/SystemTypeEnum#ControlSystem> a owl:Class ;
    rdfs:label "ControlSystem" ;
    rdfs:subClassOf narad:SystemTypeEnum ;
    skos:definition "A control system (e.g. epics) that manages device process variables." .

<https://example.org/narad_linkml/schema/narad/SystemTypeEnum#Facility> a owl:Class ;
    rdfs:label "Facility" ;
    rdfs:subClassOf narad:SystemTypeEnum ;
    skos:definition "A physical facility or installation (e.g. BTA, CEBAF, or UITF)." .

<https://example.org/narad_linkml/schema/narad/SystemTypeEnum#Magnet> a owl:Class ;
    rdfs:label "Magnet" ;
    rdfs:subClassOf narad:SystemTypeEnum ;
    skos:definition "A powered magnet device/system (generic supertype for all magnet kinds)." .

narad:TemplateComponent a owl:Class ;
    rdfs:label "TemplateComponent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:required ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty narad:required ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:pattern ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:pattern ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:pattern ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:required ],
        narad:NamedThing ;
    skos:definition """A component of a naming convention template, representing a variable part of the control system PV name that is substituted based on the device instance and signal definition.  For example, in the template "{device_name}{signal_code_suffix}", "device_name" and "signal_code_suffix" would be TemplateComponents that are replaced with the actual device name and signal code suffix for each specific binding.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:beamlines a owl:ObjectProperty ;
    rdfs:label "beamlines" ;
    rdfs:range narad:Beamline ;
    skos:definition "A top-level NARAD-system container for the ordered beamline definitions keyed by beamline name. Serializes as a keyed map by beamline name." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:capabilities a owl:ObjectProperty ;
    rdfs:label "capabilities" ;
    rdfs:range narad:Capability ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:capability_layer a owl:ObjectProperty ;
    rdfs:label "capability_layer" ;
    rdfs:range narad:Capability ;
    skos:definition "Control Capability definitions for this facility." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:device_layer a owl:ObjectProperty ;
    rdfs:label "device_layer" ;
    rdfs:range narad:Device ;
    skos:definition "Device definitions for this facility." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:elements a owl:ObjectProperty ;
    rdfs:label "elements" ;
    rdfs:range narad:BeamlineElement ;
    skos:definition "Beamline element definitions referenced by name from beamline sequences. Serializes as a keyed map by element name." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:examples a owl:ObjectProperty ;
    rdfs:label "examples" ;
    rdfs:range narad:NamingConventionExample ;
    skos:definition "Examples of how this naming convention is applied to specific device instances and signals." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:facilities a owl:ObjectProperty ;
    rdfs:label "facilities" ;
    rdfs:range narad:FacilitySystem ;
    skos:definition "Facility-specific signal binding configurations keyed by facility name." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:facility_identifier a owl:ObjectProperty ;
    rdfs:label "facility_identifier" ;
    rdfs:range narad:FacilityIdentifier ;
    skos:definition "Globally unique identifier for the facility, with specified type and value." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:has_naming_convention a owl:ObjectProperty ;
    rdfs:label "has_naming_convention" ;
    rdfs:range narad:NamingConvention ;
    skos:definition "Signal naming conventions used by this control system defined in a machine actionable manner.  This is where you would capture the patterns/templates for how control system PVs or signals are constructed for this control system,  for example, the EPICS convention of using suffixes like .R, .S, :GSET to indicate readback, status, and setpoint signals. Multiple naming conventions can be captured if a control system uses more than one convention for different device types or domains." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:has_signal a owl:ObjectProperty ;
    rdfs:label "has_signal" ;
    rdfs:range narad:Signal ;
    skos:definition "Signals within a capability, keyed by a semantic signal name." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:hosts_device a owl:ObjectProperty ;
    rdfs:label "hosts_device" ;
    rdfs:domain narad:FacilitySystem ;
    rdfs:range narad:Device ;
    skos:definition "Structured container for facility-specific signal suffix templates." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:line a owl:ObjectProperty ;
    rdfs:label "line" ;
    rdfs:range narad:BeamlineElement ;
    skos:definition "Ordered sequence of beamline elements in this beamline. Serializes as a list of element names (BeamlineElement names) referencing the keys in the elements map This is not a direct containment slot; the actual element definitions are in the top-level elements map." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:template_components a owl:ObjectProperty ;
    rdfs:label "template_components" ;
    rdfs:range narad:TemplateComponent ;
    skos:definition "Structured components of the naming convention template, for capturing the template in a more machine-actionable way than a raw string.  For example, you could have components for the device name, signal suffix, and any fixed parts of the naming convention." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:DeployedSystem a owl:Class ;
    rdfs:label "DeployedSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:system_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:has_control_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:has_control_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SystemTypeEnum ;
            owl:onProperty narad:system_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty narad:has_system_capability ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ControlSystem ;
            owl:onProperty narad:has_control_system ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:has_system_capability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:system_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:facility_identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:FacilityIdentifier ;
            owl:onProperty narad:facility_identifier ],
        narad:System ;
    skos:broadMatch ssn:Deployment,
        ssn-system:System ;
    skos:definition """A deployed system, with an identified facility, that is the subject of a NARAD configuration.  This is the child of the target of the narad_config.deployed_system slot. In the SSN graph a DeployedSystem is a broad mapping to the ssn:Deployment and also is equivalent to the signal_layers.facilities entries.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:FacilitySystem a owl:Class ;
    rdfs:label "FacilitySystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:has_control_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:has_control_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:hosts_device ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ControlSystem ;
            owl:onProperty narad:has_control_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Device ;
            owl:onProperty narad:hosts_device ],
        narad:System ;
    skos:definition "Facility-specific signal binding configuration." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:Kn1 a owl:DatatypeProperty ;
    rdfs:label "Kn1" ;
    rdfs:range xsd:float ;
    skos:definition "First-order magnetic multipole coefficient (quadrupole strength)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:Ksol a owl:DatatypeProperty ;
    rdfs:label "Ksol" ;
    rdfs:range xsd:float ;
    skos:definition "Solenoid integrated field strength." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:SignalBinding a owl:Class ;
    rdfs:label "SignalBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:signal_code_suffix ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:signal_code_suffix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:signal_code_suffix ],
        narad:NamedThing ;
    skos:definition "A named control system suffix definition for one semantic signal. The suffix is used within in a template naming convention to construct the full control system PV name for a given device instance." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:SystemCapability a owl:Class ;
    rdfs:label "SystemCapability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom narad:ElementKindEnum ;
            owl:onProperty narad:device_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:device_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:device_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:for_property ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:for_property ],
        narad:NamedThing ;
    skos:definition """A capability of a system. SystemCapability describes what a system can expose, monitor, control, or actuate with respect to one or more signals. Aligned to ssn-system:SystemCapability; linked from System instances via ssn-system:hasSystemCapability, and from Signals via ssn:forProperty. Profile-level inheritance (shared vs. type-specific signals) is expressed in CapabilityProfile, not here.
""" ;
    skos:exactMatch ssn-system:SystemCapability ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:angle_ref a owl:DatatypeProperty ;
    rdfs:label "angle_ref" ;
    rdfs:range xsd:float ;
    skos:definition "Reference bend angle in radians." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:control_system a owl:ObjectProperty ;
    rdfs:label "control_system" ;
    rdfs:range narad:ControlSystem ;
    skos:definition "Identifier of the control system (e.g. epics)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:data_type a owl:ObjectProperty ;
    rdfs:label "data_type" ;
    rdfs:range narad:DataTypeEnum ;
    skos:definition "The data type of the signal's value." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:deployed_system a owl:ObjectProperty ;
    rdfs:label "deployed_system" ;
    rdfs:range narad:DeployedSystem ;
    skos:definition "Identifier of the deployed system this configuration describes." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:e1 a owl:DatatypeProperty ;
    rdfs:label "e1" ;
    rdfs:range xsd:float ;
    skos:definition "Entry edge angle in radians." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:e2 a owl:DatatypeProperty ;
    rdfs:label "e2" ;
    rdfs:range xsd:float ;
    skos:definition "Exit edge angle in radians." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:facility_element_type a owl:DatatypeProperty ;
    rdfs:label "facility_element_type" ;
    rdfs:range xsd:string ;
    skos:altLabel "type" ;
    skos:definition "capture the facility-specific or local designation (e.g., \"QW\", \"WarmCavity\", \"HCorrector\").  Isused for local naming, inventory, or legacy mapping of instances of facility elements (within elements:)  to the facility-specific type designations used in the control system or elsewhere at the facility." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:facility_param_set a owl:ObjectProperty ;
    rdfs:label "facility_param_set" ;
    rdfs:range narad:FacilityParamSet ;
    skos:definition "Facility-specific element parameters (type designation, model name, open property map)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    rdfs:range xsd:float ;
    skos:definition "RF frequency in Hz." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:full_pattern a owl:DatatypeProperty ;
    rdfs:label "full_pattern" ;
    rdfs:range xsd:string ;
    skos:definition "A regex pattern that the full resolved value (e.g. after template substitution) must match for validation." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:identifier_type a owl:ObjectProperty ;
    rdfs:label "identifier_type" ;
    rdfs:range narad:IdentifierTypeEnum ;
    skos:definition "The type of identifier used in the identifier slot (e.g. DOI, ARK, URL, local)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:identifier_value a owl:DatatypeProperty ;
    rdfs:label "identifier_value" ;
    rdfs:range xsd:string ;
    skos:definition "The value of the identifier (e.g. the DOI string, ARK string, URL string, or local ID)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:intent a owl:DatatypeProperty ;
    rdfs:label "intent" ;
    rdfs:range xsd:string ;
    skos:definition "A human-readable statement of the intended use or purpose of this NARAD configuration." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:is_hosted_by a owl:ObjectProperty ;
    rdfs:label "is_hosted_by" ;
    rdfs:range narad:DeployedSystem ;
    skos:broadMatch ssn:isHostedBy,
        ssn-system:hasSubSystem ;
    skos:definition """Links an InstanceSignalBinding to the FacilitySystem it belongs to. This is the edge that connects the facility-specific bindings to the Facility node in the graph.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:modeled_as a owl:DatatypeProperty ;
    rdfs:label "modeled_as" ;
    rdfs:range xsd:string ;
    skos:definition "Accelerator physics code model element type (e.g. RFCA, KQUAD, HKICK)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:multipass a owl:DatatypeProperty ;
    rdfs:label "multipass" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether this beamline is a multipass recirculating line (true) or a single-pass line (false)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable name or local string key for the entity." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:narad_config a owl:ObjectProperty ;
    rdfs:label "narad_config" ;
    rdfs:range narad:NaradConfig ;
    skos:altLabel "narad" ;
    skos:definition "Top-level NARAD configuration block (capability_layer + signal_layer)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:param_set a owl:ObjectProperty ;
    rdfs:label "param_set" ;
    rdfs:range narad:ElementParamSet ;
    skos:definition "Named physics-parameter blocks for this element (e.g. RFP, BendP, MagneticMultipoleP)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:pattern a owl:DatatypeProperty ;
    rdfs:label "pattern" ;
    rdfs:range xsd:string ;
    skos:definition "A regex pattern that the value of this slot must match for validation." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:periodic a owl:DatatypeProperty ;
    rdfs:label "periodic" ;
    rdfs:range xsd:boolean ;
    skos:definition "For a beamline, indicates whether the orbit and Twiss parameters are periodic (true) or non-periodic (false)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:phase a owl:DatatypeProperty ;
    rdfs:label "phase" ;
    rdfs:range xsd:float ;
    skos:definition "RF phase in degrees." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:properties a owl:ObjectProperty ;
    rdfs:label "properties" ;
    rdfs:range narad:AnyValue ;
    skos:definition "Intentionally open-ended key-value property map for element-specific or facility-specific parameters." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:pv_name a owl:DatatypeProperty ;
    rdfs:label "pv_name" ;
    rdfs:range xsd:string ;
    skos:definition """Fully-resolved facility-specific process variable name, e.g. MQWK202:STAT or MQWK202:BDL.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:required a owl:DatatypeProperty ;
    rdfs:label "required" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether this configuration element is required for a valid configuration." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:range narad:SignalRoleEnum ;
    skos:definition "The semantic role of the signal within its capability." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:schema_version a owl:DatatypeProperty ;
    rdfs:label "schema_version" ;
    rdfs:range xsd:string ;
    skos:definition "Version of the NARAD schema used in this document." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:signal_code_suffix a owl:DatatypeProperty ;
    rdfs:label "signal_code_suffix" ;
    rdfs:range xsd:string ;
    skos:definition """Facility-specific control-system (e.g. EPICS) naming suffix used to derive or interpret the signal binding, e.g. .S, M, :GSET.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:signal_layer a owl:ObjectProperty ;
    rdfs:label "signal_layer" ;
    rdfs:range narad:SignalLayer ;
    skos:definition "Signal suffix templates for this facility." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:template a owl:DatatypeProperty ;
    rdfs:label "template" ;
    rdfs:range xsd:string ;
    skos:definition "A template string for constructing control system PV names based on the semantic signal name and device instance. This can include placeholders for the device name and signal suffix, e.g. {device_name}{signal_suffix}." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:units a owl:DatatypeProperty ;
    rdfs:label "units" ;
    rdfs:range xsd:string ;
    skos:definition "Conventional unit symbol (e.g. A, MV/m, T*m, G/cm)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:units_uri a owl:DatatypeProperty ;
    rdfs:label "units_uri" ;
    rdfs:range xsd:string ;
    skos:definition "Machine-resolvable QUDT unit reference (e.g. si-unit:A for Ampere). The si-unit: prefix maps to http://qudt.org/vocab/unit/." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:voltage a owl:DatatypeProperty ;
    rdfs:label "voltage" ;
    rdfs:range xsd:float ;
    skos:definition "RF voltage in volts." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:zero_point a owl:ObjectProperty ;
    rdfs:label "zero_point" ;
    rdfs:range narad:BeamlineElement ;
    skos:definition "Name of a line item used as a reference point when  the beamline is used as a subline.\"" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:Device a owl:Class ;
    rdfs:label "Device" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:device_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:has_system_capability ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SignalBinding ;
            owl:onProperty narad:is_observed_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:device_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:is_observed_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SystemCapability ;
            owl:onProperty narad:has_system_capability ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ElementKindEnum ;
            owl:onProperty narad:device_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:subclass_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:System ;
            owl:onProperty narad:has_sub_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:subclass_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:System ;
            owl:onProperty narad:subclass_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:has_sub_system ],
        narad:System ;
    skos:broadMatch pals:Element ;
    skos:definition """A system representing a beam diagnostic instrument, magnet, or other non-magnet device. It represents the instrument as a whole rather than the control system for that instrument. In the SSN graph a Device is a subsystem of the Facility and a sibling to the ControlSystem. Also used in the SignalLayer to group signal bindings by device type. Aligned to ssn:System.
""" ;
    skos:exactMatch ssn:System ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:for_property a owl:DatatypeProperty ;
    rdfs:label "for_property" ;
    skos:definition """SystemCapability → Signal: the capability can expose, monitor, control, or actuate that signal.
""" ;
    skos:exactMatch ssn:forProperty ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:is_instance_of a owl:DatatypeProperty ;
    rdfs:label "is_instance_of" ;
    rdfs:range xsd:string ;
    skos:definition """NARAD alias for rdf:type. Links a facility-specific instance node to the LinkML class or semantic class it instantiates. In the graph this edge is labelled narad:isInstanceOf. Values are typically the rdf:type of the Class that implements the signal binding.
""" ;
    skos:exactMatch rdf:type ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:is_observed_by a owl:ObjectProperty ;
    rdfs:label "is_observed_by" ;
    rdfs:range narad:SignalBinding ;
    skos:definition "Control-system-specific, e.g. EPICS, suffix definitions keyed by signal name within a device/domain set. Can also be used to link a BeamlineElement instance to the signal bindings that observe or actuate it,  since the instance of the element is directly observed or controlled through a Device. Facility-specific bindings of signals to control-system interfaces (e.g. EPICS PVs) for a specific beamline element instance. These are the keyed by the semantic signal name (e.g. current_readback) rather than the control-system suffix, which is captured in the SignalBinding. The semantic signal name links the instance binding to the abstract Signal definition and its place in the capability profile, while the SignalBinding captures the concrete implementations of the abstract SignalBindings referenced by the element's capability profile." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:Signal a owl:Class ;
    rdfs:label "Signal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:units ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:units ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:data_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:units ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:DataTypeEnum ;
            owl:onProperty narad:data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:units_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:units_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:units_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SignalRoleEnum ;
            owl:onProperty narad:role ],
        narad:NamedThing ;
    skos:altLabel "EPICS Process Variable",
        "control signal",
        "control-system signal",
        "epics_pv",
        "process_variable",
        "pv" ;
    skos:broadMatch qudt:QuantityKind,
        sosa:Property,
        ssn:Property ;
    skos:definition """Domain term for a control-system signal. A Signal represents an identifiable quantity, state, setpoint, readback, limit, or status. In SSN/SOSA alignment, NARAD Signals are treated as properties of systems (ssn:forProperty). The concrete facility binding is captured in SignalBinding.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:BeamlineElement a owl:Class ;
    rdfs:label "BeamlineElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom narad:ElementParamSet ;
            owl:onProperty narad:param_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:param_set ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ElementKindEnum ;
            owl:onProperty narad:is_instance_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:InstanceSignalBinding ;
            owl:onProperty narad:is_observed_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:param_set ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:is_observed_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:is_instance_of ],
        narad:NamedThing ;
    skos:broadMatch pals:Element ;
    skos:definition "A single element in a beamline with its kind and optional NARAD capability annotations." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:Capability a owl:Class ;
    rdfs:label "Capability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:is_property_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ElementKindEnum ;
            owl:onProperty narad:device_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:subclass_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:ControlSystem ;
            owl:onProperty narad:is_property_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:device_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:has_signal ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Signal ;
            owl:onProperty narad:has_signal ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:Capability ;
            owl:onProperty narad:subclass_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:device_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:is_property_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:subclass_of ],
        narad:NamedThing ;
    skos:definition "A reusable device-type control profile that extends a generic shared capability with type-specific signals (e.g. QuadrupoleCurrentControlProfile)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:SignalRoleEnum a owl:Class ;
    rdfs:label "SignalRoleEnum" ;
    owl:unionOf ( <https://example.org/narad_linkml/schema/narad/SignalRoleEnum#control> <https://example.org/narad_linkml/schema/narad/SignalRoleEnum#readback> <https://example.org/narad_linkml/schema/narad/SignalRoleEnum#constraint> <https://example.org/narad_linkml/schema/narad/SignalRoleEnum#status> ) ;
    skos:definition "Controlled vocabulary for the semantic role of a signal within a capability." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> ;
    linkml:permissible_values <https://example.org/narad_linkml/schema/narad/SignalRoleEnum#constraint>,
        <https://example.org/narad_linkml/schema/narad/SignalRoleEnum#control>,
        <https://example.org/narad_linkml/schema/narad/SignalRoleEnum#readback>,
        <https://example.org/narad_linkml/schema/narad/SignalRoleEnum#status> .

narad:example a owl:DatatypeProperty ;
    rdfs:label "example" ;
    rdfs:range xsd:string ;
    skos:definition "A single example of how this naming convention is applied to a specific device instance and signal." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:has_control_system a owl:ObjectProperty ;
    rdfs:label "has_control_system" ;
    rdfs:domain narad:System ;
    rdfs:range narad:ControlSystem ;
    skos:broadMatch ssn-system:hasSubSystem ;
    skos:definition """Relates a System to one of its control systems (SSN alignment to sub system). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:has_sub_system a owl:ObjectProperty ;
    rdfs:label "has_sub_system" ;
    rdfs:domain narad:System ;
    rdfs:range narad:System ;
    skos:definition """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
    skos:exactMatch ssn-system:hasSubSystem ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:is_property_of a owl:ObjectProperty ;
    rdfs:label "is_property_of" ;
    rdfs:range narad:ControlSystem ;
    skos:broadMatch ssn:isPropertyOf ;
    skos:definition """Inverse of for_property: links the Class Signal to the Class of SignalBinding Procedure that implements it. This can also link the Instance of a SignalBinding to the ControlSystem that implements it. This is the edge that connects the signal definitions to the facility-specific bindings in the graph. Values are typically the ControlSystem that implements this binding, e.g. narad:epics (for EPICS control system). NOTE: The value of this slot must match one of the values in narad_config.has_sub_system.
""" ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:length a owl:DatatypeProperty ;
    rdfs:label "length" ;
    rdfs:range xsd:float ;
    skos:definition "Physical length of the element in meters." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:subclass_of a owl:ObjectProperty ;
    rdfs:label "subclass_of" ;
    rdfs:range narad:System ;
    skos:definition "-> NARAD alias for rdfs:subClassOf. Links a type-specific capability to the generic capability it extends. In the graph this edge is labelled narad:subclassOf." ;
    skos:exactMatch rdfs:subClassOf ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:SystemTypeEnum a owl:Class ;
    rdfs:label "SystemTypeEnum" ;
    owl:unionOf ( <https://example.org/narad_linkml/schema/narad/SystemTypeEnum#Facility> <https://example.org/narad_linkml/schema/narad/SystemTypeEnum#ControlSystem> <https://example.org/narad_linkml/schema/narad/SystemTypeEnum#Magnet> ) ;
    skos:definition "High-level system type for classification and querying. This is a broad categorization that can be used for filtering or grouping systems without needing to traverse the has_sub_system and has_system_capability edges." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> ;
    linkml:permissible_values <https://example.org/narad_linkml/schema/narad/SystemTypeEnum#ControlSystem>,
        <https://example.org/narad_linkml/schema/narad/SystemTypeEnum#Facility>,
        <https://example.org/narad_linkml/schema/narad/SystemTypeEnum#Magnet> .

narad:ControlSystem a owl:Class ;
    rdfs:label "ControlSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:has_sub_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:system_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty narad:has_sub_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty narad:has_system_capability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:system_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:has_system_capability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:has_naming_convention ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SystemTypeEnum ;
            owl:onProperty narad:system_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:NamingConvention ;
            owl:onProperty narad:has_naming_convention ],
        narad:System ;
    skos:definition """A control system (e.g. EPICS) that manages device process variables. In the SSN graph a ControlSystem is a subsystem of the Facility.
""" ;
    skos:exactMatch ssn:System ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:DataTypeEnum a owl:Class ;
    rdfs:label "DataTypeEnum" ;
    owl:unionOf ( ncit:C47840 ncit:C48150 ncit:C48870 ncit:C45253 ncit:C45254 ncit:C95637 ) ;
    skos:definition "Allowed data types for signal values." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> ;
    linkml:permissible_values ncit:C45253,
        ncit:C45254,
        ncit:C47840,
        ncit:C48150,
        ncit:C48870,
        ncit:C95637 .

narad:IdentifierTypeEnum a owl:Class ;
    rdfs:label "IdentifierTypeEnum" ;
    owl:unionOf ( <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#doi> <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#ark> <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#handle> <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#url> <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#local> <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#other> ) ;
    skos:definition "Allowed identifier types for facilities and other entities." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> ;
    linkml:permissible_values <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#ark>,
        <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#doi>,
        <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#handle>,
        <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#local>,
        <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#other>,
        <https://example.org/narad_linkml/schema/narad/IdentifierTypeEnum#url> .

narad:has_system_capability a owl:ObjectProperty ;
    rdfs:label "has_system_capability" ;
    rdfs:domain narad:System ;
    rdfs:range narad:SystemCapability ;
    skos:definition """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
    skos:exactMatch ssn-system:hasSystemCapability ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "Detailed description of the entity." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:device_type a owl:ObjectProperty ;
    rdfs:label "device_type" ;
    rdfs:range narad:ElementKindEnum ;
    skos:definition "Represents the generic, semantic class of the device (e.g., \"Quadrupole\", \"BPM\") and is used for capability, instrument, and signal profile matching." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:system_type a owl:ObjectProperty ;
    rdfs:label "system_type" ;
    rdfs:range narad:SystemTypeEnum ;
    skos:definition "High-level system type for classification and querying." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:NamedThing a owl:Class ;
    rdfs:label "NamedThing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty narad:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty narad:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:description ] ;
    skos:definition "Abstract base class providing identity and human-readable metadata." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:System a owl:Class ;
    rdfs:label "System" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:has_system_capability ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:System ;
            owl:onProperty narad:has_sub_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty narad:system_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:has_sub_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty narad:system_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SystemCapability ;
            owl:onProperty narad:has_system_capability ],
        [ a owl:Restriction ;
            owl:allValuesFrom narad:SystemTypeEnum ;
            owl:onProperty narad:system_type ],
        narad:NamedThing ;
    skos:definition """A physical, logical, or cyber-physical system involved in sensing, monitoring, control, or actuation. Broadly aligned to ssn:System.
""" ;
    skos:exactMatch ssn:System ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> .

narad:ElementKindEnum a owl:Class ;
    rdfs:label "ElementKindEnum" ;
    owl:unionOf ( <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Drift> <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Marker> <https://example.org/narad_linkml/schema/narad/ElementKindEnum#BPM> <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Corrector> <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Dipole> <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Quadrupole> <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Solenoid> <https://example.org/narad_linkml/schema/narad/ElementKindEnum#CavityGradient> <https://example.org/narad_linkml/schema/narad/ElementKindEnum#RFCavity> <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Instrument> <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Magnet> ) ;
    skos:definition "Controlled vocabulary for beamline element types, shared between the capability layer (CapabilityProfile.device_type) and the element layer (BeamlineElement.kind). Keeping the enum here keeps profile device_type values in sync with element kind values without circular imports. Values must stay aligned with CapabilityProfile.device_type. NOTE: The kind of a BeamlineElement must match the device_type of the Device referenced by is_instance_of." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/system> ;
    linkml:permissible_values <https://example.org/narad_linkml/schema/narad/ElementKindEnum#BPM>,
        <https://example.org/narad_linkml/schema/narad/ElementKindEnum#CavityGradient>,
        <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Corrector>,
        <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Dipole>,
        <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Drift>,
        <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Instrument>,
        <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Magnet>,
        <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Marker>,
        <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Quadrupole>,
        <https://example.org/narad_linkml/schema/narad/ElementKindEnum#RFCavity>,
        <https://example.org/narad_linkml/schema/narad/ElementKindEnum#Solenoid> .


