    {
      "name": "ElectricMultipoleP",
      "definition_uri": "https://example.org/narad/ElectricMultipoleP",
      "description": "Mixin for electric multipole parameters, \nwhich can be used to describe the electric field components of an accelerator element.\nThis mixin is aligned with PALS ElectricMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS).\nExample with three multipole components (N=0,1,2): ```yaml components: - order: 7\n  tilt: 0.7\n- order: 3\n  En: 27.3\n- order: 2\n  EnL: 3.47e1\n```",
      "from_schema": "https://w3id.org/accelerator-core",
      "exact_mappings": [
        "pals:ElectricMultipoleP"
      ],
      "broad_mappings": [
        "pals:ElectricMultipoleP"
      ],
      "mixin": true,
      "slots": [
        "electricMultipoleP__components"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "components",
          "description": "Electric multipole components, one per order N.",
          "range": "MultipoleComponent",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://example.org/narad/ElectricMultipoleP",
      "@type": "ClassDefinition"
    },
    {
      "name": "MagneticMultipoleP",
      "definition_uri": "https://example.org/narad/MagneticMultipoleP",
      "description": "Mixin for magnetic multipole parameters, \nwhich can be used to describe the magnetic field components of an accelerator element.\nThis mixin is aligned with PALS MagneticMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS).\nExample with three multipole components (N=0,1,2): ```yaml components: - order: 7\n  tilt: 0.7\n- order: 3\n  Bn: 27.3\n- order: 2\n  BnL: 3.47e1\n- order: 1\n  Kn: 0.85     # normalized form, e.g. a quadrupole's k1-like strength\n```",
      "from_schema": "https://w3id.org/accelerator-core",
      "exact_mappings": [
        "pals:MagneticMultipoleP"
      ],
      "broad_mappings": [
        "pals:MagneticMultipoleP"
      ],
      "mixin": true,
      "slots": [
        "magneticMultipoleP__components"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "components",
          "description": "Magnetic multipole components, one per order N.",
          "range": "MultipoleComponent",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://example.org/narad/MagneticMultipoleP",
      "@type": "ClassDefinition"
    },
    {
      "name": "MultipoleComponent",
      "definition_uri": "https://example.org/narad/MultipoleComponent",
      "description": "A single order's electric (or magnetic) multipole component.\nOnly the fields supporting Electric Multipoles  OR the fields for Magnetic Multipoles should be present, not both.\nNot a mixin, but a class used in the ElectricMultipoleP and MagneticMultipoleP mixins to represent individual multipole components.",
      "from_schema": "https://w3id.org/accelerator-core",
      "slots": [
        "multipoleComponent__order",
        "multipoleComponent__tilt",
        "multipoleComponent__En",
        "multipoleComponent__Es",
        "multipoleComponent__EnL",
        "multipoleComponent__EsL",
        "multipoleComponent__Bn",
        "multipoleComponent__Bs",
        "multipoleComponent__Kn",
        "multipoleComponent__Ks"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "order",
          "description": "Multipole order N (0 = dipole, 1 = quadrupole, etc.)",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tilt",
          "description": "Tilt of the Nth multipole.",
          "broad_mappings": [
            "pals:tilt"
          ],
          "range": "float",
          "unit": {
            "ucum_code": "rad",
            "@type": "UnitOfMeasure"
          },
          "@type": "SlotDefinition"
        },
        {
          "name": "En",
          "description": "Normal component of the field.",
          "broad_mappings": [
            "pals:EnN"
          ],
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "Es",
          "description": "Skew component of the field.",
          "broad_mappings": [
            "pals:EsN"
          ],
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "EnL",
          "description": "Length-integrated normal component.",
          "broad_mappings": [
            "pals:EnNL"
          ],
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "EsL",
          "description": "Length-integrated skew component.",
          "broad_mappings": [
            "pals:EsNL"
          ],
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "Bn",
          "description": "Normal component of the magnetic field.",
          "broad_mappings": [
            "pals:BnN"
          ],
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "Bs",
          "description": "Skew component of the magnetic field.",
          "broad_mappings": [
            "pals:BsN"
          ],
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "Kn",
          "description": "Normalized normal component.",
          "broad_mappings": [
            "pals:KnN"
          ],
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "Ks",
          "description": "Normalized skew component.",
          "broad_mappings": [
            "pals:KsN"
          ],
          "range": "float",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://example.org/narad/MultipoleComponent",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "Es",
                "value_presence": {
                  "text": "PRESENT",
                  "@type": "PermissibleValue"
                },
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "Bn",
                "value_presence": {
                  "text": "ABSENT",
                  "@type": "PermissibleValue"
                },
                "@type": "SlotDefinition"
              },
              {
                "name": "Bs",
                "value_presence": {
                  "text": "ABSENT",
                  "@type": "PermissibleValue"
                },
                "@type": "SlotDefinition"
              },
              {
                "name": "Kn",
                "value_presence": {
                  "text": "ABSENT",
                  "@type": "PermissibleValue"
                },
                "@type": "SlotDefinition"
              },
              {
                "name": "Ks",
                "value_presence": {
                  "text": "ABSENT",
                  "@type": "PermissibleValue"
                },
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "If Es is present, then Bn, Bs, Kn, Ks should NOT be present",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "En",
                "value_presence": {
                  "text": "PRESENT",
                  "@type": "PermissibleValue"
                },
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "Bn",
                "value_presence": {
                  "text": "ABSENT",
                  "@type": "PermissibleValue"
                },
                "@type": "SlotDefinition"
              },
              {
                "name": "Bs",
                "value_presence": {
                  "text": "ABSENT",
                  "@type": "PermissibleValue"
                },
                "@type": "SlotDefinition"
              },
              {
