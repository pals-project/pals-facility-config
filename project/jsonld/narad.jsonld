  "classes": [
    {
      "name": "NARAD",
      "definition_uri": "https://example.org/narad/NARAD",
      "description": "Root container for accelerator core components, semantic signals, and local bindings.",
      "from_schema": "https://w3id.org/accelerator-core",
      "slots": [
        "type",
        "nARAD__description",
        "nARAD__physical_components",
        "nARAD__virtual_components",
        "nARAD__beamlines",
        "nARAD__supporting_facility_components",
        "nARAD__signals",
        "nARAD__signal_bindings",
        "nARAD__component_relations"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "description",
          "description": "Human-readable description for the representation of a particle accelerator and its operations.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "physical_components",
          "description": "A list of physical components in the accelerator system.",
          "range": "PhysicalComponent",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "virtual_components",
          "description": "A list of virtual components in the accelerator system.",
          "range": "VirtualComponent",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "beamlines",
          "description": "A list of beamlines in the accelerator system.",
          "range": "Beamline",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "supporting_facility_components",
          "description": "A list of supporting facility components in the accelerator system.",
          "range": "SupportingFacilityComponent",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "signals",
          "description": "A list of signals in the accelerator system.",
          "range": "Signal",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "signal_bindings",
          "description": "A list of signal bindings in the accelerator system (Component <-> Signal relationships).",
          "range": "SignalBinding",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "component_relations",
          "description": "A list of component relations in the accelerator system (Component <-> Component relationships).",
          "range": "ComponentRelation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://example.org/narad/NARAD",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "MetaP",
      "definition_uri": "https://example.org/narad/MetaP",
      "description": "Mixin class for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS).",
      "from_schema": "https://w3id.org/accelerator-core",
      "broad_mappings": [
        "pals:MetaP"
      ],
      "mixin": true,
      "slots": [
        "metaP__description",
        "metaP__label",
        "metaP__alias",
        "metaP__additional_metadata"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "description",
          "description": "Human-readable description.",
          "slot_uri": "pals:description",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "label",
          "description": "A label string.",
          "slot_uri": "pals:label",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "alias",
          "description": "An alternative name or identifier for the instance.",
          "slot_uri": "pals:alias",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "additional_metadata",
          "description": "Additional metadata or annotations for the instance.",
          "range": "MetadataEntry",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
