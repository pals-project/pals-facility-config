    {
      "name": "Beamline",
      "definition_uri": "https://example.org/narad/Beamline",
      "description": "A top-level NARAD-system for an ordered sequence of beamline elements defining a beam path.",
      "from_schema": "https://w3id.org/accelerator-core",
      "exact_mappings": [
        "pals:BeamLine"
      ],
      "is_a": "VirtualComponent",
      "slots": [
        "id",
        "type",
        "component__native_types",
        "metaP__description",
        "metaP__label",
        "metaP__alias",
        "metaP__additional_metadata",
        "virtualComponent__function",
        "virtualComponent__beamline_relation",
        "floorP__x",
        "floorP__y",
        "floorP__z",
        "floorP__theta",
        "floorP__phi",
        "floorP__psi",
        "beamline__multipass",
        "beamline__length",
        "beamline__zero_point",
        "beamline__periodic",
        "beamline__repeat",
        "beamline__direction"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "multipass",
          "description": "Indicates whether the beamline is a multipass beamline, where the beam passes through the same physical elements multiple times.\nIf not provided, the default assumption is that the beamline is single-pass.",
          "slot_uri": "pals:multipass",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "length",
          "description": "The total length of the beamline.\nFor pals interoperability, use m as the unit of length.",
          "slot_uri": "pals:length",
          "range": "float",
          "@type": "SlotDefinition"
        },
        {
          "name": "zero_point",
          "description": "Name of a line item used as a reference point when the BeamLine is used as a subline.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "periodic",
          "description": "Indicates whether orbit and Twiss parameters periodic.\nIf not provided, the default assumption is that the beamline is not periodic.",
          "slot_uri": "pals:periodic",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "repeat",
          "description": "Repetition count. If not provided, the default assumption is that the beamline is not repeated and the value is 1.\nIf value is greater than 1, the beamline is repeated that many times.",
          "slot_uri": "pals:repeat",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "direction",
          "description": "Beam direction along the beamline: +1 or -1. \nLongitudinal orientation. Default is +1.",
          "slot_uri": "pals:direction",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://example.org/narad/Beamline",
      "@type": "ClassDefinition"
    },
    {
      "name": "Signal",
      "definition_uri": "https://example.org/narad/Signal",
      "description": "Semantic meaning of a control-system signal associated with a component.",
      "from_schema": "https://w3id.org/accelerator-core",
      "broad_mappings": [
        "sosa:Sensor",
        "sosa:Actuator"
