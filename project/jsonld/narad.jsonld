  "classes": [
    {
      "name": "PALS",
      "definition_uri": "https://pals-project.readthedocs.io/PALS",
      "description": "Root container for accelerator core components, semantic signals, and local bindings.",
      "from_schema": "https://w3id.org/accelerator-core",
      "slots": [
        "kind",
        "description",
        "affiliation",
        "pALS__version",
        "pALS__authors",
        "pALS__notes",
        "pALS__facility"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "version",
          "description": "Version of the representation of a particle accelerator and its operations.",
          "range": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "@type": "SlotDefinition"
        },
        {
          "name": "authors",
          "description": "Contains the authorship information for this representation of an accelerator facility and its operations.",
          "range": "Author",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "notes",
          "description": "Additional notes or comments about the representation of a particle accelerator and its operations.",
          "range": "string",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "facility",
          "description": "A facility that contains lattice elements (physical and virtual), beamlines, parameter set commands, signals, etc.",
          "range": "Facility",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://pals-project.readthedocs.io/PALS",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "Author",
      "definition_uri": "https://pals-project.readthedocs.io/Author",
      "description": "Contains authorship information for a representation of an accelerator facility and its operations.",
      "from_schema": "https://w3id.org/accelerator-core",
      "slots": [
        "name",
        "affiliation",
        "author__email",
        "author__orcid"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "email",
          "description": "The email address of the author.",
          "range": "string",
          "pattern": "^[^@]+@[^@]+\\.[^@]+$",
          "@type": "SlotDefinition"
        },
        {
          "name": "orcid",
          "description": "The ORCID identifier of the author.",
          "range": "string",
          "pattern": "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://pals-project.readthedocs.io/Author",
      "@type": "ClassDefinition"
    },
    {
      "name": "Facility",
      "definition_uri": "https://pals-project.readthedocs.io/Facility",
      "description": "A facility that houses one or more accelerators.",
      "from_schema": "https://w3id.org/accelerator-core",
      "slots": [
        "identifiers",
        "facility__components",
        "facility__beamlines",
        "facility__signals",
        "facility__signal_bindings",
        "facility__component_relations"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "components",
          "description": "A list of physical components in the accelerator system.",
          "range": "Component",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "beamlines",
          "description": "A list of beamlines in the accelerator system.",
          "range": "BeamLine",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "signals",
          "description": "A list of signals in the accelerator system.",
          "range": "Signal",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "signal_bindings",
          "description": "A list of signal bindings in the accelerator system (Component <-> Signal relationships).",
          "range": "SignalBinding",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "component_relations",
          "description": "A list of component relations in the accelerator system (Component <-> Component relationships).",
          "range": "ComponentRelation",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://pals-project.readthedocs.io/Facility",
      "@type": "ClassDefinition"
    },
    {
      "name": "Affiliation",
      "definition_uri": "https://pals-project.readthedocs.io/Affiliation",
      "description": "Contains affiliation information for an author or component, such as a ROR.",
      "from_schema": "https://w3id.org/accelerator-core",
      "slots": [
        "id",
        "name",
        "identifiers"
      ],
      "slot_usage": {},
      "class_uri": "https://pals-project.readthedocs.io/Affiliation",
      "@type": "ClassDefinition"
    },
    {
      "name": "Identifier",
      "definition_uri": "https://pals-project.readthedocs.io/Identifier",
      "description": "A unique, and ideally persistent, identifier for a facility, such as a DOI or ROR.",
      "from_schema": "https://w3id.org/accelerator-core",
      "slots": [
        "identifier__identifier_type",
        "identifier__identifier_value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier_type",
          "description": "The type of identifier, such as DOI | PURL | ROR | LOCAL | URL | ARK.",
          "range": "IdentifierTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "identifier_value",
          "description": "The value of the identifier.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://pals-project.readthedocs.io/Identifier",
      "@type": "ClassDefinition"
    },
    {
      "name": "HasMetaP",
      "definition_uri": "https://pals-project.readthedocs.io/HasMetaP",
