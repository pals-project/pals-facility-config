    {
      "name": "Component",
      "definition_uri": "https://pals-project.readthedocs.io/Component",
      "description": "A general class for accelerator components, which can be specialized into more specific types like AcceleratorDevice, Magnet, etc.",
      "from_schema": "https://w3id.org/accelerator-core",
      "broad_mappings": [
        "pals:Element"
      ],
      "abstract": true,
      "mixins": [
        "HasMetaP"
      ],
      "slots": [
        "id",
        "kind",
        "component__native_types",
        "hasMetaP__MetaP"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "native_types",
          "description": "The native type of the component in the source system, which can be used to identify the component across different source systems.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://pals-project.readthedocs.io/Component",
      "@type": "ClassDefinition"
    },
    {
      "name": "PhysicalComponent",
      "definition_uri": "https://pals-project.readthedocs.io/PhysicalComponent",
      "description": "A physical item that participates in or supports accelerator operation.  This can be used to capture physical components, such as magnets, cavities, diagnostics, vacuum devices, and racks that are important for understanding the structure and function of the accelerator system.",
      "from_schema": "https://w3id.org/accelerator-core",
      "broad_mappings": [
        "pals:Element"
      ],
      "is_a": "Component",
      "mixins": [
        "HasFloorP",
        "HasLongitudinalPlacementP"
      ],
      "slots": [
        "id",
        "kind",
        "component__native_types",
        "hasMetaP__MetaP",
        "physicalComponent__functions",
        "physicalComponent__beamline_relation",
        "hasFloorP__FloorP",
        "hasLongitudinalPlacementP__LongitudinalPlacementP"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "functions",
          "description": "The function of the physical component,  which can be used to identify the component across different source systems.",
          "slot_uri": "pals:physical_function",
          "range": "PhysicalFunctionEnum",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
