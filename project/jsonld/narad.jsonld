    {
      "name": "Component",
      "definition_uri": "https://example.org/narad/Component",
      "description": "A general class for accelerator components, which can be specialized into more specific types like AcceleratorDevice, Magnet, etc.",
      "from_schema": "https://w3id.org/accelerator-core",
      "broad_mappings": [
        "pals:Element"
      ],
      "abstract": true,
      "mixins": [
        "MetaP"
      ],
      "slots": [
        "id",
        "type",
        "component__native_types",
        "metaP__description",
        "metaP__label",
        "metaP__alias",
        "metaP__additional_metadata"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "native_types",
          "description": "The native type of the component in the source system, which can be used to identify the component across different source systems.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://example.org/narad/Component",
      "@type": "ClassDefinition"
    },
    {
      "name": "PhysicalComponent",
      "definition_uri": "https://example.org/narad/PhysicalComponent",
      "description": "A physical item that participates in or supports accelerator operation.  This can be used to capture physical components, such as magnets, cavities, diagnostics, vacuum devices, and racks that are important for understanding the structure and function of the accelerator system.",
      "from_schema": "https://w3id.org/accelerator-core",
      "broad_mappings": [
        "pals:Element"
      ],
      "is_a": "Component",
      "mixins": [
        "FloorP",
        "HasLongitudinalPlacement"
      ],
      "slots": [
        "id",
        "type",
        "component__native_types",
        "metaP__description",
        "metaP__label",
        "metaP__alias",
        "metaP__additional_metadata",
        "physicalComponent__function",
        "physicalComponent__beamline_relation",
        "floorP__x",
        "floorP__y",
        "floorP__z",
        "floorP__theta",
        "floorP__phi",
        "floorP__psi",
        "hasLongitudinalPlacement__length",
        "hasLongitudinalPlacement__s_position"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "function",
          "description": "The function of the physical component,  which can be used to identify the component across different source systems.",
          "slot_uri": "narad:physical_function",
          "range": "PhysicalFunctionEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "beamline_relation",
          "description": "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems.",
          "slot_uri": "narad:physical_beamline_relation",
          "range": "PhysicalRelationEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://example.org/narad/PhysicalComponent",
      "@type": "ClassDefinition"
    },
    {
      "name": "VirtualComponent",
      "definition_uri": "https://example.org/narad/VirtualComponent",
      "description": "A virtual or logical component that represents a concept, function, or role in the accelerator  beamline operation but does not have a physical instantiation.  This can be used to capture abstract components, such as Markers, BeamlineSections, and FacilitySpaces that are important for understanding the structure and function of the accelerator system but are not physical devices.",
      "from_schema": "https://w3id.org/accelerator-core",
      "broad_mappings": [
        "pals:Element",
        "pals:BookkeepingElement"
      ],
      "is_a": "Component",
