    {
      "name": "HasLongitudinalPlacement",
      "definition_uri": "https://example.org/narad/HasLongitudinalPlacement",
      "description": "Mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis. \nCorresponds to PALS's ungrouped element parameters `length` and `s_position`.\nOne (or both) `length` or `s_position` must be present.",
      "from_schema": "https://w3id.org/accelerator-core",
      "mixin": true,
      "slots": [
        "hasLongitudinalPlacement__length",
        "hasLongitudinalPlacement__s_position"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "length",
          "description": "Length of the element (arc length for bends).",
          "slot_uri": "pals:length",
          "range": "float",
          "unit": {
            "ucum_code": "m",
            "@type": "UnitOfMeasure"
          },
          "@type": "SlotDefinition"
        },
        {
          "name": "s_position",
          "description": "Longitudinal position of the element along the beamline.",
          "slot_uri": "pals:s_position",
          "range": "float",
          "unit": {
            "ucum_code": "m",
            "@type": "UnitOfMeasure"
          },
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://example.org/narad/HasLongitudinalPlacement",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "id",
                "value_presence": {
                  "text": "PRESENT",
                  "@type": "PermissibleValue"
                },
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "length",
                    "value_presence": {
                      "text": "PRESENT",
                      "@type": "PermissibleValue"
                    },
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "s_position",
                    "value_presence": {
                      "text": "PRESENT",
                      "@type": "PermissibleValue"
                    },
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "An element must have a length and/or a position along the beamline.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
