@prefix linkml: <https://w3id.org/linkml/> .
@prefix narad: <https://example.org/narad_linkml/schema/narad/> .
@prefix ncit: <http://purl.obolibrary.org/obo/ncit.owl> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

narad:ActuatableSignal a sh:NodeShape ;
    sh:closed true ;
    sh:description """A NARAD signal that can be commanded, set, or acted upon. Examples: current_setpoint, strength_setpoint, kick_setpoint, field_setpoint, current_min, current_max, gradient_setpoint. Aligned to sosa:ActuatableProperty.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ],
        [ sh:description "The semantic role of the signal within its capability." ;
            sh:in ( "control" "readback" "constraint" "status" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:role ],
        [ sh:datatype xsd:string ;
            sh:description "Machine-resolvable QUDT unit reference (e.g. si-unit:A for Ampere). The si-unit: prefix maps to http://qudt.org/vocab/unit/." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:units_uri ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Conventional unit symbol (e.g. A, MV/m, T*m, G/cm)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:units ],
        [ sh:description "The data type of the signal's value." ;
            sh:in ( ncit:C47840 ncit:C48150 ncit:C48870 ncit:C45253 ncit:C45254 ncit:C95637 ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:data_type ] ;
    sh:targetClass narad:ActuatableSignal .

narad:CapabilityLayer a sh:NodeShape ;
    sh:closed true ;
    sh:description "Capability-layer container for control profile families." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:Capability ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:capabilities ] ;
    sh:targetClass narad:CapabilityLayer .

narad:Instrument a sh:NodeShape ;
    sh:closed true ;
    sh:description "A generic beam diagnostic instrument." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:has_system_capability ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:name ],
        [ sh:description "High-level system type for classification and querying." ;
            sh:in ( "Facility" "ControlSystem" "Magnet" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:system_type ],
        [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:has_sub_system ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:description ] ;
    sh:targetClass narad:Instrument .

narad:NamedThing a sh:NodeShape ;
    sh:closed false ;
    sh:description "Abstract base class providing identity and human-readable metadata." ;
    sh:ignoredProperties ( narad:role narad:has_system_capability narad:examples narad:has_naming_convention rdf:type narad:subclass_of narad:is_hosted_by narad:device_type narad:system_type narad:template narad:param_set narad:template_components narad:multipass narad:signal_code_suffix narad:pattern narad:pv_name narad:length narad:has_control_system narad:line narad:hosts_device narad:units narad:is_property_of narad:is_instance_of narad:full_pattern narad:has_sub_system narad:facility_identifier narad:has_signal narad:units_uri narad:data_type narad:required narad:is_observed_by narad:for_property narad:periodic narad:zero_point ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:name ] ;
    sh:targetClass narad:NamedThing .

narad:NaradModel a sh:NodeShape ;
    sh:closed true ;
    sh:description "Top-level NARAD document container." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:NaradConfig ;
            sh:description "Top-level NARAD configuration block (capability_layer + signal_layer)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:narad_config ],
        [ sh:class narad:BeamlineElement ;
            sh:description "Beamline element definitions referenced by name from beamline sequences. Serializes as a keyed map by element name." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:elements ],
        [ sh:class narad:Beamline ;
            sh:description "A top-level NARAD-system container for the ordered beamline definitions keyed by beamline name. Serializes as a keyed map by beamline name." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:beamlines ] ;
    sh:targetClass narad:NaradModel .

narad:ObservableSignal a sh:NodeShape ;
    sh:closed true ;
    sh:description """A NARAD signal that is read, monitored, observed, or exposed by a system. Examples: current_readback, status, horizontal_beam_position, gradient_readback. Aligned to sosa:ObservableProperty.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The semantic role of the signal within its capability." ;
            sh:in ( "control" "readback" "constraint" "status" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:role ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Conventional unit symbol (e.g. A, MV/m, T*m, G/cm)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:units ],
        [ sh:description "The data type of the signal's value." ;
            sh:in ( ncit:C47840 ncit:C48150 ncit:C48870 ncit:C45253 ncit:C45254 ncit:C95637 ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:data_type ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ],
        [ sh:datatype xsd:string ;
            sh:description "Machine-resolvable QUDT unit reference (e.g. si-unit:A for Ampere). The si-unit: prefix maps to http://qudt.org/vocab/unit/." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:units_uri ] ;
    sh:targetClass narad:ObservableSignal .

narad:TemplateExample a sh:NodeShape ;
    sh:closed true ;
    sh:description """An example of a control system PV name generated from a naming convention template, along with a description of what it represents.  This can be used to illustrate how the template works in practice and to provide concrete examples of the expected PV naming convention for different device types and signals.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "A single example of how this naming convention is applied to a specific device instance and signal." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:example ] ;
    sh:targetClass narad:TemplateExample .

narad:Beamline a sh:NodeShape ;
    sh:closed true ;
    sh:description "A top-level NARAD-system for an ordered sequence of beamline elements defining a beam path." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:BeamlineElement ;
            sh:description "Name of a line item used as a reference point when  the beamline is used as a subline.\"" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:zero_point ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:name ],
        [ sh:datatype xsd:float ;
            sh:description "Physical length of the element in meters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:length ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates whether this beamline is a multipass recirculating line (true) or a single-pass line (false)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:multipass ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path narad:description ],
        [ sh:datatype xsd:boolean ;
            sh:description "For a beamline, indicates whether the orbit and Twiss parameters are periodic (true) or non-periodic (false)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:periodic ],
        [ sh:class narad:BeamlineElement ;
            sh:description "Ordered sequence of beamline elements in this beamline. Serializes as a list of element names (BeamlineElement names) referencing the keys in the elements map This is not a direct containment slot; the actual element definitions are in the top-level elements map." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path narad:line ] ;
    sh:targetClass narad:Beamline .

narad:DeployedSystem a sh:NodeShape ;
    sh:closed true ;
    sh:description """A deployed system, with an identified facility, that is the subject of a NARAD configuration.  This is the child of the target of the narad_config.deployed_system slot. In the SSN graph a DeployedSystem is a broad mapping to the ssn:Deployment and also is equivalent to the signal_layers.facilities entries.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:name ],
        [ sh:class narad:ControlSystem ;
            sh:description """Relates a System to one of its control systems (SSN alignment to sub system). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:has_control_system ],
        [ sh:class narad:FacilityIdentifier ;
            sh:description "Globally unique identifier for the facility, with specified type and value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:facility_identifier ],
        [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:has_sub_system ],
        [ sh:description "High-level system type for classification and querying - set to Facility for all DeployedSystem instances." ;
            sh:in ( "Facility" "ControlSystem" "Magnet" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path narad:system_type ],
        [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path narad:has_system_capability ] ;
    sh:targetClass narad:DeployedSystem .

narad:ElementParamSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "Named physics-parameter block for a beamline element. The name identifies the block type (e.g. RFP, BendP, MagneticMultipoleP, SolenoidP)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Entry edge angle in radians." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:e1 ],
        [ sh:datatype xsd:float ;
            sh:description "Exit edge angle in radians." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:e2 ],
        [ sh:datatype xsd:float ;
            sh:description "RF voltage in volts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:voltage ],
        [ sh:datatype xsd:float ;
            sh:description "Reference bend angle in radians." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:angle_ref ],
        [ sh:datatype xsd:float ;
            sh:description "RF phase in degrees." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:phase ],
        [ sh:datatype xsd:float ;
            sh:description "First-order magnetic multipole coefficient (quadrupole strength)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path narad:Kn1 ],
        [ sh:datatype xsd:float ;
            sh:description "RF frequency in Hz." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:frequency ],
        [ sh:class narad:FacilityParamSet ;
            sh:description "Facility-specific element parameters (type designation, model name, open property map)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path narad:facility_param_set ],
        [ sh:datatype xsd:float ;
            sh:description "Solenoid integrated field strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path narad:Ksol ] ;
    sh:targetClass narad:ElementParamSet .

narad:FacilityIdentifier a sh:NodeShape ;
    sh:closed true ;
    sh:description "A globally unique identifier for an entity (e.g., facility), with a specified type (e.g. DOI, ROR, ARK, local)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The type of identifier used in the identifier slot (e.g. DOI, ARK, URL, local)." ;
            sh:in ( "doi" "ark" "handle" "url" "local" "other" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:identifier_type ],
        [ sh:datatype xsd:string ;
            sh:description "The value of the identifier (e.g. the DOI string, ARK string, URL string, or local ID)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:identifier_value ] ;
    sh:targetClass narad:FacilityIdentifier .

narad:FacilityParamSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "Facility-specific element parameters block for beamline elements. Differs from an ElementParamSet in that it captures facility-specific metadata about the element (e.g. type designation, model name) rather than physics parameters." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "capture the facility-specific or local designation (e.g., \"QW\", \"WarmCavity\", \"HCorrector\").  Isused for local naming, inventory, or legacy mapping of instances of facility elements (within elements:)  to the facility-specific type designations used in the control system or elsewhere at the facility." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:facility_element_type ],
        [ sh:datatype xsd:string ;
            sh:description "Accelerator physics code model element type (e.g. RFCA, KQUAD, HKICK)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:modeled_as ],
        [ sh:class linkml:Any ;
            sh:description "Intentionally open-ended key-value property map for element-specific or facility-specific parameters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path narad:properties ] ;
    sh:targetClass narad:FacilityParamSet .

narad:FacilitySystem a sh:NodeShape ;
    sh:closed true ;
    sh:description "Facility-specific signal binding configuration." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path narad:has_system_capability ],
        [ sh:class narad:Device ;
            sh:description "Structured container for facility-specific signal suffix templates." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:hosts_device ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path narad:description ],
        [ sh:description "High-level system type for classification and querying." ;
            sh:in ( "Facility" "ControlSystem" "Magnet" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path narad:system_type ],
        [ sh:class narad:ControlSystem ;
            sh:description """Relates a System to one of its control systems (SSN alignment to sub system). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:has_control_system ],
        [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:has_sub_system ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:name ] ;
    sh:targetClass narad:FacilitySystem .

narad:InstanceSignalBinding a sh:NodeShape ;
    sh:closed true ;
    sh:description """A facility-specific binding between a NARAD Signal and an implementation interface (e.g. an EPICS process variable). Modeled as sosa:Sensor because it describes how a signal is observed, monitored, or actuated. ssn:forProperty → Signal; narad:isInstanceOf → the capability class.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:name ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path narad:description ],
        [ sh:class narad:Signal ;
            sh:description """NARAD alias for rdf:type. Links a facility-specific instance node to the LinkML class or semantic class it instantiates. In the graph this edge is labelled narad:isInstanceOf. Values are typically the rdf:type of the Class that implements the signal binding.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:is_instance_of ],
        [ sh:datatype xsd:string ;
            sh:description """Links an InstanceSignalBinding to the FacilitySystem it belongs to. This is the edge that connects the facility-specific bindings to the Facility node in the graph.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:is_hosted_by ],
        [ sh:class narad:SignalBinding ;
            sh:description """SystemCapability → Signal: the capability can expose, monitor, control, or actuate that signal.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:for_property ],
        [ sh:class narad:ControlSystem ;
            sh:description """Inverse of for_property: links the Class Signal to the Class of SignalBinding Procedure that implements it. This can also link the Instance of a SignalBinding to the ControlSystem that implements it. This is the edge that connects the signal definitions to the facility-specific bindings in the graph. Values are typically the ControlSystem that implements this binding, e.g. narad:epics (for EPICS control system). NOTE: The value of this slot must match one of the values in narad_config.has_sub_system.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path narad:is_property_of ],
        [ sh:datatype xsd:string ;
            sh:description """Fully-resolved facility-specific process variable name, e.g. MQWK202:STAT or MQWK202:BDL.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:pv_name ] ;
    sh:targetClass narad:InstanceSignalBinding .

narad:NamingConvention a sh:NodeShape ;
    sh:closed true ;
    sh:description """A template for constructing facility-specific signal names from a semantic signal name and a control-system-specific suffix.  The template is used to generate the full control system PV name for a given device instance and semantic signal by substituting the device name and signal code suffix into the template.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:NamingConventionExample ;
            sh:description "Examples of how this naming convention is applied to specific device instances and signals." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:examples ],
        [ sh:class narad:TemplateComponent ;
            sh:description "Structured components of the naming convention template, for capturing the template in a more machine-actionable way than a raw string.  For example, you could have components for the device name, signal suffix, and any fixed parts of the naming convention." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:template_components ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ],
        [ sh:datatype xsd:string ;
            sh:description "A regex pattern that the full resolved value (e.g. after template substitution) must match for validation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:full_pattern ],
        [ sh:datatype xsd:string ;
            sh:description "A template string for constructing control system PV names based on the semantic signal name and device instance. This can include placeholders for the device name and signal suffix, e.g. {device_name}{signal_suffix}." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:template ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ] ;
    sh:targetClass narad:NamingConvention .

narad:NamingConventionExample a sh:NodeShape ;
    sh:closed true ;
    sh:description """An example of a control system naming convention, illustrating how the template is used to generate full control system PV names from semantic signal names and device instance information.  This can be used to provide concrete examples of the expected PV naming convention for different device types and signals based on the defined NamingConvention template.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "A single example of how this naming convention is applied to a specific device instance and signal." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:example ] ;
    sh:targetClass narad:NamingConventionExample .

narad:NaradConfig a sh:NodeShape ;
    sh:closed true ;
    sh:description "A top-level NARAD-system container for the: capability layer + signal layer." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:ControlSystem ;
            sh:description "Identifier of the control system (e.g. epics) this configuration describes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:control_system ],
        [ sh:class narad:Device ;
            sh:description "Device Capability definitions keyed by capability name." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path narad:device_layer ],
        [ sh:class narad:SignalLayer ;
            sh:description "Signal-layer container for facility-specific signal bindings." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path narad:signal_layer ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the NARAD schema used in this document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:schema_version ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable statement of the intended use or purpose of this NARAD configuration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:intent ],
        [ sh:class narad:DeployedSystem ;
            sh:description "Identifier of the deployed system this configuration describes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:deployed_system ],
        [ sh:class narad:Capability ;
            sh:description "Control Capability definitions for this facility." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path narad:capability_layer ] ;
    sh:targetClass narad:NaradConfig .

narad:SignalLayer a sh:NodeShape ;
    sh:closed true ;
    sh:description "Signal-layer container for facility-specific signal bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:FacilitySystem ;
            sh:description "Facility-specific signal binding configurations keyed by facility name." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:facilities ] ;
    sh:targetClass narad:SignalLayer .

narad:TemplateComponent a sh:NodeShape ;
    sh:closed true ;
    sh:description """A component of a naming convention template, representing a variable part of the control system PV name that is substituted based on the device instance and signal definition.  For example, in the template "{device_name}{signal_code_suffix}", "device_name" and "signal_code_suffix" would be TemplateComponents that are replaced with the actual device name and signal code suffix for each specific binding.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A regex pattern that the value of this slot must match for validation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:pattern ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates whether this configuration element is required for a valid configuration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:required ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:name ] ;
    sh:targetClass narad:TemplateComponent .

linkml:Any a sh:NodeShape ;
    sh:closed true ;
    sh:description "Unconstrained type — accepts any YAML/JSON value (string, number, object, list, etc.)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

narad:Device a sh:NodeShape ;
    sh:closed true ;
    sh:description """A system representing a beam diagnostic instrument, magnet, or other non-magnet device. It represents the instrument as a whole rather than the control system for that instrument. In the SSN graph a Device is a subsystem of the Facility and a sibling to the ControlSystem. Also used in the SignalLayer to group signal bindings by device type. Aligned to ssn:System.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:has_sub_system ],
        [ sh:class narad:System ;
            sh:description "-> NARAD alias for rdfs:subClassOf. Links a type-specific capability to the generic capability it extends. In the graph this edge is labelled narad:subclassOf." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:subclass_of ],
        [ sh:description "High-level system type for classification and querying." ;
            sh:in ( "Facility" "ControlSystem" "Magnet" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path narad:system_type ],
        [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:has_system_capability ],
        [ sh:description "Represents the generic, semantic class of the device (e.g., \"Quadrupole\", \"BPM\") and is used for capability, instrument, and signal profile matching." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "CavityGradient" "RFCavity" "Instrument" "Magnet" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path narad:device_type ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path narad:description ],
        [ sh:class narad:SignalBinding ;
            sh:description "Control-system-specific, e.g. EPICS, suffix definitions keyed by signal name within a device/domain set. Can also be used to link a BeamlineElement instance to the signal bindings that observe or actuate it,  since the instance of the element is directly observed or controlled through a Device. Facility-specific bindings of signals to control-system interfaces (e.g. EPICS PVs) for a specific beamline element instance. These are the keyed by the semantic signal name (e.g. current_readback) rather than the control-system suffix, which is captured in the SignalBinding. The semantic signal name links the instance binding to the abstract Signal definition and its place in the capability profile, while the SignalBinding captures the concrete implementations of the abstract SignalBindings referenced by the element's capability profile." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path narad:is_observed_by ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path narad:name ] ;
    sh:targetClass narad:Device .

narad:Signal a sh:NodeShape ;
    sh:closed true ;
    sh:description """Domain term for a control-system signal. A Signal represents an identifiable quantity, state, setpoint, readback, limit, or status. In SSN/SOSA alignment, NARAD Signals are treated as properties of systems (ssn:forProperty). The concrete facility binding is captured in SignalBinding.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Conventional unit symbol (e.g. A, MV/m, T*m, G/cm)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:units ],
        [ sh:datatype xsd:string ;
            sh:description "Machine-resolvable QUDT unit reference (e.g. si-unit:A for Ampere). The si-unit: prefix maps to http://qudt.org/vocab/unit/." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:units_uri ],
        [ sh:description "The semantic role of the signal within its capability." ;
            sh:in ( "control" "readback" "constraint" "status" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:role ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:description "The data type of the signal's value." ;
            sh:in ( ncit:C47840 ncit:C48150 ncit:C48870 ncit:C45253 ncit:C45254 ncit:C95637 ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:data_type ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ] ;
    sh:targetClass narad:Signal .

narad:SignalBinding a sh:NodeShape ;
    sh:closed true ;
    sh:description "A named control system suffix definition for one semantic signal. The suffix is used within in a template naming convention to construct the full control system PV name for a given device instance." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Facility-specific control-system (e.g. EPICS) naming suffix used to derive or interpret the signal binding, e.g. .S, M, :GSET.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:signal_code_suffix ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:name ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:description ] ;
    sh:targetClass narad:SignalBinding .

narad:BeamlineElement a sh:NodeShape ;
    sh:closed true ;
    sh:description "A single element in a beamline with its kind and optional NARAD capability annotations." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description """NARAD alias for rdf:type. Links a facility-specific instance node to the LinkML class or semantic class it instantiates. In the graph this edge is labelled narad:isInstanceOf. Values are typically the rdf:type of the Class that implements the signal binding.
""" ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "CavityGradient" "RFCavity" "Instrument" "Magnet" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:is_instance_of ],
        [ sh:class narad:ElementParamSet ;
            sh:description "Named physics-parameter blocks for this element (e.g. RFP, BendP, MagneticMultipoleP)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path narad:param_set ],
        [ sh:datatype xsd:float ;
            sh:description "Physical length of the element in meters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:length ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:class narad:InstanceSignalBinding ;
            sh:description "Control-system-specific, e.g. EPICS, suffix definitions keyed by signal name within a device/domain set. Can also be used to link a BeamlineElement instance to the signal bindings that observe or actuate it,  since the instance of the element is directly observed or controlled through a Device. Facility-specific bindings of signals to control-system interfaces (e.g. EPICS PVs) for a specific beamline element instance. These are the keyed by the semantic signal name (e.g. current_readback) rather than the control-system suffix, which is captured in the SignalBinding. The semantic signal name links the instance binding to the abstract Signal definition and its place in the capability profile, while the SignalBinding captures the concrete implementations of the abstract SignalBindings referenced by the element's capability profile." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:is_observed_by ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ] ;
    sh:targetClass narad:BeamlineElement .

narad:Capability a sh:NodeShape ;
    sh:closed true ;
    sh:description "A reusable device-type control profile that extends a generic shared capability with type-specific signals (e.g. QuadrupoleCurrentControlProfile)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ],
        [ sh:class narad:Capability ;
            sh:description "Links a type-specific capability to the generic capability it extends via rdfs:subClassOf." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:subclass_of ],
        [ sh:description "Represents the generic, semantic class of the device (e.g., \"Quadrupole\", \"BPM\") and is used for capability, instrument, and signal profile matching." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "CavityGradient" "RFCavity" "Instrument" "Magnet" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:device_type ],
        [ sh:class narad:ControlSystem ;
            sh:description "Links the capability layer to the control systems it applies to via ssn:isPropertyOf." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:is_property_of ],
        [ sh:class narad:Signal ;
            sh:description "Signals within a capability, keyed by a semantic signal name." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:has_signal ] ;
    sh:targetClass narad:Capability .

narad:ControlSystem a sh:NodeShape ;
    sh:closed true ;
    sh:description """A control system (e.g. EPICS) that manages device process variables. In the SSN graph a ControlSystem is a subsystem of the Facility.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:has_system_capability ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ],
        [ sh:description "High-level system type for classification and querying - set to ControlSystem for all ControlSystem instances." ;
            sh:in ( "Facility" "ControlSystem" "Magnet" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:system_type ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:has_sub_system ],
        [ sh:class narad:NamingConvention ;
            sh:description "Signal naming conventions used by this control system defined in a machine actionable manner.  This is where you would capture the patterns/templates for how control system PVs or signals are constructed for this control system,  for example, the EPICS convention of using suffixes like .R, .S, :GSET to indicate readback, status, and setpoint signals. Multiple naming conventions can be captured if a control system uses more than one convention for different device types or domains." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:has_naming_convention ] ;
    sh:targetClass narad:ControlSystem .

narad:SystemCapability a sh:NodeShape ;
    sh:closed true ;
    sh:description """A capability of a system. SystemCapability describes what a system can expose, monitor, control, or actuate with respect to one or more signals. Aligned to ssn-system:SystemCapability; linked from System instances via ssn-system:hasSystemCapability, and from Signals via ssn:forProperty. Profile-level inheritance (shared vs. type-specific signals) is expressed in CapabilityProfile, not here.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:name ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:description ],
        [ sh:description "Represents the generic, semantic class of the device (e.g., \"Quadrupole\", \"BPM\") and is used for capability, instrument, and signal profile matching." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "CavityGradient" "RFCavity" "Instrument" "Magnet" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:device_type ],
        [ sh:datatype xsd:string ;
            sh:description """SystemCapability → Signal: the capability can expose, monitor, control, or actuate that signal.
""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:for_property ] ;
    sh:targetClass narad:SystemCapability .

narad:System a sh:NodeShape ;
    sh:closed true ;
    sh:description """A physical, logical, or cyber-physical system involved in sensing, monitoring, control, or actuation. Broadly aligned to ssn:System.
""" ;
    sh:ignoredProperties ( narad:device_type narad:is_observed_by narad:has_naming_convention rdf:type narad:subclass_of narad:facility_identifier narad:has_control_system narad:hosts_device ) ;
    sh:property [ sh:description "High-level system type for classification and querying." ;
            sh:in ( "Facility" "ControlSystem" "Magnet" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:system_type ],
        [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:has_sub_system ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:name ],
        [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:has_system_capability ] ;
    sh:targetClass narad:System .

