narad:ComponentRelation a sh:NodeShape ;
    sh:closed true ;
    sh:description "Association between two Components (Physical or Virtual), with supporting contextual/qualifying information about how and where the relationship holds." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "beam_direction" "facility_coordinates" "local_component_frame" "tunnel_stationing" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path narad:reference_frame ],
        [ sh:class narad:Beamline ;
            sh:description "The specific Beamline this relationship is defined with respect to (relevant when context=beamline_order)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:beamline_context ],
        [ sh:class narad:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdf:subject ],
        [ sh:in ( unit:MilliM unit:M unit:A unit:T-M unit:PA unit:TORR unit:REM-PER-H unit:MREM-PER-H unit:V unit:KiloW unit:DEG unit:MegaV-PER-M "G_per_cm" unit:NUM "none" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path narad:distance_unit ],
        [ sh:description "The frame of reference / domain in which this relationship is asserted to hold." ;
            sh:in ( "beamline_order" "Euclidean_3D" "Euclidean_2D" "floorplan" "containment" "installation_mounting" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:context ],
        [ sh:in ( "upstream" "downstream" "positive" "negative" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path narad:direction ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:distance_value ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path narad:id ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path narad:tolerance_value ],
        [ sh:in ( "x" "y" "z" "s" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path narad:axis ],
        [ sh:class narad:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path rdf:object ],
        [ sh:in ( BFO:0000063 BFO:0000062 BFO:0000051 BFO:0000050 RO:0002170 RO:0002220 RO:0002131 narad:mounted_on narad:intersects narad:nearest_to ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 11 ;
            sh:path rdf:predicate ],
        [ sh:in ( unit:MilliM unit:M unit:A unit:T-M unit:PA unit:TORR unit:REM-PER-H unit:MREM-PER-H unit:V unit:KiloW unit:DEG unit:MegaV-PER-M "G_per_cm" unit:NUM "none" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path narad:tolerance_unit ] ;
    sh:targetClass narad:ComponentRelation .

narad:SignalBinding a sh:NodeShape ;
    sh:closed true ;
    sh:description "Association between a PhysicalComponent and one of its Signals, e.g. QUAD1.QUAD1_STATUS_binding." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:Signal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rdf:object ],
        [ sh:in ( "has_signal" "has_status_signal" "has_setpoint_signal" "has_readback_signal" "has_command_signal" "has_limit_signal" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path rdf:predicate ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:id ],
        [ sh:class narad:PhysicalComponent ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rdf:subject ] ;
    sh:targetClass narad:SignalBinding .

narad:SupportingFacilityComponent a sh:NodeShape ;
    sh:closed true ;
    sh:description """A physical component that supports accelerator operation 
without a specific beam-pipe placement, 
such as a power supply, control rack, or radiation detector.
These can include Girders, Racks, Power Supplies, 
and other physical infrastructure components that are important for understanding 
the structure and function of the accelerator system but are not inline with the beamline.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Shift in the Z direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:z_offset ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path narad:id ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path narad:native_types ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path pals:z_rot ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal position of the element along the beamline." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:s_position ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:phi ],
        [ sh:class narad:MetadataEntry ;
            sh:description "Additional metadata or annotations for the instance." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path narad:additional_metadata ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the element (arc length for bends)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:length ],
        [ sh:datatype xsd:float ;
            sh:description "Global X coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:x ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:psi ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamline" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 15 ;
            sh:path narad:physical_beamline_relation ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path narad:type ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:float ;
            sh:description "Global Z coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:z ],
        [ sh:datatype xsd:string ;
            sh:description "A label string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path pals:label ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path pals:y_rot ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path pals:description ],
        [ sh:datatype xsd:float ;
            sh:description "Orientation angle around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:theta ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:x_rot ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Y direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:y_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Global Y coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:y ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the X direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:x_offset ],
        [ sh:description "The function of the supporting facility component,  which can be used to identify the component across different source systems." ;
            sh:in ( "Support" "Alignment" "PowerSupply" "ControlRack" "Cooling" "Detection" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path narad:supporting_facility_function ] ;
    sh:targetClass narad:SupportingFacilityComponent .

narad:VirtualComponent a sh:NodeShape ;
    sh:closed true ;
    sh:description "A virtual or logical component that represents a concept, function, or role in the accelerator  beamline operation but does not have a physical instantiation.  This can be used to capture abstract components, such as Markers, BeamlineSections, and FacilitySpaces that are important for understanding the structure and function of the accelerator system but are not physical devices." ;
    sh:ignoredProperties ( pals:y_rot narad:length pals:x_offset pals:repeat pals:y_offset pals:phi_b pals:z_rot rdf:type pals:alpha_a narad:direction pals:eta_y pals:eta_x pals:phi_a pals:alpha_b pals:periodic pals:beta_a pals:beta_b pals:etap_x pals:x_rot pals:etap_y pals:z_offset narad:zero_point pals:multipass ) ;
    sh:property [ sh:class narad:MetadataEntry ;
            sh:description "Additional metadata or annotations for the instance." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path narad:additional_metadata ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path narad:native_types ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:phi ],
        [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:Beamline pals:Marker pals:Fork "Control" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path narad:virtual_function ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path narad:type ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Orientation angle around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:theta ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path narad:id ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamline" "NotAssociatedWithBeamline" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path narad:virtual_beamline_relation ],
        [ sh:datatype xsd:float ;
            sh:description "Global X coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:x ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:description ],
        [ sh:datatype xsd:float ;
            sh:description "Global Y coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:y ],
        [ sh:datatype xsd:float ;
            sh:description "Global Z coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:z ],
        [ sh:datatype xsd:string ;
            sh:description "A label string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:label ] ;
    sh:targetClass narad:VirtualComponent .

narad:Beamline a sh:NodeShape ;
    sh:closed true ;
    sh:description "A top-level NARAD-system for an ordered sequence of beamline elements defining a beam path." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Global X coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:x ],
        [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:Beamline pals:Marker pals:Fork "Control" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path narad:virtual_function ],
        [ sh:datatype xsd:integer ;
            sh:description """Repetition count. If not provided, the default assumption is that the beamline is not repeated and the value is 1.
If value is greater than 1, the beamline is repeated that many times.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:repeat ],
        [ sh:class narad:MetadataEntry ;
            sh:description "Additional metadata or annotations for the instance." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path narad:additional_metadata ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path pals:alias ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamline" "NotAssociatedWithBeamline" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path narad:virtual_beamline_relation ],
        [ sh:datatype xsd:float ;
            sh:description "Orientation angle around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:theta ],
        [ sh:datatype xsd:integer ;
            sh:description """Beam direction along the beamline: +1 or -1. 
Longitudinal orientation. Default is +1.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:direction ],
        [ sh:datatype xsd:string ;
            sh:description "Name of a line item used as a reference point when the BeamLine is used as a subline." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:zero_point ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:phi ],
        [ sh:datatype xsd:float ;
            sh:description "Global Y coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:y ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path narad:id ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path narad:type ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether orbit and Twiss parameters periodic.
If not provided, the default assumption is that the beamline is not periodic.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:periodic ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path pals:description ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path pals:psi ],
        [ sh:datatype xsd:float ;
            sh:description """The total length of the beamline.
For pals interoperability, use m as the unit of length.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:length ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the beamline is a multipass beamline, where the beam passes through the same physical elements multiple times.
If not provided, the default assumption is that the beamline is single-pass.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:multipass ],
        [ sh:datatype xsd:string ;
            sh:description "A label string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path pals:label ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path narad:native_types ],
        [ sh:datatype xsd:float ;
            sh:description "Global Z coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:z ] ;
    sh:targetClass narad:Beamline .

narad:Component a sh:NodeShape ;
    sh:closed false ;
    sh:description "A general class for accelerator components, which can be specialized into more specific types like AcceleratorDevice, Magnet, etc." ;
    sh:ignoredProperties ( narad:length pals:pc_ref pals:y_rot pals:x pals:phi pals:E_tot_ref pals:x_offset pals:repeat pals:y_offset pals:phi_b pals:z_rot pals:y rdf:type pals:alpha_a narad:direction pals:eta_y pals:psi narad:plane pals:eta_x pals:s_position pals:phi_a narad:beamline_relation pals:species_ref pals:alpha_b pals:periodic narad:components pals:beta_a pals:beta_b pals:etap_x pals:x_rot pals:etap_y narad:function pals:z pals:Ksol pals:z_offset pals:Bsol pals:time_ref pals:theta narad:zero_point pals:multipass ) ;
