narad:MagneticMultipoleP a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin for magnetic multipole parameters, 
which can be used to describe the magnetic field components of an accelerator element.
This mixin is aligned with PALS MagneticMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS).
Example with three multipole components (N=0,1,2): ```yaml components: - order: 7
  tilt: 0.7
- order: 3
  Bn: 27.3
- order: 2
  BnL: 3.47e1
- order: 1
  Kn: 0.85     # normalized form, e.g. a quadrupole's k1-like strength
```""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:MultipoleComponent ;
            sh:description "Magnetic multipole components, one per order N." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:components ] ;
    sh:targetClass narad:MagneticMultipoleP .

narad:Marker a sh:NodeShape ;
    sh:closed true ;
    sh:description "A virtual component used as a reference point or marker in the beamline structure." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
