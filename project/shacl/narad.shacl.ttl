@prefix acc: <https://example.org/accelerator-core/> .
@prefix om: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix pals: <https://pals-project.readthedocs.io/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdf:Statement a sh:NodeShape ;
    sh:closed false ;
    sh:description "Abstract base for subject-predicate-object associations." ;
    sh:ignoredProperties ( pals:component_direction pals:coordinates pals:tolerance_value pals:context pals:reference_frame pals:tolerance_unit rdf:type om:Distance pals:beamline_context pals:distance_unit ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdf:subject ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdf:predicate ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rdf:object ] ;
    sh:targetClass rdf:Statement .

pals:ACKicker a sh:NodeShape ;
    sh:closed true ;
    sh:description "An ACKicker element simulates a time-dependent kicker.  It is like a Kicker element except that the field varies in time.  This element requires a user supplied time-dependent expression." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path pals:FloorP ],
        [ sh:class pals:ElectricMultipoleParamGroup ;
            sh:description "A mixin for electric multipole parameters that are aligned with PALS ElectricMultipoleP (Electric Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pals:ElectricMultipoleP ],
        [ sh:description "The function of the physical component,  which can be used to identify the component across different source systems." ;
            sh:in ( "Focusing" "Steering" "BeamPositionMeasurement" "VacuumGeneration" "RadiationMonitoring" "Measurement" "BeamAcceleration" "BeamLossDetection" "BeamCurrentMeasurement" "BeamProfileMeasurement" "MachineProtection" "TimingSynchronization" ) ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path pals:physical_function ],
        [ sh:class pals:ReferenceParamGroup ;
            sh:description "A mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pals:ReferenceP ],
        [ sh:class pals:TwissParamGroup ;
            sh:description "A mixin for Twiss parameters that are aligned with PALS TwissP (Twiss Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pals:TwissP ],
        [ sh:class pals:BodyShiftParamGroup ;
            sh:description "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pals:BodyShiftP ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path pals:MetaP ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:native_types ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path pals:alias ],
        [ sh:class pals:MagneticMultipoleParamGroup ;
            sh:description "A mixin for magnetic multipole parameters that are aligned with PALS MagneticMultipoleP (Magnetic Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pals:MagneticMultipoleP ],
        [ sh:class pals:LongitudinalPlacementParamGroup ;
            sh:description "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path pals:LongitudinalPlacementP ],
        [ sh:description "The transverse plane in which the kicker operates, either horizontal or vertical." ;
            sh:in ( "Horizontal" "Vertical" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path pals:plane ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance in uri/curie form, e.g. `pals:Quadrupole` or `pals:BeamProfileMonitor`." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rdf:type ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:id ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamLine" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path pals:physical_beamline_relation ] ;
    sh:targetClass pals:ACKicker .

pals:AdjacentToRelation a sh:NodeShape ;
    sh:closed true ;
    sh:description """A relationship indicating that the subject component is adjacent to the object component and not overlapping
 in a specified context, such as radiation detector and a magnet.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unit of the distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
            sh:in ( qudt:A qudt:DEG qudt:EV "eV_per_c" "eV_per_c2" "fundamental_charge" "G_per_cm" qudt:HZ qudt:KiloW qudt:M qudt:MilliM qudt:MREM-PER-H qudt:MegaV-PER-M qudt:PA "randians_pi2" "rem_per_h" qudt:SEC qudt:T qudt:T-M qudt:TORR qudt:V qudt:V-PER-M qudt:NUM "none" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path pals:distance_unit ],
        [ sh:description "Unit of the tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
            sh:in ( qudt:A qudt:DEG qudt:EV "eV_per_c" "eV_per_c2" "fundamental_charge" "G_per_cm" qudt:HZ qudt:KiloW qudt:M qudt:MilliM qudt:MREM-PER-H qudt:MegaV-PER-M qudt:PA "randians_pi2" "rem_per_h" qudt:SEC qudt:T qudt:T-M qudt:TORR qudt:V qudt:V-PER-M qudt:NUM "none" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path pals:tolerance_unit ],
        [ sh:in ( "beam_direction" "facility_coordinates" "local_component_frame" "tunnel_stationing" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path pals:reference_frame ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:id ],
        [ sh:datatype xsd:float ;
            sh:description "Distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path om:Distance ],
        [ sh:datatype xsd:string ;
            sh:description "The predicate of the relationship, which can be used to identify the relationship across different source systems." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rdf:predicate ],
        [ sh:datatype xsd:float ;
            sh:description "Tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:tolerance_value ],
        [ sh:in ( "upstream" "downstream" "positive" "negative" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path pals:component_direction ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path rdf:object ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdf:subject ],
        [ sh:class pals:CoordinateSet ;
            sh:description "A set of coordinates that define the spatial relationship between the two components. Only an edge-property slot for edges that require a set of coordinates to define the spatial relationship between two components in a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path pals:coordinates ],
        [ sh:description "The frame of reference / domain in which this relationship is asserted to hold." ;
            sh:in ( "beamline_order" "Euclidean_3D" "Euclidean_2D" "floorplan" "containment" "installation_mounting" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path pals:context ] ;
    sh:targetClass pals:AdjacentToRelation .

pals:Aperture a sh:NodeShape ;
    sh:closed true ;
    sh:description "A diagnostic or limiting aperture element used to constrain or characterize beam passage." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path pals:MetaP ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:id ],
        [ sh:class pals:TwissParamGroup ;
            sh:description "A mixin for Twiss parameters that are aligned with PALS TwissP (Twiss Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pals:TwissP ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamLine" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path pals:physical_beamline_relation ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pals:FloorP ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance in uri/curie form, e.g. `pals:Quadrupole` or `pals:BeamProfileMonitor`." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rdf:type ],
        [ sh:class pals:LongitudinalPlacementParamGroup ;
            sh:description "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pals:LongitudinalPlacementP ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:native_types ],
        [ sh:class pals:ReferenceParamGroup ;
            sh:description "A mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path pals:ReferenceP ],
        [ sh:description "The function of the physical component,  which can be used to identify the component across different source systems." ;
            sh:in ( "Focusing" "Steering" "BeamPositionMeasurement" "VacuumGeneration" "RadiationMonitoring" "Measurement" "BeamAcceleration" "BeamLossDetection" "BeamCurrentMeasurement" "BeamProfileMeasurement" "MachineProtection" "TimingSynchronization" ) ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path pals:physical_function ] ;
    sh:targetClass pals:Aperture .

pals:BeamLineSection a sh:NodeShape ;
    sh:closed true ;
    sh:description "A virtual component used to represent a section of the BeamLine for organizational or functional grouping of components." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:BeamLine pals:Marker pals:Drift pals:Fork "Control" ) ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path pals:virtual_function ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance in uri/curie form, e.g. `pals:Quadrupole` or `pals:BeamProfileMonitor`." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path rdf:type ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pals:MetaP ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:id ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:alias ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamLine" "NotAssociatedWithBeamLine" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path pals:virtual_beamline_relation ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:native_types ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path pals:FloorP ],
        [ sh:class pals:BodyShiftParamGroup ;
            sh:description "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pals:BodyShiftP ] ;
    sh:targetClass pals:BeamLineSection .

pals:BeamPositionMonitor a sh:NodeShape ;
    sh:closed true ;
    sh:description "A diagnostic device used to measure transverse beam position." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:LongitudinalPlacementParamGroup ;
            sh:description "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path pals:LongitudinalPlacementP ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamLine" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path pals:physical_beamline_relation ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance in uri/curie form, e.g. `pals:Quadrupole` or `pals:BeamProfileMonitor`." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rdf:type ],
        [ sh:class pals:BodyShiftParamGroup ;
            sh:description "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pals:BodyShiftP ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:native_types ],
        [ sh:class pals:ReferenceParamGroup ;
            sh:description "A mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path pals:ReferenceP ],
        [ sh:description "The function of the physical component,  which can be used to identify the component across different source systems." ;
            sh:in ( "Focusing" "Steering" "BeamPositionMeasurement" "VacuumGeneration" "RadiationMonitoring" "Measurement" "BeamAcceleration" "BeamLossDetection" "BeamCurrentMeasurement" "BeamProfileMeasurement" "MachineProtection" "TimingSynchronization" ) ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path pals:physical_function ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pals:FloorP ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path pals:MetaP ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:id ],
        [ sh:class pals:TwissParamGroup ;
            sh:description "A mixin for Twiss parameters that are aligned with PALS TwissP (Twiss Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pals:TwissP ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:alias ] ;
    sh:targetClass pals:BeamPositionMonitor .

