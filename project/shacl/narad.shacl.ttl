            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pals:LongitudinalPlacementP ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamLine" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path pals:physical_beamline_relation ],
        [ sh:class pals:BodyShiftParamGroup ;
            sh:description "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pals:BodyShiftP ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:native_types ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:alias ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path pals:MetaP ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pals:FloorP ],
        [ sh:description "The function of the supporting facility component,  which can be used to identify the component across different source systems." ;
            sh:in ( "Support" "Alignment" "PowerSupply" "ControlRack" "Cooling" "Diagnostics" "Detection" ) ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pals:supporting_facility_function ] ;
    sh:targetClass pals:SupportingFacilityComponent .

pals:VirtualComponent a sh:NodeShape ;
    sh:closed true ;
    sh:description "A virtual or logical component that represents a concept, function, or role in the accelerator  beamline operation but does not have a physical instantiation.  This can be used to capture abstract components, such as Markers, BeamLineSections, and FacilitySpaces that are important for understanding the structure and function of the accelerator system but are not physical devices." ;
    sh:ignoredProperties ( pals:multipass pals:periodic rdf:type pals:BodyShiftP pals:TwissP pals:length pals:direction pals:description pals:repeat ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:native_types ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamLine" "NotAssociatedWithBeamLine" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pals:virtual_beamline_relation ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pals:FloorP ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pals:MetaP ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:kind ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:id ],
        [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:BeamLine pals:Marker pals:Fork "Control" ) ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pals:virtual_function ] ;
    sh:targetClass pals:VirtualComponent .

pals:adjacent_to a sh:NodeShape ;
    sh:closed true ;
    sh:description """A relationship indicating that the subject component is adjacent to the object component and not overlapping
 in a specified context, such as radiation detector and a magnet.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "upstream" "downstream" "positive" "negative" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path pals:component_direction ],
        [ sh:class pals:CoordinateSet ;
            sh:description "A set of coordinates that define the spatial relationship between the two components. Only an edge-property slot for edges that require a set of coordinates to define the spatial relationship between two components in a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path pals:coordinates ],
        [ sh:description "The frame of reference / domain in which this relationship is asserted to hold." ;
            sh:in ( "beamline_order" "Euclidean_3D" "Euclidean_2D" "floorplan" "containment" "installation_mounting" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path pals:context ],
        [ sh:description "Unit of the distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
            sh:in ( "A" "degree" "eV" "eV_per_c" "eV_per_c2" "fundamental_charge" "G_per_cm" "Hz" "kW" "m" "mm" "mrem_per_h" "MV_per_m" "PA" "randians_pi2" "rem_per_h" "seconds" "T" "T_M" "Torr" "V" "V_per_m" "unitless" "none" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path pals:distance_unit ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The predicate of the relationship, which can be used to identify the relationship across different source systems." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rdf:predicate ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:id ],
        [ sh:datatype xsd:float ;
            sh:description "Tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:tolerance_value ],
        [ sh:datatype xsd:float ;
            sh:description "Distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path om:Distance ],
        [ sh:in ( "beam_direction" "facility_coordinates" "local_component_frame" "tunnel_stationing" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path pals:reference_frame ],
        [ sh:description "Unit of the tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
            sh:in ( "A" "degree" "eV" "eV_per_c" "eV_per_c2" "fundamental_charge" "G_per_cm" "Hz" "kW" "m" "mm" "mrem_per_h" "MV_per_m" "PA" "randians_pi2" "rem_per_h" "seconds" "T" "T_M" "Torr" "V" "V_per_m" "unitless" "none" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path pals:tolerance_unit ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdf:subject ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path rdf:object ] ;
    sh:targetClass pals:adjacent_to .

pals:contains a sh:NodeShape ;
    sh:closed true ;
    sh:description "A relationship indicating that the subject component contains the object component in a specified context,  such as within a BeamLineSection or other organizational grouping." ;
    sh:ignoredProperties ( rdf:type ) ;
