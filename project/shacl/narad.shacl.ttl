narad:NARAD a sh:NodeShape ;
    sh:closed true ;
    sh:description "Root container for accelerator core components, semantic signals, and local bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:Beamline ;
            sh:description "A list of beamlines in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path narad:beamlines ],
        [ sh:class narad:ComponentRelation ;
            sh:description "A list of component relations in the accelerator system (Component <-> Component relationships)." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path narad:component_relations ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description for the representation of a particle accelerator and its operations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:description ],
        [ sh:class narad:VirtualComponent ;
            sh:description "A list of virtual components in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:virtual_components ],
        [ sh:class narad:PhysicalComponent ;
            sh:description "A list of physical components in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:physical_components ],
        [ sh:class narad:Signal ;
            sh:description "A list of signals in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path narad:signals ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:type ],
        [ sh:class narad:SupportingFacilityComponent ;
            sh:description "A list of supporting facility components in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path narad:supporting_facility_components ],
        [ sh:class narad:SignalBinding ;
            sh:description "A list of signal bindings in the accelerator system (Component <-> Signal relationships)." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path narad:signal_bindings ] ;
    sh:targetClass narad:NARAD .

