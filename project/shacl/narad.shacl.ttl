            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pals:ReferenceP ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:native_types ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:id ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance in uri/curie form, e.g. `pals:Quadrupole` or `pals:BeamProfileMonitor`." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rdf:type ],
        [ sh:class pals:BodyShiftParamGroup ;
            sh:description "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pals:BodyShiftP ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path pals:MetaP ],
        [ sh:class pals:LongitudinalPlacementParamGroup ;
            sh:description "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path pals:LongitudinalPlacementP ],
        [ sh:class pals:MagneticMultipoleParamGroup ;
            sh:description "A mixin for magnetic multipole parameters that are aligned with PALS MagneticMultipoleP (Magnetic Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pals:MagneticMultipoleP ],
        [ sh:class pals:ElectricMultipoleParamGroup ;
            sh:description "A mixin for electric multipole parameters that are aligned with PALS ElectricMultipoleP (Electric Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pals:ElectricMultipoleP ],
        [ sh:class pals:RFParamGroup ;
            sh:description "A mixin for RF parameters that are aligned with PALS RFP (RF Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path pals:RFP ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamLine" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path pals:physical_beamline_relation ],
        [ sh:description "The function of the physical component,  which can be used to identify the component across different source systems." ;
            sh:in ( "Focusing" "Steering" "BeamPositionMeasurement" "VacuumGeneration" "RadiationMonitoring" "Measurement" "BeamAcceleration" "BeamLossDetection" "BeamCurrentMeasurement" "BeamProfileMeasurement" "MachineProtection" "TimingSynchronization" ) ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path pals:physical_function ] ;
    sh:targetClass pals:NormalConductingRFCavity .

