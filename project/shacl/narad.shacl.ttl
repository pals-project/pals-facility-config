pals:has_connecting_branch a sh:NodeShape ;
    sh:closed true ;
    sh:description "A relationship indicating that the subject component has a connecting branch to the object component in a specified context,  such as a beamline section having a fork as a connecting branch." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "upstream" "downstream" "positive" "negative" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path pals:component_direction ],
        [ sh:in ( "beam_direction" "facility_coordinates" "local_component_frame" "tunnel_stationing" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path pals:reference_frame ],
        [ sh:class pals:BeamLine ;
            sh:description "The specific BeamLine this relationship is defined with respect to (relevant when context=beamline_order). Only an edge-property slot for edges that are defined with respect to a specific BeamLine." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path pals:beamline_context ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path rdf:object ],
        [ sh:description "The frame of reference / domain in which this relationship is asserted to hold. For pals:has_connecting_branch, this is the Beamline context = beamline_context." ;
            sh:in ( "beamline_order" "Euclidean_3D" "Euclidean_2D" "floorplan" "containment" "installation_mounting" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pals:context ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rdf:subject ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:id ],
        [ sh:datatype xsd:anyURI ;
            sh:description "The predicate of the relationship, which can be used to identify the relationship across different source systems." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
