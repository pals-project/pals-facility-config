pals:OverlapsRelation a sh:NodeShape ;
    sh:closed true ;
    sh:description "A relationship indicating that the subject component overlaps the object component in a specified context,  such as a magnet and a diagnostic device." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path rdf:object ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:id ],
        [ sh:in ( "upstream" "downstream" "positive" "negative" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path pals:component_direction ],
        [ sh:datatype xsd:string ;
            sh:description "The predicate of the relationship, which can be used to identify the relationship across different source systems." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rdf:predicate ],
        [ sh:in ( "beam_direction" "facility_coordinates" "local_component_frame" "tunnel_stationing" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path pals:reference_frame ],
        [ sh:description "The frame of reference / domain in which this relationship is asserted to hold." ;
            sh:in ( "beamline_order" "Euclidean_3D" "Euclidean_2D" "floorplan" "containment" "installation_mounting" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pals:context ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rdf:subject ],
        [ sh:class pals:CoordinateSet ;
            sh:description "A set of coordinates that define the spatial relationship between the two components. Only an edge-property slot for edges that require a set of coordinates to define the spatial relationship between two components in a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path pals:coordinates ] ;
    sh:targetClass pals:OverlapsRelation .

pals:PALSAccelerator a sh:NodeShape ;
    sh:closed true ;
    sh:description "Root container for accelerator core components, semantic signals, and local bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version of the representation of a particle accelerator and its operations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:version ;
            sh:pattern "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" ],
        [ sh:class pals:Author ;
            sh:description "Contains the authorship information for this representation of an accelerator facility and its operations." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path pals:authors ],
        [ sh:class pals:Affiliation ;
            sh:description "The affiliation of the author or component, as a ROR." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pals:affiliation ],
        [ sh:class pals:Facility ;
            sh:description "A facility that contains lattice elements (physical and virtual), beamlines, parameter set commands, signals, etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path pals:facility ],
        [ sh:datatype xsd:string ;
            sh:description "Additional notes or comments about the representation of a particle accelerator and its operations." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:notes ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description of the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:description ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance in uri/curie form, e.g. `pals:Quadrupole` or `pals:BeamProfileMonitor`." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdf:type ] ;
    sh:targetClass pals:PALSAccelerator .

pals:ParamGroup a sh:NodeShape ;
    sh:closed false ;
    sh:description "Abstract base for inlined PALS parameter-group objects, giving each an identifier so it resolves to a stable node/IRI rather than a blank node when exported to RDF." ;
    sh:ignoredProperties ( pals:multipass_phase pals:s_position pals:bend_field_actual pals:y rdf:type pals:psi pals:etap_y pals:alpha_a pals:time_ref pals:L_sagitta pals:g_actual pals:E_tot_ref pals:phi pals:z pals:x pals:label pals:harmon pals:Ksol pals:num_cells pals:L_active pals:length pals:species_ref pals:g_ref pals:e1_rect pals:e2 pals:bend_field_ref pals:description pals:elec_components pals:x_offset pals:beta_a pals:mag_components pals:e1 pals:etap_x pals:edge1_int pals:h2 pals:Bsol pals:x_rot pals:ref_geometry pals:h1 pals:z_rot pals:edge2_int pals:z_offset pals:frequency pals:y_rot pals:e2_rect pals:pc_ref pals:beta_b pals:eta_x pals:phase pals:phi_a pals:dE_ref pals:cavity_type pals:theta pals:tilt_ref pals:zero_phase pals:y_offset pals:phi_b pals:eta_y pals:voltage pals:multipole_geometry pals:additional_metadata pals:L_chord pals:L_rectangle pals:alpha_b pals:angle_ref pals:rho_ref pals:alias ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:id ] ;
    sh:targetClass pals:ParamGroup .

pals:PrecedesRelation a sh:NodeShape ;
    sh:closed true ;
    sh:description "A relationship indicating that the subject component precedes the object component in a specified context,  such as along a beamline." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "upstream" "downstream" "positive" "negative" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path pals:component_direction ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rdf:subject ],
        [ sh:class pals:BeamLine ;
            sh:description "The specific BeamLine this relationship is defined with respect to (relevant when context=beamline_order). Only an edge-property slot for edges that are defined with respect to a specific BeamLine." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path pals:beamline_context ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path rdf:object ],
        [ sh:description "The frame of reference / domain in which this relationship is asserted to hold. For pals:precedes, this is the Beamline context = beamline_context." ;
            sh:in ( "beamline_order" "Euclidean_3D" "Euclidean_2D" "floorplan" "containment" "installation_mounting" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pals:context ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:id ],
        [ sh:datatype xsd:string ;
            sh:description "The predicate of the relationship, which can be used to identify the relationship across different source systems." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rdf:predicate ],
        [ sh:in ( "beam_direction" "facility_coordinates" "local_component_frame" "tunnel_stationing" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path pals:reference_frame ] ;
    sh:targetClass pals:PrecedesRelation .

pals:Quadrupole a sh:NodeShape ;
    sh:closed true ;
    sh:description """A magnet primarily used to focus or defocus the beam. 4 poles.
Only one of the electric or magnetic multipole components should be present, not both.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:MagneticMultipoleParamGroup ;
            sh:description "A mixin for magnetic multipole parameters that are aligned with PALS MagneticMultipoleP (Magnetic Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pals:MagneticMultipoleP ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path pals:MetaP ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path pals:FloorP ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance in uri/curie form, e.g. `pals:Quadrupole` or `pals:BeamProfileMonitor`." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path rdf:type ],
        [ sh:class pals:BodyShiftParamGroup ;
            sh:description "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pals:BodyShiftP ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:id ],
        [ sh:class pals:TwissParamGroup ;
            sh:description "A mixin for Twiss parameters that are aligned with PALS TwissP (Twiss Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pals:TwissP ],
        [ sh:class pals:ElectricMultipoleParamGroup ;
            sh:description "A mixin for electric multipole parameters that are aligned with PALS ElectricMultipoleP (Electric Multipole Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path pals:ElectricMultipoleP ],
        [ sh:class pals:LongitudinalPlacementParamGroup ;
            sh:description "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path pals:LongitudinalPlacementP ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:native_types ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamLine" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path pals:physical_beamline_relation ],
        [ sh:description "The function of the physical component,  which can be used to identify the component across different source systems." ;
            sh:in ( "Focusing" "Steering" "BeamPositionMeasurement" "VacuumGeneration" "RadiationMonitoring" "Measurement" "BeamAcceleration" "BeamLossDetection" "BeamCurrentMeasurement" "BeamProfileMeasurement" "MachineProtection" "TimingSynchronization" ) ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path pals:physical_function ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path pals:alias ],
        [ sh:class pals:ReferenceParamGroup ;
            sh:description "A mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pals:ReferenceP ] ;
    sh:targetClass pals:Quadrupole .

pals:RFCavity a sh:NodeShape ;
