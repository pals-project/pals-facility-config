pals:SupportingFacilityComponent a sh:NodeShape ;
    rdfs:comment "A physical component that supports accelerator operation  without a specific beam-pipe placement,  such as a power supply, control rack, or radiation detector. These can include Girders, Racks, Power Supplies,  and other physical infrastructure components that are important for understanding  the structure and function of the accelerator system but are not inline with the beamline." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:LongitudinalPlacementParamGroup ;
            sh:description "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path pals:LongitudinalPlacementP ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:id ],
        [ sh:description "The function of the supporting facility component,  which can be used to identify the component across different source systems." ;
            sh:in ( "Support" "Alignment" "PowerSupply" "ControlRack" "Cooling" "Diagnostics" "Detection" ) ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pals:supporting_facility_function ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:native_types ],
        [ sh:class pals:BodyShiftParamGroup ;
            sh:description "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path pals:BodyShiftP ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamLine" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path pals:physical_beamline_relation ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path pals:MetaP ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path pals:FloorP ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:kind ] ;
    sh:targetClass pals:SupportingFacilityComponent .

pals:VirtualComponent a sh:NodeShape ;
    rdfs:comment "A virtual or logical component that represents a concept, function, or role in the accelerator  beamline operation but does not have a physical instantiation.  This can be used to capture abstract components, such as Markers, BeamLineSections, and FacilitySpaces that are important for understanding the structure and function of the accelerator system but are not physical devices." ;
    sh:closed true ;
    sh:ignoredProperties ( pals:multipass pals:description pals:BodyShiftP pals:length rdf:type pals:direction pals:repeat pals:periodic pals:TwissP ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:kind ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path pals:MetaP ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamLine" "NotAssociatedWithBeamLine" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pals:virtual_beamline_relation ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:native_types ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:id ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path pals:FloorP ],
        [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:BeamLine pals:Marker pals:Fork "Control" ) ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pals:virtual_function ] ;
    sh:targetClass pals:VirtualComponent .

pals:AdditionalMetadata a sh:NodeShape ;
    rdfs:comment "A single generic key/value metadata entry, used as a GraphQL-compatible replacement for an open-ended (range: Any) field. A list of these represents an arbitrary, extensible bag of program-specific metadata." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Hint for the value's original type, so consumers can parse it back (e.g. float, integer, boolean) rather than treating everything as an opaque string." ;
            sh:in ( xsd:string xsd:integer xsd:float xsd:boolean ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path pals:datatype ],
        [ sh:datatype xsd:string ;
            sh:description "The metadata field name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:key ],
        [ sh:datatype xsd:string ;
            sh:description "The metadata value, serialized as a string." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:value ] ;
    sh:targetClass pals:AdditionalMetadata .

pals:Author a sh:NodeShape ;
    rdfs:comment "Contains authorship information for a representation of an accelerator facility and its operations." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The name of the entity. For example, the name of the person or organization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:name ],
        [ sh:datatype xsd:string ;
            sh:description "The ORCID identifier of the author." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:orcid ;
            sh:pattern "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" ],
        [ sh:class pals:Affiliation ;
            sh:description "The affiliation of the author or component, as a ROR." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pals:affiliation ],
        [ sh:datatype xsd:string ;
            sh:description "The email address of the author." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:email ;
            sh:pattern "^[^@]+@[^@]+\\.[^@]+$" ] ;
    sh:targetClass pals:Author .

pals:ComponentRelation a sh:NodeShape ;
    rdfs:comment "Association between two Components (Physical or Virtual), with supporting contextual/qualifying information about how and where the relationship holds." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:tolerance_value ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:distance_value ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:id ],
        [ sh:in ( "beam_direction" "facility_coordinates" "local_component_frame" "tunnel_stationing" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path pals:reference_frame ],
        [ sh:in ( "upstream" "downstream" "positive" "negative" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path pals:component_direction ],
        [ sh:in ( BFO:0000063 BFO:0000062 BFO:0000051 BFO:0000050 RO:0002170 saref:controls saref:isControlledBy BFO:0000050 BFO:0000051 RO:0002220 RO:0002131 pals:mounted_on pals:intersects pals:nearest_to ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 11 ;
            sh:path rdf:predicate ],
        [ sh:in ( "A" "degree" "eV" "eV_per_c" "eV_per_c2" "fundamental_charge" "G_per_cm" "Hz" "kW" "m" "mm" "mrem_per_h" "MV_per_m" "PA" "randians_pi2" "rem_per_h" "seconds" "T" "T_M" "Torr" "V" "V_per_m" "unitless" "none" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path pals:distance_unit ],
        [ sh:in ( "x" "y" "z" "s" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path pals:axis ],
        [ sh:in ( "A" "degree" "eV" "eV_per_c" "eV_per_c2" "fundamental_charge" "G_per_cm" "Hz" "kW" "m" "mm" "mrem_per_h" "MV_per_m" "PA" "randians_pi2" "rem_per_h" "seconds" "T" "T_M" "Torr" "V" "V_per_m" "unitless" "none" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path pals:tolerance_unit ],
        [ sh:class pals:BeamLine ;
            sh:description "The specific BeamLine this relationship is defined with respect to (relevant when context=beamline_order)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pals:beamline_context ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path rdf:object ],
        [ sh:description "The frame of reference / domain in which this relationship is asserted to hold." ;
            sh:in ( "beamline_order" "Euclidean_3D" "Euclidean_2D" "floorplan" "containment" "installation_mounting" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path pals:context ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdf:subject ] ;
    sh:targetClass pals:ComponentRelation .

pals:Facility a sh:NodeShape ;
    rdfs:comment "A facility that houses one or more accelerators." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:SignalBinding ;
            sh:description "A list of signal bindings in the accelerator system (Component <-> Signal relationships)." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path pals:signal_bindings ],
        [ sh:class pals:BeamLine ;
            sh:description "A list of beamlines in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pals:beamlines ],
        [ sh:class pals:ComponentRelation ;
            sh:description "A list of component relations in the accelerator system (Component <-> Component relationships)." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path pals:component_relations ],
        [ sh:class pals:Signal ;
            sh:description "A list of signals in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path pals:signals ],
        [ sh:class pals:Identifier ;
            sh:description "A unique and ideally persistent identifier for the facility, such as a DOI or ROR." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path pals:identifiers ],
        [ sh:class pals:Component ;
            sh:description "A list of physical components in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path pals:components ] ;
    sh:targetClass pals:Facility .

pals:PhysicalComponent a sh:NodeShape ;
    rdfs:comment "A physical item that participates in or supports accelerator operation.  This can be used to capture physical components, such as magnets, cavities, diagnostics, vacuum devices, and racks that are important for understanding the structure and function of the accelerator system." ;
    sh:closed true ;
    sh:ignoredProperties ( pals:ReferenceP pals:RFP pals:BodyShiftP pals:ElectricMultipoleP rdf:type pals:MagneticMultipoleP pals:BendP pals:TwissP pals:plane pals:SolenoidP ) ;
    sh:property [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path pals:MetaP ],
        [ sh:description "The function of the physical component,  which can be used to identify the component across different source systems." ;
            sh:in ( "Focusing" "Steering" "BeamPositionMeasurement" "VacuumGeneration" "RadiationMonitoring" "Measurement" "BeamAcceleration" "BeamLossDetection" "BeamCurrentMeasurement" "BeamProfileMeasurement" "MachineProtection" "TimingSynchronization" ) ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pals:physical_function ],
        [ sh:class pals:LongitudinalPlacementParamGroup ;
            sh:description "A mixin for an element's extent and position along the longitudinal (beam-direction, \"s\") axis that are aligned with PALS LongitudinalPlacementP (Longitudinal Placement Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path pals:LongitudinalPlacementP ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:id ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:kind ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamLine" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pals:physical_beamline_relation ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path pals:FloorP ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:native_types ] ;
    sh:targetClass pals:PhysicalComponent .

pals:SignalBinding a sh:NodeShape ;
    rdfs:comment "Association between a PhysicalComponent and one of its Signals, e.g. QUAD1.QUAD1_STATUS_binding." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:PhysicalComponent ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rdf:subject ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:id ],
        [ sh:class pals:Signal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rdf:object ],
        [ sh:in ( "has_signal" "has_status_signal" "has_setpoint_signal" "has_readback_signal" "has_command_signal" "has_limit_signal" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path rdf:predicate ] ;
    sh:targetClass pals:SignalBinding .

pals:Affiliation a sh:NodeShape ;
    rdfs:comment "Contains affiliation information for an author or component, such as a ROR." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:id ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the entity. For example, the name of the person or organization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:name ],
        [ sh:class pals:Identifier ;
            sh:description "A unique and ideally persistent identifier for the facility, such as a DOI or ROR." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path pals:identifiers ] ;
    sh:targetClass pals:Affiliation .

pals:BendParamGroup a sh:NodeShape ;
    rdfs:comment """Mixin for bend parameters, which can be used to describe the bending properties of an accelerator element.
This mixin is aligned with PALS BendP for interoperability with the Particle Accelerator Language Standard (PALS).""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Exit end pole face rotation with respect to a sector geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:e2 ],
        [ sh:datatype xsd:float ;
            sh:description "Reference tilt of the bend." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path pals:tilt_ref ],
        [ sh:datatype xsd:float ;
            sh:description "Output parameter. Sagitta length." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path pals:L_sagitta ],
        [ sh:datatype xsd:float ;
            sh:description "Exit end pole face rotation with respect to a rectangular geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:e2_rect ],
        [ sh:datatype xsd:float ;
            sh:description "Exit end pole face curvature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:h2 ],
        [ sh:datatype xsd:float ;
            sh:description "Entrance end pole face curvature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:h1 ],
        [ sh:datatype xsd:float ;
            sh:description "Entrance end pole face rotation with respect to a sector geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:e1 ],
        [ sh:datatype xsd:float ;
            sh:description "Actual bend strength = 1/radius_actual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:g_actual ],
        [ sh:datatype xsd:float ;
            sh:description "Entrance end pole face rotation with respect to a rectangular geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:e1_rect ],
        [ sh:datatype xsd:float ;
            sh:description "Actual bend field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:bend_field_actual ],
        [ sh:datatype xsd:float ;
            sh:description "Reference bend field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:bend_field_ref ],
        [ sh:datatype xsd:float ;
            sh:description "Entrance end fringe field integral." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:edge1_int ],
        [ sh:datatype xsd:float ;
            sh:description "Chord length of the bend." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path pals:L_chord ],
        [ sh:datatype xsd:float ;
            sh:description "Reference bend radius." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path pals:rho_ref ],
        [ sh:datatype xsd:float ;
            sh:description "Reference bend strength = 1/radius_ref" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:g_ref ],
        [ sh:datatype xsd:float ;
            sh:description "Exit end fringe field integral." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:edge2_int ],
        [ sh:datatype xsd:float ;
            sh:description "Rectangular length." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path pals:L_rectangle ],
        [ sh:description "Reference geometry type. Must be `arc`." ;
            sh:in ( "arc" "chord" "entrance_coords" "exit_coords" ) ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path pals:ref_geometry ],
        [ sh:datatype xsd:float ;
            sh:description "Reference bend angle." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:angle_ref ],
        [ sh:description "Multipole geometry type. Must be `follows_ref_geometry`." ;
            sh:in ( "follows_ref_geometry" "vertically_pure" "horizontally_pure" "chord" "entrance_coords" "exit_coords" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path pals:multipole_geometry ] ;
    sh:targetClass pals:BendParamGroup .

pals:Identifier a sh:NodeShape ;
    rdfs:comment "A unique, and ideally persistent, identifier for a facility, such as a DOI or ROR." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The value of the identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:identifier_value ],
        [ sh:description "The type of identifier, such as DOI | PURL | ROR | LOCAL | URL | ARK." ;
            sh:in ( <http://purl.org/spar/datacite/doi> <http://purl.org/spar/datacite/purl> <http://purl.org/spar/datacite/ror> <http://purl.org/spar/datacite/local-resource-identifier-scheme> <http://purl.org/spar/datacite/url> <http://purl.org/spar/datacite/ark> ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path pals:identifier_type ] ;
    sh:targetClass pals:Identifier .

pals:MultipoleParameterGroup a sh:NodeShape ;
    rdfs:comment """A single order's electric (or magnetic) multipole component.
Only the fields supporting Electric Multipoles  OR the fields for Magnetic Multipoles should be present, not both.
Not a mixin, but a class used in the ElectricMultipoleP and MagneticMultipoleP mixins to represent individual multipole components.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Normal component of the field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:En ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized normal component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:Kn ],
        [ sh:datatype xsd:float ;
            sh:description "Skew component of the field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:Es ],
        [ sh:datatype xsd:float ;
            sh:description "Length-integrated normal component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:EnL ],
        [ sh:datatype xsd:integer ;
            sh:description "Multipole order N (0 = dipole, 1 = quadrupole, etc.)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:order ],
        [ sh:datatype xsd:float ;
            sh:description "Normalized skew component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:Ks ],
        [ sh:datatype xsd:float ;
            sh:description "Normal component of the magnetic field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:Bn ],
        [ sh:datatype xsd:float ;
            sh:description "Skew component of the magnetic field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:Bs ],
        [ sh:datatype xsd:float ;
            sh:description "Tilt of the Nth multipole." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:tilt ],
        [ sh:datatype xsd:float ;
            sh:description "Length-integrated skew component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:EsL ] ;
    sh:targetClass pals:MultipoleParameterGroup .

pals:Signal a sh:NodeShape ;
    rdfs:comment "Semantic meaning of a control-system signal associated with a component." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The physical quantity kind of the signal." ;
            sh:in ( "BeamPosition" sosa:ObservableProperty quantitykind:ElectricCurrent quantitykind:MagneticFluxPerLength quantitykind:MagneticFluxDensity quantitykind:Pressure quantitykind:AbsorbedDoseRate quantitykind:Voltage quantitykind:Power quantitykind:PhaseAngle quantitykind:ElectricFieldStrength ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path pals:quantity_kind ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path pals:MetaP ],
        [ sh:description "The source system from which the signal originates, such as EPICS, PALS-Ext, MYA, an element database, a channel database, or a simulation service." ;
            sh:in ( "EPICS" "EPICS_ChannelAccess" "PALS_Ext" "MYA" "ElementDatabase" "ChannelDatabase" "Simulation" "Other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path pals:source_system ],
        [ sh:datatype xsd:string ;
            sh:description "The protocol used to access the signal in the source system,  such as EPICS Channel Access, PALS-Ext, MYA, or a simulation service." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:access_protocol ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:id ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:kind ],
        [ sh:description "The native data type of the signal in the source system,  such as String, Integer, Float, or Boolean." ;
            sh:in ( xsd:string xsd:integer xsd:float xsd:boolean ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path pals:native_data_type ],
        [ sh:description "The native unit of the signal in the source system." ;
            sh:in ( "A" "degree" "eV" "eV_per_c" "eV_per_c2" "fundamental_charge" "G_per_cm" "Hz" "kW" "m" "mm" "mrem_per_h" "MV_per_m" "PA" "randians_pi2" "rem_per_h" "seconds" "T" "T_M" "Torr" "V" "V_per_m" "unitless" "none" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 9 ;
            sh:path pals:native_unit ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier used to reference the signal in an archival system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:archive_identifier ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:alias ],
        [ sh:description "The role of the signal in the control system, such as setpoint, readback, status, command, or limit." ;
            sh:in ( sosa:ActuatableProperty sosa:ObservableProperty "Status" sosa:ActuatableProperty xsd:minInclusive xsd:maxInclusive ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path pals:signal_role ],
        [ sh:description "The canonical semantic meaning of the signal." ;
            sh:in ( "HorizontalBeamPosition" "VerticalBeamPosition" "HorizontalBeamPositionOffset" "VerticalBeamPositionOffset" "BeamIntensity" "DeviceStatus" "GradientSetpoint" "GradientReadback" "MagnetCurrentSetpoint" "MagnetCurrentReadback" "MagnetFieldSetpoint" "IntegratedFieldSetpoint" "IntegratedFieldReadback" "VacuumPressure" "IonPumpCurrent" "IonPumpVoltage" "GammaDoseRate" "NeutronDoseRate" "Status" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path pals:canonical_signal_type ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description of the signal in the source system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:native_description ] ;
    sh:targetClass pals:Signal .

pals:SolenoidParamGroup a sh:NodeShape ;
    rdfs:comment "Mixin for solenoid-specific parameters." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Normalized solenoid strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:Ksol ],
        [ sh:datatype xsd:float ;
            sh:description "Solenoid field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:Bsol ] ;
    sh:targetClass pals:SolenoidParamGroup .

pals:Component a sh:NodeShape ;
    rdfs:comment "A general class for accelerator components, which can be specialized into more specific types like AcceleratorDevice, Magnet, etc." ;
    sh:closed false ;
    sh:ignoredProperties ( pals:multipass pals:LongitudinalPlacementP pals:BodyShiftP pals:RFP pals:beamline_relation pals:repeat pals:BendP pals:TwissP pals:plane pals:FloorP pals:functions pals:ReferenceP pals:description pals:length pals:ElectricMultipoleP rdf:type pals:direction pals:MagneticMultipoleP pals:periodic pals:SolenoidP ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:native_types ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:kind ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:id ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path pals:MetaP ] ;
    sh:targetClass pals:Component .

pals:RFParamGroup a sh:NodeShape ;
    rdfs:comment "Mixin for RF parameters, which can be used to describe the RF properties of an accelerator element. This mixin is aligned with PALS RFP for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Sets what phase = 0 means." ;
            sh:in ( "ACCELERATING" "BELOW_TRANSITION" "ABOVE_TRANSITION" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path pals:zero_phase ],
        [ sh:datatype xsd:float ;
            sh:description "Active acceleration length." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:L_active ],
        [ sh:datatype xsd:float ;
            sh:description "rad/2pi RF Phase added to multipass elements" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:multipass_phase ],
        [ sh:datatype xsd:float ;
            sh:description "RF phase. rad/2pi RF phase in 0 to 2*pi" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:phase ],
        [ sh:datatype xsd:float ;
            sh:description "RF frequency." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:frequency ],
        [ sh:description "Cavity type" ;
            sh:in ( "STANDING_WAVE" "TRAVELING_WAVE" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path pals:cavity_type ],
        [ sh:datatype xsd:float ;
            sh:description "RF voltage." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:voltage ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of cells in the cavity" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:num_cells ],
        [ sh:datatype xsd:float ;
            sh:description "Reference energy gain." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:dE_ref ],
        [ sh:datatype xsd:integer ;
            sh:description "RF harmonic number." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:harmon ] ;
    sh:targetClass pals:RFParamGroup .

pals:Marker a sh:NodeShape ;
    rdfs:comment "A virtual component used as a reference point or marker in the beamline structure." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:id ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:kind ],
        [ sh:class pals:TwissParamGroup ;
            sh:description "A mixin for Twiss parameters that are aligned with PALS TwissP (Twiss Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path pals:TwissP ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path pals:MetaP ],
        [ sh:class pals:BodyShiftParamGroup ;
            sh:description "A mixin for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path pals:BodyShiftP ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamLine" "NotAssociatedWithBeamLine" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path pals:virtual_beamline_relation ],
        [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:BeamLine pals:Marker pals:Fork "Control" ) ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path pals:virtual_function ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:native_types ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path pals:FloorP ] ;
    sh:targetClass pals:Marker .

pals:BeamLine a sh:NodeShape ;
    rdfs:comment "PALS element for an ordered sequence of beamline elements defining a beam path." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Indicates whether orbit and Twiss parameters periodic. If not provided, the default assumption is that the BeamLine is not periodic." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:periodic ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates whether the BeamLine is a multipass BeamLine, where the beam passes through the same physical elements multiple times. If not provided, the default assumption is that the BeamLine is single-pass." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:multipass ],
        [ sh:class pals:FloorParamGroup ;
            sh:description "A mixin for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path pals:FloorP ],
        [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:BeamLine pals:Marker pals:Fork "Control" ) ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path pals:virtual_function ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamLine" "NotAssociatedWithBeamLine" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path pals:virtual_beamline_relation ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:kind ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:native_types ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description of the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:description ],
        [ sh:class pals:MetaParamGroup ;
            sh:description "A mixin for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path pals:MetaP ],
        [ sh:datatype xsd:float ;
            sh:description "The total length of the BeamLine. For pals interoperability, use m as the unit of length." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:length ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:id ],
        [ sh:datatype xsd:integer ;
            sh:description """Repetition count. If not provided, the default assumption is that the beamline is not repeated and the value is 1.
If value is greater than 1, the beamline is repeated that many times.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:repeat ],
        [ sh:datatype xsd:integer ;
            sh:description "Beam direction along the BeamLine: +1 or -1. Longitudinal orientation. Default is +1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:direction ] ;
    sh:targetClass pals:BeamLine .

pals:ElectricMultipoleParamGroup a sh:NodeShape ;
    rdfs:comment """Mixin for electric multipole parameters, 
which can be used to describe the electric field components of an accelerator element.
This mixin is aligned with PALS ElectricMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS).
Example with three multipole components (N=0,1,2): ```yaml elec_components: - order: 7
  tilt: 0.7
- order: 3
  En: 27.3
- order: 2
  EnL: 3.47e1
```""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:MultipoleParameterGroup ;
            sh:description "Electric multipole components, one per order N." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path pals:elec_components ] ;
    sh:targetClass pals:ElectricMultipoleParamGroup .

pals:MagneticMultipoleParamGroup a sh:NodeShape ;
    rdfs:comment """Mixin for magnetic multipole parameters,  which can be used to describe the magnetic field components of an accelerator element. This mixin is aligned with PALS MagneticMultipoleP for interoperability with the Particle Accelerator Language Standard (PALS). Example with three multipole components (N=0,1,2): ```yaml mag_components: - order: 7
  tilt: 0.7
- order: 3
  Bn: 27.3
- order: 2
  BnL: 3.47e1
- order: 1
  Kn: 0.85     # normalized form, e.g. a quadrupole's k1-like strength
```""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:MultipoleParameterGroup ;
            sh:description "Magnetic multipole components, one per order N." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path pals:mag_components ] ;
    sh:targetClass pals:MagneticMultipoleParamGroup .

pals:ReferenceParamGroup a sh:NodeShape ;
    rdfs:comment "Mixin for reference parameters that are aligned with PALS ReferenceP (Reference Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "[s] Reference time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:time_ref ],
        [ sh:datatype xsd:float ;
            sh:description "[momentum*c] Reference momentum times speed of light." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:pc_ref ],
        [ sh:datatype xsd:float ;
            sh:description "[eV] Reference total energy" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:E_tot_ref ],
        [ sh:datatype xsd:string ;
            sh:description "A reference to a species or particle type, such as an ion, electron, or proton." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:species_ref ] ;
    sh:targetClass pals:ReferenceParamGroup .

pals:TwissParamGroup a sh:NodeShape ;
    rdfs:comment "Mixin for Twiss parameters, which can be used to describe the beam optics of an accelerator element." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Twiss phase advance parameter in the horizontal plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:phi_a ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss alpha parameter in the horizontal plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:alpha_a ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss dispersion parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:eta_y ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss alpha parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:alpha_b ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss dispersion slope parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:etap_y ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss beta parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:beta_b ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss dispersion parameter in the horizontal plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:eta_x ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss beta parameter in the horizontal plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:beta_a ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss phase advance parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:phi_b ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss dispersion slope parameter in the horizontal plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:etap_x ] ;
    sh:targetClass pals:TwissParamGroup .

pals:BodyShiftParamGroup a sh:NodeShape ;
    rdfs:comment "Mixin class for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Shift in the X direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:x_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:z_rot ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Y direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:y_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:y_rot ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:x_rot ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Z direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:z_offset ] ;
    sh:targetClass pals:BodyShiftParamGroup .

pals:LongitudinalPlacementParamGroup a sh:NodeShape ;
    rdfs:comment """Mixin for an element's extent and position along the longitudinal (beam-direction, "s") axis. 
Corresponds to PALS's ungrouped element parameters `length` and `s_position`.
One (or both) `length` or `s_position` must be present.""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Longitudinal position of the element along the beamline." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:s_position ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the element (arc length for bends)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:length ] ;
    sh:targetClass pals:LongitudinalPlacementParamGroup .

pals:FloorParamGroup a sh:NodeShape ;
    rdfs:comment "Mixin class for floor plan parameters that are aligned with PALS FloorP (Floor Plan Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Global X coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:x ],
        [ sh:datatype xsd:float ;
            sh:description "Orientation angle around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:theta ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Global Z coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:z ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:phi ],
        [ sh:datatype xsd:float ;
            sh:description "Global Y coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:y ] ;
    sh:targetClass pals:FloorParamGroup .

pals:MetaParamGroup a sh:NodeShape ;
    rdfs:comment "Mixin class for metadata parameters that are aligned with PALS MetaP (Metadata Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description of the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:description ],
        [ sh:datatype xsd:string ;
            sh:description "A label string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:label ],
        [ sh:class pals:AdditionalMetadata ;
            sh:description "Additional metadata or annotations for the instance." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path pals:additional_metadata ] ;
    sh:targetClass pals:MetaParamGroup .

