pals:NearestToRelation a sh:NodeShape ;
    sh:closed true ;
    sh:description "A relationship indicating that the subject component is nearest to the object component in a specified context,  such as a diagnostic device nearest to a magnet." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unit of the tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
            sh:in ( qudt:A qudt:DEG qudt:EV "eV_per_c" "eV_per_c2" "fundamental_charge" "G_per_cm" qudt:HZ qudt:KiloW qudt:M qudt:MilliM qudt:MREM-PER-H qudt:MegaV-PER-M qudt:PA "randians_pi2" "rem_per_h" qudt:SEC qudt:T qudt:T-M qudt:TORR qudt:V qudt:V-PER-M qudt:NUM "none" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path pals:tolerance_unit ],
        [ sh:class pals:CoordinateSet ;
            sh:description "A set of coordinates that define the spatial relationship between the two components. Only an edge-property slot for edges that require a set of coordinates to define the spatial relationship between two components in a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path pals:coordinates ],
        [ sh:datatype xsd:float ;
            sh:description "Distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path om:Distance ],
        [ sh:description "The frame of reference / domain in which this relationship is asserted to hold." ;
            sh:in ( "beamline_order" "Euclidean_3D" "Euclidean_2D" "floorplan" "containment" "installation_mounting" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path pals:context ],
        [ sh:description "Unit of the distance value between two components in a relationship. Only an edge-property slot for edges that require a distance value between two components in a relationship." ;
            sh:in ( qudt:A qudt:DEG qudt:EV "eV_per_c" "eV_per_c2" "fundamental_charge" "G_per_cm" qudt:HZ qudt:KiloW qudt:M qudt:MilliM qudt:MREM-PER-H qudt:MegaV-PER-M qudt:PA "randians_pi2" "rem_per_h" qudt:SEC qudt:T qudt:T-M qudt:TORR qudt:V qudt:V-PER-M qudt:NUM "none" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path pals:distance_unit ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path rdf:object ],
        [ sh:class pals:Component ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdf:subject ],
        [ sh:datatype xsd:float ;
            sh:description "Tolerance value for the distance between two components in a relationship. Only an edge-property slot for edges that require a tolerance value between two components in a relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:tolerance_value ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:id ],
        [ sh:in ( "upstream" "downstream" "positive" "negative" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path pals:component_direction ],
        [ sh:in ( "beam_direction" "facility_coordinates" "local_component_frame" "tunnel_stationing" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path pals:reference_frame ],
        [ sh:datatype xsd:string ;
            sh:description "The predicate of the relationship, which can be used to identify the relationship across different source systems." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rdf:predicate ] ;
    sh:targetClass pals:NearestToRelation .

pals:Node a sh:NodeShape ;
    sh:closed false ;
    sh:description "Abstract base class for all node entities in the accelerator core ontology. This differentiates nodes from edges (relationships) in the ontology. This class is not intended to be instantiated directly, but serves as a common ancestor for all other classes. Allows for the use of kind: as a discriminator for the type of node in the ontology." ;
    sh:ignoredProperties ( pals:BodyShiftP pals:direction pals:beamline_relation pals:multipass rdf:type pals:TwissP pals:LongitudinalPlacementP pals:signal_role pals:MagneticMultipoleP pals:ElectricMultipoleP pals:RFP pals:archive_identifier pals:plane pals:source_system pals:quantity_kind pals:length pals:native_description pals:repeat pals:BendP pals:FloorP pals:canonical_signal_type pals:description pals:native_types pals:functions pals:periodic pals:ReferenceP pals:access_protocol pals:MetaP pals:native_data_type pals:native_unit pals:SolenoidP ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance in uri/curie form, e.g. `pals:Quadrupole` or `pals:BeamProfileMonitor`." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdf:type ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:id ] ;
    sh:targetClass pals:Node .

pals:NormalConductingRFCavity a sh:NodeShape ;
    sh:closed true ;
    sh:description "A cavity used for RF acceleration or longitudinal manipulation, which is normal conducting." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pals:TwissParamGroup ;
            sh:description "A mixin for Twiss parameters that are aligned with PALS TwissP (Twiss Parameters) for interoperability with the Particle Accelerator Language Standard (PALS)." ;
