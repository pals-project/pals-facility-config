@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix narad: <https://example.org/narad/> .
@prefix pals: <https://pals-project.readthedocs.io/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

narad:BeamPositionMonitor a sh:NodeShape ;
    sh:closed true ;
    sh:description "A diagnostic device used to measure transverse beam position." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path pals:alias ],
        [ sh:description "The function of the physical component,  which can be used to identify the component across different source systems." ;
            sh:in ( "Focusing" "Steering" "BeamPositionMeasurement" "VacuumGeneration" "RadiationMonitoring" "Measurement" "BeamAcceleration" "BeamLossDetection" "BeamCurrentMeasurement" "BeamProfileMeasurement" "MachineProtection" "TimingSynchronization" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 20 ;
            sh:path narad:physical_function ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss dispersion slope parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path pals:etap_y ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path pals:phi ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path narad:native_types ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal position of the element along the beamline." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path pals:s_position ],
        [ sh:datatype xsd:float ;
            sh:description "Length of the element (arc length for bends)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path pals:length ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:y_rot ],
        [ sh:datatype xsd:float ;
            sh:description "[s] Reference time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:time_ref ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path pals:description ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Y direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:y_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss phase advance parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path pals:phi_b ],
        [ sh:class narad:MetadataEntry ;
            sh:description "Additional metadata or annotations for the instance." ;
            sh:nodeKind sh:IRI ;
            sh:order 36 ;
            sh:path narad:additional_metadata ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss dispersion parameter in the horizontal plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path pals:eta_x ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss dispersion parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path pals:eta_y ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path pals:psi ],
        [ sh:datatype xsd:string ;
            sh:description "A label string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path pals:label ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss beta parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path pals:beta_b ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamline" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 21 ;
            sh:path narad:physical_beamline_relation ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss phase advance parameter in the horizontal plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path pals:phi_a ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:z_rot ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss alpha parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:alpha_b ],
        [ sh:datatype xsd:float ;
            sh:description "Orientation angle around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path pals:theta ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path narad:id ],
        [ sh:datatype xsd:float ;
            sh:description "Global Z coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path pals:z ],
        [ sh:datatype xsd:float ;
            sh:description "[momentum*c] Reference momentum times speed of light." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:pc_ref ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss dispersion slope parameter in the horizontal plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path pals:etap_x ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path narad:type ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss alpha parameter in the horizontal plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:alpha_a ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:x_rot ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Z direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:z_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Global Y coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path pals:y ],
        [ sh:datatype xsd:string ;
            sh:description "A reference to a species or particle type, such as an ion, electron, or proton." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:species_ref ],
        [ sh:datatype xsd:float ;
            sh:description "[eV] Reference total energy" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:E_tot_ref ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss beta parameter in the horizontal plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:beta_a ],
        [ sh:datatype xsd:float ;
            sh:description "Global X coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path pals:x ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the X direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:x_offset ] ;
    sh:targetClass narad:BeamPositionMonitor .

narad:BeamlineSection a sh:NodeShape ;
    sh:closed true ;
    sh:description """A virtual component used to represent a section of the beamline for organizational 
or functional grouping of components.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:Beamline pals:Marker pals:Fork "Control" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path narad:virtual_function ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:phi ],
        [ sh:datatype xsd:float ;
            sh:description "Global Y coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:y ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path narad:id ],
        [ sh:datatype xsd:float ;
            sh:description "Orientation angle around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:theta ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:string ;
            sh:description "A label string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path pals:label ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path narad:type ],
        [ sh:class narad:MetadataEntry ;
            sh:description "Additional metadata or annotations for the instance." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path narad:additional_metadata ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the X direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:x_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Y direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:y_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Z direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:z_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:z_rot ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path pals:description ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path narad:native_types ],
        [ sh:datatype xsd:float ;
            sh:description "Global X coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:x ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamline" "NotAssociatedWithBeamline" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path narad:virtual_beamline_relation ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path pals:psi ],
        [ sh:datatype xsd:float ;
            sh:description "Global Z coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:z ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:x_rot ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:y_rot ] ;
    sh:targetClass narad:BeamlineSection .

narad:BodyShiftP a sh:NodeShape ;
    sh:closed false ;
    sh:description "Mixin class for floor plan shift parameters that are aligned with PALS BodyShiftP (Floor Plan Shift Parameters)  for interoperability with the Particle Accelerator Language Standard (PALS)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Shift in the Y direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:y_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Z direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:z_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the X direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:x_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:y_rot ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:z_rot ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:x_rot ] ;
    sh:targetClass narad:BodyShiftP .

narad:BookkeepingComponent a sh:NodeShape ;
    sh:closed true ;
    sh:description """A virtual component that represents a bookkeeping or organizational role in the accelerator system, 
such as a BeamlineSection, Marker or a Fork.
These can include BeamlineSections, Markers, Forks, 
and other virtual components that are important for understanding 
the structure and function of the accelerator system but are not physical devices.""" ;
    sh:ignoredProperties ( pals:phi_b pals:eta_x pals:etap_y pals:phi_a rdf:type pals:alpha_a pals:alpha_b pals:beta_a pals:eta_y pals:beta_b pals:etap_x ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path narad:type ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Z direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:z_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Global Z coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:z ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:phi ],
        [ sh:class narad:MetadataEntry ;
            sh:description "Additional metadata or annotations for the instance." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path narad:additional_metadata ],
        [ sh:datatype xsd:float ;
            sh:description "Global X coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:x ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path narad:native_types ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the X direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:x_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Global Y coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:y ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path pals:psi ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path narad:id ],
        [ sh:datatype xsd:string ;
            sh:description "A label string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path pals:label ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:y_rot ],
        [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:Beamline pals:Marker pals:Fork "Control" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path narad:virtual_function ],
        [ sh:datatype xsd:float ;
            sh:description "Orientation angle around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:theta ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Y direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:y_offset ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:x_rot ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path pals:description ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:z_rot ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamline" "NotAssociatedWithBeamline" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path narad:virtual_beamline_relation ] ;
    sh:targetClass narad:BookkeepingComponent .

narad:Cavity a sh:NodeShape ;
    sh:closed true ;
    sh:description "A cavity used for beam acceleration or manipulation." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "[s] Reference time" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:time_ref ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path narad:id ],
        [ sh:datatype xsd:float ;
            sh:description "Longitudinal position of the element along the beamline." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path pals:s_position ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the Z direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:z_offset ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path pals:phi ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss dispersion parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path pals:eta_y ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss beta parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path pals:beta_b ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss alpha parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:alpha_b ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss phase advance parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path pals:phi_b ],
        [ sh:datatype xsd:float ;
            sh:description "Twiss dispersion slope parameter in the vertical plane." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path pals:etap_y ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path pals:description ],
        [ sh:datatype xsd:float ;
            sh:description "[momentum*c] Reference momentum times speed of light." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:pc_ref ],
        [ sh:datatype xsd:float ;
            sh:description "Shift in the X direction in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:x_offset ],
        [ sh:class narad:MultipoleComponent ;
            sh:description "Electric multipole components, one per order N." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path narad:components ],
        [ sh:description "The relationship of the physical component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AttachedToPipe" "NearBeamline" "SupportingFacility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 22 ;
