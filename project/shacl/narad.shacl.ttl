    sh:targetClass pals:Multipole .

pals:Node a sh:NodeShape ;
    sh:closed false ;
    sh:description "Abstract base class for all node entities in the accelerator core ontology. This differentiates nodes from edges (relationships) in the ontology. This class is not intended to be instantiated directly, but serves as a common ancestor for all other classes. Allows for the use of kind: as a discriminator for the type of node in the ontology." ;
    sh:ignoredProperties ( rdf:type pals:plane pals:BodyShiftP pals:length pals:beamline_relation pals:repeat pals:canonical_signal_type pals:BendP pals:archive_identifier pals:LongitudinalPlacementP pals:quantity_kind pals:ReferenceP pals:description pals:access_protocol pals:MagneticMultipoleP pals:native_types pals:ElectricMultipoleP pals:FloorP pals:multipass pals:signal_role pals:SolenoidP pals:native_unit pals:TwissP pals:direction pals:RFP pals:native_description pals:MetaP pals:periodic pals:functions pals:native_data_type pals:source_system ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:kind ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:id ] ;
    sh:targetClass pals:Node .

