            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pals:alias ] ;
    sh:targetClass narad:MetaP .

narad:Multipole a sh:NodeShape ;
    sh:closed true ;
