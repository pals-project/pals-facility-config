pals:PALSAccelerator a sh:NodeShape ;
    rdfs:comment "Root container for accelerator core components, semantic signals, and local bindings." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version of the representation of a particle accelerator and its operations." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:version ;
            sh:pattern "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" ],
        [ sh:class pals:Affiliation ;
            sh:description "The affiliation of the author or component, as a ROR." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path pals:affiliation ],
        [ sh:class pals:Facility ;
            sh:description "A facility that contains lattice elements (physical and virtual), beamlines, parameter set commands, signals, etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path pals:facility ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable description of the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:description ],
        [ sh:datatype xsd:string ;
            sh:description "Additional notes or comments about the representation of a particle accelerator and its operations." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:notes ],
        [ sh:class pals:Author ;
            sh:description "Contains the authorship information for this representation of an accelerator facility and its operations." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path pals:authors ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class name of this instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:kind ] ;
    sh:targetClass pals:PALSAccelerator .

