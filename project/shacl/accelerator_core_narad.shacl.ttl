            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class type of the NARAD root container, i.e., `NARAD`, which can be used to distinguish between different kinds of NARAD representations." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:type ],
        [ sh:class narad:Signal ;
            sh:description "A list of signals in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path narad:signals ],
        [ sh:class narad:PhysicalComponent ;
            sh:description "A list of physical components in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:physical_components ],
        [ sh:class narad:ComponentRelation ;
            sh:description "A list of component relations in the accelerator system (Component <-> Component relationships)." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path narad:component_relations ] ;
    sh:targetClass narad:NARAD .

