narad:NARAD a sh:NodeShape ;
    sh:closed true ;
    sh:description "Root container for accelerator core components, semantic signals, and local bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:VirtualComponent ;
            sh:description "A list of virtual components in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:virtual_components ],
        [ sh:class narad:SignalBinding ;
            sh:description "A list of signal bindings in the accelerator system (Component <-> Signal relationships)." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path narad:signal_bindings ],
        [ sh:class narad:Beamline ;
            sh:description "A list of beamlines in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path narad:beamlines ],
        [ sh:class narad:SupportingFacilityComponent ;
            sh:description "A list of supporting facility components in the accelerator system." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path narad:supporting_facility_components ],
        [ sh:datatype xsd:string ;
