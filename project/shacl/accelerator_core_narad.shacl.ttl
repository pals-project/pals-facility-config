            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path narad:native_types ],
        [ sh:datatype xsd:float ;
            sh:description "Global Y coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:y ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamline" "NotAssociatedWithBeamline" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path narad:beamline_relation ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pals:phi ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class type of the component, which can be used to distinguish between different kinds of components." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path narad:type ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path pals:psi ],
        [ sh:datatype xsd:string ;
            sh:description "A label string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:label ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the component." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path narad:id ],
        [ sh:datatype xsd:float ;
            sh:description "Orientation angle around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:theta ],
        [ sh:datatype xsd:float ;
            sh:description "Global Z coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:z ],
        [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:Beamline pals:Marker pals:Fork "Control" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path narad:function ] ;
    sh:targetClass narad:VirtualComponent .

narad:Beamline a sh:NodeShape ;
    sh:closed true ;
    sh:description "A top-level NARAD-system for an ordered sequence of beamline elements defining a beam path." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Rotation around the X-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path pals:phi ],
        [ sh:datatype xsd:integer ;
            sh:description """Repetition count. If not provided, the default assumption is that the beamline is not repeated and the value is 1.
If value is greater than 1, the beamline is repeated that many times.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pals:repeat ],
        [ sh:datatype xsd:string ;
            sh:description "The LinkML class type of the component, which can be used to distinguish between different kinds of components." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path narad:type ],
        [ sh:datatype xsd:float ;
            sh:description "Global Y coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path pals:y ],
        [ sh:datatype xsd:float ;
            sh:description "Orientation angle around the Y-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path pals:theta ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether orbit and Twiss parameters periodic.
If not provided, the default assumption is that the beamline is not periodic.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pals:periodic ],
        [ sh:datatype xsd:float ;
            sh:description """The total length of the beamline.
For pals interoperability, use m as the unit of length.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pals:length ],
        [ sh:datatype xsd:string ;
            sh:description "An alternative name or identifier for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path pals:alias ],
        [ sh:datatype xsd:string ;
            sh:description "A label string." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path pals:label ],
        [ sh:description "The function of the virtual component,  which can be used to identify the component across different source systems." ;
            sh:in ( pals:Beamline pals:Marker pals:Fork "Control" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path narad:function ],
        [ sh:datatype xsd:float ;
            sh:description "Global X coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path pals:x ],
        [ sh:datatype xsd:string ;
            sh:description "Name of a line item used as a reference point when the BeamLine is used as a subline." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:zero_point ],
        [ sh:datatype xsd:float ;
            sh:description "Rotation around the Z-axis in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path pals:psi ],
        [ sh:datatype xsd:string ;
            sh:description "The native type of the component in the source system, which can be used to identify the component across different source systems." ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path narad:native_types ],
        [ sh:description "The relationship of the virtual component to the beamline,  which can be used to identify the component across different source systems." ;
            sh:in ( "Inline" "AssociatedWithBeamline" "NotAssociatedWithBeamline" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path narad:beamline_relation ],
        [ sh:datatype xsd:integer ;
            sh:description """Beam direction along the beamline: +1 or -1. 
Longitudinal orientation. Default is +1.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pals:direction ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the beamline is a multipass beamline, where the beam passes through the same physical elements multiple times.
If not provided, the default assumption is that the beamline is single-pass.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pals:multipass ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable description." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path pals:description ],
        [ sh:class narad:AnyValue ;
            sh:description "Additional metadata or annotations for the instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path narad:additional_metadata ],
        [ sh:datatype xsd:string ;
            sh:description "A unique identifier for the component." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path narad:id ],
        [ sh:datatype xsd:float ;
            sh:description "Global Z coordinate in the facility floor plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path pals:z ] ;
    sh:targetClass narad:Beamline .

narad:Component a sh:NodeShape ;
    sh:closed false ;
    sh:description "A general class for accelerator components, which can be specialized into more specific types like AcceleratorDevice, Magnet, etc." ;
    sh:ignoredProperties ( pals:pc_ref pals:z_offset narad:plane pals:y_rot rdf:type pals:etap_x narad:length pals:x_offset pals:eta_y pals:z_rot pals:y_offset narad:zero_point pals:z pals:Ksol pals:phi pals:x_rot pals:x pals:time_ref narad:beamline_relation narad:components pals:etap_y pals:repeat pals:s_position pals:y pals:E_tot_ref pals:phi_a pals:multipass pals:species_ref pals:eta_x pals:Bsol pals:periodic pals:theta pals:beta_b pals:psi pals:alpha_a narad:direction pals:alpha_b pals:phi_b narad:function pals:beta_a ) ;
