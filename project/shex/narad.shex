             <https://pals-project.readthedocs.io/FacilityFunctionEnum#ControlRack>
             <https://pals-project.readthedocs.io/FacilityFunctionEnum#Cooling>
             <https://pals-project.readthedocs.io/FacilityFunctionEnum#Diagnostics>
             <https://pals-project.readthedocs.io/FacilityFunctionEnum#Detection> ] + ;
          <BodyShiftP> @<BodyShiftParamGroup> ?
       ) ;
       rdf:type [ <SupportingFacilityComponent> ]
    )
}

<TwissParamGroup> CLOSED {
    (  $<TwissParamGroup_tes> (  <alpha_a> @linkml:Float ? ;
          <alpha_b> @linkml:Float ? ;
          <beta_a> @linkml:Float ? ;
          <beta_b> @linkml:Float ? ;
          <eta_x> @linkml:Float ? ;
          <eta_y> @linkml:Float ? ;
          <etap_x> @linkml:Float ? ;
          <etap_y> @linkml:Float ? ;
