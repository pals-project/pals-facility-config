    )
}

<VirtualComponent>  (
    CLOSED {
       (  $<VirtualComponent_tes> (  &<Component_tes> ;
             rdf:type [ <Component> ] ? ;
             &<HasFloorP_tes> ;
             rdf:type [ <HasFloorP> ] ? ;
             <virtual_function> [ <BeamLine> <Marker> <Fork> <https://pals-project.readthedocs.io/VirtualFunctionEnum#Control> ] +
             ;
             <virtual_beamline_relation> [ <https://pals-project.readthedocs.io/VirtualRelationEnum#Inline>
                <https://pals-project.readthedocs.io/VirtualRelationEnum#AssociatedWithBeamLine>
                <https://pals-project.readthedocs.io/VirtualRelationEnum#NotAssociatedWithBeamLine> ] ;
             <FloorP> @<FloorParamGroup> ?
          ) ;
          rdf:type [ <VirtualComponent> ]
       )
    } OR @<BeamLine> OR @<BookkeepingComponent>
)
