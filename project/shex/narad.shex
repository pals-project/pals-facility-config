       ) ;
       rdf:type [ <SuperConductingRFCavity> ]
    )
}

<SupportingFacilityComponent> CLOSED {
    (  $<SupportingFacilityComponent_tes> (  &<PhysicalComponent_tes> ;
          rdf:type [ <PhysicalComponent> ] ? ;
          &<HasFloorP_tes> ;
          rdf:type [ <HasFloorP> ] ? ;
          &<HasLongitudinalPlacementP_tes> ;
          rdf:type [ <HasLongitudinalPlacementP> ] ? ;
          &<HasBodyShiftP_tes> ;
          rdf:type [ <HasBodyShiftP> ] ? ;
          <supporting_facility_function> [ <https://pals-project.readthedocs.io/FacilityFunctionEnum#Support>
