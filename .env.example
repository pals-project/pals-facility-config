# Copy this file to .env and fill in the values.
# .env is git-ignored and should never be committed.

NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.example.com/
LLM_MODEL_NAME=gpt-4o-mini
USE_GRAPH_CONTEXT=true
SHOW_REASONING=false
NEO4J_TRACE_MAX_CHARS=4000
NEO4J_SCHEMA_CACHE_TTL_SECONDS=300

# ---- Optional: forwarded into the gradio-chat container as UI defaults, and
# ---- also used by src/run_pipeline.py. NEO4J_URI is intentionally NOT
# ---- overridable here -- docker-compose.yml hardcodes it to the compose
# ---- service name so the container can actually reach Neo4j.
# OPENAI_TEMPERATURE=0.7
# OPENAI_SYSTEM_PROMPT=
# NEO4J_DATABASE=neo4j
# NEO4J_AGENT_MAX_ITERATIONS=6
# NEO4J_MANUAL_QUERY=MATCH (n) RETURN n LIMIT 25

# ---- Internal: set automatically by src/run_pipeline.py before it runs
# ---- `docker compose up`. Do not set these manually -- if left unset, the
# ---- defaults baked into docker-compose.yml are used instead.
# NEO4J_SCHEMA_TTL_PATH=
# NEO4J_INSTANCE_TTL_PATH=
