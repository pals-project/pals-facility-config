    {
      "name": "is_property_of",
      "definition_uri": "https://w3id.org/narad_linkml/schema/narad/is_property_of",
      "description": "Inverse of for_property: links the Class Signal to the Class of SignalBinding Procedure that implements it. This can also link the Instance of a SignalBinding to the ControlSystem that implements it. This is the edge that connects the signal definitions to the facility-specific bindings in the graph. Values are typically the ControlSystem that implements this binding, e.g. narad:epics (for EPICS control system).\n",
      "from_schema": "https://w3id.org/narad_linkml/schema/narad/system",
      "broad_mappings": [
        "http://www.w3.org/ns/ssn/isPropertyOf"
      ],
      "slot_uri": "https://w3id.org/narad_linkml/schema/narad/is_property_of",
      "owner": "InstanceSignalBinding",
      "domain_of": [
        "InstanceSignalBinding"
      ],
      "range": "uriorcurie",
      "@type": "SlotDefinition"
    },
    {
      "name": "is_hosted_by",
      "definition_uri": "https://w3id.org/narad_linkml/schema/narad/is_hosted_by",
      "description": "Links an InstanceSignalBinding to the FacilitySystem it belongs to. This is the edge that connects the facility-specific bindings to the Facility node in the graph.\n",
      "from_schema": "https://w3id.org/narad_linkml/schema/narad/system",
      "broad_mappings": [
        "http://www.w3.org/ns/ssn/systems/hasSubSystem",
        "http://www.w3.org/ns/ssn/isHostedBy"
      ],
      "slot_uri": "https://w3id.org/narad_linkml/schema/narad/is_hosted_by",
      "owner": "InstanceSignalBinding",
      "domain_of": [
        "InstanceSignalBinding"
      ],
      "range": "uriorcurie",
      "@type": "SlotDefinition"
    },
    {
      "name": "is_instance_of",
      "definition_uri": "https://w3id.org/narad_linkml/schema/narad/is_instance_of",
      "description": "NARAD alias for rdf:type. Links a facility-specific instance node to the LinkML class or semantic class it instantiates. In the graph this edge is labelled narad:isInstanceOf. Values are typically the rdf:type of the Class that implements the signal binding.\n",
      "from_schema": "https://w3id.org/narad_linkml/schema/narad/system",
      "exact_mappings": [
        "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"
