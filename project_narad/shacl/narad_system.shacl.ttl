@prefix linkml: <https://w3id.org/linkml/> .
@prefix narad: <https://w3id.org/narad_linkml/schema/narad/> .
@prefix ncit: <http://purl.obolibrary.org/obo/ncit.owl> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

narad:ActuatableSignal a sh:NodeShape ;
    sh:closed true ;
    sh:description """A NARAD signal that can be commanded, set, or acted upon. Examples: current_setpoint, strength_setpoint, kick_setpoint, field_setpoint, current_min, current_max, gradient_setpoint. Aligned to sosa:ActuatableProperty.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The data type of the signal's value." ;
            sh:in ( ncit:C47840 ncit:C48150 ncit:C48870 ncit:C45253 ncit:C45254 ncit:C95637 ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:data_type ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Machine-resolvable QUDT unit reference (e.g. si-unit:A for Ampere). The si-unit: prefix maps to http://qudt.org/vocab/unit/." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:units_uri ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:description "The semantic role of the signal within its capability." ;
            sh:in ( "control" "readback" "constraint" "status" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:role ],
        [ sh:datatype xsd:string ;
            sh:description "Conventional unit symbol (e.g. A, MV/m, T*m, G/cm)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:units ] ;
    sh:targetClass narad:ActuatableSignal .

narad:BPM a sh:NodeShape ;
    sh:closed true ;
    sh:description "A Beam Position Monitor." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:description ],
        [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:has_sub_system ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:name ],
        [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:has_system_capability ] ;
    sh:targetClass narad:BPM .

narad:BPMCapability a sh:NodeShape ;
    sh:closed true ;
    sh:description "BPM-specific capability with horizontal and vertical position readback signals." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:Signal ;
            sh:description """SystemCapability → Signal: the capability can expose, monitor, control, or actuate that signal.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:for_property ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:name ],
        [ sh:description "The specific device type this capability profile or system capability targets (e.g. Quadrupole, Corrector, BPM)." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "RFCavity" "Instrument" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:device_type ],
        [ sh:datatype xsd:boolean ;
            sh:description "If true, this profile is a template not intended to be directly assigned to a beamline element. Concrete profiles set this to false (default)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:is_abstract ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:description ] ;
    sh:targetClass narad:BPMCapability .

