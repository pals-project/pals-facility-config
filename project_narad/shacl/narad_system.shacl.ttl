    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
