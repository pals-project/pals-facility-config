narad:NamedThing a sh:NodeShape ;
    sh:closed false ;
    sh:description "Abstract base class providing identity and human-readable metadata." ;
    sh:ignoredProperties ( narad:is_abstract narad:signals rdf:type narad:Ksol narad:is_property_of narad:units narad:data_type narad:signal_definitions narad:voltage narad:device_type narad:e1 narad:has_sub_system narad:param_set narad:units_uri narad:facility_param_set narad:line narad:is_instance_of narad:Kn1 narad:shared_capabilities narad:type_specific_capabilities narad:capability_profile narad:pv_name narad:device_domain narad:control_system narad:capability_profile_family narad:has_system_capability narad:element_kind narad:beamline_kind narad:for_property narad:is_hosted_by narad:e2 narad:angle_ref narad:type_profiles narad:frequency narad:role narad:instance_signal_bindings narad:naming_convention narad:length narad:phase narad:inherits_shared_capabilities narad:facility_identifier ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:name ] ;
    sh:targetClass narad:NamedThing .

narad:NaradModel a sh:NodeShape ;
    sh:closed true ;
    sh:description "Top-level NARAD document container." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:BeamlineElement ;
            sh:description "Beamline element definitions referenced by name from beamline sequences." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:elements ],
        [ sh:class narad:NaradConfig ;
            sh:description "Top-level NARAD configuration block (capability_layer + signal_layer)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:narad_config ],
        [ sh:class narad:Beamline ;
            sh:description "Ordered beamline definitions keyed by beamline name." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:beamlines ] ;
    sh:targetClass narad:NaradModel .

narad:ObservableSignal a sh:NodeShape ;
    sh:closed true ;
    sh:description """A NARAD signal that is read, monitored, observed, or exposed by a system. Examples: current_readback, status, horizontal_beam_position, gradient_readback. Aligned to sosa:ObservableProperty.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Conventional unit symbol (e.g. A, MV/m, T*m, G/cm)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:units ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Machine-resolvable QUDT unit reference (e.g. si-unit:A for Ampere). The si-unit: prefix maps to http://qudt.org/vocab/unit/." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:units_uri ],
        [ sh:description "The data type of the signal's value." ;
            sh:in ( ncit:C47840 ncit:C48150 ncit:C48870 ncit:C45253 ncit:C45254 ncit:C95637 ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:data_type ],
        [ sh:description "The semantic role of the signal within its capability." ;
            sh:in ( "control" "readback" "constraint" "status" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:role ] ;
    sh:targetClass narad:ObservableSignal .

narad:Quadrupole a sh:NodeShape ;
    sh:closed true ;
    sh:description "A quadrupole focusing/defocusing magnet." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:description ],
        [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:has_system_capability ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:name ],
        [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:has_sub_system ] ;
    sh:targetClass narad:Quadrupole .

narad:QuadrupoleCapability a sh:NodeShape ;
    sh:closed true ;
    sh:description "Quadrupole-specific capability extending MagnetCapability with strength signals." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:name ],
        [ sh:description "The specific device type this capability profile or system capability targets (e.g. Quadrupole, Corrector, BPM)." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "RFCavity" "Instrument" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:device_type ],
        [ sh:datatype xsd:boolean ;
            sh:description "If true, this profile is a template not intended to be directly assigned to a beamline element. Concrete profiles set this to false (default)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:is_abstract ],
        [ sh:class narad:Signal ;
            sh:description """SystemCapability → Signal: the capability can expose, monitor, control, or actuate that signal.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:for_property ] ;
    sh:targetClass narad:QuadrupoleCapability .

narad:RFCavity a sh:NodeShape ;
    sh:closed true ;
    sh:description "A radio-frequency accelerating or bunching cavity." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:has_system_capability ],
        [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:has_sub_system ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:name ] ;
    sh:targetClass narad:RFCavity .

narad:Solenoid a sh:NodeShape ;
    sh:closed true ;
    sh:description "A solenoid magnet." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:description ],
        [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:has_system_capability ],
        [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:has_sub_system ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:name ] ;
    sh:targetClass narad:Solenoid .

narad:SolenoidCapability a sh:NodeShape ;
    sh:closed true ;
    sh:description "Solenoid-specific capability extending MagnetCapability with focusing signals." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:name ],
        [ sh:description "The specific device type this capability profile or system capability targets (e.g. Quadrupole, Corrector, BPM)." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "RFCavity" "Instrument" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:device_type ],
        [ sh:datatype xsd:boolean ;
            sh:description "If true, this profile is a template not intended to be directly assigned to a beamline element. Concrete profiles set this to false (default)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:is_abstract ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:description ],
        [ sh:class narad:Signal ;
            sh:description """SystemCapability → Signal: the capability can expose, monitor, control, or actuate that signal.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:for_property ] ;
    sh:targetClass narad:SolenoidCapability .

linkml:Any a sh:NodeShape ;
    sh:closed true ;
    sh:description "Unconstrained type — accepts any YAML/JSON value (string, number, object, list, etc.)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

narad:BPMSignalSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "BPM-specific signal bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:horizontal_beam_position ],
        [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path narad:vertical_beam_position ],
        [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path narad:status ] ;
    sh:targetClass narad:BPMSignalSet .

narad:Beamline a sh:NodeShape ;
    sh:closed true ;
    sh:description "An ordered sequence of beamline elements defining a beam path." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:name ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:description ],
        [ sh:class narad:BeamlineElement ;
            sh:description "Ordered sequence of cross-referenced element names forming a beamline." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:line ],
        [ sh:datatype xsd:string ;
            sh:description "Kind/type label for the beamline entry (e.g. BeamLine)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:beamline_kind ] ;
    sh:targetClass narad:Beamline .

narad:CapabilityLayer a sh:NodeShape ;
    sh:closed true ;
    sh:description "Capability-layer container for control profile families." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:ControlProfileFamily ;
            sh:description "Control profile families keyed by family name." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:profiles ] ;
    sh:targetClass narad:CapabilityLayer .

narad:CorrectorSignalSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "Corrector-specific signal bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:kick_setpoint ] ;
    sh:targetClass narad:CorrectorSignalSet .

narad:DipoleSignalSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "Dipole-specific signal bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:field_setpoint ] ;
    sh:targetClass narad:DipoleSignalSet .

narad:ElementParamSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "Named physics-parameter block for a beamline element. The name identifies the block type (e.g. RFP, BendP, MagneticMultipoleP, SolenoidP)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Exit edge angle in radians." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:e2 ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path narad:name ],
        [ sh:datatype xsd:float ;
            sh:description "Solenoid integrated field strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path narad:Ksol ],
        [ sh:datatype xsd:float ;
            sh:description "RF frequency in Hz." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:frequency ],
        [ sh:datatype xsd:float ;
            sh:description "First-order magnetic multipole coefficient (quadrupole strength)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path narad:Kn1 ],
        [ sh:datatype xsd:float ;
            sh:description "Reference bend angle in radians." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:angle_ref ],
        [ sh:datatype xsd:float ;
            sh:description "RF phase in degrees." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:phase ],
        [ sh:datatype xsd:float ;
            sh:description "RF voltage in volts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:voltage ],
        [ sh:datatype xsd:float ;
            sh:description "Entry edge angle in radians." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:e1 ] ;
    sh:targetClass narad:ElementParamSet .

narad:FacilityConfig a sh:NodeShape ;
    sh:closed true ;
    sh:description "Facility-specific signal binding configuration." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:class narad:FacilityIdentifier ;
            sh:description "Globally unique identifier for the facility, with specified type and value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:facility_identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Signal naming convention template (e.g. <device><signal_code>)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:naming_convention ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of the control system (e.g. epics)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:control_system ],
        [ sh:class narad:SignalDefinitions ;
            sh:description "Signal suffix templates for this facility." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path narad:signal_definitions ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ] ;
    sh:targetClass narad:FacilityConfig .

narad:FacilityIdentifier a sh:NodeShape ;
    sh:closed true ;
    sh:description "A globally unique identifier for an entity (e.g., facility), with a specified type (e.g. DOI, ROR, ARK, local)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The type of identifier used in the identifier slot (e.g. DOI, ARK, URL, local)." ;
            sh:in ( "doi" "ark" "handle" "url" "local" "other" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:identifier_type ],
        [ sh:datatype xsd:string ;
            sh:description "The value of the identifier (e.g. the DOI string, ARK string, URL string, or local ID)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:identifier_value ] ;
    sh:targetClass narad:FacilityIdentifier .

narad:FacilityParamSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "Facility-specific element parameters block for beamline elements." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Facility-specific element type designation (e.g. WarmCavity, QW, HCorrector). named facility_element_type here to avoid conflict with the LinkML metamodel 'type'  designator used for polymorphic class selection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:facility_element_type ],
        [ sh:datatype xsd:string ;
            sh:description "Accelerator physics code model element type (e.g. RFCA, KQUAD, HKICK)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:modeled_as ],
        [ sh:class linkml:Any ;
            sh:description "Open-ended key-value property map for element-specific or facility-specific parameters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path narad:properties ] ;
    sh:targetClass narad:FacilityParamSet .

narad:InstanceSignalBinding a sh:NodeShape ;
    sh:closed true ;
    sh:description """A facility-specific binding between a NARAD Signal and an implementation interface (e.g. an EPICS process variable). Modeled as sosa:Sensor because it describes how a signal is observed, monitored, or actuated. ssn:forProperty → Signal; narad:isInstanceOf → the capability class.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ],
        [ sh:datatype xsd:string ;
            sh:description """Fully-resolved facility-specific process variable name, e.g. MQWK202:STAT or MQWK202:BDL.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:pv_name ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:datatype xsd:anyURI ;
            sh:description """NARAD alias for rdf:type. Links a facility-specific instance node to the LinkML class or semantic class it instantiates. In the graph this edge is labelled narad:isInstanceOf.
""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:is_instance_of ],
        [ sh:datatype xsd:anyURI ;
            sh:description """Links an InstanceSignalBinding to the FacilitySystem it belongs to. This is the edge that connects the facility-specific bindings to the Facility node in the graph.
""" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:is_hosted_by ],
        [ sh:datatype xsd:anyURI ;
            sh:description """Inverse of for_property: links the Class Signal to the Class of SignalBinding Procedure that implements it. This can also link the Instance of a SignalBinding to the ControlSystem that implements it. This is the edge that connects the signal definitions to the facility-specific bindings in the graph.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:is_property_of ] ;
    sh:targetClass narad:InstanceSignalBinding .

narad:MagnetSignalSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "Shared magnet signal bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path narad:status ],
        [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path narad:current_readback ],
        [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path narad:current_max ],
        [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:current_setpoint ],
        [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path narad:current_min ] ;
    sh:targetClass narad:MagnetSignalSet .

narad:NaradConfig a sh:NodeShape ;
    sh:closed true ;
    sh:description "NARAD configuration block: capability layer + signal layer." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identifier of the facility this configuration describes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:facility ],
        [ sh:class narad:CapabilityLayer ;
            sh:description "Capability-layer container for control profile families." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path narad:capability_layer ],
        [ sh:datatype xsd:string ;
            sh:description "A human-readable statement of the intended use or purpose of this NARAD configuration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:intent ],
        [ sh:datatype xsd:string ;
            sh:description "Version of the NARAD schema used in this document." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:schema_version ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of the control system (e.g. epics) this configuration describes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:control_system ],
        [ sh:class narad:SignalLayer ;
            sh:description "Signal-layer container for facility-specific signal bindings." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path narad:signal_layer ] ;
    sh:targetClass narad:NaradConfig .

narad:QuadrupoleSignalSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "Quadrupole-specific signal bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:strength_setpoint ] ;
    sh:targetClass narad:QuadrupoleSignalSet .

narad:RFCavitySignalSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "RF cavity-specific signal bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path narad:status ],
        [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path narad:gradient_readback ],
        [ sh:class narad:SignalBinding ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:gradient_setpoint ] ;
    sh:targetClass narad:RFCavitySignalSet .

narad:SignalDefinitions a sh:NodeShape ;
    sh:closed true ;
    sh:description "EPICS signal suffix templates keyed by device type or device domain. Domain-level keys (e.g. Magnet, RFCavity) cover signals shared across all types in that domain; device-type keys are type-specific." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:TypeSignalSet ;
            sh:description "Signal suffix groups keyed by device type or device domain name. Domain-level keys cover signals shared across all types in that domain; device-type keys are type-specific." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:type_signal_sets ] ;
    sh:targetClass narad:SignalDefinitions .

narad:SignalLayer a sh:NodeShape ;
    sh:closed true ;
    sh:description "Signal-layer container for facility-specific signal bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:FacilityConfig ;
            sh:description "Facility-specific signal binding configurations keyed by facility name." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:facilities ] ;
    sh:targetClass narad:SignalLayer .

narad:TypeSignalSet a sh:NodeShape ;
    sh:closed true ;
    sh:description "Explicit signal binding groups keyed by device domain or device type." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:DipoleSignalSet ;
            sh:description "Dipole-specific signal bindings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path narad:dipole_signals ],
        [ sh:class narad:CorrectorSignalSet ;
            sh:description "Corrector-specific signal bindings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path narad:corrector_signals ],
        [ sh:class narad:BPMSignalSet ;
            sh:description "BPM-specific signal bindings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path narad:bpm_signals ],
        [ sh:class narad:QuadrupoleSignalSet ;
            sh:description "Quadrupole-specific signal bindings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path narad:quadrupole_signals ],
        [ sh:class narad:RFCavitySignalSet ;
            sh:description "RF cavity-specific signal bindings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path narad:rfcavity_signals ],
        [ sh:class narad:MagnetSignalSet ;
            sh:description "Shared magnet signal bindings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path narad:magnet_signals ] ;
    sh:targetClass narad:TypeSignalSet .

narad:TypeSpecificCapability a sh:NodeShape ;
    sh:closed true ;
    sh:description "An inline capability declared within a device-type profile that extends a generic shared Capability. The explicit link to the shared Capability being extended is given by inherits_from. Adds type-specific signals on top of those already defined in the referenced shared Capability." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:Signal ;
            sh:description "Signals within a capability, keyed by signal name." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:signals ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:name ] ;
    sh:targetClass narad:TypeSpecificCapability .

narad:BeamlineElement a sh:NodeShape ;
    sh:closed true ;
    sh:description "A single element in a beamline with its kind and optional NARAD capability annotations." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path narad:name ],
        [ sh:class narad:FacilityParamSet ;
            sh:description "Facility-specific element parameters (type designation, model name, open property map)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path narad:facility_param_set ],
        [ sh:class narad:ElementParamSet ;
            sh:description "Named physics-parameter blocks for this element (e.g. RFP, BendP, MagneticMultipoleP)." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path narad:param_set ],
        [ sh:description "The type of this beamline element (e.g. Quadrupole, BPM, RFCavity)." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "RFCavity" "Instrument" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:element_kind ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path narad:description ],
        [ sh:datatype xsd:float ;
            sh:description "Physical length of the element in metres." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:length ],
        [ sh:class narad:InstanceSignalBinding ;
            sh:description "Facility-specific bindings of signals to control-system interfaces (e.g. EPICS PVs) for a specific beamline element instance. These are the concrete implementations of the abstract SignalBindings referenced by the element's capability profile." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path narad:instance_signal_bindings ],
        [ sh:class narad:CapabilityProfile ;
            sh:description "Cross-reference to the specific capability profile applied to this element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:capability_profile ],
        [ sh:class narad:ControlProfileFamily ;
            sh:description "Cross-reference to the control profile family for this element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:capability_profile_family ] ;
    sh:targetClass narad:BeamlineElement .

narad:Capability a sh:NodeShape ;
    sh:closed true ;
    sh:description "A named, shared grouping of semantically related signals for a control aspect (e.g. MagnetCurrentControlCapability)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:Signal ;
            sh:description "Signals within a capability, keyed by signal name." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:signals ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:name ] ;
    sh:targetClass narad:Capability .

narad:CapabilityProfile a sh:NodeShape ;
    sh:closed true ;
    sh:description "A device-type profile that reuses shared capabilities and adds type-specific ones (e.g. QuadrupoleProfile)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "If true, this profile is a template not intended to be directly assigned to a beamline element. Concrete profiles set this to false (default)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:is_abstract ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:class narad:TypeSpecificCapability ;
            sh:description "Type-specific capabilities declared directly in a profile." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path narad:type_specific_capabilities ],
        [ sh:class narad:Capability ;
            sh:description "Shared capabilities inherited by this profile, cross-referenced by name." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:inherits_shared_capabilities ],
        [ sh:description "The specific device type this capability profile or system capability targets (e.g. Quadrupole, Corrector, BPM)." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "RFCavity" "Instrument" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:device_type ] ;
    sh:targetClass narad:CapabilityProfile .

narad:ControlProfileFamily a sh:NodeShape ;
    sh:closed true ;
    sh:description "A reusable family of control profiles sharing common semantics and structure (e.g. MagnetCurrentControlProfileFamily)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "High-level device domain that this profile family governs." ;
            sh:in ( "Magnet" "Instrument" "RFCavity" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:device_domain ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:name ],
        [ sh:class narad:Capability ;
            sh:description "Named shared capabilities reused by profile types in a family." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:shared_capabilities ],
        [ sh:class narad:CapabilityProfile ;
            sh:description "Device-type profile definitions for this family, keyed by profile name." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path narad:type_profiles ] ;
    sh:targetClass narad:ControlProfileFamily .

narad:Signal a sh:NodeShape ;
    sh:closed true ;
    sh:description """Domain term for a control-system signal. A Signal represents an identifiable quantity, state, setpoint, readback, limit, or status. In SSN/SOSA alignment, NARAD Signals are treated as properties of systems (ssn:forProperty). The concrete facility binding is captured in SignalBinding.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The data type of the signal's value." ;
            sh:in ( ncit:C47840 ncit:C48150 ncit:C48870 ncit:C45253 ncit:C45254 ncit:C95637 ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:data_type ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path narad:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:name ],
        [ sh:description "The semantic role of the signal within its capability." ;
            sh:in ( "control" "readback" "constraint" "status" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path narad:role ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Machine-resolvable QUDT unit reference (e.g. si-unit:A for Ampere). The si-unit: prefix maps to http://qudt.org/vocab/unit/." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:units_uri ],
        [ sh:datatype xsd:string ;
            sh:description "Conventional unit symbol (e.g. A, MV/m, T*m, G/cm)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:units ] ;
    sh:targetClass narad:Signal .

narad:System a sh:NodeShape ;
    sh:closed true ;
    sh:description """A physical, logical, or cyber-physical system involved in sensing, monitoring, control, or actuation. Broadly aligned to ssn:System.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class narad:System ;
            sh:description """Relates a System to one of its subsystems (SSN alignment). Use for facility → control-system, facility → device, and device → component decomposition.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:has_sub_system ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:name ],
        [ sh:class narad:SystemCapability ;
            sh:description """Relates a System to a SystemCapability it supports (SSN-System alignment). Prefer this over directly attaching signals to systems when capability context matters.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path narad:has_system_capability ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:description ] ;
    sh:targetClass narad:System .

narad:SystemCapability a sh:NodeShape ;
    sh:closed true ;
    sh:description """A capability of a system. SystemCapability describes what a system can expose, monitor, control, or actuate with respect to one or more signals. Aligned to ssn-system:SystemCapability; linked from System instances via ssn-system:hasSystemCapability, and from Signals via ssn:forProperty. Profile-level inheritance (shared vs. type-specific signals) is expressed in CapabilityProfile, not here.
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path narad:description ],
        [ sh:class narad:Signal ;
            sh:description """SystemCapability → Signal: the capability can expose, monitor, control, or actuate that signal.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path narad:for_property ],
        [ sh:datatype xsd:boolean ;
            sh:description "If true, this profile is a template not intended to be directly assigned to a beamline element. Concrete profiles set this to false (default)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path narad:is_abstract ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or local string key for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path narad:name ],
        [ sh:description "The specific device type this capability profile or system capability targets (e.g. Quadrupole, Corrector, BPM)." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "RFCavity" "Instrument" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path narad:device_type ] ;
    sh:targetClass narad:SystemCapability .

narad:SignalBinding a sh:NodeShape ;
    sh:closed true ;
    sh:description "A named EPICS suffix definition for one semantic signal." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Facility-specific control-system (e.g. EPICS) naming suffix used to derive or interpret the signal binding, e.g. .S, M, :GSET.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path narad:control_system_suffix ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path narad:description ] ;
    sh:targetClass narad:SignalBinding .

