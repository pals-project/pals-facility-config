        [ sh:description "The specific device type this capability profile or system capability targets (e.g. Quadrupole, Corrector, BPM)." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "RFCavity" "Instrument" ) ;
            sh:maxCount 1 ;
