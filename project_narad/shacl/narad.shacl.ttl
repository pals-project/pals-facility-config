@prefix linkml: <https://w3id.org/linkml/> .
@prefix ncit: <http://purl.obolibrary.org/obo/NCIT_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/narad_linkml/schema/narad/NaradModel> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Top-level NARAD document container." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/NaradConfig> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/narad> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/beamline/Beamline> ;
            sh:description "Beamlines — open structure to accommodate the list-of-named-dict serialization format used in NARAD YAML files." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/beamlines> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/elements/BeamlineElement> ;
            sh:description "Beamline element definitions (referenced by name from beamline line sequences)." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/NaradModel> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityMixin> a sh:NodeShape ;
    sh:closed false ;
    sh:description "Shared structure common to all capability types: a description and an ordered list of signals." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class sosa:ObservableProperty ;
            sh:description "Signals within a capability." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/signals> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/description> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityMixin> .

linkml:Any a sh:NodeShape ;
    sh:closed true ;
    sh:description "Unconstrained type — accepts any YAML/JSON value (string, number, object, list, etc.)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

<https://w3id.org/narad_linkml/schema/narad/beamline/Beamline> a sh:NodeShape ;
    sh:closed true ;
    sh:description "An ordered sequence of beamline elements defining a beam path." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Generic kind/type label. Used for Beamline entries (e.g. BeamLine). For ControlProfileFamily device domain use device_domain: DeviceDomainEnum. For CapabilityProfile device type use device_type: ElementKindEnum." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/kind> ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the beamline." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/beamline/beamline_name> ],
        [ sh:datatype xsd:string ;
            sh:description "Ordered sequence of cross-referenced element names forming a beamline." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/beamline/line> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/beamline/Beamline> .

<https://w3id.org/narad_linkml/schema/narad/elements/BeamlineElement> a sh:NodeShape ;
    sh:closed true ;
    sh:description "A single element in a beamline with optional physics parameter blocks." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/narad_linkml/schema/narad/elements/ElementNaradRef> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/narad> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/elements/BendParams> ;
            sh:description "Dipole/bend physics parameters block." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/BendP> ],
        [ sh:datatype xsd:float ;
            sh:description "Physical length of the element in meters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/length> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/facility_params/FacilityParams> ;
            sh:description "Facility-specific element parameters block." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/facility_params/facility_params> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/elements/MagneticMultipoleParams> ;
            sh:description "Magnetic multipole physics parameters block." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/MagneticMultipoleP> ],
        [ sh:datatype xsd:string ;
            sh:description "Name/identifier of the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/elements/SolenoidParams> ;
            sh:description "Solenoid physics parameters block." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/SolenoidP> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/elements/RFParams> ;
            sh:description "RF cavity physics parameters block." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/RFP> ],
        [ sh:description "Generic kind/type label. Used for Beamline entries (e.g. BeamLine). For ControlProfileFamily device domain use device_domain: DeviceDomainEnum. For CapabilityProfile device type use device_type: ElementKindEnum." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "RFCavity" "Instrument" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/kind> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/elements/BeamlineElement> .

<https://w3id.org/narad_linkml/schema/narad/elements/BendParams> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Dipole/bend physics parameters (entry angle, exit edge angles)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Entry edge angle in radians." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/e1> ],
        [ sh:datatype xsd:float ;
            sh:description "Exit edge angle in radians." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/e2> ],
        [ sh:datatype xsd:float ;
            sh:description "Reference bend angle in radians." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/angle_ref> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/elements/BendParams> .

<https://w3id.org/narad_linkml/schema/narad/elements/ElementNaradRef> a sh:NodeShape ;
    sh:closed true ;
    sh:description "NARAD semantic reference block attached to a beamline element." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/narad_linkml/schema/narad/elements/PVBinding> ;
            sh:description "Signal definitions keyed by signal name within a device type." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/signal_bindings> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/ControlProfileFamily> ;
            sh:description "Cross-reference to the control profile family for this element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_profile_family> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityProfile> ;
            sh:description "Cross-reference to the specific capability profile applied to this element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_profile> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/elements/ElementNaradRef> .

<https://w3id.org/narad_linkml/schema/narad/elements/MagneticMultipoleParams> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Magnetic multipole physics parameters." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "First-order magnetic multipole coefficient (quadrupole strength)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/Kn1> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/elements/MagneticMultipoleParams> .

<https://w3id.org/narad_linkml/schema/narad/elements/PVBinding> a sh:NodeShape ;
    sh:closed true ;
    sh:description "A concrete PV (Process Variable) binding for one semantic signal on a beamline element." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/control_system> ],
        [ sh:datatype xsd:string ;
            sh:description "Name/identifier of the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/facility> ],
        [ sh:datatype xsd:string ;
            sh:description "The EPICS Process Variable name (e.g. MBHK101H.S)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/pv> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/elements/PVBinding> .

<https://w3id.org/narad_linkml/schema/narad/elements/RFParams> a sh:NodeShape ;
    sh:closed true ;
    sh:description "RF cavity physics parameters (frequency, voltage, phase)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "RF voltage in volts." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/voltage> ],
        [ sh:datatype xsd:float ;
            sh:description "RF phase in degrees." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/phase> ],
        [ sh:datatype xsd:float ;
            sh:description "RF frequency in Hz." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/frequency> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/elements/RFParams> .

<https://w3id.org/narad_linkml/schema/narad/elements/SolenoidParams> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Solenoid physics parameters." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:float ;
            sh:description "Solenoid integrated field strength." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/elements/Ksol> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/elements/SolenoidParams> .

<https://w3id.org/narad_linkml/schema/narad/facility_params/FacilityParams> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Facility-specific element parameters: type designation, accelerator model name, and open property map." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class linkml:Any ;
            sh:description "Open-ended key-value property map for element-specific parameters." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/facility_params/properties> ],
        [ sh:datatype xsd:string ;
            sh:description "Facility-specific element type designation (e.g. WarmCavity, QW, HCorrector). named facility_element_type here to avoid conflict with the LinkML metamodel 'type' designator used for polymorphic class selection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/facility_params/facility_element_type> ],
        [ sh:datatype xsd:string ;
            sh:description "Accelerator physics code model element type (e.g. RFCA, KQUAD, HKICK)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/facility_params/modeled_as> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/facility_params/FacilityParams> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityLayer> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Capability-layer container for profile families and a shared default graph projection." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/GraphProjection> ;
            sh:description "The canonical graph projection for all profile families in this capability layer. Defines the full set of possible node labels (except device, which is derived from each family's device_domain) and the complete relationship vocabulary. Individual families may provide a graph_projection override when needed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/default_graph_projection> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/ControlProfileFamily> ;
            sh:description "Control profile families keyed by family name." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/profiles> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityLayer> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/DeviceTypeSignalSet> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Signal binding set scoped to a device type (for example, Quadrupole or BPM)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalBinding> ;
            sh:description "Signal definitions keyed by signal name within a device type." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/signal_bindings> ],
        [ sh:datatype xsd:string ;
            sh:description "Name/identifier of the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/DeviceTypeSignalSet> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/Facility> a sh:NodeShape ;
    sh:closed true ;
    sh:description "A facility with specific signal bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name/identifier of the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/Identifier> ;
            sh:description "Globally unique identifier for the facility, with specified type and value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/identifier> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalDefinitions> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/signal_definitions> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/naming_convention> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/control_system> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/Facility> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/Identifier> a sh:NodeShape ;
    sh:closed true ;
    sh:description "A globally unique identifier for an entity (e.g., facility), with a specified type (e.g. DOI, ROR, ARK, local)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The value of the identifier (e.g. the DOI string, ARK string, URL string, or local ID)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/identifier_value> ],
        [ sh:description "The type of identifier used in the identifier slot (e.g. DOI, ARK, URL, local)." ;
            sh:in ( "doi" "ark" "handle" "url" "local" "other" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/identifier_type> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/Identifier> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/NaradConfig> a sh:NodeShape ;
    sh:closed true ;
    sh:description "NARAD configuration block containing the capability layer." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/control_system> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/facility> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalLayer> ;
            sh:description "Signal-layer container for facility-specific signal bindings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/signal_layer> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityLayer> ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_layer> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/intent> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/schema_version> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/NaradConfig> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/NodeLabels> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Static node-type label strings for the graph projection, covering all node categories except Device. The device label is derived from ControlProfileFamily.device_domain and need not be repeated here." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_family> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/profile> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/signal> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/NodeLabels> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalBinding> a sh:NodeShape ;
    sh:closed true ;
    sh:description "A named EPICS suffix definition for one semantic signal." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Facility-specific EPICS suffix for a semantic signal." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/epics_suffix> ],
        [ sh:datatype xsd:string ;
            sh:description "Name/identifier of the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/description> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalBinding> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalDefinitions> a sh:NodeShape ;
    sh:closed true ;
    sh:description "EPICS signal suffix templates keyed by device type or device domain. Use a domain-level key (e.g. Magnet, RFCavity) for signals shared across all types in that domain; use a device-type key (e.g. Quadrupole, BPM) for type-specific signals. New device types require no schema changes." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/DeviceTypeSignalSet> ;
            sh:description "Signal suffix groups keyed by device type or device domain name. Domain-level keys (e.g. Magnet, RFCavity) represent signals shared across all types in that domain; device-type keys (e.g. Quadrupole, BPM) are type-specific. New device types require no schema changes." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/type_signal_sets> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalDefinitions> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalLayer> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Signal-layer container for facility-specific signal bindings." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/Facility> ;
            sh:description "Facility identifiers for facility-specific signal bindings." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/facilities> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalLayer> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/TypeSpecificCapability> a sh:NodeShape ;
    sh:closed true ;
    sh:description "An inline capability declared within a device-type profile, with its own identifier, a semantic class label, a description, and a list of signals. Distinct from the shared capabilities referenced by name; these are profile-local definitions." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/description> ],
        [ sh:class sosa:ObservableProperty ;
            sh:description "Signals within a capability." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/signals> ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/id> ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Optional machine-resolvable URI or CURIE for a TypeSpecificCapability class. Use the narad: prefix for NARAD-defined classes (e.g. narad:QuadrupoleStrengthCapability), or any registered prefix for externally defined capability types. New capability classes can be introduced freely by using a suitable namespace." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/class_curie> ],
        [ sh:datatype xsd:string ;
            sh:description "Semantic class label for a type-specific capability (e.g. QuadrupoleStrengthCapability). Serialized as 'class' in source YAML; renamed here to avoid conflict with reserved keywords." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_class> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/TypeSpecificCapability> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/Capability> a sh:NodeShape ;
    sh:closed true ;
    sh:description "A named, shared grouping of semantically related signals for a control aspect." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/description> ],
        [ sh:class sosa:ObservableProperty ;
            sh:description "Signals within a capability." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/signals> ],
        [ sh:datatype xsd:string ;
            sh:description "Name/identifier of the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/Capability> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityProfile> a sh:NodeShape ;
    sh:closed true ;
    sh:description "A device-type profile that reuses shared capabilities and adds specific capabilities." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name/identifier of the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ sh:datatype xsd:boolean ;
            sh:description "If true, this profile is a template or abstract definition not intended to be directly assigned to a beamline element. Concrete profiles that refine a template should set this to false (the default)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/is_abstract> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/TypeSpecificCapability> ;
            sh:description "Type-specific capabilities declared directly in a profile, each with an id, class label, description, and signals." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/type_specific_capabilities> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/Capability> ;
            sh:description "Shared capabilities inherited by this profile, cross-referenced by name. The validator checks that referenced names exist in the parent family's shared_capabilities." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/inherits_shared_capabilities> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/description> ],
        [ sh:description "The specific device type this capability profile targets (e.g. Quadrupole, Corrector, BPM). Uses ElementKindEnum to stay in sync with BeamlineElement.kind." ;
            sh:in ( "Drift" "Marker" "BPM" "Corrector" "Dipole" "Quadrupole" "Solenoid" "RFCavity" "Instrument" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/device_type> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityProfile> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/ControlProfileFamily> a sh:NodeShape ;
    sh:closed true ;
    sh:description "A reusable family of control profiles sharing common semantics and structure." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityProfile> ;
            sh:description "Device-type profile definitions for this family, keyed by profile name. New device types are accommodated by adding a new entry without schema changes." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/type_profiles> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/description> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/GraphProjection> ;
            sh:description "Optional per-family graph projection override. If absent, the CapabilityLayer.default_graph_projection applies. Provide only when this family genuinely requires a different projection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/graph_projection> ],
        [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/Capability> ;
            sh:description "Named shared capabilities reused by profile types in a family." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/shared_capabilities> ],
        [ sh:description "High-level device domain that this profile family governs." ;
            sh:in ( "Magnet" "Instrument" "RFCavity" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/device_domain> ],
        [ sh:datatype xsd:string ;
            sh:description "Name/identifier of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/ControlProfileFamily> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/GraphProjection> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Graph projection metadata for node labels and edge categories." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/narad_linkml/schema/narad/narad_narad/NodeLabels> ;
            sh:description "Node label mapping for the graph projection." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/node_labels> ],
        [ sh:class owl:ObjectProperty ;
            sh:description "Relationship definitions used in the graph projection." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/relationships> ] ;
    sh:targetClass <https://w3id.org/narad_linkml/schema/narad/narad_narad/GraphProjection> .

owl:ObjectProperty a sh:NodeShape ;
    sh:closed true ;
    sh:description "A directed edge type in the NARAD graph projection, modelled after the OBO Relation Ontology (RO) ObjectProperty metamodel. Each relationship carries an identifier, human-readable label, natural-language description, and explicit domain/range node-type constraints." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "True if the relation is symmetric: if A rel B then B rel A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/symmetric> ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if no entity can stand in this relation to itself." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/irreflexive> ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if the relation is asymmetric: if A rel B then NOT B rel A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/asymmetric> ],
        [ sh:description "The node type that can appear as the object (target) of this relationship." ;
            sh:in ( "Device" "CapabilityFamily" "Profile" "Capability" "TypeSpecificCapability" "Signal" "Facility" "ControlSystem" "SignalBinding" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/range> ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/id> ],
        [ sh:description "The node type that can appear as the subject (source) of this relationship." ;
            sh:in ( "Device" "CapabilityFamily" "Profile" "Capability" "TypeSpecificCapability" "Signal" "Facility" "ControlSystem" "SignalBinding" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/domain> ],
        [ sh:class owl:ObjectProperty ;
            sh:description "The inverse relationship, if any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/inverse_of> ],
        [ sh:datatype xsd:boolean ;
            sh:description "True if the relation is transitive: if A rel B and B rel C then A rel C." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/transitive> ],
        [ sh:class owl:ObjectProperty ;
            sh:description "Parent relationships of which this is a more specific sub-relation." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/subproperty_of> ] ;
    sh:targetClass owl:ObjectProperty .

sosa:ObservableProperty a sh:NodeShape ;
    sh:closed true ;
    sh:description "A named semantic signal used by a capability." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The data type of the signal's value." ;
            sh:in ( ncit:C45255 ncit:C47840 ncit:C48150 ncit:C48870 ncit:C45253 ncit:C45254 ncit:C95630 ncit:C48871 ncit:C95637 ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/data_type> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/description> ],
        [ sh:datatype xsd:string ;
            sh:description "Name/identifier of the entity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ sh:datatype xsd:string ;
            sh:description "Conventional unit symbol (e.g. A, MV/m, T*m, G/cm)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/units> ],
        [ sh:description "The semantic role of the signal within its capability." ;
            sh:in ( "control" "readback" "constraint" "status" "interlock" "diagnostic" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/role> ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Machine-resolvable QUDT unit reference (e.g. si-unit:A for Ampere, si-unit:MegaV-PER-M for MV/m, si-unit:T-M for T*m). The si-unit: prefix maps to http://qudt.org/vocab/unit/. Companion to the human-readable symbol in the units slot. Use the narad:CustomUnit for user-defined units not in QUDT; these should be defined in the graph projection with a narad:CustomUnit class and linked to signals via the units_uri slot." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://w3id.org/narad_linkml/schema/narad/narad_narad/units_uri> ] ;
    sh:targetClass sosa:ObservableProperty .

