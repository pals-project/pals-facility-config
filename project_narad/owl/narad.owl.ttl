<https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityMixin> a owl:Class ;
    rdfs:label "CapabilityMixin" ;
    rdfs:subClassOf <https://w3id.org/linkml/ClassDefinition#Mixin> ;
    skos:definition "Shared structure common to all capability types: a description and an ordered list of signals." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/asymmetric> a owl:DatatypeProperty ;
    rdfs:label "asymmetric" ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the relation is asymmetric: if A rel B then NOT B rel A." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/capability> a owl:DatatypeProperty ;
    rdfs:label "capability" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_class> a owl:DatatypeProperty ;
    rdfs:label "capability_class" ;
    rdfs:range xsd:string ;
    skos:altLabel "class" ;
    skos:definition "Semantic class label for a type-specific capability (e.g. QuadrupoleStrengthCapability). Serialized as 'class' in source YAML; renamed here to avoid conflict with reserved keywords." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_family> a owl:DatatypeProperty ;
    rdfs:label "capability_family" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_layer> a owl:ObjectProperty ;
    rdfs:label "capability_layer" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityLayer> ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_profile> a owl:ObjectProperty ;
    rdfs:label "capability_profile" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityProfile> ;
    skos:definition "Cross-reference to the specific capability profile applied to this element." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_profile_family> a owl:ObjectProperty ;
    rdfs:label "capability_profile_family" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/ControlProfileFamily> ;
