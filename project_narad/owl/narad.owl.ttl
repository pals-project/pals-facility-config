    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/beamline> .

<https://w3id.org/narad_linkml/schema/narad/elements/BendP> a owl:ObjectProperty ;
    rdfs:label "BendP" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/elements/BendParams> ;
    skos:definition "Dipole/bend physics parameters block." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/elements> .

<https://w3id.org/narad_linkml/schema/narad/elements/Kn1> a owl:DatatypeProperty ;
    rdfs:label "Kn1" ;
    rdfs:range xsd:float ;
    skos:definition "First-order magnetic multipole coefficient (quadrupole strength)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/elements> .

<https://w3id.org/narad_linkml/schema/narad/elements/Ksol> a owl:DatatypeProperty ;
