        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:broadMatch ro:0001025 ;
    skos:definition "A element is contained in an element." .

<https://w3id.org/narad_linkml/schema/narad/:SignalRoleEnum#constraint> a owl:Class ;
    rdfs:label "constraint" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:SignalRoleEnum> ;
