<https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalDefinitions> a owl:Class ;
    rdfs:label "SignalDefinitions" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/type_signal_sets> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/narad_narad/DeviceTypeSignalSet> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/type_signal_sets> ],
        linkml:ClassDefinition ;
    skos:definition "EPICS signal suffix templates keyed by device type or device domain. Use a domain-level key (e.g. Magnet, RFCavity) for signals shared across all types in that domain; use a device-type key (e.g. Quadrupole, BPM) for type-specific signals. New device types require no schema changes." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalLayer> a owl:Class ;
    rdfs:label "SignalLayer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/narad_narad/Facility> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/facilities> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/facilities> ],
        linkml:ClassDefinition ;
    skos:definition "Signal-layer container for facility-specific signal bindings." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/TypeSpecificCapability> a owl:Class ;
    rdfs:label "TypeSpecificCapability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/class_curie> ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityMixin> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_class> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_class> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/class_curie> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/class_curie> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_class> ],
        linkml:ClassDefinition ;
    skos:definition "An inline capability declared within a device-type profile, with its own identifier, a semantic class label, a description, and a list of signals. Distinct from the shared capabilities referenced by name; these are profile-local definitions." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/facilities> a owl:ObjectProperty ;
    rdfs:label "facilities" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/Facility> ;
    skos:definition "Facility identifiers for facility-specific signal bindings." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/identifier> a owl:ObjectProperty ;
    rdfs:label "identifier" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/Identifier> ;
    skos:definition "Globally unique identifier for the facility, with specified type and value." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/inherits_shared_capabilities> a owl:ObjectProperty ;
    rdfs:label "inherits_shared_capabilities" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/Capability> ;
    skos:definition "Shared capabilities inherited by this profile, cross-referenced by name. The validator checks that referenced names exist in the parent family's shared_capabilities." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/profiles> a owl:ObjectProperty ;
    rdfs:label "profiles" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/ControlProfileFamily> ;
    skos:definition "Control profile families keyed by family name." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/relationships> a owl:ObjectProperty ;
    rdfs:label "relationships" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/Relationship> ;
    skos:definition "Relationship definitions used in the graph projection." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/shared_capabilities> a owl:ObjectProperty ;
    rdfs:label "shared_capabilities" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/Capability> ;
    skos:definition "Named shared capabilities reused by profile types in a family." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/signals> a owl:ObjectProperty ;
    rdfs:label "signals" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/Signal> ;
    skos:definition "Signals within a capability." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/subproperty_of> a owl:ObjectProperty ;
    rdfs:label "subproperty_of" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/Relationship> ;
    skos:definition "Parent relationships of which this is a more specific sub-relation." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/type_profiles> a owl:ObjectProperty ;
    rdfs:label "type_profiles" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityProfile> ;
    skos:definition "Device-type profile definitions for this family, keyed by profile name. New device types are accommodated by adding a new entry without schema changes." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/type_signal_sets> a owl:ObjectProperty ;
    rdfs:label "type_signal_sets" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/DeviceTypeSignalSet> ;
    skos:definition "Signal suffix groups keyed by device type or device domain name. Domain-level keys (e.g. Magnet, RFCavity) represent signals shared across all types in that domain; device-type keys (e.g. Quadrupole, BPM) are type-specific. New device types require no schema changes." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/type_specific_capabilities> a owl:ObjectProperty ;
    rdfs:label "type_specific_capabilities" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/TypeSpecificCapability> ;
    skos:definition "Type-specific capabilities declared directly in a profile, each with an id, class label, description, and signals." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/> a owl:Ontology ;
    rdfs:label "narad" ;
    dcterms:license "CC-BY-4.0" ;
    pav:version "0.1.0" ;
    skos:definition "NARAD extension for capability-layer semantics and facility-specific signal bindings" .

<https://w3id.org/narad_linkml/schema/narad/beamline/beamline_name> a owl:DatatypeProperty ;
    rdfs:label "beamline_name" ;
    rdfs:range xsd:string ;
