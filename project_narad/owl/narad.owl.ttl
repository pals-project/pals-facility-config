    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/class_curie> a owl:DatatypeProperty ;
    rdfs:label "class_curie" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Optional machine-resolvable URI or CURIE for a TypeSpecificCapability class. Use the narad: prefix for NARAD-defined classes (e.g. narad:QuadrupoleStrengthCapability), or any registered prefix for externally defined capability types. New capability classes can be introduced freely by using a suitable namespace." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/data_type> a owl:ObjectProperty ;
    rdfs:label "data_type" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/:DataTypeEnum> ;
    skos:broadMatch ncit:C42645,
        qudt:Datatype ;
    skos:definition "The data type of the signal's value." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/default_graph_projection> a owl:ObjectProperty ;
    rdfs:label "default_graph_projection" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/GraphProjection> ;
    skos:definition "The canonical graph projection for all profile families in this capability layer. Defines the full set of possible node labels (except device, which is derived from each family's device_domain) and the complete relationship vocabulary. Individual families may provide a graph_projection override when needed." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/device_domain> a owl:ObjectProperty ;
    rdfs:label "device_domain" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/:DeviceDomainEnum> ;
    skos:definition "High-level device domain that this profile family governs." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/device_type> a owl:ObjectProperty ;
    rdfs:label "device_type" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
    skos:definition "The specific device type this capability profile targets (e.g. Quadrupole, Corrector, BPM). Uses ElementKindEnum to stay in sync with BeamlineElement.kind." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/domain> a owl:ObjectProperty ;
    rdfs:label "domain" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "The node type that can appear as the subject (source) of this relationship." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/epics_suffix> a owl:DatatypeProperty ;
    rdfs:label "epics_suffix" ;
    rdfs:range xsd:string ;
    skos:definition "Facility-specific EPICS suffix for a semantic signal." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/graph_projection> a owl:ObjectProperty ;
    rdfs:label "graph_projection" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/GraphProjection> ;
    skos:definition "Optional graph projection metadata attached to a profile family." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/identifier_type> a owl:ObjectProperty ;
    rdfs:label "identifier_type" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum> ;
    skos:definition "The type of identifier used in the identifier slot (e.g. DOI, ARK, URL, local)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/identifier_value> a owl:DatatypeProperty ;
    rdfs:label "identifier_value" ;
    rdfs:range xsd:string ;
    skos:definition "The value of the identifier (e.g. the DOI string, ARK string, URL string, or local ID)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/intent> a owl:DatatypeProperty ;
    rdfs:label "intent" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/inverse_of> a owl:ObjectProperty ;
    rdfs:label "inverse_of" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/Relationship> ;
    skos:definition "The inverse relationship, if any." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/irreflexive> a owl:DatatypeProperty ;
    rdfs:label "irreflexive" ;
    rdfs:range xsd:boolean ;
    skos:definition "True if no entity can stand in this relation to itself." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/is_abstract> a owl:DatatypeProperty ;
    rdfs:label "is_abstract" ;
    rdfs:range xsd:boolean ;
    skos:definition "If true, this profile is a template or abstract definition not intended to be directly assigned to a beamline element. Concrete profiles that refine a template should set this to false (the default)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/naming_convention> a owl:DatatypeProperty ;
    rdfs:label "naming_convention" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/node_labels> a owl:ObjectProperty ;
    rdfs:label "node_labels" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/NodeLabels> ;
    skos:definition "Node label mapping for the graph projection." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/profile> a owl:DatatypeProperty ;
    rdfs:label "profile" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/range> a owl:ObjectProperty ;
    rdfs:label "range" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "The node type that can appear as the object (target) of this relationship." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/role> a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/:SignalRoleEnum> ;
    skos:definition "The semantic role of the signal within its capability." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/schema_version> a owl:DatatypeProperty ;
    rdfs:label "schema_version" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/signal> a owl:DatatypeProperty ;
    rdfs:label "signal" ;
    rdfs:range xsd:string ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/signal_definitions> a owl:ObjectProperty ;
    rdfs:label "signal_definitions" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalDefinitions> ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/signal_layer> a owl:ObjectProperty ;
    rdfs:label "signal_layer" ;
    rdfs:range <https://w3id.org/narad_linkml/schema/narad/narad_narad/SignalLayer> ;
    skos:definition "Signal-layer container for facility-specific signal bindings." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/symmetric> a owl:DatatypeProperty ;
    rdfs:label "symmetric" ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the relation is symmetric: if A rel B then B rel A." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/transitive> a owl:DatatypeProperty ;
    rdfs:label "transitive" ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the relation is transitive: if A rel B and B rel C then A rel C." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/units> a owl:DatatypeProperty ;
    rdfs:label "units" ;
    rdfs:range xsd:string ;
    skos:broadMatch si-unit:Unit ;
    skos:definition "Conventional unit symbol (e.g. A, MV/m, T*m, G/cm)." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/units_uri> a owl:DatatypeProperty ;
    rdfs:label "units_uri" ;
    rdfs:range xsd:anyURI ;
    skos:broadMatch si-unit:Unit ;
    skos:definition "Machine-resolvable QUDT unit reference (e.g. si-unit:A for Ampere, si-unit:MegaV-PER-M for MV/m, si-unit:T-M for T*m). The si-unit: prefix maps to http://qudt.org/vocab/unit/. Companion to the human-readable symbol in the units slot. Use the narad:CustomUnit for user-defined units not in QUDT; these should be defined in the graph projection with a narad:CustomUnit class and linked to signals via the units_uri slot." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/Capability> a owl:Class ;
    rdfs:label "Capability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ a owl:Restriction ;
            owl:onProperty linkml:mixins ;
            owl:someValuesFrom <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityMixin> ],
        linkml:ClassDefinition ;
    skos:definition "A named, shared grouping of semantically related signals for a control aspect." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityProfile> a owl:Class ;
    rdfs:label "CapabilityProfile" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/type_specific_capabilities> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/is_abstract> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/is_abstract> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/device_type> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/narad_narad/Capability> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/inherits_shared_capabilities> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/device_type> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/is_abstract> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/inherits_shared_capabilities> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/device_type> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/narad_narad/TypeSpecificCapability> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/type_specific_capabilities> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
