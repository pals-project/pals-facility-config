@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix ncit: <http://purl.obolibrary.org/obo/NCIT_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ro: <http://purl.obolibrary.org/obo/RO_> .
@prefix si-unit: <http://qudt.org/vocab/unit/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/narad_linkml/schema/narad/NaradModel> a owl:Class ;
    rdfs:label "NaradModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/narad> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/elements> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/narad> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/elements/BeamlineElement> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/elements> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/narad_narad/NaradConfig> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/narad> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/beamline/Beamline> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/beamlines> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/beamlines> ],
        linkml:ClassDefinition ;
    skos:definition "Top-level NARAD document container." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/> .

<https://w3id.org/narad_linkml/schema/narad/elements/cavity_semantics> a owl:DatatypeProperty ;
    rdfs:label "cavity_semantics" ;
    rdfs:range xsd:string ;
    skos:definition "Deprecated — capabilities are now derived from capability_profile. This slot is retained for migration only." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/elements> .

<https://w3id.org/narad_linkml/schema/narad/elements/instrument_semantics> a owl:DatatypeProperty ;
    rdfs:label "instrument_semantics" ;
    rdfs:range xsd:string ;
    skos:definition "Deprecated — capabilities are now derived from capability_profile. This slot is retained for migration only." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/elements> .

<https://w3id.org/narad_linkml/schema/narad/elements/magnet_semantics> a owl:DatatypeProperty ;
    rdfs:label "magnet_semantics" ;
    rdfs:range xsd:string ;
    skos:definition "Deprecated — capabilities are now derived from capability_profile. This slot is retained for migration only." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/elements> .

<https://w3id.org/narad_linkml/schema/narad/narad_narad/label> a owl:DatatypeProperty ;
    rdfs:label "label" ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable label for the relationship (e.g. 'has shared capability')." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/narad_narad> .

<https://w3id.org/narad_linkml/schema/narad/elements/ElementNaradRef> a owl:Class ;
    rdfs:label "ElementNaradRef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/narad_narad/CapabilityProfile> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_profile> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_profile> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/narad_narad/ControlProfileFamily> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_profile_family> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_profile> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_profile_family> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/narad_linkml/schema/narad/elements/PVBinding> ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/signal_bindings> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/capability_profile_family> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/signal_bindings> ],
        linkml:ClassDefinition ;
    skos:definition "NARAD semantic reference block attached to a beamline element." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/elements> .

<https://w3id.org/narad_linkml/schema/narad/elements/PVBinding> a owl:Class ;
    rdfs:label "PVBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/control_system> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/facility> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/facility> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/control_system> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/control_system> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/elements/pv> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/elements/pv> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/elements/pv> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/narad_linkml/schema/narad/narad_narad/facility> ],
        linkml:ClassDefinition ;
    skos:definition "A concrete PV (Process Variable) binding for one semantic signal on a beamline element." ;
    skos:inScheme <https://w3id.org/narad_linkml/schema/narad/elements> .

ncit:C45253 a owl:Class ;
    rdfs:label "string" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DataTypeEnum> ;
    skos:definition "A sequence of characters used to represent text." .

ncit:C45254 a owl:Class ;
    rdfs:label "boolean" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DataTypeEnum> ;
    skos:definition "A data type with two possible values: true and false." .

ncit:C45255 a owl:Class ;
    rdfs:label "None" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DataTypeEnum> ;
    skos:definition "A special value that may represent an unknown, missing, not applicable, or undefined value." .

ncit:C47840 a owl:Class ;
    rdfs:label "int" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DataTypeEnum> ;
    skos:definition "A data type comprised of numbers with no fractional part, including negative and positive values." .

ncit:C48150 a owl:Class ;
    rdfs:label "float" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DataTypeEnum> ;
    skos:definition "A number that can have its decimal point in any position." .

ncit:C48870 a owl:Class ;
    rdfs:label "double" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DataTypeEnum> ;
    skos:definition "A 64-bit floating-point value." .

ncit:C48871 a owl:Class ;
    rdfs:label "date" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DataTypeEnum> ;
    skos:definition "A calendar date (year, month, day)." .

ncit:C95630 a owl:Class ;
    rdfs:label "boolean_non_null" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DataTypeEnum> ;
    skos:definition "A two-value boolean data type that does not include null flavor." .

ncit:C95637 a owl:Class ;
    rdfs:label "coded_value" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DataTypeEnum> ;
    skos:definition "A code value referenced from an external coding system or ontology." .

<https://w3id.org/narad_linkml/schema/narad/:DeviceDomainEnum#Instrument> a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DeviceDomainEnum> ;
    skos:definition "Beam diagnostic instruments: BPMs, screens, halos, viewers, etc." .

<https://w3id.org/narad_linkml/schema/narad/:DeviceDomainEnum#Magnet> a owl:Class ;
    rdfs:label "Magnet" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DeviceDomainEnum> ;
    skos:definition "Magnet devices: dipoles, quadrupoles, correctors, solenoids." .

<https://w3id.org/narad_linkml/schema/narad/:DeviceDomainEnum#RFCavity> a owl:Class ;
    rdfs:label "RFCavity" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:DeviceDomainEnum> ;
    skos:definition "RF cavity and RF-related devices." .

<https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum#BPM> a owl:Class ;
    rdfs:label "BPM" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
    skos:definition "Beam Position Monitor." .

<https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum#Corrector> a owl:Class ;
    rdfs:label "Corrector" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
    skos:definition "Dipole corrector magnet for orbit correction." .

<https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum#Dipole> a owl:Class ;
    rdfs:label "Dipole" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
    skos:definition "Dipole bending magnet." .

<https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum#Drift> a owl:Class ;
    rdfs:label "Drift" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
    skos:definition "A field-free drift space between elements." .

<https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum#Instrument> a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
    skos:definition "Generic beam diagnostic instrument (halo monitor, viewer, etc.)." .

<https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum#Marker> a owl:Class ;
    rdfs:label "Marker" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
    skos:definition "A zero-length reference point or survey marker." .

<https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum#Quadrupole> a owl:Class ;
    rdfs:label "Quadrupole" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
    skos:definition "Quadrupole focusing/defocusing magnet." .

<https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum#RFCavity> a owl:Class ;
    rdfs:label "RFCavity" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
    skos:definition "Radio-frequency accelerating or bunching cavity." .

<https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum#Solenoid> a owl:Class ;
    rdfs:label "Solenoid" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:ElementKindEnum> ;
    skos:definition "Solenoid magnet." .

<https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum#ark> a owl:Class ;
    rdfs:label "ark" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum> ;
    skos:definition "Archival Resource Key (ARK)." .

<https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum#doi> a owl:Class ;
    rdfs:label "doi" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum> ;
    skos:definition "Digital Object Identifier (DOI)." .

<https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum#handle> a owl:Class ;
    rdfs:label "handle" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum> ;
    skos:definition "Handle System identifier." .

<https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum#local> a owl:Class ;
    rdfs:label "local" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum> ;
    skos:definition "Local identifier unique within a specific context or namespace." .

<https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum#other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum> ;
    skos:definition "Any other type of identifier not covered by the above categories." .

<https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum#url> a owl:Class ;
    rdfs:label "url" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:IdentifierTypeEnum> ;
    skos:definition "Uniform Resource Locator (URL)." .

<https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum#Capability> a owl:Class ;
    rdfs:label "Capability" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "A shared capability grouping signals." .

<https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum#CapabilityFamily> a owl:Class ;
    rdfs:label "CapabilityFamily" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "A control profile family (ControlProfileFamily)." .

<https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum#ControlSystem> a owl:Class ;
    rdfs:label "ControlSystem" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "The control system (e.g. EPICS) managing device PVs." .

<https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum#Device> a owl:Class ;
    rdfs:label "Device" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "A physical beamline element (BeamlineElement)." .

<https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum#Facility> a owl:Class ;
    rdfs:label "Facility" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "A physical accelerator facility." .

<https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum#Profile> a owl:Class ;
    rdfs:label "Profile" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "A device-type capability profile (CapabilityProfile)." .

<https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum#Signal> a owl:Class ;
    rdfs:label "Signal" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "An individual semantic signal (EPICS PV or equivalent)." .

<https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum#SignalBinding> a owl:Class ;
    rdfs:label "SignalBinding" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "A concrete facility-specific PV binding for a semantic signal." .

<https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum#TypeSpecificCapability> a owl:Class ;
    rdfs:label "TypeSpecificCapability" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:NodeTypeEnum> ;
    skos:definition "A profile-local type-specific capability." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#after> a owl:Class ;
    rdfs:label "after" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:broadMatch ro:0002412 ;
    skos:definition "A beamline element is downstream of another in the beam path." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#before> a owl:Class ;
    rdfs:label "before" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:broadMatch ro:0002411 ;
    skos:definition "A beamline element is upstream of another in the beam path." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#binds_to> a owl:Class ;
    rdfs:label "binds_to" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:definition "A PV signal binding is bound to a physical beamline element." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#controlled_by> a owl:Class ;
    rdfs:label "controlled_by" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:broadMatch ro:0002334 ;
    skos:definition "An entity is controlled by a control system element." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#has_shared_capability> a owl:Class ;
    rdfs:label "has_shared_capability" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:broadMatch ro:0001019 ;
    skos:definition "A profile family has a shared capability available to all its member profiles. Analogous to ro:has_part for capability composition." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#has_signal> a owl:Class ;
    rdfs:label "has_signal" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:broadMatch ro:0002234 ;
    skos:definition "A capability has a semantic signal (EPICS PV or equivalent). Broad mapping to sosa:hasResult." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#has_type_profile> a owl:Class ;
    rdfs:label "has_type_profile" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:definition "A profile family has a device-type profile (e.g. Quadrupole, BPM)." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#has_type_specific_capability> a owl:Class ;
    rdfs:label "has_type_specific_capability" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:definition "A type profile has a locally-declared type-specific capability." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#implemented_by> a owl:Class ;
    rdfs:label "implemented_by" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:broadMatch <http://purl.obolibrary.org/obo/swo.owl0000085> ;
    skos:definition "A semantic signal or capability is implemented by a concrete facility binding." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#inherits_capability> a owl:Class ;
    rdfs:label "inherits_capability" ;
    rdfs:subClassOf linkml:PermissibleValue,
        <https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum> ;
    skos:definition "A type-specific profile inherits a named shared capability from its family. Sub-relation of has_shared_capability." .

<https://w3id.org/narad_linkml/schema/narad/:RelationshipTypeEnum#located_in> a owl:Class ;
    rdfs:label "located_in" ;
