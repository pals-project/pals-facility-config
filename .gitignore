# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# python package artifacts
*.egg-info/
dist/
build/

# Generated from the LinkML schema; regenerate with `just gen-project` / `just gen-python` / `just gen-doc`
/project/
/src/narad/datamodel/
/docs/schema/
/docs/elements/

# Intermediate files written by src/run_pipeline.py and the gen-* just recipes
*.resolved.yaml
*.owl.ttl
*_rdf.ttl
/examples/*.ttl

# type checking and linting artifacts
.mypy_cache/
.pytype/
.pylint.d/
.ruff_cache/
.coverage.*


# Ignore virtual environment directories
venv/
env/
.venv/
ENV/

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore pytest cache
.pytest_cache/
.coverage
htmlcov/

# Ignore macOS Finder metadata
.DS_Store
**/.DS_Store

# IDE / editor config
.idea/
.vscode/
*.swp

# Environment files with secrets
.env

# Generated schema documentation.
# These pages are produced by `just gen-doc` and rebuilt by CI on Linux; they are not
# tracked. See linkml/linkml#632: on case-insensitive filesystems (macOS) a locally
# generated tree can differ from the Linux one, so checking it in produces spurious diffs.
# Note the pattern covers subdirectories (classes/, slots/, ...), which a `*.md` glob
# would miss now that --subfolder-type-separation is enabled.
/docs/elements/**
!/docs/elements/.gitkeep

# The merged (imports-resolved) schema, written by `just gen-doc` via gen-yaml.
# Not tracked: gen-yaml stamps a `generation_date` into it, so the file differs on
# every single run. Committing it guarantees a dirty working tree for anyone who
# regenerates the docs, and makes any "is it up to date?" CI check fail every time.
# CI regenerates it and publishes it with the site, so the download link still works.
/docs/schema/

# Build-time copy of the field reference guide, which lives in template/. Copied in by
# `just gen-doc` so template/ stays the single source of truth rather than being
# duplicated in git.
/docs/guides/

# Template page generated by `just gen-doc` from template/latest/
/docs/template.md

# Built documentation site
/site/
/public/
