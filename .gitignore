# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# python package artifacts
*.egg-info/
dist/
build/

# Generated from the LinkML schema; regenerate with the gen-* just recipes
/project/
/src/narad/datamodel/
/docs/schema/

# Intermediate RDF files
*.resolved.yaml
*.owl.ttl
*_rdf.ttl
/examples/*.ttl

# Reproducible PALS-to-NARAD skeletons and other local translation intermediates
/.local/translation/

# type checking and linting artifacts
.mypy_cache/
.pytype/
.pylint.d/
.ruff_cache/
.coverage.*


# Ignore virtual environment directories
venv/
env/
.venv/
ENV/

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore pytest cache
.pytest_cache/
.coverage
htmlcov/

# Ignore macOS Finder metadata
.DS_Store
**/.DS_Store
